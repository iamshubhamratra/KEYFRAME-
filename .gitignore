node_modules/
*/node_modules/
**/node_modules/

# v1 + server runtime artifacts
**/jobs/*
!**/jobs/.gitkeep
**/public/videos/*.mp4
jobs.json
**/jobs.json

# secrets
.env
**/.env
heygen-keyframes-video/config.json
keyframe-studio/config.json
server/config.json

# keyframe-studio runtime
keyframe-studio/jobs/
keyframe-studio/public/output/

# build outputs
web/dist/
**/public/dist/

# uploads / asset cache (large binaries)
server/uploads/
server/asset_cache/

# OS noise
Thumbs.db
.DS_Store

# Local curated asset library (large, not versioned)
server/asset_library/
server/_review/

# stray screenshots / runtime logs / large showcase binaries
image.png
**/image.png
*.run.log
server/public/showcase.mp4

# render/debug scratch output (generated, not source)
server/scrub/
server/framecheck/occ_test/

# stray debug screenshots + large showcase binaries (re-added)
image copy*.png
**/image copy*.png
server/showcase/

# auth runtime store (file-based users/otps)
auth-store.json
**/auth-store.json

# CLIP/transformers model weights (~150 MB, downloaded at runtime)
server/.cache/

# Slot-fit measurement output (regenerated by `npm run audit:slotfit`; large, machine-local)
server/scripts/slot-fit-*/
server/scripts/slot-fit-*.log
server/scripts/_fix_*/
server/scripts/_cmp.csv
server/scripts/_slot-problems.json
server/scripts/real-before/
server/scripts/real-after/
server/scripts/real-shots-*/

# Film portrait audit working output — rendered frames and contact sheets, regenerated
# on demand by `npm run audit:film` / `npm run sheet:film`.
server/scripts/vfilm/
server/scripts/vmulti/

# AI Video Edit runtime: private user uploads/renders, the project index, generated test
# fixtures (regenerated by `npm run fixtures:edit`) and e2e harness output
server/edits/
server/video-edits.json
server/video-edits.json.*
server/test-fixtures/
server/scripts/video-edit-e2e-out/
server/scripts/regression-baseline.local.json
