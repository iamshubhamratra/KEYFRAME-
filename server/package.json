{
  "name": "keyframe-server",
  "version": "0.1.0",
  "description": "KEYFRAME — multi-modal AI video studio backend. Prompt/video/URL -> editable script -> frame-pack-styled HyperFrames composition -> MP4.",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node scripts/dev-watch.js",
    "audit:contrast": "node scripts/audit-contrast.js",
    "audit:identity": "node scripts/audit-identity.js",
    "audit:portrait": "node scripts/portrait-audit.js",
    "check:packs": "node scripts/check-pack-identity.js",
    "test:director": "node scripts/template_director.test.cjs",
    "check:templates": "node scripts/check-templates.js",
    "test:engine": "node scripts/template_engine.test.cjs",
    "test:media": "node scripts/media_demand.test.cjs",
    "test:align": "node scripts/av_align.test.cjs",
    "audit:families": "node scripts/audit-families.js",
    "check:motion": "node scripts/check-motion.js",
    "check:pace": "node scripts/check-vertical-pace.js",
    "fonts:sync": "node scripts/sync-omelette-fonts.js",
    "check:fonts": "node scripts/sync-omelette-fonts.js --check",
    "qa:probe": "node scripts/qa-probe.js",
    "check:script": "node scripts/check-script-coverage.js",
    "test:queries": "node scripts/query_diversity.test.cjs",
    "test:shotretry": "node scripts/screenshot_retry.test.cjs",
    "test:pace": "node scripts/check-vertical-pace.js --selftest",
    "test:checker": "node scripts/contrast_check.test.cjs",
    "audit:density": "node scripts/audit-density.js",
    "audit:density:films": "node scripts/audit-density-films.js",
    "audit:capacity": "node scripts/audit-media-capacity.js 999 --save",
    "check:slots": "node scripts/check-slot-types.js",
    "check:graph": "node scripts/test-graph-topology.js"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@langchain/core": "^1.1.48",
    "@langchain/langgraph": "^1.4.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "hyperframes": "0.6.120",
    "jsonwebtoken": "^9.0.3",
    "msedge-tts": "^2.0.6",
    "multer": "^2.1.1",
    "nanoid": "^3.3.7",
    "nodemailer": "^9.0.1",
    "openai": "^4.73.0",
    "p-queue": "^6.6.2",
    "puppeteer-core": "^24.43.1",
    "zod": "^3.25.76"
  }
}
