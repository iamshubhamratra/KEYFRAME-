e":0.368},"assets/images/10.jpg":{"relevance":0,"visualQuality":10,"brandCompat":5,"storytelling":0,"motionPotential":10,"templateCompat":5,"overall":5,"clipRelevance":0.036}},"screenshotRankings":{"ranked":[]},"musicAnalysis":{"classification":"premium","fitScore":92,"introSuitable":true,"featureSuitable":true,"ctaSuitable":true,"keep":true,"suggestedQuery":"","note":"Bright electronica perfectly mirrors the satisfying, high-tech transition from chaotic notes to structured, clean UI."},"soundEffectAnalysis":{"recommend":["transition","highlight","cta"],"reject":["impact"],"note":"Replace heavy cinematic impacts with tactile clicks and digital sparkles to keep the app aesthetic premium and lightweight."},"sceneAssignments":{"s2":["assets/images/1.jpg","assets/images/7.svg"],"s5":["assets/images/8.jpg","assets/images/11.svg"],"s3":["assets/images/9.svg"]},"storytellingRecommendations":[],"templateCompatibility":{"framePack":"liquid-glass","category":"saas","note":"Scored against the selected frame pack (KEYFRAME's templates are frame packs).","averageScore":48},"qualityScore":59,"category":"saas","creativeDirectorNotes":["Rejected 4 weak/off-topic asset(s); prioritized quality over quantity.","Approved 5 asset(s); 2 cleared for prominent placement."]},"assets":[{"path":"assets/images/1.jpg","type":"image","sceneId":"s2","startSec":3,"durationSec":3,"style":"background","alt":"real product rises browser","width":1280,"height":720,"license":"Pixabay Content License","sourceUrl":"https://pixabay.com/vectors/laptop-workspace-flat-design-3214756/","source":"cache:pixabay","fromCache":true,"clipRelevance":0.713,"cdScore":58,"sees":"Flat vector illustration of a laptop, clipboard, phone, and coffee cup","cdProminence":"support","visionOk":true,"kind":"vector","fit":"contain","focus":"center","effect":"float","quality":"ok","cropFocus":"center center"},{"path":"assets/images/7.svg","type":"image","sceneId":"s2","startSec":3,"durationSec":3,"style":"background","alt":"real product rises browser","width":128,"height":128,"license":"Open source (Iconify — per-set license)","sourceUrl":"https://icon-sets.iconify.design/","source":"iconify","fromCache":false,"clipRelevance":0.722},{"path":"assets/images/8.jpg","type":"image","sceneId":"s5","startSec":6,"durationSec":3.5,"style":"inset","alt":"notebook","width":1280,"height":1071,"ratio":1.195,"hasAlpha":true,"license":"Pixabay Content License","sourceUrl":"https://pixabay.com/vectors/laptop-computer-portable-pc-2298286/","source":"pixabay","fromCache":false,"clipRelevance":0.368,"cdScore":59,"sees":"Flat vector illustration of a laptop, lamp, mug, and cactus","cdProminence":"support","visionOk":true,"kind":"vector","fit":"contain","focus":"center","effect":"float","quality":"ok","cropFocus":"center center"},{"path":"assets/images/9.svg","type":"image","sceneId":"s3","startSec":6,"durationSec":3.5,"style":"background","alt":"feature spotlight camera zooms","width":128,"height":128,"license":"Open source (Iconify — per-set license)","sourceUrl":"https://icon-sets.iconify.design/","source":"iconify","fromCache":false,"clipRelevance":0.553},{"path":"assets/images/11.svg","type":"image","sceneId":"s5","startSec":12,"durationSec":3,"style":"background","alt":"logo locks center soft","width":128,"height":128,"license":"Open source (Iconify — per-set license)","sourceUrl":"https://icon-sets.iconify.design/","source":"iconify","fromCache":false,"clipRelevance":0.38}],"text_review":{"source":"llm","added":7,"llmAdded":5,"minedAdded":2,"scenesWithSubtext":5,"scenesWithBullets":3,"sceneCount":5},"layout_review":{"keptScreenshots":0,"keptPhotos":2,"demoted":0,"heroScale":0.6,"montageMax":6,"prominentTotal":2,"scenes":[{"sceneId":"s1","archetype":"hook","heroScale":0.6},{"sceneId":"s2","archetype":"text","heroScale":0.6},{"sceneId":"s3","archetype":"text","heroScale":0.6},{"sceneId":"s4","archetype":"text","heroScale":0.6},{"sceneId":"s5","archetype":"cta","heroScale":0.6}],"score":{"compositionQuality":100,"source":"deterministic"}},"captions":[{"start":0,"end":2.25,"text":"Messy thoughts piling up?"},{"start":3,"end":6.55,"text":"NimbusNotes, the AI note-taking app."},{"start":7.1,"end":10.649999999999999,"text":"Turns messy thoughts into organized notes."},{"start":11.2,"end":14.2,"text":"Chaos to clarity in seconds."},{"start":14.75,"end":16.85,"text":"Try NimbusNotes now."}],"srt_url":"/videos/uf54lrpzsz.srt","final_attempt":"qa-repair","qa":{"pass":false,"score":4,"issues":[{"atSec":1.8,"severity":"blocker","issue":"Headlines are rendering in a generic system sans-serif font instead of the required 'Space Grotesk' display face, as evidenced by the standard double-story 'g' in 'thoughts' and 'taking'.","fix":"Update the CSS font-family rule for all headline elements to use 'Space Grotesk' to match the liquid-glass design system specifications."},{"atSec":1.8,"severity":"minor","issue":"The subtitle text duplicates the headline text exactly ('Messy thoughts?'), indicating a template variable binding error.","fix":"Change the subtitle text variable in scene 2 to a unique supporting description instead of duplicating the main headline."}]},"quality_report":{"verdict":"flagged","flags":["template fit 48/100","QA: 1 blocker(s)"],"contrast":{"checked":true,"fixed":2,"remaining":0,"passes":0},"identity":{"remapped":0},"layout":{"duplicatesRemoved":0,"collisionsScrimmed":0},"assetFloor":null,"audio":{"lufs":-14,"peak":-3,"lra":3.7,"target":-14,"layers":{"voice":5,"sfx":3,"music":true,"ambient":false,"musicEnvelope":false}},"screenshots":null,"assetQuality":59,"templateFit":48,"qa":{"pass":false,"score":4,"skipped":false,"blockers":1}}},{"id":"u4strmnt6y","kind":"project","prompt":"","duration":150,"orientation":"horizontal","quality":"1080p","width":1920,"height":1080,"fps":30,"frame_pack":"flagship","frame_pack_user":0,"status":"done","progress":"finalizing","video_url":"/videos/u4strmnt6y.mp4","error":null,"used_fallback":0,"llm_tokens_in":61850,"llm_tokens_out":28527,"created_at":1784716253115,"started_at":1784716617548,"finished_at":1784718005908,"client_ip":"::1","voice_style":null,"captions_enabled":0,"upload_path":null,"task":null,"requeue_count":1,"intent":{"prompt":"","websiteUrl":"https://linear.app","blogUrl":null,"hasReferenceVideo":false,"preferences":{"duration":150,"orientation":"horizontal","voiceStyle":"auto","framePack":"auto"},"website":{"url":"https://linear.app","title":"Linear – The system for product development","description":"Purpose-built for planning and building products with AI agents.","headings":["The product development system for teams and agentsThe product developmentsystem for teams and agentsThe product development system for teams and agents","Faster app launch","A new species of product tool. Purpose-built for modern teams with AI workflows at its core, Linear sets a new standard for planning and building products.","Make product operations self-driving","Define the product direction","Move work forward across teams and agents","Review PRs and agent output","Understand progress at scale","Changelog","Built for the future. Available today.","Product","Features","Company","Resources","Connect","Legal"],"bodyText":"Skip to content →\nProduct\nResources\nCustomers\nPricing\nNow\nContact\nLog in\nSign up\nThe product development\nsystem for teams and agents\nThe product development system for teams and agents\n\nPurpose-built for planning and building products. Designed for the AI era.\n\nNew\nCoding Sessions →\nLinear\nInbox\nMy issues\nReviews\nPulse\nWorkspace\nInitiatives\nProjects\nMore\nFavorites\nFaster app launch\nAgent tasks\nUI Refresh\nAgents Insights\nFaster app launch\n02\n/\n145\nFaster app launch\n\nRender UI before vehicle_state sync when minimum required state is present, instead of blocking on full refresh during iOS startup.\n\nActivity\nLinear created the issue via Slack on behalf of karri · 2min ago\nTriage Intelligence added the label Performance and iOS · 2min ago\nkarri\n· 4 min ago\nRight now we show a spinner forever, which makes it look like the car disappeared...\njori\n· just now\n@Linear can you take a stab at this?\nLinear\nconnected by\njori\n·\n2 min ago\nChanged 2 files\nDraft PR awaiting your review\n·\n2 min ago\nLinear moved from Todo to In Progress · just now\nLinearOpus 4.8\njori\nconnected Linear to ENG-2703\nExamining the startup path...\nWorked for 7s \nPushed and opened a draft PR. Changes:\nuseRideHistory.ts : build a waitingStatusById map and use it as the getLastAction by line\nRideHistoryPage.tsx : dimmed rows reset\nPreview\nChanged\n2 files\n+4\n-4\nDraft\nUpdate homepage H1\nmaster\n←\nride/drv-899-update-homepage-h1-65a6\nENG-2703\nIn Progress\nHigh\njori\nLinear\nLabels\nPerformance\niOS\nCycle\nCycle 144\nProject\nCore Performance\nA new species of product tool. Purpose-built for modern teams with AI workflows at its core, Linear sets a new standard for planning and building products.\nFIG 0.2\nPurpose-built\n\nLinear is shaped by the practices and principles of world-class product teams.\n\nFIG 0.3\nPowered by agents\n\nDesigned for workflows shared by humans and agents, from PRD to PR.\n\nFIG 0.4\nDesigned for speed\n\nReduces noise and restores momentum to help teams ship with high velocity and focus.\n\nMake product operations self-driving\n\nTurn conversations and customer feedback into actionable issues that are routed, labeled, and prioritized for the right team.\n\n1.0Intake→\nBacklog\n8\nENG-2085\nReduce UI flicker during autonomy...\nENG-2094\nAdd buffering for autonomy event streams\nENG-2092\nReduce startup delay caused by vehicle sync\nENG-2200\nFix delayed route updates during rerouting\nTodo\n71\nENG-926\nRemove UI inconsistencies\nBug\nDesign\nENG-2088\nTypeError: Cannot read properties\nBug\nENG-924\nUpgrade to Claude Opus 4.8\nAI\nENG-1882\nOptimize load times\nPerformance\nIn Progress\n3\nENG-1487\nRemove contentData from GraphQL API\n61039\nMKT-1028\nLaunch page assets\nDesign\nENG-2187\nPrevent duplicate ride requests on poor...\nBug\n62048\nDone\n53\nENG-2074\nClean up deprecated APIs...\nAPI\n61002\nENG-1912\nReduce latency in autonomy st...\n61005\nENG-1951\nReduce ETA fluctuations durin...\n61202\nENG-1960\nImprove fallback messaging\nUI\n61149\nENG-1991\nImprove rider visibility into veh...\nThread in #feedback\ndidier\n4:02 PM\nHas anyone been looking into the iOS startup performance issues?\nlena\n4:02 PM\nAnyone else noticing the iOS app feels slow to open if you haven't used it in a bit?\ndidier\n4:02 PM\nYea, we're still blocking initial render on a full vehicle_state sync every time...\nandreas\n4:02 PM\nFeels like we could render sooner and load the rest in the background. Probably also worth tracking startup timing so we know how often this happens!\n@Linear\ncreate urgent issues and assign to me\n1.1\nLinear Agent +\n1.2\nTriage +\n1.3\nCustomer Requests +\n1.4\nLinear Asks +\nDefine the product direction\n\nPlan and navigate from idea to launch. Align your team with product initiatives, strategic roadmaps, and clear, up-to-date PRDs.\n\n2.0Plan→\nFEB\nMAR\nAPR\nMAY\nJUN\nJUL\nAUG\nSEP\n2\n9\n16\n23\n2\n9\n16\n23\n30\n6\n13\n20\n27\n4\n11\n18\n25\n1\n8\n15\n22\n29\n6\n13\n20\n27\n3\n10\n17\n24\n31\n7\n14\n21\n28\nUI Refresh\nCore screens\nPolish\nSplit fares\nInternal\nPublic Beta\nAutonomy status clarity\nAlpha\nGA\nInitiatives\nCore Product\n99\nInfra stability\n28\nAutonomous systems\n16\nMobile ","brandColors":["#191917","#27261A","#201E12"],"ogImage":"https://linear.app/static/og/homepage.jpg","hasRealScreenshots":3},"__ingested":true},"autopilot":1,"render3d":0,"compose_mode":"standard","brief":{"improvedPrompt":"A 150-second horizontal brand film for Linear, the product development system purpose-built for modern teams and AI agents. It opens on the friction of fragmented planning tools, then reveals Linear as a single system that turns conversations into routed issues, aligns teams on initiatives and roadmaps, and moves work from PRD to PR with humans and agents side by side. Walk through self-driving intake and triage, strategic planning, agent-powered execution, PR review, and progress at scale. Built for product and engineering leaders who want speed without chaos. Premium, precise, and quietly confident — dark cinematic frames of the product UI, closing on Built for the future. Available today.","subject":"product development software dashboard UI","audience":"Product managers, engineering leaders, and modern product teams adopting AI agents","tone":"premium, precise, confident, futuristic","goal":"Make viewers feel Linear is the default OS for product work in the AI era — and sign up to try it","keyMessages":["The product development system for teams and agents","Purpose-built for planning and building products in the AI era","Make product operations self-driving","Workflows shared by humans and agents, from PRD to PR","Plan from idea to launch with initiatives, roadmaps, and PRDs","Review PRs and agent output; understand progress at scale"],"mustIncludeFacts":["Purpose-built for planning and building products with AI agents","Designed for the AI era","The product development system for teams and agents","Make product operations self-driving","Turn conversations and customer feedback into actionable issues that are routed, labeled, and prioritized","Designed for workflows shared by humans and agents, from PRD to PR","Reduces noise and restores momentum to help teams ship with high velocity and focus","Built for the future. Available today."],"brandColors":["#191917","#27261A","#201E12"],"suggestedFramePack":"flagship","suggestedDuration":150,"musicMood":"dark ambient electronica","voProfile":"male, mid-30s, calm, precise, quietly confident"},"script":{"title":"Linear Built for the AI Era","scenes":[{"id":"s1","start":0,"duration":3.5,"purpose":"hook","voiceover":"Product work is breaking.","onScreenText":["Too many tools."],"visualDirection":"Overlapping app windows shatter and scatter into a dark void as the camera pushes hard through the debris.","assetNeeds":[],"sfx":["impact"],"musicCue":"intro"},{"id":"s2","start":3.5,"duration":3.5,"purpose":"context","voiceover":"Planning here. Execution somewhere else.","onScreenText":["Fragmented by design"],"visualDirection":"A split frame of disconnected boards and docs slides apart, camera tracking the widening gap.","assetNeeds":[{"type":"image","query":"messy desk sticky notes laptop","role":"background"}],"sfx":["whoosh"],"musicCue":"intro"},{"id":"s3","start":7,"duration":4,"purpose":"context","voiceover":"Feedback drowns in inboxes. Priorities drift.","onScreenText":["Signal lost"],"visualDirection":"Unread counters and message piles stack upward while the camera slowly pushes into the clutter.","assetNeeds":[{"type":"icon","query":"chat bubble","role":"inset"}],"sfx":[],"musicCue":"build"},{"id":"s4","start":11,"duration":3.5,"purpose":"context","voiceover":"Noise wins. Momentum dies.","onScreenText":["Noise over signal"],"visualDirection":"Notification storms fade to black as a single stalled progress bar freezes mid-frame.","assetNeeds":[],"sfx":["swoosh"],"musicCue":"build"},{"id":"s5","start":14.5,"duration":4,"purpose":"context","voiceover":"Modern teams need one system.","onScreenText":["One system"],"visualDirection":"Scattered interface fragments pull inward and lock into a single dark geometric frame.","assetNeeds":[{"type":"icon","query":"layers","role":"inset"}],"sfx":["riser"],"musicCue":"build"},{"id":"s6","start":18.5,"duration":4.5,"purpose":"feature","voiceover":"Linear. The product development system for teams and agents.","onScreenText":["Linear"],"visualDirection":"Hero product UI in a browser frame blooms from darkness with a slow cinematic push-in.","assetNeeds":[],"sfx":["impact","sparkle"],"musicCue":"build"},{"id":"s7","start":23,"duration":4,"purpose":"feature","voiceover":"Purpose-built for planning and building with AI agents.","onScreenText":["Designed for the A