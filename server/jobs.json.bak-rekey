0,"inputCostUsd":0,"outputCostUsd":0,"totalCostUsd":0},"external":{"openrouter_chat":3,"openverse_search":4,"pixabay_scrape_search":3,"hyperframes_lint":1,"hyperframes_render":1},"totalCostUsd":0.321876},"stage_timings":{"storyboardMs":33804,"assetsMs":14721,"compose_renderMs":149847},"final_attempt":"main"},{"id":"4yuak7gkcm","kind":"project","prompt":"","duration":20,"orientation":"horizontal","quality":"720p","width":1280,"height":720,"fps":30,"frame_pack":"blockframe","status":"done","progress":"finalizing","video_url":null,"error":null,"used_fallback":0,"llm_tokens_in":92717,"llm_tokens_out":53668,"created_at":1781585582029,"started_at":1781585663381,"finished_at":1781586122394,"client_ip":"::1","voice_style":null,"captions_enabled":1,"upload_path":null,"intent":{"prompt":"","websiteUrl":"https://www.bulkdoor.in/","hasReferenceVideo":false,"preferences":{"duration":20,"orientation":"horizontal","voiceStyle":"auto","framePack":"blockframe"},"website":{"url":"https://www.bulkdoor.in/","title":"Bulkdoor - India's #1 B2B Beauty, Cosmetics & Skincare Wholesale Marketplace | Bulk Buy 50+ Brands","description":"Bulkdoor is India's First B2B wholesale marketplace for beauty, cosmetics, skincare, haircare & personal care. Buy Dot&Key, Lotus Herbals, Forever52 theboldeye, Mamaearth, Cetaphil & 50+ brands in bulk. MOQ from 6 units. 500+ SKUs. 100% authentic direct sourcing from verified suppliers. Pan-India delivery.","headings":["Your DirectGateway toWholesale Beauty","Welcome Back","Welcome Back","What is Bulkdoor?","Centralized Hub","Verification First","Scalable Growth","Source beauty stock with less guesswork","Buyer Confidence","What We Offer ?","Cosmetics","Skincare","Beauty Tools","Haircare","Fragrances","Our Services","Verified Supplier Sourcing","Authentic Products","Logistics Support","Market Analytics","How To Use Bulkdoor?","Login","Browse Brands","Select Quantity","Order & Delivery"],"bodyText":"Login\nB2B BEAUTY WHOLESALE\nYour Direct\nGateway to\nWholesale Beauty\n\nBulkdoor is a B2B wholesale marketplace in India for beauty, cosmetics, skincare, haircare and personal care products. It helps retailers, pharmacies, salons and resellers source from verified suppliers and brands - reducing traditional wholesaler layers. With low MOQ options, GST billing and Free doorstep delivery across India.\n\nBuilt for retailers, pharmacies, salons and resellers across India\n\nStart Shopping\nView Catalogue\n\nIndia's Trusted B2B Beauty Marketplace\n\n4.9/5\nWelcome Back\n\nAccess your wholesale Marketplace\n\nLogin\nRegister\n+91\nGet OTP\n\nBy continuing, you agree to our Terms of Service\n\nWhat is Bulkdoor?\n\nBulkdoor is a business-to-business(B2B) wholesale platform for beauty, cosmetics, skincare, haircare, and personal care products in India. It helps retailers, shop owners, pharmacies, salons, and resellers find products and buy in bulk with low MOQ. You get GST invoices and delivery across India - all from one place, with 100% authentic and original product quality.\n\nCentralized Hub\n\nAccess beauty, cosmetics, skincare, haircare and personal care products through a single interface for simpler bulk procurement.\n\nVerification First\n\nCheck supplier information, GST billing, product details and support terms before placing larger orders.\n\nScalable Growth\n\nStart with smaller quantities where available, then increase order size as your demand becomes predictable.\n\nBUILT FOR BUSINESS BUYING\nSource beauty stock with less guesswork\n\nBulkdoor helps retailers, pharmacies, salons and resellers buy beauty, cosmetics, skincare, haircare and personal care products through one B2B catalogue, with low MOQ options, GST billing and order support built into the sourcing flow.\n\n50+\nBRANDS\n500+\nSKUS\nGST\nBILLING\nPan-India\nDELIVERY\nBrowse Wholesale Products\nTalk to Sales\nBuyer Confidence\n\nA simple first-order path for new B2B buyers.\n\n01\nChoose the right Products\n\nSelect brands, categories, pack sizes, MOQ and wholesale pricing before adding stock.\n\n02\nVerify business details\n\nUse GST billing, product information and seller support to confirm your purchase terms.\n\n03\nStart with a controlled order\n\nChoose quantity and place your order easily. You can start small with low MOQ.\n\n04\nTrack delivery and reorder\n\nGet regular updates and use support to manage your inventory flow.\n\nWhat We Offer ?\n\nExplore a wide range of professional beauty product categories\n\nCosmetics\n\nA wide range of makeup products from trusted beauty brands.\n\nSkincare\n\nSkincare products for pharmacies, salons, beauty retailers and resellers.\n\nBeauty Tools\n\nProfessional beauty tools for precise and effective application.\n\nHaircare\n\nProfessional haircare products for healthy, beautiful hair.\n\nFragrances\n\nPopular perfumes and fragrances for every preference.\n\nOur Services\nVerified Supplier Sourcing\n\nSource through brand, distributor and supplier channels reviewed for business suitability, invoice readiness and product information quality.\n\nAuthentic Products\n\nBulkdoor prioritizes genuine inventory, clear product details and GST billing so business buyers can verify what they are purchasing before scaling orders.\n\nQUALITY GUARANTEED\nLogistics Support\n\nTracked fulfillment support from dispatch to delivery, with order updates designed for retailers, salons, resellers and distributors.\n\nMarket Analytics\n\nUse category demand, brand availability and wholesale pricing signals to plan inventory more carefully and reduce dead stock.\n\n85%\nACCURACY\n24/7\nUPTIME\n4.8/5\nRATING\nHow To Use Bulkdoor?\n\nGet started in 4 simple steps\n\n1\nLogin\n\nQuick access using your Mobile Number and OTP.\n\n2\nBrowse Brands\n\nExplore beauty, skincare, haircare and personal care products from listed brands.\n\n3\nSelect Quantity\n\nChoose the exact quantities you need for your business inventory.\n\n4\nOrder & Delivery\n\nSet payment method and tracked delivery to your doorstep.\n\nGame Changer for Small Businesses\nLow MOQ Options.\nWholesale Pricing.\n\nStart with s","brandColors":["#0F314F","#0B243B","#304E6A","#2A445B"],"ogImage":"https://www.bulkdoor.in/logo.png","hasRealScreenshots":3},"__ingested":true},"autopilot":0,"brief":{"improvedPrompt":"An energetic B2B promo targeting Indian beauty retailers, salon owners, and pharmacies. The video kicks off with the frustration of traditional wholesale layers, quickly introducing Bulkdoor as the ultimate direct gateway to wholesale beauty. It showcases top brands, low MOQs starting at 6 units, and 100% authentic sourcing with GST billing. The video wraps with a clear 4-step call-to-action to register and start shopping with Pan-India delivery.","audience":"Indian beauty retailers, pharmacies, salons, and cosmetics resellers seeking a reliable bulk sourcing platform.","tone":"confident, efficient, modern, trustworthy","goal":"Get retail business owners to register on Bulkdoor and place their first low-MOQ wholesale order.","keyMessages":["India's #1 B2B marketplace for beauty, skincare, and cosmetics.","Buy directly from 50+ trusted brands with 500+ SKUs.","Low MOQ starting from just 6 units with official GST billing.","100% authentic products delivered straight to your doorstep Pan-India."],"mustIncludeFacts":["50+ brands","500+ SKUs","MOQ from 6 units","100% authentic direct sourcing from verified suppliers","Pan-India delivery","GST billing"],"brandColors":["#0F314F","#0B243B","#304E6A","#2A445B"],"suggestedFramePack":"blockframe","suggestedDuration":20,"musicMood":"upbeat corporate synth-pop","voProfile":"female, mid-20s, energetic, clear Indian-accented English"},"script":{"title":"Bulkdoor Direct Wholesale Beauty Gateway","scenes":[{"id":"s1","start":0,"duration":3.5,"purpose":"hook","voiceover":"Tired of endless wholesale middlemen?","onScreenText":["Bypass Middlemen","Direct Wholesale"],"visualDirection":"Split-screen layout highlighting a frustrated retail owner looking at messy paperwork in a salon.","assetNeeds":[{"type":"video","query":"frustrated business owner salon","role":"background"}],"sfx":["impact"],"musicCue":"intro"},{"id":"s2","start":3.5,"duration":3.5,"purpose":"context","voiceover":"Meet Bulkdoor, your direct beauty gateway.","onScreenText":["Bulkdoor","50+ Brands","500+ SKUs"],"visualDirection":"An energetic reveal of various cosmetics and skincare products floating in a clean, modern grid.","assetNeeds":[{"type":"video","query":"skincare cosmetics bottles layout","role":"background"}],"sfx":["whoosh"],"musicCue":"build"},{"id":"s3","start":7,"duration":3.5,"purpose":"proof","voiceover":"Source fifty plus brands completely risk free.","onScreenText":["100% Authentic","Verified Suppliers"],"visualDirection":"The real product UI displayed inside a sleek browser frame, showcasing the brand catalog and verified badges.","assetNeeds":[],"sfx":["pop"],"musicCue":"steady"},{"id":"s4","start":10.5,"duration":3.5,"purpose":"feature","voiceover":"Order just six units with GST billing.","onScreenText":["MOQ: 6 Units","Official GST Billing"],"visualDirection":"A dynamic split layout highlighting a small box of six cosmetic items next to a clean digital GST invoice.","assetNeeds":[{"type":"icon","query":"approved invoice document","role":"inset"}],"sfx":["click"],"musicCue":"steady"},{"id":"s5","start":14,"duration":3,"purpose":"feature","voiceover":"Get authentic products delivered Pan-India.","onScreenText":["Pan-India","Doorstep Delivery"],"visualDirection":"Fast-paced motion of a delivery vehicle traveling across a stylized map of India.","assetNeeds":[{"type":"video","query":"delivery truck road fast","role":"background"}],"sfx":["swoosh"],"musicCue":"lift"},{"id":"s6","start":17,"duration":3,"purpose":"cta","voiceover":"Register today and start growing your business.","onScreenText":["Register in 4 Steps","Start Sourcing Now"],"visualDirection":"Bold typography with a clean mockup of the registration button in Bulkdoor brand colors.","assetNeeds":[],"sfx":["riser","impact"],"musicCue":"outro"}],"music":{"mood":"upbeat corporate synth-pop","query":"energetic upbeat synth-pop b2b"},"voice":{"style":"female, mid-20s, energetic, clear Indian-accented English","pace":"conversational"}},"script_warnings":[],"website_screenshot":"C:\\MERN\\Internshit website\\KEYFRAME\\server\\jobs\\4yuak7gkcm\\ingest\\website.png","website_screenshots":["C:\\MERN\\Internshit website\\KEYFRAME\\server\\jobs\\4yuak7gkcm\\ingest\\website.png","C:\\MERN\\Internshit website\\KEYFRAME\\server\\jobs\\4yuak7gkcm\\ingest\\website_section2.png","C:\\MERN\\Internshit website\\KEYFRAME\\server\\jobs\\4yuak7gkcm\\ingest\\website_section3.png"],"website_title":"Bulkdoor - India's #1 B2B Beauty, Cosmetics & Skincare Wholesale Marketplace | Bulk Buy 50+ Brands","usage":{"llm":{"inputTokens":92717,"outputTokens":53668,"callCount":6,"inputCostUsd":0.139076,"outputCostUsd":0.483012,"totalCostUsd":0.622088},"tts":{"inputChars":291,"inputTokensEst":76,"outputTokensEst":1074,"callCount":7,"inputCostUsd":0.000046,"outputCostUsd":0.002578,"totalCostUsd":0.002623},"external":{"freesound_search":1,"internet_archive_search":1,"openrouter_tts":7,"openrouter_chat":6,"openverse_search":2,"asset_cache_hit":1,"pixabay_scrape_search":2,"hyperframes_lint":2,"hyperframes_render":2},"totalCostUsd":0.624711},"stage_timings":{"ingestMs":11609,"briefMs":12953,"scriptMs":21589,"productionMs":459013},"assets":[{"path":"assets/images/site_0.png","type":"image","sceneId":"s2","startSec":3.5,"durationSec":3.5,"style":"inset","alt":"REAL website screenshot of Bulkdoor - India's #1 B2B Beauty, Cosmetics & Skincare Wholesale Marketplace | Bulk Buy 50+ Brands (homepage hero) — present in a styled browser frame with hero treatment","license":"owner content","sourceUrl":"https://www.bulkdoor.in/","source":"website","fromCache":false},{"path":"assets/images/site_1.png","type":"image","sceneId":"s3","startSec":7,"durationSec":3.5,"style":"inset","alt":"REAL website screenshot of Bulkdoor - India's #1 B2B Beauty, Cosmetics & Skincare Wholesale Marketplace | Bulk Buy 50+ Brands (page section 2) — present in a styled browser frame with hero treatment","license":"owner content","sourceUrl":"https://www.bulkdoor.in/","source":"website","fromCache":false},{"path":"assets/images/site_2.png","type":"image","sceneId":"s4","startSec":10.5,"durationSec":3.5,"style":"inset","alt":"REAL website screenshot of Bulkdoor - India's #1 B2B Beauty, Cosmetics & Skincare Wholesale Marketplace | Bulk Buy 50+ Brands (page section 3) — present in a styled browser frame with hero treatment","license":"owner content","sourceUrl":"https://www.bulkdoor.in/","source":"website","fromCache":false},{"path":"assets/images/0.jpg","type":"image","sceneId":"s1","startSec":0,"durationSec":3.5,"style":"background","alt":"frustrated business owner salon","license":"Pixabay Content License","sourceUrl":"https://cdn.pixabay.com/photo/2017/12/29/11/14/business-3047316_1280.jpg","source":"pixabay_scrape","fromCache":false},{"path":"assets/images/1.jpg","type":"image","sceneId":"s4","startSec":10.5,"durationSec":3.5,"style":"inset","alt":"approved invoice document","license":"Pixabay Content License","sourceUrl":"https://cdn.pixabay.com/photo/2016/02/17/13/28/workbook-1205044_1280.jpg","source":"pixabay_scrape","fromCache":false},{"path":"assets/images/2.jpg","type":"image","sceneId":"s5","startSec":14,"durationSec":3,"style":"background","alt":"delivery truck road fast","license":"Pixabay Content License","sourceUrl":"https://cdn.pixabay.com/photo/2021/02/14/19/27/night-6015583_1280.jpg","source":"cache:pixabay_scrape","fromCache":true}],"captions":[{"start":0,"end":2.5,"text":"Tired of endless wholesale middlemen?"},{"start":3.5,"end":6.65,"text":"Meet Bulkdoor, your direct beauty gateway."},{"start":7,"end":10.4,"text":"Source fifty plus brands completely risk free."},{"start":10.5,"end":13.5,"text":"Order just six units with GST billing."},{"start":14,"end":16.95,"text":"Get authentic products delivered Pan-India."},{"start":17,"end":19.65,"text":"Register today and grow your business."}],"srt_url":"/videos/4yuak7gkcm.srt","final_attempt":"qa-repair","qa":{"pass":true,"score":10,"issues":[]}},{"id":"xqwj377ft0","kind":"project","prompt":"Atlas is an AI teammate that automates repetitive work across email, meetings, research, project management, and reporting.\n\nThe tone should feel like a mix of Apple, Linear, Arc Browser, and Stripe.\n\nThe audience is startup founders, product managers, engineers, and executives.\n\nDo not create a feature slideshow.\n\nCreate an emotional narrative.\n\nThe video should begin by showing the chaos of modern work.\n\nHundreds of notifications.\n\nTabs multiplying.\n\nMeetings stacking.\n\nDocuments scattered.\n\nPeople drowning in busywork.\n\nThen introduce Atlas as the solution.\n\nShow Atlas understanding context across tools.\n\nAutomating tasks.\n\nWriting reports.\n\nSummarizing meetings.\n\nFinding information instantly.\n\nCoordinating projects.\n\nEnd with the idea that humans should focus on thinking while Atlas handles execution.\n\nUse premium motion design.\n\nUse kinetic typography.\n\nUse dynamic camera movement.\n\nUse depth, particles, animated gradients, and cinematic transitions.\n\nThe final feeling should be:\n\n\"Work just changed forever.\"\n\nDuration: 60 seconds.\n\nExpected Script Output\nScene 1 — The Chaos\n\nVoiceover:\n\nWork was supposed to get easier. Instead, it became noise.\n\nVisuals:\n\nNotification storm\nSlack bubbles\nEmail floods\nCalendar collisions\nBrowser tabs multiplying endlessly\n\nMotion:\n\nFast camera movement\nParallax layers\nAlert explosions\nScene 2 — Drowning\n\nVoiceover:\n\nEvery day begins with a hundred decisions that shouldn't exist.\n\nVisuals:\n\nEndless task cards\nDocuments stacking\nMeeting windows expanding\n\nMotion:\n\nCards overwhelm screen\nCamera trapped in clutter\nScene 3 — The Breaking Point\n\nVoiceover:\n\nThe problem isn't effort. It's fragmentation.\n\nVisuals:\n\nWork apps floating apart\nData scattered everywhere\n\nMotion:\n\nSystems drifting apart in 3D space\nScene 4 — Atlas Appears\n\nVoiceover:\n\nMeet Atlas.\n\nVisuals:\n\nCalm light emerges\nNoise fades\nElegant AI core appears\n\nMotion:\n\nMassive cinematic reveal\nParticle convergence\nScene 5 — Understanding Everything\n\nVoiceover:\n\nAtlas understands your work the way a teammate does.\n\nVisuals:\n\nEmails\nDocs\nMeetings\nTasks\n\nall connecting into one intelligence layer\n\nMotion:\n\nNeural network animations\nData flowing\nScene 6 — Meetings\n\nVoiceover:\n\nEvery meeting summarized before you ask.\n\nVisuals:\n\nTranscript transforms into insights\n\nMotion:\n\nText morphing\nHighlight extraction\nScene 7 — Research\n\nVoiceover:\n\nHours of research condensed into seconds.\n\nVisuals:\n\nHundreds of pages collapsing into one answer\n\nMotion:\n\nDocuments flying toward center\nScene 8 — Projects\n\nVoiceover:\n\nAtlas keeps every project moving.\n\nVisuals:\n\nRoadmaps\nTimelines\nTeam coordination\n\nMotion:\n\nDynamic progress systems\nScene 9 — The Transformation\n\nVoiceover:\n\nLess management. More momentum.\n\nVisuals:\n\nWorkspace becomes clean\nFocus returns\n\nMotion:\n\nClutter dissolves\nScene 10 — Future of Work\n\nVoiceover:\n\nThe future isn't working harder. It's working with Atlas.\n\nVisuals:\n\nBeautiful hero shot\nGlobal network\nProduct UI showcase\n\nMotion:\n\nEpic pullback\nCinematic ending","duration":20,"orientation":"horizontal","quality":"720p","width":1280,"height":720,"fps":30,"frame_pack":"blockframe","status":"done","progress":"finalizing","video_url":null,"error":null,"used_fallback":0,"llm_tokens_in":88452,"llm_tokens_out":61938,"created_at":1781590778375,"started_at":1781591804153,"finished_at":1781592246943,"client_ip":"::1","voice_style":null,"captions_enabled":1,"upload_path":null,"intent":{"prompt":"Atlas is an AI teammate that automates repetitive work across email, meetings, research, project management, and reporting.\n\nThe tone should feel like a mix of Apple, Linear, Arc Browser, and Stripe.\n\nThe audience is startup founders, product managers, engineers, and executives.\n\nDo not create a feature slideshow.\n\nCreate an emotional narrative.\n\nThe video should begin by showing the chaos of modern work.\n\nHundreds of notifications.\n\nTabs multiplying.\n\nMeetings stacking.\n\nDocuments scattered.\n\nPeople drowning in busywork.\n\nThen introduce Atlas as the solution.\n\nShow Atlas understanding context across tools.\n\nAutomating tasks.\n\nWriting reports.\n\nSummarizing meetings.\n\nFinding information instantly.\n\nCoordinating projects.\n\nEnd with the idea that humans should focus on thinking while Atlas handles execution.\n\nUse premium motion design.\n\nUse kinetic typography.\n\nUse dynamic camera movement.\n\nUse depth, particles, animated gradients, and cinematic transitions.\n\nThe final feeling should be:\n\n\"Work just changed forever.\"\n\nDuration: 60 seconds.\n\nExpected Script Output\nScene 1 — The Chaos\n\nVoiceover:\n\nWork was supposed to get easier. Instead, it became noise.\n\nVisuals:\n\nNotification storm\nSlack bubbles\nEmail floods\nCalendar collisions\nBrowser tabs multiplying endlessly\n\nMotion:\n\nFast camera movement\nParallax layers\nAlert explosions\nScene 2 — Drowning\n\nVoiceover:\n\nEvery day begins with a hundred decisions that shouldn't exist.\n\nVisuals:\n\nEndless task cards\nDocuments stacking\nMeeting windows expanding\n\nMotion:\n\nCards overwhelm screen\nCamera trapped in clutter\nScene 3 — The Breaking Point\n\nVoiceover:\n\nThe problem isn't effort. It's fragmentation.\n\nVisuals:\n\nWork apps floating apart\nData scattered everywhere\n\nMotion:\n\nSystems drifting apart in 3D space\nScene 4 — Atlas Appears\n\nVoiceover:\n\nMeet Atlas.\n\nVisuals:\n\nCalm light emerges\nNoise fades\nElegant AI core appears\n\nMotion:\n\nMassive cinematic reveal\nParticle convergence\nScene 5 — Understanding Everything\n\nVoiceover:\n\nAtlas understands your work the way a teammate does.\n\nVisuals:\n\nEmails\nDocs\nMeetings\nTasks\n\nall connecting into one intelligence layer\n\nMotion:\n\nNeural network animations\nData flowing\nScene 6 — Meetings\n\nVoiceover:\n\nEvery meeting summarized before you ask.\n\nVisuals:\n\nTranscript transforms into insights\n\nMotion:\n\nText morphing\nHighlight extraction\nScene 7 — Research\n\nVoiceover:\n\nHours of research condensed into seconds.\n\nVisuals:\n\nHundreds of pages collapsing into one answer\n\nMotion:\n\nDocuments flying toward center\nScene 8 — Projects\n\nVoiceover:\n\nAtlas keeps every project moving.\n\nVisuals:\n\nRoadmaps\nTimelines\nTeam coordination\n\nMotion:\n\nDynamic progress systems\nScene 9 — The Transformation\n\nVoiceover:\n\nLess management. More momentum.\n\nVisuals:\n\nWorkspace becomes clean\nFocus returns\n\nMotion:\n\nClutter dissolves\nScene 10 — Future of Work\n\nVoiceover:\n\nThe future isn't working harder. It's working with Atlas.\n\nVisuals:\n\nBeautiful hero shot\nGlobal network\nProduct UI showcase\n\nMotion:\n\nEpic pullback\nCinematic ending","websiteUrl":null,"hasReferenceVideo":false,"preferences":{"duration":20,"orientation":"horizontal","voiceStyle":"auto","framePack":"blockframe"}},"autopilot":0,"brief":{"improvedPrompt":"A cinematic, high-momentum video for startup founders, PMs, and executives overwhelmed by digital noise. The narrative opens in a chaotic, fast-paced storm of multiplying browser tabs, notification alerts, and fragmented tools. A sudden, elegant transition cuts through the clutter to reveal Atlas—a premium AI teammate. Through sleek kinetic typography and dynamic camera movements, we see Atlas instantly synthesize meetings, condense hours of research, and coordinate projects in the background. The video ends on a clean, focused, and triumphant note, leaving the viewer with the profound realization that work has just changed forever, freeing them to focus entirely on thinking.","audience":"Startup founders, product managers, software engineers, and enterprise executives.","tone":"cinematic, premium, focused, revolutionary","goal":"Convince the viewer that Atlas completely redefines and simplifies daily work, shifting their role from tedious execution to pure thinking.","keyMessages":["Modern work is broken, fragmented by endless notifications, meetings, and scattered tools.","Atlas is an AI teammate that understands context across all your existing platforms.","Atlas automates repetitive execution: summarizing meetings, conducting research, and coordinating projects.","Humans should focus on high-level thinking while AI handles the execution."],"mustIncludeFacts":["Atlas is an AI teammate that automates repetitive work across email, meetings, research, project management, and reporting."],"brandColors":["#121214","#FFFFFF","#5469D4","#00D4B2"],"suggestedFramePack":"blockframe","suggestedDuration":20,"musicMood":"cinematic ambient electronica","voProfile":"neutral, mid-30s, calm, authoritative, and cinematic"},"script":{"title":"Atlas: Redefining the Future of Work","scenes":[{"id":"s1","start":0,"duration":4,"purpose":"hook","voiceover":"Modern work is broken, buried in digital noise.","onScreenText":["DIGITAL NOISE","WORK IS BROKEN"],"visualDirection":"A fast-paced, chaotic collage of multiplying browser tabs and flashing notification alerts overlaying a dark background.","assetNeeds":[{"type":"video","query":"glitchy notification screens digital chaos","role":"background"}],"sfx":["riser"],"musicCue":"intro"},{"id":"s2","start":4,"duration":4,"purpose":"context","voiceover":"Meet Atlas. Your premium AI teammate.","onScreenText":["MEET ATLAS","YOUR AI TEAMMATE"],"visualDirection":"A sudden, elegant transition cuts through the noise, revealing a clean dark space with a glowing teal abstract sphere.","assetNeeds":[{"type":"video","query":"abstract glowing particle sphere dark background","role":"background"}],"sfx":["impact","whoosh"],"musicCue":"build"},{"id":"s3","start":8,"duration":4,"purpose":"feature","voiceover":"It automates meetings, research, and project execution.","onScreenText":["AUTOMATED EXECUTION","MEETINGS • RESEARCH • PROJECTS"],"visualDirection":"A sleek browser frame slides into view, showcasing the real Atlas product UI summarizing documents and updating project timelines dynamically.","assetNeeds":[],"sfx":["click"],"musicCue":"steady"},{"id":"s4","start":12,"duration":4,"purpose":"proof","voiceover":"Freeing you to focus on high-level thinking.","onScreenText":["FOCUS ON THINKING"],"visualDirection":"A cinematic, slow-motion shot of a thoughtful founder illuminated by screen light, looking focused and calm.","assetNeeds":[{"type":"video","query":"thoughtful founder face screen light reflection","role":"background"}],"sfx":["transition"],"musicCue":"lift"},{"id":"s5","start":16,"duration":4,"purpose":"cta","voiceover":"Atlas is here. Redefine how you work.","onScreenText":["ATLAS","WORK REDEFINED"],"visualDirection":"A premium, minimalist dark screen displaying the Atlas wordmark in elegant white and teal typography.","assetNeeds":[],"sfx":["sparkle","impact"],"musicCue":"outro"}],"music":{"mood":"cinematic ambient electronica","query":"cinematic ambient electronic tension resolution"},"voice":{"style":"neutral, mid-30s, calm, authoritative, and cinematic","pace":"conversational"}},"script_warnings":[],"usage":{"llm":{"inputTokens":88452,"outputTokens":61938,"callCount":5,"inputCostUsd":0.132678,"outputCostUsd":0.557442,"totalCostUsd":0.69012},"tts":{"inputChars":220,"inputTokensEst":57,"outputTokensEst":814,"callCount":5,"inputCostUsd":0.000034,"outputCostUsd":0.001954,"totalCostUsd":0.001988},"external":{"freesound_search":1,"internet_archive_search":1,"openrouter_tts":5,"internet_archive_download":1,"openrouter_chat":5,"asset_library_hit":4,"hyperframes_lint":2,"hyperframes_render":2},"totalCostUsd":0.692108},"stage_timings":{"briefMs":10191,