-photography-dslr-581126/","source":"cache:pixabay","fromCache":true},{"path":"assets/images/5.svg","type":"image","sceneId":"s4","startSec":12,"durationSec":4,"style":"inset","alt":"customer support headset glow","license":"curated-library","sourceUrl":null,"source":"library:vector-illustrator","fromCache":true},{"path":"assets/images/6.jpg","type":"image","sceneId":"s4","startSec":12,"durationSec":4,"style":"background","alt":"clean glowing booking confirmation","license":"Pixabay Content License","sourceUrl":"https://pixabay.com/photos/return-feedback-news-board-chalk-1825515/","source":"pixabay","fromCache":false},{"path":"assets/images/7.svg","type":"image","sceneId":"s5","startSec":16,"durationSec":4,"style":"background","alt":"bold red brand logo","license":"curated-library","sourceUrl":null,"source":"library:vector-illustrator","fromCache":true}],"captions":[{"start":0,"end":1.854688,"text":"Looking for your next big night out?"},{"start":3.5,"end":7.209375,"text":"Get instant access to movies, sports, plays, and live events."},{"start":7.5,"end":10.922,"text":"Discover the very best experiences happening right in your city."},{"start":12,"end":15.5265,"text":"Book instantly, backed by twenty-four seven customer care."},{"start":16,"end":18.324875,"text":"Open BookMyShow and book your tickets today."}],"srt_url":"/videos/g7zja4jvyr.srt","final_attempt":"qa-repair","qa":{"pass":false,"score":4,"issues":[{"atSec":2.1,"severity":"blocker","issue":"The cyan accent line overlaps and strikes through the subtitle text, reducing readability.","fix":"Reposition the cyan line element downward to sit below the subtitle text container."},{"atSec":14.4,"severity":"minor","issue":"The decorative icon on the right has extremely low contrast against the dark background.","fix":"Apply a light gradient or glow to the icon asset to improve visibility."}]}},{"id":"redumtyq9p","kind":"generate","prompt":"A 12-second promo for FocusFlow, a productivity app for developers to manage deep-work sessions.","duration":12,"orientation":"horizontal","quality":"720p","width":1280,"height":720,"fps":30,"frame_pack":"blockframe","status":"done","progress":"finalizing","video_url":null,"error":null,"used_fallback":0,"llm_tokens_in":15134,"llm_tokens_out":1371,"created_at":1782969670037,"started_at":1782969670039,"finished_at":1782969742172,"client_ip":"::1","voice_style":null,"captions_enabled":0,"upload_path":null,"intent":null,"autopilot":0,"brief":null,"script":null,"script_warnings":null,"usage":{"byStage":[{"stage":"storyboard","model":"google/gemini-3.5-flash","inputTokens":10365,"outputTokens":961,"totalTokens":11326,"callCount":1,"costUsd":0.005512},{"stage":"brief","model":"google/gemini-3.5-flash","inputTokens":2200,"outputTokens":293,"totalTokens":2493,"callCount":1,"costUsd":0.001393},{"stage":"audio","model":"google/gemini-3.5-flash","inputTokens":2569,"outputTokens":117,"totalTokens":2686,"callCount":1,"costUsd":0.001063}],"llm":{"inputTokens":15134,"outputTokens":1371,"callCount":3,"inputCostUsd":0.00454,"outputCostUsd":0.003428,"totalCostUsd":0.007968},"tts":{"inputChars":154,"inputTokensEst":40,"outputTokensEst":471,"callCount":3,"inputCostUsd":0.000024,"outputCostUsd":0.00113,"totalCostUsd":0.001154},"external":{"openrouter_chat":3,"freesound_search":1,"openrouter_tts":3,"hyperframes_render":1,"freesound_download":1},"totalCostUsd":0.009122},"stage_timings":{"briefMs":10189,"storyboardMs":15675,"voMs":10690,"compose_renderMs":33969,"audioMs":1605},"final_attempt":"three"},{"id":"j6jjiup2op","kind":"project","prompt":"A 12-second promo for Linear, the issue tracker built for modern software teams.","duration":12,"orientation":"horizontal","quality":"720p","width":1280,"height":720,"fps":30,"frame_pack":"midnight-glass","status":"done","progress":"finalizing","video_url":null,"error":null,"used_fallback":0,"llm_tokens_in":31054,"llm_tokens_out":1416,"created_at":1782972183159,"started_at":1782972217432,"finished_at":1782972605033,"client_ip":"::1","voice_style":null,"captions_enabled":0,"upload_path":null,"intent":{"prompt":"A 12-second promo for Linear, the issue tracker built for modern software teams.","websiteUrl":"https://linear.app","hasReferenceVideo":false,"preferences":{"duration":12,"orientation":"horizontal","voiceStyle":"auto","framePack":"auto"},"website":{"url":"https://linear.app","title":"Linear – The system for product development","description":"Purpose-built for planning and building products with AI agents.","headings":["The product development system for teams and agentsThe product developmentsystem for teams and agentsThe product development system for teams and agents","Faster app launch","A new species of product tool. Purpose-built for modern teams with AI workflows at its core, Linear sets a new standard for planning and building products.","Make product operations self-driving","Define the product direction","Move work forward across teams and agents","Review PRs and agent output","Understand progress at scale","Changelog","Built for the future. Available today.","Product","Features","Company","Resources","Connect","Legal"],"bodyText":"Skip to content →\nProduct\nResources\nCustomers\nPricing\nNow\nContact\nLog in\nSign up\nThe product development\nsystem for teams and agents\nThe product development system for teams and agents\n\nPurpose-built for planning and building products. Designed for the AI era.\n\nNew\nCoding Sessions →\nLinear\nInbox\nMy issues\nReviews\nPulse\nWorkspace\nInitiatives\nProjects\nMore\nFavorites\nFaster app launch\nAgent tasks\nUI Refresh\nAgents Insights\nFaster app launch\n02\n/\n145\nFaster app launch\n\nRender UI before vehicle_state sync when minimum required state is present, instead of blocking on full refresh during iOS startup.\n\nActivity\nLinear created the issue via Slack on behalf of karri · 2min ago\nTriage Intelligence added the label Performance and iOS · 2min ago\nkarri\n· 4 min ago\nRight now we show a spinner forever, which makes it look like the car disappeared...\njori\n· just now\n@Linear can you take a stab at this?\nLinear\nconnected by\njori\n·\n2 min ago\nChanged 2 files\nDraft PR awaiting your review\n·\n2 min ago\nLinear moved from Todo to In Progress · just now\nLinearOpus 4.8\njori\nconnected Linear to ENG-2703\nExamining the startup path...\nThinking...\nENG-2703\nIn Progress\nHigh\njori\nLinear\nLabels\nPerformance\niOS\nCycle\nCycle 144\nProject\nCore Performance\nA new species of product tool. Purpose-built for modern teams with AI workflows at its core, Linear sets a new standard for planning and building products.\nFIG 0.2\nBuilt for purpose\n\nLinear is shaped by the practices and principles of world-class product teams.\n\nFIG 0.3\nPowered by AI agents\n\nDesigned for workflows shared by humans and agents, from PRD to PR.\n\nFIG 0.4\nDesigned for speed\n\nReduces noise and restores momentum to help teams ship with high velocity and focus.\n\nMake product operations self-driving\n\nTurn conversations and customer feedback into actionable issues that are routed, labeled, and prioritized for the right team.\n\n1.0Intake→\nBacklog\n8\nENG-2085\nReduce UI flicker during autonomy...\nENG-2094\nAdd buffering for autonomy event streams\nENG-2092\nReduce startup delay caused by vehicle sync\nENG-2200\nFix delayed route updates during rerouting\nTodo\n71\nENG-926\nRemove UI inconsistencies\nBug\nDesign\nENG-2088\nTypeError: Cannot read properties\nBug\nENG-924\nUpgrade to Claude Opus 4.8\nAI\nENG-1882\nOptimize load times\nPerformance\nIn Progress\n3\nENG-1487\nRemove contentData from GraphQL API\n61039\nMKT-1028\nLaunch page assets\nDesign\nENG-2187\nPrevent duplicate ride requests on poor...\nBug\n62048\nDone\n53\nENG-2074\nClean up deprecated APIs...\nAPI\n61002\nENG-1912\nReduce latency in autonomy st...\n61005\nENG-1951\nReduce ETA fluctuations durin...\n61202\nENG-1960\nImprove fallback messaging\nUI\n61149\nENG-1991\nImprove rider visibility into veh...\nThread in #feedback\ndidier\n11:33 AM\nHas anyone been looking into the iOS startup performance issues?\nlena\n11:33 AM\nAnyone else noticing the iOS app feels slow to open if you haven't used it in a bit?\ndidier\n11:33 AM\nYea, we're still blocking initial render on a full vehicle_state sync every time...\nandreas\n11:33 AM\nFeels like we could render sooner and load the rest in the background. Probably also worth tracking startup timing so we know how often this happens!\n@Linear\ncreate urgent issues and assign to me\n1.1\nLinear Agent +\n1.2\nTriage +\n1.3\nCustomer Requests +\n1.4\nLinear Asks +\nDefine the product direction\n\nPlan and navigate from idea to launch. Align your team with product initiatives, strategic roadmaps, and clear, up-to-date PRDs.\n\n2.0Plan→\nFEB\nMAR\nAPR\nMAY\nJUN\nJUL\nAUG\nSEP\n2\n9\n16\n23\n2\n9\n16\n23\n30\n6\n13\n20\n27\n4\n11\n18\n25\n1\n8\n15\n22\n29\n6\n13\n20\n27\n3\n10\n17\n24\n31\n7\n14\n21\n28\nUI Refresh\nCore screens\nPolish\nSplit fares\nInternal\nPublic Beta\nAutonomy status clarity\nAlpha\nGA\nInitiatives\nCore Product\n99\nInfra stability\n28\nAutonomous systems\n16\nMobile apps\n8\nAPAC Expansion\n21\nJapan Launch\n12\nCustomer-driven priorities\n9\n2.1\nProjects +\n2.2\nDocuments +\n2.3\nInitiatives +\n2.4\nVisual planning +\nMove work forward across teams and agents\n\nBuild and deploy AI agents that work alongside your team. Work on complex task","brandColors":["#1A1A16","#28261B","#201E12"],"ogImage":"https://linear.app/static/og/homepage.jpg","hasRealScreenshots":3},"__ingested":true},"autopilot":1,"brief":{"improvedPrompt":"A razor-sharp 12-second horizontal promo for Linear, showcasing it as the premier product development system built for modern teams and AI agents. The video moves with extreme velocity, opening with a bold hook about the new era of product development where humans and AI build together. It transitions rapidly through sleek, dark UI representations highlighting self-driving product operations and planning, before closing on a commanding call to action to build for the future today. The aesthetic is premium, dark, and hyper-focused, mirroring Linear's own design standard.","audience":"Modern software developers, product managers, and engineering leaders building with AI workflows.","tone":"premium, precise, fast, futuristic","goal":"Convince product teams that Linear is the ultimate, high-velocity system for the AI era.","keyMessages":["The product development system for teams and agents","Purpose-built for planning and building with AI workflows","Designed for speed and high-velocity focus"],"mustIncludeFacts":["The product development system for teams and agents","Purpose-built for planning and building products with AI agents.","Built for the future. Available today."],"brandColors":["#1A1A16","#28261B","#201E12"],"suggestedFramePack":"midnight-glass","suggestedDuration":12,"musicMood":"minimal cinematic techno","voProfile":"male, mid-30s, low-pitched, confident, ultra-precise"},"script":{"title":"Linear: System for Teams and Agents","scenes":[{"id":"s1","start":0,"duration":3.5,"purpose":"hook","voiceover":"The product development system for teams and agents.","onScreenText":["Teams and agents","Built together"],"visualDirection":"A camera pushes forward through a sleek, dark, minimal environment where glowing network nodes converge into a sharp, dark glass interface.","assetNeeds":[],"sfx":["impact"],"musicCue":"intro"},{"id":"s2","start":3.5,"duration":4.5,"purpose":"feature","voiceover":"Purpose-built for planning and building products with AI agents.","onScreenText":["Purpose-built","AI workflows"],"visualDirection":"The camera zooms into a high-fidelity dark UI mockup of Linear showing automated tasks and AI sub-issues self-populating in real-time.","assetNeeds":[{"type":"video","query":"abstract dark code data stream","role":"texture"}],"sfx":["click","transition"],"musicCue":"steady"},{"id":"s3","start":8,"duration":4,"purpose":"cta","voiceover":"Built for t