cus on thinking."],"visualDirection":"Split screen: one side shows automated tasks (report generation, meeting summaries) happening fluidly, the other shows a human silhouette in deep thought.","assetNeeds":[],"sfx":["ding"],"musicCue":"lift"},{"id":"s7","start":27,"duration":3,"purpose":"cta","voiceover":"Work just changed forever.","onScreenText":["Work just changed forever."],"visualDirection":"The Atlas logo expands to fill the screen with a powerful, inspiring gradient. The tagline lands with authority.","assetNeeds":[],"sfx":["riser","impact"],"musicCue":"outro"}],"music":{"mood":"epic cinematic orchestral, building tension then resolving to inspiring","query":"epic cinematic orchestral build resolve"},"voice":{"style":"male or female, authoritative yet warm, clear and deliberate pacing","pace":"deliberate"}},"script_warnings":[],"usage":{"llm":{"inputTokens":205378,"outputTokens":47807,"callCount":8,"inputCostUsd":0.308067,"outputCostUsd":0.430263,"totalCostUsd":0.73833},"tts":{"inputChars":299,"inputTokensEst":77,"outputTokensEst":1631,"callCount":8,"inputCostUsd":0.000046,"outputCostUsd":0.003914,"totalCostUsd":0.003961},"external":{"freesound_search":1,"internet_archive_search":1,"openrouter_tts":8,"openrouter_chat":8,"asset_library_hit":5,"hyperframes_lint":4,"hyperframes_render":3},"totalCostUsd":0.742291},"stage_timings":{"briefMs":2713,"scriptMs":5317,"productionMs":741729},"assets":[{"path":"assets/images/0.jpeg","type":"image","sceneId":"s2","startSec":4.5,"durationSec":4.5,"style":"background","alt":"visuals shift show abstract","license":"curated-library","sourceUrl":null,"source":"library:keywords-real","fromCache":true},{"path":"assets/images/1.jpg","type":"image","sceneId":"s3","startSec":9,"durationSec":5,"style":"background","alt":"drowning silhouette digital chaos","license":"curated-library","sourceUrl":null,"source":"library:assetcollection","fromCache":true},{"path":"assets/images/2.png","type":"image","sceneId":"s4","startSec":14,"duratio