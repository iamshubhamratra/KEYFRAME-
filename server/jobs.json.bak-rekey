gh","cropFocus":"center center"},{"path":"assets/images/0.jpg","type":"image","sceneId":"s1","startSec":0,"durationSec":4,"style":"background","alt":"slow camera push lush","width":853,"height":1280,"license":"Pixabay Content License","sourceUrl":"https://pixabay.com/photos/black-peppercorn-pepper-plant-plant-8337820/","source":"cache:pixabay","fromCache":true,"clipRelevance":0.354,"cdScore":90,"sees":"Close-up of a vibrant green leaf backlit by soft sunlight","cdProminence":"hero","visionOk":true,"kind":"photo","fit":"cover","focus":"center","effect":"zoom","quality":"high","cropFocus":"center center"},{"path":"assets/images/6.svg","type":"image","sceneId":"s2","startSec":4,"durationSec":4,"style":"background","alt":"hand gently plucks crisp","width":128,"height":128,"license":"Open source (Iconify — per-set license)","sourceUrl":"https://icon-sets.iconify.design/","source":"iconify","fromCache":false,"clipRelevance":0.076},{"path":"assets/images/8.svg","type":"image","sceneId":"s3","startSec":8,"durationSec":4,"style":"background","alt":"clean overlay showing automated","width":128,"height":128,"license":"Open source (Iconify — per-set license)","sourceUrl":"https://icon-sets.iconify.design/","source":"iconify","fromCache":false,"clipRelevance":0.007}],"text_review":{"source":"llm","added":8,"llmAdded":6,"minedAdded":2,"scenesWithSubtext":7,"scenesWithBullets":6,"sceneCount":7},"layout_review":{"keptScreenshots":4,"keptPhotos":1,"demoted":0,"heroScale":0.54,"montageMax":6,"prominentTotal":5,"scenes":[{"sceneId":"s1","archetype":"hook","heroScale":0.54},{"sceneId":"s2","archetype":"text","heroScale":0.54},{"sceneId":"s3","archetype":"text","heroScale":0.54},{"sceneId":"s4","archetype":"stat","heroScale":0.54},{"sceneId":"s5","archetype":"quote","heroScale":0.54},{"sceneId":"s6","archetype":"stat","heroScale":0.54},{"sceneId":"s7","archetype":"cta","heroScale":0.54}],"score":{"compositionQuality":100,"source":"deterministic"}},"template_review":{"source":"llm","framePack":"organic-garden","scenes":7,"llmCast":7,"deterministic":0,"unsourcedNumbers":0,"withMedia":3,"assetsUsed":4,"assetPool":7,"types":{"hook":1,"feature":2,"stats":1,"cta":1,"statement":1,"montage":1},"cast":[{"id":"s1","type":"hook","media":0,"why":"Introduces the brand and core promise."},{"id":"s3","type":"feature","media":1,"why":"Shows the AI automation feature."},{"id":"s5","type":"stats","media":0,"why":"Provides social proof with numbers."},{"id":"s6","type":"feature","media":1,"why":"Highlights financial benefit with screenshot."},{"id":"s7","type":"cta","media":0,"why":"Final call to action."},{"id":"s2","type":"statement","media":0,"why":"States the core belief of the product."},{"id":"s4","type":"montage","media":2,"why":"Displays the variety of produce."}]},"captions":[{"start":0,"end":3.4,"text":"Love fresh food, but hate the work of gardening?"},{"start":4,"end":8.75,"text":"Meet Gardyn: fresh, pesticide-free produce, year-round."},{"start":9.3,"end":13.5,"text":"Kelby, your AI gardener, automates light and water."},{"start":14.05,"end":18.25,"text":"Discover over one hundred delicious non-GMO varieties."},{"start":18.8,"end":22.35,"text":"Join over one hundred thousand happy Gardyners."},{"start":22.9,"end":27.349999999999998,"text":"Now HSA and FSA eligible. Save about thirty percent."},{"start":27.9,"end":32,"text":"Start your journey to better health with Gardyn today."}],"srt_url":"/videos/elgcs19wn3.srt","final_attempt":"main","qa":{"pass":false,"score":6,"issues":[{"atSec":21.3,"severity":"blocker","issue":"The headline '100,000+ HAPPY GARDYNERS' collides with the '100k+ happy users' stat card, with the card overlapping and obscuring the bottom half of the word 'GARDYNERS'.","fix":"Move the '100k+ happy users' stat card downwards vertically or reduce the headline's line-height/font-size to ensure there is an explicit gap and no overlap between the text and the card container."}]},"quality_report":{"verdict":"flagged","flags":["QA: 1 blocker(s)"],"contrast":{"checked":true,"fixed":0,"remaining":0,"passes":0},"identity":{"remapped":0},"layout":{"duplicatesRemoved":0,"collisionsScrimmed":0},"assetFloor":null,"audio":{"lufs":-14,"peak":-3.94,"lra":4.8,"target":-14,"layers":{"voice":7,"sfx":6,"music":true,"ambient":false,"musicEnvelope":false}},"screenshots":{"kept":4,"dropped":0,"repinned":2,"problems":[]},"assetQuality":80,"templateFit":83,"qa":{"pass":false,"score":6,"skipped":false,"blockers":1}}},{"id":"5q1vqnphvj","kind":"project","prompt":"","duration":30,"orientation":"vertical","quality":"1080p","width":1080,"height":1920,"fps":30,"frame_pack":"lantern-night","frame_pack_user":1,"status":"done","progress":"finalizing","video_url":"/videos/5q1vqnphvj.mp4","error":null,"used_fallback":0,"llm_tokens_in":33318,"llm_tokens_out":15498,"created_at":1785129700977,"started_at":1785130950293,"finished_at":1785131164410,"client_ip":"::ffff:127.0.0.22","voice_style":null,"captions_enabled":0,"upload_path":null,"task":null,"requeue_count":0,"intent":{"prompt":"","websiteUrl":"https://obsidian.md","blogUrl":null,"hasReferenceVideo":false,"preferences":{"duration":30,"orientation":"vertical","voiceStyle":"auto","framePack":"lantern-night"},"website":{"url":"https://obsidian.md","title":"Obsidian - Sharpen your thinking","description":"The free and flexible app for your private thoughts.","headings":["Sharpen your thinking.","Spark ideas.","Sync securely.","Publish instantly.","It’s your time to shine."],"bodyText":"Download\nPricing\nSync\nPublish\nEnterprise\nCommunity\nAccount\nSharpen your thinking.\n\nThe free and flexible app for your private thoughts.\n\nGet Obsidian for Windows\nMore platforms\nWriting is telepathy\nEvergreen notes\nGraph of Writing is t...\nClippings\nDaily\nIdeas\nWriting is telepathy\nMeta\nProjects\nReferences\nEvergreen notes\nCalmness is a superpower\nTravel\nCreativity is combinatory u...\nEmergence\nRecipes\nBooks\nHealth\nWhat if it were easy\nTools\nSpecialization is for insects\nFirst principles\nPhilosophy\nA little bit every day\n1,000 true fans\nNotes\nWriting is telepathy\n#evergreen\n\nFrom On Writing\n\nIdeas can travel through time and space\n\nIdeas can travel through time and space without being uttered out loud. The process of telepathy requires two places:\n\nA sending place, a transmission place — where the writer sends ideas, such as a desk\nA receiving place — where the reader receives the ideas/imagery such as a couch, a comfortable chair, in bed\nQuote\nLook, here’s a table covered with red cloth. On it is a cage the size of a small fish aquarium. In the cage is a white rabbit with a pink nose and pink-rimmed eyes. On its back, clearly marked in blue ink, is the numeral 8. The most interesting thing here isn’t even the carrot-munching rabbit in the cage, but the number on its back. I never opened my mouth and you never opened yours. We’re not even in the same year together, let alone the same room... except we are together. We are close. We’re having a meeting of the minds. We’ve engaged in an act of telepathy.\n1 backlink\n206 words\n1139 char\n10:55\nJapan Trip Planning\n#projects\n#travel\nTo-do\nSchedule flights\nAsk for recommendations\n✓\nKeiko\n✓\nAndrew\nGarrett\nResearch ryokans in\nKyoto\nItinerary\n1\nYour thoughts are yours.\nObsidian stores notes privately on your device, so you can access them quickly, even offline. No one else can read them, not even us.\nYour mind is unique.\nWith thousands of plugins and themes, you can shape Obsidian to fit your way of thinking.\nYour knowledge should last.\nObsidian uses open file formats, so you’re never locked in. You own your data for the long term.\nFree without limits.\nDownload now\nSpark ideas.\n\nFrom personal notes to journaling, knowledge bases, and project management, Obsidian gives you the tools to come up with ideas and organize them.\n\nLinks\nCreate connections between your notes. Link anything and everything — ideas, people, places, books, and beyond. Invent your own personal Wikipedia.\n\nIn Meditations on First Philosophy the philosopher René Descartes describes a series of doubts about the nature of reality, arriving at the famous phrase:\n\n[[I thin]]\nI think therefore I am\nJust think about it\nThinking, Fast and Slow\n\nBooks/\nThe Thing\n\nMovies/\n\nHe argues that doubting requires thinking, and therefore, the act of thinking confirms his existence.\n\nGraph\nVisualize the relationships between your notes. Find hidden patterns in your thinking through a visually engaging and interactive graph.\nCanvas\nAn infinite space to research, brainstorm, diagram, and lay out your ideas. Canvas is a limitless playground for your mind. Learn more.\nLecture 1\n\nRationalists\n\nReason and innate knowledge → acquire knowledge\nFundamental truths and principles can be known independent of experience\nA priori reasoning\nReason and deduction\n\nEmpiricists\n\nExperience and sensory perception → acquire knowledge\nAll knowledge is derived from experience and observation of the external world\nA posteriori reasoning\nCogito, ergo sum\n\nIn Meditations on First Philosophy the philosopher René Descartes describes a series of doubts about the nature of reality, arriving at the famous phrase:\n\nI think therefore I am\n\nHe argues that doubting requires thinking, and therefore, the act of thinking confirms his existence.\n\nPhilosophers\nPlugins\nBuild your ideal thinking space. With thousands of plugins and our open API, it’s easy to tailor Obsidian to fit your personal workflow. Learn more.\nCommunity plugins\nCalendar by Liam Cain\nCalendar view of your dail","brandColors":["#8B4CF8","#6931C7","#341D59","#282831"],"ogImage":"https://obsidian.md/images/banner.png","hasRealScreenshots":3},"__ingested":true},"autopilot":1,"render3d":0,"compose_mode":null,"brief":{"improvedPrompt":"A 30-second vertical video introducing Obsidian as the ultimate private sanctuary for your thoughts and ideas. The narrative transitions from the anxiety of scattered notes to the calm clarity of a connected, local-first knowledge base. It highlights absolute privacy, the magic of linking notes to generate a visual graph, and the freedom of an infinite canvas. Designed for deep thinkers, researchers, and writers who refuse to lock their minds into proprietary clouds. It closes with a clear invitation to download Obsidian for free and own their data forever.","subject":"software application interface with interactive node graphs","audience":"Writers, researchers, developers, and creators seeking privacy and deep organization","tone":"calm, intellectual, empowering, secure","goal":"Convince the viewer to download Obsidian and take control of their digital mind","keyMessages":["Your thoughts are yours—stored privately on your device","Connect your ideas with links and interactive graphs","Brainstorm without limits on an infinite Canvas","Open file formats mean you own your data forever"],"mustIncludeFacts":["stores notes privately on your device","uses open file formats","thousands of plugins and themes","Free without limits"],"brandColors":["#8B4CF8","#6931C7","#341D59","#282831"],"suggestedFramePack":"lantern-night","suggestedDuration":30,"musicMood":"warm minimal ambient","voProfile":"male, mid-30s, warm, thoughtful, measured"},"script":{"title":"Obsidian Your Private Digital Mind","scenes":[{"id":"s1","start":0,"duration":4,"purpose":"hook","voiceover":"Where do your most valuable thoughts go?","onScreenText":["Where do your thoughts go?"],"visualDirection":"Camera slowly drifts through a dark space filled with floating, disconnected text fragments that slowly fade out.","assetNeeds":[],"sfx":["whoosh"],"musicCue":"intro"},{"id":"s2","start":4,"duration":4,"purpose":"context","voiceover":"Keep them safe. Obsidian stores notes privately on your device.","onScreenText":["100% Private","Stored on your device"],"visualDirection":"A clean laptop mockup appears on a desk in a warm, dark room, glowing with a soft purple ambient light.","assetNeeds":[{"type":"image","query":"focused writer laptop desk night warm light","role":"background"}],"sfx":["pop"],"musicCue":"build"},{"id":"s3","start":8,"duration":4.5,"purpose":"feature","voiceover":"Connect your ideas, watching them grow into a personal mind map.","onScreenText":["Connect ideas","Interactive graph"],"visualDirection":"The real Obsidian UI is showcased with an interactive graph view as nodes light up and connect dynamically.","assetNeeds":[],"sfx":["sparkle"],"musicCue":"steady"},{"id":"s4","start":12.5,"duration":4.5,"purpose":"feature","voiceover":"Brainstorm without limits on an infinite, flexible canvas.","onScreenText":["Infinite Canvas","No limits"],"visualDirection":"The camera pans smoothly across the real product's Canvas interface, highlighting connected media cards and sketches.","assetNeeds":[],"sfx":["swoosh"],"musicCue":"steady"},{"id":"s5","start":17,"duration":4.5,"purpose":"feature","voiceover":"Make it yours with thousands of plugins and themes.","onScreenText":["Thousands of plugins","Fully customizable"],"visualDirection":"A grid of clean, glowing icons representing different tools and layout tiles morphs smoothly on screen.","assetNeeds":[{"type":"icon","query":"gear puzzle tool","role":"inset"}],"sfx":["transition"],"musicCue":"lift"},{"id":"s6","start":21.5,"duration":4,"purpose":"proof","voiceover":"With open file formats, you own your data forever.","onScreenText":["Open file formats","Own your data"],"visualDirection":"A secure, glowing folder icon sits centered as clean data lines flow safely into it.","assetNeeds":[{"type":"icon","query":"shield lock folder","role":"inset"}],"sfx":["ding"],"musicCue":"lift"},{"id":"s7","start":25.5,"duration":4.5,"purpose":"cta","voiceover":"Download Obsidian today. Free without limits.","onScreenText":["Get Obsidian","Free without limits"],"visualDirection":"The elegant Obsidian logo resolves in a warm purple glow with a prominent download button pulsing gently 