ps://gumroad.com/self-improvement","text":"coloring page"},{"url":"https://gumroad.com/recorded-music","text":"singles"},{"url":"https://gumroad.com/software-development","text":"programming"},{"url":"https://gumroad.com/writing-and-publishing","text":"kdp interior"},{"url":"https://gumroad.com/small-bets","text":"Small Bets"},{"url":"https://gumroad.com/help","text":"Help"},{"url":"https://gumroad.com/terms","text":"Terms of Service"},{"url":"https://gumroad.com/privacy","text":"Privacy Policy"}],"website_auth_wall":false,"usage":{"byStage":[],"llm":{"inputTokens":0,"outputTokens":0,"callCount":0,"inputCostUsd":0,"outputCostUsd":0,"totalCostUsd":0},"tts":{"inputChars":0,"inputTokensEst":0,"outputTokensEst":0,"callCount":0,"inputCostUsd":0,"outputCostUsd":0,"totalCostUsd":0},"external":{},"totalCostUsd":0},"stage_timings":{"ingestMs":21209,"briefMs":29795,"scriptMs":30313}},{"id":"iu7vjvqcpn","kind":"project","prompt":"","duration":30,"orientation":"vertical","quality":"1080p","width":1080,"height":1920,"fps":30,"frame_pack":"poster-pop","frame_pack_user":1,"status":"failed","progress":"storyboard","video_url":null,"error":"403 Key limit exceeded (daily limit). Manage it using https://openrouter.ai/workspaces/default/keys/bc6c462a6ad8c5c19bcb3a91ae6f73d73746f810705d23d8d8947a1d36e8c8b1","used_fallback":0,"llm_tokens_in":0,"llm_tokens_out":0,"created_at":1785129701604,"started_at":1785131164654,"finished_at":1785131164702,"client_ip":"::ffff:127.0.0.24","voice_style":null,"captions_enabled":0,"upload_path":null,"task":null,"requeue_count":0,"intent":{"prompt":"","websiteUrl":"https://mailchimp.com","blogUrl":null,"hasReferenceVideo":false,"preferences":{"duration":30,"orientation":"vertical","voiceStyle":"auto","framePack":"poster-pop"},"website":{"url":"https://mailchimp.com","title":"Email & SMS Marketing Platform | Mailchimp","description":"Utilize real-time user behavior data and artificial intelligence to convert more customers. Easy to use, get started for free!","headings":["Industries and Solutions","Integrations","Most Popular","Most Popular","Resources","Account","Main Menu","Industries and Solutions","Integrations","Most Popular","Resources","Account","Email & SMS marketing minus the learning curve","Recommended for your business","Design with ease","Get more sales","Reach your audience on any device","Connect all your apps","Make Mailchimp work for you","Businesses like yours are thriving with Mailchimp","Try our Standard plan for 50% off!","Standard","The ultimate expert-assisted platform for growth at scale","Phone & Priority Support","Phone & Priority Support"],"bodyText":"___\nSkip to main content\n\nSave 50% for 12 months - limited time offer. Get started today.\n\nIndustries and Solutions\nIntegrations\nResources\nSwitch to Mailchimp\nSales: +1 (855) 338-7935\nPricing\nLog In\nMain Menu\nEmail & SMS marketing minus the learning curve\n\nDrive revenue with intuitive marketing analytics, automations, and AI tools.\n\nSign Up\nMailchimp has a four and half star rating\n\n*Based on 33,000+ reviews across\n\nRecommended for your business\nCustomize my experience\nDesign with ease\n\nCreate emails like a pro with easy-to-use tools and high-quality templates for every purpose.\n\n300+ templates for different seasons and industries\nIntuitive drag-and-drop builder\nUse AI-powered content creation tools to craft on-brand headlines and designs in seconds\nSee our content creation tools\nDesign with ease\nGet more sales\n\nSend effective, personalized messages that turn shoppers into buyers.\n\nAlways-on marketing automations\nPowerful e-commerce integrations\nSave up to 42% by switching from Klaviyo to Mailchimp*\nLearn about Mailchimp for e-commerce\nGet more sales\nReach your audience on any device\n\nBoost results by reaching your audience with the right message on the right device.\n\nSeamless integration and fast registration\nOn-brand, AI-powered content tips\nMailchimp users saw up to a 97% click rate when they used both Email and SMS\nSee SMS marketing\nReach your audience on any device\nConnect all your apps\n\nMailchimp seamlessly connects to the apps, platforms, and stores you depend on.\n\nUnify your data in one place—automatically\nShopify, WooCommerce, Wix, and more\nE-commerce customers saw up to 30x ROI when they connected their stores to Mailchimp*\nSee 300+ integrations\nConnect all your apps\nSee pricing\nMake Mailchimp work for you\n\nGot a second to answer a couple questions? We can personalize your visit with the info that matters most to you and your business.\n\nWhat's your industry?\nSelect\nWhat are the top 4 things you want to achieve?\nSelect up to 4\nGet more sales\nSave time with automation\nAttract more customers\nOptimize your marketing\nSend SMS campaigns\nManage customer relationships\nDesign better emails\nConnect your store and other apps\nGet 24/7 support\nSwitch from another tool\nNo thank you\nCustomize my experience\nBusinesses like yours are thriving with Mailchimp\nView all case studies\nRequest demo\nStart Free Trial\nTry our Standard plan for 50% off!\n\nSpend less to grow more with 50% off for 12 months, even if you change to our Premium or Essentials plans. Cancel or downgrade to our basic Free plan at any time.\n\nGenerative AI features\n\nActionable insights into audience growth and conversion funnels\n\nEnhanced automations\n\nCustom-coded email templates\n\nCustomizable Popup forms\n\nPersonalized onboarding\n\nSee all plans\n₹ INR\n$ USD\nStandard\n\nSend up to 6,000 emails each month.\n\nContacts\n0-500\n501-1,500\n1,501-2,500\n2,501-5,000\n5,001-10,000\n10,001-15,000\n15,001-20,000\n20,001-25,000\n25,001-30,000\n30,001-40,000\n40,001-50,000\n50,001-75,000\n75,001-100,000\n100,001-130,000\n130,001-150,000\n150,001-200,000\n200,001-250,000\n250,001-500,000\n500,001-1,000,000\n1,000,000+\n\nSave 50%\n\n₹\n575\n/mo for 12 months\n\n₹575 per month for 12 months\n\nThen, starts at ₹1,150/month†\nper month†\n\nBuy Now\n\n†See Offer Terms. Overages apply if contact or email send limit is exceeded. Learn More\ntooltip\n\nOne marketing platform to unite 300+ apps\n\nMailchimp integrates with hundreds of tools to help you save time and get more done.\n\nView all integrations\nQuickBooks Online\nSync real-time data between QuickBooks and Mailchimp\nCanva\nCreate custom designs in Canva and seamlessly share them\nSalesforce\nEasy to set up bi-directional sync with Salesforce\nStripe\nSync Stripe customer and order data\nSquarespace\nConnect commerce and website data to Mailchimp\nWooCommerce\nAccess powerful marketing features\nQuickBooks Online\nSync real-time data between QuickBooks and Mailchimp\nCanva\nCreate custom designs in Canva and seamlessly share them\nSalesforce\nEasy to set up bi-directional sync with Salesforce\nSt","brandColors":["#524734","#281B0E","#353027","#312719"],"ogImage":"https://mailchimp.com/ctf/images/yzco4xsimv0y/1SB1jCYU95Dh5YDdrucTh0/add18363e44ff00d54254592c7c0860c/Intuit_Mailchimp_-_Wordmark_2023_-_Recirculation_.png","hasRealScreenshots":3},"__ingested":true},"autopilot":1,"render3d":0,"compose_mode":null,"brief":{"improvedPrompt":"A 30-second high-energy vertical promo for Mailchimp, targeting busy small business owners and e-commerce creators. The video kicks off with the ultimate frustration—marketing that takes too long to learn—then positions Mailchimp as the effortless solution with zero learning curve. It highlights powerful AI design tools, automated SMS/Email workflows that drive up to 30x ROI, and wraps with an irresistible call-to-action: get 50% off the Standard plan. Visually bold, fast-paced, and impossible to ignore.","subject":"digital marketing dashboard and email templates","audience":"Small business owners, e-commerce store operators, and busy marketers","tone":"bold, high-energy, confident, playful","goal":"Get viewers to sign up for Mailchimp and claim the 50% off Standard plan offer","keyMessages":["Email & SMS marketing minus the learning curve","