, measured trailer cadence"},"script":{"title":"Lumen Notes That Keep Pace","scenes":[{"id":"s1","start":0,"duration":3.5,"purpose":"hook","voiceover":"Your mind moves faster than your pen.","onScreenText":["Faster than pens"],"visualDirection":"A warm spark ignites center frame as kinetic type bursts outward in layered planes under a rising sunrise glow.","assetNeeds":[],"sfx":["impact"],"musicCue":"intro"},{"id":"s2","start":3.5,"duration":3.5,"purpose":"context","voiceover":"But your notes fall far behind.","onScreenText":["Notes fall behind"],"visualDirection":"Camera pans across a cluttered desk of unfinished notebooks and sticky notes as focus softens and slips.","assetNeeds":[{"type":"image","query":"messy desk sticky notes notebooks","role":"background"}],"sfx":["whoosh"],"musicCue":"build"},{"id":"s3","start":7,"duration":4,"purpose":"feature","voiceover":"Meet Lumen. AI note-taking.","onScreenText":["Meet Lumen"],"visualDirection":"The real product UI rises inside a browser frame on a laptop; slow cinematic push-in through warm golden light.","assetNeeds":[{"type":"image","query":"professional laptop open desk warm light","role":"background"}],"sfx":["pop","sparkle"],"musicCue":"build"},{"id":"s4","start":11,"duration":3.5,"purpose":"feature","voiceover":"Fast. Capture thoughts as they come.","onScreenText":["Fast"],"visualDirection":"Phone slides into frame on a shallow plane; camera orbits as floating words snap into a clean note.","assetNeeds":[{"type":"icon","query":"lightning bolt","role":"inset"}],"sfx":["click"],"musicCue":"steady"},{"id":"s5","start":14.5,"duration":3.5,"purpose":"feature","voiceover":"Intelligent. Notes shaped by AI.","onScreenText":["Intelligent"],"visualDirection":"Camera zooms into the real product UI as note cards glide and reorganize across layered depth planes.","assetNeeds":[{"type":"icon","query":"sparkle","role":"inset"}],"sfx":["swoosh"],"musicCue":"steady"},{"id":"s6","start":18,"duration":3.5,"purpose":"feature","voice