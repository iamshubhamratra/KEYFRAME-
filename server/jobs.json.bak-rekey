ationSec":4,"style":"background","alt":"lone human silhouette glowing","width":128,"height":128,"license":"Open source (Iconify — per-set license)","sourceUrl":"https://icon-sets.iconify.design/","source":"iconify","fromCache":false,"clipRelevance":0.89},{"path":"assets/images/30.svg","type":"image","sceneId":"s8","startSec":26.5,"durationSec":5,"style":"background","alt":"linear product materializes floating","width":128,"height":128,"license":"Open source (Iconify — per-set license)","sourceUrl":"https://icon-sets.iconify.design/","source":"iconify","fromCache":false,"clipRelevance":0.796},{"path":"assets/images/32.svg","type":"image","sceneId":"s10","startSec":36.5,"durationSec":4.5,"style":"inset","alt":"compass","width":128,"height":128,"license":"Open source (Iconify — per-set license)","sourceUrl":"https://icon-sets.iconify.design/","source":"iconify","fromCache":false,"clipRelevance":0.33}],"text_review":{"source":"llm","added":13,"llmAdded":9,"minedAdded":4,"scenesWithSubtext":30,"scenesWithBullets":17,"sceneCount":30},"layout_review":{"keptScreenshots":3,"keptPhotos":3,"demoted":0,"heroScale":0.54,"montageMax":6,"prominentTotal":6,"scenes":[{"sceneId":"s1","archetype":"hook","heroScale":0.54},{"sceneId":"s2","archetype":"text","heroScale":0.54},{"sceneId":"s3","archetype":"text","heroScale":0.54},{"sceneId":"s4","archetype":"text","heroScale":0.54},{"sceneId":"s5","archetype":"text","heroScale":0.54},{"sceneId":"s6","archetype":"text","heroScale":0.54},{"sceneId":"s7","archetype":"hook","heroScale":0.54},{"sceneId":"s8","archetype":"hook","heroScale":0.54},{"sceneId":"s9","archetype":"text","heroScale":0.54},{"sceneId":"s10","archetype":"text","heroScale":0.54},{"sceneId":"s11","archetype":"text","heroScale":0.54},{"sceneId":"s12","archetype":"text","heroScale":0.54},{"sceneId":"s13","archetype":"text","heroScale":0.54},{"sceneId":"s14","archetype":"text","heroScale":0.54},{"sceneId":"s15","archetype":"text","heroScale":0.54},{"sceneId":"s16","archetype":"text","heroScale":0.54},{"sceneId":"s17","archetype":"text","heroScale":0.54},{"sceneId":"s18","archetype":"text","heroScale":0.54},{"sceneId":"s19","archetype":"text","heroScale":0.54},{"sceneId":"s20","archetype":"text","heroScale":0.54},{"sceneId":"s21","archetype":"text","heroScale":0.54},{"sceneId":"s22","archetype":"quote","heroScale":0.54},{"sceneId":"s23","archetype":"text","heroScale":0.54},{"sceneId":"s24","archetype":"text","heroScale":0.54},{"sceneId":"s25","archetype":"text","heroScale":0.54},{"sceneId":"s26","archetype":"text","heroScale":0.54},{"sceneId":"s27","archetype":"text","heroScale":0.54},{"sceneId":"s28","archetype":"text","heroScale":0.54},{"sceneId":"s29","archetype":"text","heroScale":0.54},{"sceneId":"s30","archetype":"cta","heroScale":0.54}],"score":{"compositionQuality":100,"source":"deterministic"}},"captions":[{"start":0,"end":3.15,"text":"Product development is chaos."},{"start":3.7,"end":6.2,"text":"Feedback floods every channel."},{"start":7.2,"end":10.8,"text":"Roadmaps stall. Priorities blur."},{"start":11.35,"end":15.75,"text":"Handoffs break and context vanishes."},{"start":16.3,"end":20,"text":"Tools pile up. Focus fades."},{"start":20.55,"end":24.85,"text":"Agents arrive. Fragmentation stays."},{"start":25.4,"end":27.099999999999998,"text":"Until now."},{"start":28.9,"end":32.6,"text":"Linear. A new species of product tool."},{"start":33.9,"end":37.699999999999996,"text":"The product development system for teams and agents."},{"start":38.9,"end":43.699999999999996,"text":"Purpose-built for planning and building with AI agents."},{"start":44.25,"end":48.4,"text":"Intake turns conversations into issues."},{"start":48.95,"end":52.35,"text":"Prioritized. Actionable. Instant."},{"start":52.95,"end":57.400000000000006,"text":"Define direction with initiatives and roadmaps."},{"start":57.95,"end":60.7,"text":"PRDs that set clear intent."},{"start":62.45,"end":65.85000000000001,"text":"Visual planning. Shared direction."},{"start":66.95,"end":70.85000000000001,"text":"Agents move work from PRD to PR."},{"start":71.95,"end":75.25,"text":"Workflows shared by humans and agents."},{"start":76.45,"end":79.65,"text":"Side by side. Same system."},{"start":80.45,"end":85.7,"text":"Live progress views restore focus at scale."},{"start":86.25,"end":88.8,"text":"Clarity at every scale."},{"start":90.25,"end":93.85,"text":"Designed for speed and high velocity."},{"start":94.75,"end":97.05,"text":"Teams ship with focus."},{"start":98.75,"end":101.85,"text":"Make product operations self-driving."},{"start":103.25,"end":107,"text":"Less coordination. More building."},{"start":107.55,"end":111.35,"text":"Humans and agents, moving as one."},{"start":112.05,"end":115.85,"text":"From idea to shipped product."},{"start":116.4,"end":119.5,"text":"One continuous flow of work."},{"start":120.9,"end":124.30000000000001,"text":"No friction. No lost context."},{"start":124.9,"end":127.60000000000001,"text":"Planning to building to shipping."},{"start":139.9,"end":143.6,"text":"This is product ops, reimagined."}],"srt_url":"/videos/emdz2fw4ez.srt","last_requeue_at":1784785737319,"final_attempt":"main","qa":{"pass":false,"score":6,"issues":[{"atSec":14.3,"severity":"blocker","issue":"Text overflow in the first card where the final word is cut off mid-word as 'pr'.","fix":"In the first card component, decrease the body text font-size or adjust the container padding/width so that the full word ('projects' or 'product') renders completely without clipping."}]},"quality_report":{"verdict":"flagged","flags":["1 screenshot(s) dropped by QA","QA: 1 blocker(s)"],"contrast":{"checked":true,"fixed":0,"remaining":0,"passes":0},"identity":{"remapped":2},"layout":{"duplicatesRemoved":0,"collisionsScrimmed":0},"assetFloor":{"generated":7,"scoreBefore":72,"scoreAfter":88},"audio":{"lufs":-13.79,"peak":0.21,"lra":4.9,"target":-14,"layers":{"voice":30,"sfx":10,"music":true,"ambient":false,"musicEnvelope":false}},"screenshots":{"kept":3,"dropped":1,"repinned":2,"problems":["scene-mismatch"]},"assetQuality":84,"templateFit":83,"qa":{"pass":false,"score":6,"skipped":false,"blockers":1}}},{"id":"l3ay4u3gko","kind":"project","prompt":"","duration":60,"orientation":"horizontal","quality":"1080p","width":1920,"height":1080,"fps":30,"frame_pack":"aurora-spectrum","frame_pack_user":1,"status":"done","progress":"finalizing","video_url":"/videos/l3ay4u3gko.mp4","error":null,"used_fallback":0,"llm_tokens_in":63042,"llm_tokens_out":31252,"created_at":1784784556301,"started_at":1784787020090,"finished_at":1784787480020,"client_ip":"::1","voice_style":null,"captions_enabled":0,"upload_path":null,"task":null,"requeue_count":1,"intent":{"prompt":"","websiteUrl":"https://linear.app","blogUrl":null,"hasReferenceVideo":false,"preferences":{"duration":60,"orientation":"horizontal","voiceStyle":"auto","framePack":"aurora-spectrum"},"website":{"url":"https://linear.app","title":"Linear – The system for product development","description":"Purpose-built for planning and building products with AI agents.","headings":["The product development system for teams and agentsThe product developmentsystem for teams and agentsThe product development system for teams and agents","Faster app launch","A new species of product tool. Purpose-built for modern teams with AI workflows at its core, Linear sets a new standard for planning and building products.","Make product operations self-driving","Define the product direction","Move work forward across teams and agents","Review PRs and agent output","Understand progress at scale","Changelog","Built for the future. Available today.","Product","Features","Company","Resources","Connect","Legal"],"bodyText":"Skip to content →\nProduct\nResources\nCustomers\nPricing\nNow\nContact\nLog in\nSign up\nThe product development\nsystem for teams and agents\nThe product development system for teams and agents\n\nPurpose-built for planning and building products. Designed for the AI era.\n\nNew\nCoding Sessions →\nLinear\nInbox\nMy issues\nReviews\nPulse\nWorkspace\nInitiatives\nProjects\nMore\nFavorites\nFaster app launch\nAgent tasks\nUI Refresh\nAgents Insights\nFaster app launch\n02\n/\n145\nFaster app launch\n\nRender UI before vehicle_state sync when minimum required state is present, instead of blocking on full refresh during iOS startup.\n\nActivity\nLinear created the issue via Slack on behalf of karri · 2min ago\nTriage Intelligence added the label Performance and iOS · 2min ago\nkarri\n· 4 min ago\nRight now we show a spinner forever, which makes it look like the car disappeared...\njori\n· just now\n@Linear can you take a stab at this?\nLinear\nconnected by\njori\n·\n2 min ago\nChanged 2 files\nDraft PR awaiting your review\n·\n2 min ago\nLinear moved from Todo to In Progress · just now\nLinearOpus 4.8\njori\nconnected Linear to ENG-2703\nExamining the startup path...\nThinking...\nENG-2703\nIn Progress\nHigh\njori\nLinear\nLabels\nPerformance\niOS\nCycle\nCycle 144\nProject\nCore Performance\nA new species of product tool. Purpose-built for modern teams with AI workflows at its core, Linear sets a new standard for planning and building products.\nFIG 0.2\nPurpose-built\n\nLinear is shaped by the practices and principles of world-class product teams.\n\nFIG 0.3\nPowered by agents\n\nDesigned for workflows shared by humans and agents, from PRD to PR.\n\nFIG 0.4\nDesigned for speed\n\nReduces noise and restores momentum to help teams ship with high velocity and focus.\n\nMake product operations self-driving\n\nTurn conversations and customer feedback into actionable issues that are routed, labeled, and prioritized for the right team.\n\n1.0Intake→\nBacklog\n8\nENG-2085\nReduce UI flicker during autonomy...\nENG-2094\nAdd buffering for autonomy event streams\nENG-2092\nReduce startup delay caused by vehicle sync\nENG-2200\nFix delayed route updates during rerouting\nTodo\n71\nENG-926\nRemove UI inconsistencies\nBug\nDesign\nENG-2088\nTypeError: Cannot read properties\nBug\nENG-924\nUpgrade to Claude Opus 4.8\nAI\nENG-1882\nOptimize load times\nPerformance\nIn Progress\n3\nENG-1487\nRemove contentData from GraphQL API\n61039\nMKT-1028\nLaunch page assets\nDesign\nENG-2187\nPrevent duplicate ride requests on poor...\nBug\n62048\nDone\n53\nENG-2074\nClean up deprecated APIs...\nAPI\n61002\nENG-1912\nReduce latency in autonomy st...\n61005\nENG-1951\nReduce ETA fluctuations durin...\n61202\nENG-1960\nImprove fallback messaging\nUI\n61149\nENG-1991\nImprove rider visibility into veh...\nThread in #feedback\ndidier\n11:37 AM\nHas anyone been looking into the iOS startup performance issues?\nlena\n11:37 AM\nAnyone else noticing the iOS app feels slow to open if you haven't used it in a bit?\ndidier\n11:37 AM\nYea, we're still blocking initial render on a full vehicle_state sync every time...\nandreas\n11:37 AM\nFeels like we could render sooner and load the rest in the background. Probably also worth tracking startup timing so we know how often this happens!\n@Linear\ncreate urgent issues and assign to me\n1.1\nLinear Agent +\n1.2\nTriage +\n1.3\nCustomer Requests +\n1.4\nLinear Asks +\nDefine the product direction\n\nPlan and navigate from idea to launch. Align your team with product initiatives, strategic roadmaps, and clear, up-to-date PRDs.\n\n2.0Plan→\nFEB\nMAR\nAPR\nMAY\nJUN\nJUL\nAUG\nSEP\n2\n9\n16\n23\n2\n9\n16\n23\n30\n6\n13\n20\n27\n4\n11\n18\n25\n1\n8\n15\n22\n29\n6\n13\n20\n27\n3\n10\n17\n24\n31\n7\n14\n21\n28\nUI Refresh\nCore screens\nPolish\nSplit fares\nInternal\nPublic Beta\nAutonomy status clarity\nAlpha\nGA\nInitiatives\nCore Product\n99\nInfra stability\n28\nAutonomous systems\n16\nMobile apps\n8\nAPAC Expansion\n21\nJapan Launch\n12\nCustomer-driven priorities\n9\n2.1\nProjects +\n2.2\nDocuments +\n2.3\nInitiatives +\n2.4\nVisual planning +\nMove work forward across teams and agents\n\nBuild and deploy AI agents that work alongside your team. Work on complex tasks toget","brandColors":["#191917","#27261A","#201E12"],"ogImage":"https://linear.app/static/og/homepage.jpg","hasRealScreenshots":3},"__ingested":true},"autopilot":1,"render3d":0,"compose_mode":"standard","brief":{"improvedPrompt":"A 60-second horizontal brand film for Linear, the product development system built for modern teams and AI agents. It opens on the chaos of shipping software—scattered feedback, stalled roadmaps, endless triage—then reveals Linear as the calm, high-velocity system that turns conversations into routed issues, aligns initiatives from idea to launch, and lets humans and agents ship side by side. Aimed at product and engineering leaders who want speed without noise. The arc lands on clarity and momentum: self-driving product operations, agent-native workflows, and a tool purpose-built for the AI era—available today. Premium, precise, quietly confident.","subject":"product management software dashboard UI","audience":"Product and engineering leaders at modern software teams adopting AI workflows","tone":"premium, precise, confident, forward-looking","goal":"Make viewers feel Linear is the inevitable system for shipping with teams and agents—and sign up","keyMessages":["The product development system for teams and agents","Purpose-built for planning and building products in the AI era","Make product operations self-driving","Define direction with initiatives, roadmaps, and PRDs","Move work forward across humans and agents","Built for the future. Available today."],"mustIncludeFacts":["The product development system for teams and agents","Purpose-built for planning and building products with AI agents","Designed for the AI era","Make product operations self-driving","A new species of product tool","Built for the future. Available today."],"brandColors":["#191917","#27261A","#201E12"],"suggestedFramePack":"aurora-spectrum","suggestedDuration":60,"musicMood":"cool ambient electronica","voProfile":"male, mid-30s, calm authoritative, measured and clear"},"script":{"title":"Linear For Teams And Agents","scenes":[{"id":"s1","start":0,"duration":3.5,"purpose":"hook","voiceover":"Shipping still feels like chaos.","onScreenText":["Chaos."],"visualDirection":"Sticky notes, chat fragments, and issue tickets explode outward in a dark, frantic burst.","assetNeeds":[],"sfx":["impact"],"musicCue":"intro"},{"id":"s2","start":3.5,"duration":3.5,"purpose":"context","voiceover":"Feedback scatters. Roadmaps stall.","onScreenText":["Scattered feedback","Stalled roadmaps"],"visualDirection":"Camera tracks left as feedback bubbles drift apart and a frozen roadmap grid cracks open.","assetNeeds":[{"type":"image","query":"messy desk sticky notes laptop","role":"background"}],"sfx":["whoosh"],"musicCue":"intro"},{"id":"s3","start":7,"duration":3.5,"purpose":"context","voiceover":"And triage never ends.","onScreenText":["Endless triage"],"visualDirection":"Issue cards stack relentlessly upward until they fill the entire frame.","assetNeeds":[{"type":"icon","query":"checklist","role":"inset"}],"sfx":[],"musicCue":"build"},{"id":"s4","start":10.5,"duration":4,"purpose":"feature","voiceover":"Linear cuts through the noise.","onScreenText":["Linear"],"visualDirection":"Chaos dissolves into a clean hero reveal of the real Linear product UI in a browser frame with a slow push-in.","assetNeeds":[],"sfx":["riser","impact"],"musicCue":"build"},{"id":"s5","start":14.5,"duration":4,"purpose":"feature","voiceover":"The product development system for teams and agents.","onScreenText":["Teams + Agents"],"visualDirection":"Slow pan across the real Linear workspace UI showing projects and team activity side by side.","assetNeeds":[],"sfx":["pop"],"musicCue":"steady"},{"id":"s6","start":18.5,"duration":4,"purpose":"feature","voiceover":"Define direction with initiatives, roadmaps, and PRDs.","onScreenText":["Initiatives","Roadmaps","PRDs"],"visualDirection":"Camera glides down a roadmap timeline as initiative cards and PRD documents snap onto layered planes.","assetNeeds":[{"type":"icon","