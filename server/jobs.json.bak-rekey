pe":"text","heroScale":0.56},{"sceneId":"s3","archetype":"stat","heroScale":0.56},{"sceneId":"s4","archetype":"stat","heroScale":0.56},{"sceneId":"s5","archetype":"text","heroScale":0.56},{"sceneId":"s6","archetype":"text","heroScale":0.56},{"sceneId":"s7","archetype":"text","heroScale":0.56},{"sceneId":"s8","archetype":"cta","heroScale":0.56}],"score":{"compositionQuality":100,"source":"deterministic"}},"captions":[{"start":0,"end":3.2,"text":"Everything you want. One app."},{"start":3.75,"end":8.1,"text":"Flipkart. India's ultimate one-stop shopping destination."},{"start":8.65,"end":12.100000000000001,"text":"Up to ninety percent off top products."},{"start":12.65,"end":16.6,"text":"Flipkart Minutes. Groceries and gadgets in a flash."},{"start":17.15,"end":21.200045,"text":"Flipkart Kilos: your online grocery supermarket."},{"start":21.75,"end":24.9,"text":"Trade-in with Flipkart Reset and Exchange."},{"start":25.45,"end":28.8,"text":"Flipkart Flights. Book your next getaway."},{"start":29.35,"end":32.9,"text":"Open Flipkart. Grab the offers now."}],"srt_url":"/videos/9bytvxqh7c.srt","last_requeue_at":1784722938487},{"id":"a9nrixjhbr","kind":"project","prompt":"","duration":150,"orientation":"horizontal","quality":"1080p","width":1920,"height":1080,"fps":30,"frame_pack":"blueprint-atelier","frame_pack_user":1,"status":"done","progress":"finalizing","video_url":"/videos/a9nrixjhbr.mp4","error":null,"used_fallback":1,"llm_tokens_in":64511,"llm_tokens_out":42014,"created_at":1784721770651,"started_at":1784723365795,"finished_at":1784781969340,"client_ip":"::1","voice_style":null,"captions_enabled":0,"upload_path":null,"task":null,"requeue_count":2,"intent":{"prompt":"","websiteUrl":"https://linear.app","blogUrl":null,"hasReferenceVideo":false,"preferences":{"duration":150,"orientation":"horizontal","voiceStyle":"auto","framePack":"blueprint-atelier"},"website":{"url":"https://linear.app","title":"Linear – The system for product development","description":"Purpose-built for planning and building products with AI agents.","headings":["The product development system for teams and agentsThe product developmentsystem for teams and agentsThe product development system for teams and agents","Faster app launch","A new species of product tool. Purpose-built for modern teams with AI workflows at its core, Linear sets a new standard for planning and building products.","Make product operations self-driving","Define the product direction","Move work forward across teams and agents","Review PRs and agent output","Understand progress at scale","Changelog","Built for the future. Available today.","Product","Features","Company","Resources","Connect","Legal"],"bodyText":"Skip to content →\nProduct\nResources\nCustomers\nPricing\nNow\nContact\nLog in\nSign up\nThe product development\nsystem for teams and agents\nThe product development system for teams and agents\n\nPurpose-built for planning and building products. Designed for the AI era.\n\nNew\nCoding Sessions →\nLinear\nInbox\nMy issues\nReviews\nPulse\nWorkspace\nInitiatives\nProjects\nMore\nFavorites\nFaster app launch\nAgent tasks\nUI Refresh\nAgents Insights\nFaster app launch\n02\n/\n145\nFaster app launch\n\nRender UI before vehicle_state sync when minimum required state is present, instead of blocking on full refresh during iOS startup.\n\nActivity\nLinear created the issue via Slack on behalf of karri · 2min ago\nTriage Intelligence added the label Performance and iOS · 2min ago\nkarri\n· 4 min ago\nRight now we show a spinner forever, which makes it look like the car disappeared...\njori\n· just now\n@Linear can you take a stab at this?\nLinear\nconnected by\njori\n·\n2 min ago\nChanged 2 files\nDraft PR awaiting your review\n·\n2 min ago\nLinear moved from Todo to In Progress · just now\nLinearOpus 4.8\njori\nconnected Linear to ENG-2703\nExamining the startup path...\nWorked for 7s \nPushed and opened a draft PR. Changes:\nuseRideHistory.ts : build a waitingStatusById map and use it as the getLastAction by line\nRideHistoryPage.tsx : dimmed rows reset\nPreview\nChanged\n2 files\n+4\n-4\nDraft\nUpdate homepage H1\nmaster\n←\nride/drv-899-update-homepage-h1-65a6\nENG-2703\nIn Progress\nHigh\njori\nLinear\nLabels\nPerformance\niOS\nCycle\nCycle 144\nProject\nCore Performance\nA new species of product tool. Purpose-built for modern teams with AI workflows at its core, Linear sets a new standard for planning and building products.\nFIG 0.2\nPurpose-built\n\nLinear is shaped by the practices and principles of world-class product teams.\n\nFIG 0.3\nPowered by agents\n\nDesigned for workflows shared by humans and agents, from PRD to PR.\n\nFIG 0.4\nDesigned for speed\n\nReduces noise and restores momentum to help teams ship with high velocity and focus.\n\nMake product operations self-driving\n\nTurn conversations and customer feedback into actionable issues that are routed, labeled, and prioritized for the right team.\n\n1.0Intake→\nBacklog\n8\nENG-2085\nReduce UI flicker during autonomy...\nENG-2094\nAdd buffering for autonomy event streams\nENG-2092\nReduce startup delay caused by vehicle sync\nENG-2200\nFix delayed route updates during rerouting\nTodo\n71\nENG-926\nRemove UI inconsistencies\nBug\nDesign\nENG-2088\nTypeError: Cannot read properties\nBug\nENG-924\nUpgrade to Claude Opus 4.8\nAI\nENG-1882\nOptimize load times\nPerformance\nIn Progress\n3\nENG-1487\nRemove contentData from GraphQL API\n61039\nMKT-1028\nLaunch page assets\nDesign\nENG-2187\nPrevent duplicate ride requests on poor...\nBug\n62048\nDone\n53\nENG-2074\nClean up deprecated APIs...\nAPI\n61002\nENG-1912\nReduce latency in autonomy st...\n61005\nENG-1951\nReduce ETA fluctuations durin...\n61202\nENG-1960\nImprove fallback messaging\nUI\n61149\nENG-1991\nImprove rider visibility into veh...\nThread in #feedback\ndidier\n5:55 PM\nHas anyone been looking into the iOS startup performance issues?\nlena\n5:55 PM\nAnyone else noticing the iOS app feels slow to open if you haven't used it in a bit?\ndidier\n5:55 PM\nYea, we're still blocking initial render on a full vehicle_state sync every time...\nandreas\n5:55 PM\nFeels like we could render sooner and load the rest in the background. Probably also worth tracking startup timing so we know how often this happens!\n@Linear\ncreate urgent issues and assign to me\n1.1\nLinear Agent +\n1.2\nTriage +\n1.3\nCustomer Requests +\n1.4\nLinear Asks +\nDefine the product direction\n\nPlan and navigate from idea to launch. Align your team with product initiatives, strategic roadmaps, and clear, up-to-date PRDs.\n\n2.0Plan→\nFEB\nMAR\nAPR\nMAY\nJUN\nJUL\nAUG\nSEP\n2\n9\n16\n23\n2\n9\n16\n23\n30\n6\n13\n20\n27\n4\n11\n18\n25\n1\n8\n15\n22\n29\n6\n13\n20\n27\n3\n10\n17\n24\n31\n7\n14\n21\n28\nUI Refresh\nCore screens\nPolish\nSplit fares\nInternal\nPublic Beta\nAutonomy status clarity\nAlpha\nGA\nInitiatives\nCore Product\n99\nInfra stability\n28\nAutonomous systems\n16\nMobile ","brandColors":["#191917","#27261A","#201E12"],"ogImage":"https://linear.app/static/og/homepage.jpg","hasRealScreenshots":3},"__ingested":true},"autopilot":1,"render3d":0,"compose_mode":"standard","brief":{"improvedPrompt":"A 150-second horizontal brand film for Linear, the product development system purpose-built for modern teams and AI agents. It opens on the friction of product work—scattered feedback, stalled reviews, unclear direction—then reveals Linear as the single system that turns conversations into actionable issues, aligns teams on initiatives and roadmaps, and lets humans and agents ship side by side from PRD to PR. Built for product and engineering teams who want self-driving operations: intelligent triage, agent-assisted reviews, and progress readable at scale. Confident, precise, and future-facing, it closes on the promise that the future of building products is available today.","subject":"product development software dashboard UI","audience":"Product managers, engineers, and modern product teams adopting AI workflows","tone":"confident, precise, premium, technical","goal":"Convince viewers Linear is the definitive system for human-and-agent product work—and make them sign up","keyMessages":["The product development system for teams and agents","Purpose-built for the AI era—from PRD to PR","Make product operations self-driving","Plan initiatives, roadmaps, and PRDs in one place","Move work forward across teams and agents","Review PRs and agent output; understand progress at scale"],"mustIncludeFacts":["Purpose-built for planning and building products with AI agents","Designed for the AI era","Workflows shared by humans and agents, from PRD to PR","Turn conversations and customer feedback into actionable issues that are routed, labeled, and prioritized","Built for the future. Available today.","A new species of product tool"],"brandColors":["#191917","#27261A","#201E12"],"suggestedFramePack":"blueprint-atelier","suggestedDuration":150,"musicMood":"precise modern ambient electronica","voProfile":"male, mid-30s, calm and assured, measured and clear"},"script":{"title":"Linear: Build With Teams and Agents","scenes":[{"id":"s1","start":0,"duration":3.5,"purpose":"hook","voiceover":"Product work is broken.","onScreenText":["Product work is broken"],"visualDirection":"Chaotic sticky notes, chat threads, and stalled cards collide into frame with hard cuts and shake.","assetNeeds":[],"sfx":["impact"],"musicCue":"intro"},{"id":"s2","start":3.5,"duration":4,"purpose":"context","voiceover":"Feedback scatters across a dozen tools.","onScreenText":["Feedback everywhere"],"visualDirection":"Camera pushes through floating chat bubbles and email threads that fracture and drift apart.","assetNeeds":[{"type":"icon","query":"chat bubble","role":"inset"},{"type":"image","query":"frustrated man laptop office desk","role":"background"}],"sfx":["whoosh"],"musicCue":"intro"},{"id":"s3","start":7.5,"duration":3.5,"purpose":"context","voiceover":"Reviews stall. Direction fades.","onScreenText":["Stalled reviews","Lost direction"],"visualDirection":"A review card freezes mid-air while a roadmap line dissolves into dust particles.","assetNeeds":[{"type":"icon","query":"warning","role":"inset"}],"sfx":[],"musicCue":"build"},{"id":"s4","start":11,"duration":4,"purpose":"context","voiceover":"Ideas die between conversation and code.","onScreenText":["The gap grows"],"visualDirection":"Slow pan across a cluttered desk of notebooks, sticky notes, and an unfinished laptop screen.","assetNeeds":[{"type":"image","query":"cluttered desk sticky notes laptop","role":"background"}],"sfx":["swoosh"],"musicCue":"build"},{"id":"s5","start":15,"duration":3,"purpose":"hook","voiceover":"There is another way.","onScreenText":["Another way"],"visualDirection":"Darkness parts as a single clean geometric mark pulses into the center of frame.","assetNeeds":[],"sfx":["riser"],"musicCue":"build"},{"id":"s6","start":18,"duration":5,"purpose":"feature","voiceover":"Linear. The product development system for teams and agents.","onScreenText":["Linear","Teams + Agents"],"visualDirection":"The real product UI in a browser frame glides in with a slow dramatic push-in; the logo locks above it.","assetNeeds":[],"sfx":["impact","whoosh"],"musicCue":"lift"},{"id":"s7","start":23,"duration":4,"purpose":"feature","voiceover":"Designed for the AI era.","onScreenText":["Designed for AI"],"visualDirection":"Clean icon tiles for humans and agents orbit a central Linear mark on layered depth planes.","assetNeeds":[{"type":"icon","query":"sparkle","role":"inset"},{"type":"icon","query":"team","role":"inset"}],"sfx":["pop"],"musicCue":"steady"},{"id":"s8","start":27,"duration":4,"purpose":"feature","voiceover":"From PRD to PR.","onScreenText":["PRD to PR"],"visualDirection":"A horizontal path draws itself: a document morphs into issue cards, then into a merged checkmark.","assetNeeds":[{"type":"icon","query":"document","role":"inset"},{"type":"icon","query":"checkmark","role":"inset"}],"sfx":["transition"],"musicCue":"steady"},{"id":"s9","start":31,"duration":5,"purpose":"how","voiceover":"Workflows shared by humans and agents, end to end.","onScreenText":["Humans + Agents","Shared workflows"],"visualDirection":"Split composition of a product manager and a glowing agent avatar both advancing the same issue card.","assetNeeds":[{"type":"image","query":"product manager laptop collaboration office","role":"background"}],"sfx":["swoosh"],"musicCue":"steady"},{"id":"s10","start":36,"duration":4,"purpose":"feature","voiceover":"Plan initiatives and roadmaps in one place.","onScreenText":["Initiatives","Roadmaps"],"visualDirection":"Camera pans across the real product UI roadmap view in a browser frame as initiative columns slide into focus.","assetNeeds":[],"sfx":["whoosh"],"musicCue":"steady"},{"id":"s11","start":40,"duration":4,"purpose":"feature","voiceover":"PRDs live where the work happens.","onScreenText":["PRDs in context"],"visualDirection":"A document panel expands beside an issue list; the camera dollies in as key lines highlight.","assetNeeds":[{"type":"icon","query":"notebook","role":"inset"}],"sfx":["click"],"musicCue":"steady"},{"id":"s12","start":44,"duration":4,"purpose":"how","voiceover":"Turn conversations and customer feedback into actionable issues.","onScreenText":["Conversations → Issues"],"visualDirection":"Chat bubbles collapse and reform into crisp issue cards that snap into a backlog grid.","assetNeeds":[{"type":"icon","query":"chat bubble","role":"inset"},{"type":"icon","query":"checklist","role":"inset"}],"sfx":["pop","ding"],"musicCue":"build"},{"id":"s13","start":48,"duration":3.5,"purpose":"how","voiceover":"Routed, labeled, and prioritized.","onScreenText":["Routed","Labeled","Prioritized"],"visualDirection":"Issue cards fly into labeled columns as color tags and priority badges land with precision.","assetNeeds":[],"sfx":["click"],"musicCue":"build"},{"id":"s14","start":51.5,"duration":4,"purpose":"feature","voiceover":"Intelligent triage that never sleeps.","onScreenText":["Intelligent triage"],"visualDirection":"Incoming cards sort along glowing paths into priority lanes while the camera tracks the flow.","assetNeeds":[{"type":"icon","query":"sparkle","role":"inset"}],"sfx":["sparkle"],"musicCue":"build"},{"id":"s15","start":55.5,"duration":4,"purpose":"feature","voiceover":"Make product operations self-driving.","onScreenText":["Self-driving operations"],"visualDirection":"Status rings fill themselves on a control-center layout as the camera slowly orbits the board.","assetNeeds":[{"type":"image","query":"focused engineer dual monitors morning","role":"background"}],"sfx":["riser"],"musicCue":"lift"},{"id":"s16","start":59.5,"duration":4,"purpose":"feature","voiceover":"Move work forward across every team.","onScreenText":["Cross-team momentum"],"visualDirection":"Cards travel across team swimlanes with parallax as ownership avatars light up in sequence.","assetNeeds":[{"type":"icon","query":"team","role":"inset"}],"sfx":["whoosh"],"musicCue":"steady"},{"id":"s17","start":63.5,"duration":3.5,"purpose":"feature","voiceover":"And across every agent.","onScreenText":["Agents included"],"visualDirection":"Agent markers join the swimlanes, claiming cards and stacking completed checkmarks in rhythm.","assetNeeds":[{"type":"icon","query":"lightning","role":"inset"}],"sfx":["pop"],"musicCue":"steady"},{"id":"s18","start":67,"duration":4,"purpose":"feature","voiceover":"Review pull requests and agent output together.","onScreenText":["PRs + Agent output"],"visualDirection":"The real product UI in a browser frame shows a review feed with agent annotations; slow vertical pan down the list.","assetNeeds":[],"sfx":["transition"],"musicCue":"steady"},{"id":"s19","start":71,"duration":5,"purpose":"proof","voiceover":"Understand progress at scale without losing the details.","onScreenText":["Progress at scale"],"visualDirection":"Zoom out from a single issue to a full initiative map of connected projects glowing 