1784116567071,"client_ip":"::1","voice_style":null,"captions_enabled":0,"upload_path":null,"task":null,"requeue_count":2,"intent":{"prompt":"Claude by Anthropic � the AI thinking partner that writes, codes and researches with you. Warm storybook launch film.","websiteUrl":null,"hasReferenceVideo":false,"preferences":{"duration":20,"orientation":"horizontal","voiceStyle":"auto","framePack":"paper-tales"}},"autopilot":1,"render3d":0,"compose_mode":"premium","brief":{"improvedPrompt":"A warm 20-second horizontal storybook launch film for Claude by Anthropic — the AI thinking partner that writes, codes and researches with you. It opens like a picture-book spread: a quiet desk, a blank page, a half-finished idea. Pages turn and pop-ups unfold as Claude joins the work — drafting lines, sketching code, gathering research — always beside the human, never instead of them. Built for writers, builders and curious minds who want a thoughtful collaborator. It closes on the soft promise of a partner who thinks with you. Gentle, sincere and story-led.","subject":"person writing and coding on laptop","audience":"Writers, developers and researchers seeking a thoughtful AI collaborator","tone":"warm, gentle, sincere, storybook","goal":"Leave the viewer feeling Claude is a kind, capable thinking partner — and wanting to try it","keyMessages":["Claude — the AI thinking partner","Writes, codes and researches with you","Think with Claude, not alone","From Anthropic"],"mustIncludeFacts":["Claude by Anthropic","AI thinking partner that writes, codes and researches with you"],"brandColors":["#F5E6D3","#C4785A","#2C2420"],"suggestedFramePack":"paper-tales","suggestedDuration":20,"musicMood":"warm gentle storybook piano","voProfile":"soft female, early-30s, warm storybook narrator, unhurried"},"script":{"title":"Think With Claude Beside You","scenes":[{"id":"s1","start":0,"duration":3.5,"purpose":"hook","voiceover":"A blank page. A half-finished idea.","onScreenText":["Half-finished"],"visual