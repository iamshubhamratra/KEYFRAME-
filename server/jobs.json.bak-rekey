://mygardyn.com/how-it-works","text":"How It Works"},{"url":"https://mygardyn.com/gardyn-membership","text":"Membership"},{"url":"https://mygardyn.com/gardyn-hsa-fsa-eligible-products","text":"HSA / FSA"},{"url":"https://mygardyn.com/faq","text":"FAQs"},{"url":"https://mygardyn.com/gardyners","text":"Community"},{"url":"https://mygardyn.com/product-reviews","text":"Reviews"},{"url":"https://mygardyn.com/school-gardens","text":"Gardyn for Schools"},{"url":"https://mygardyn.com/about","text":"Mission"},{"url":"https://mygardyn.com/blog","text":"Blog"},{"url":"https://mygardyn.com/grow-sustainable","text":"Sustainability"},{"url":"https://mygardyn.com/careers","text":"Careers"},{"url":"https://mygardyn.com/products","text":"Shop All"},{"url":"https://mygardyn.com/product/gardyn-sprout-nursery","text":"Nursery"},{"url":"https://mygardyn.com/product/gardyn-harvest-kit","text":"Harvest Kit"},{"url":"https://mygardyn.com/product/microgreens-complete-kit","text":"Complete Kit"},{"url":"https://mygardyn.com/product/microgreens-seed-pad-refills","text":"Seed Pads"},{"url":"https://mygardyn.com/ycubes","text":"Plant Favorites"},{"url":"https://mygardyn.com/product/seedless-ycube","text":"seedless yCubes"},{"url":"https://mygardyn.com/corporate-gifting","text":"Corporate Gifting"},{"url":"https://mygardyn.com/ambassadors","text":"Ambassadors"},{"url":"https://mygardyn.com/gardyn-influencers","text":"Influencers"},{"url":"https://mygardyn.com/press","text":"Press"},{"url":"https://mygardyn.com/policy/return","text":"Returns"},{"url":"https://mygardyn.com/replacement-parts","text":"Replacement Parts"},{"url":"https://mygardyn.com/patents","text":"Patents"},{"url":"https://mygardyn.com/policy/terms-of-service","text":"Terms of Service"},{"url":"https://mygardyn.com/policy/subscription","text":"Membership Policy"},{"url":"https://mygardyn.com/policy/warranty","text":"Warranty"},{"url":"https://mygardyn.com/policy/map-policy","text":"MAP Policy"},{"url":"https://mygardyn.com/policy/referrals","text":"Referral Terms & Conditions"}],"website_auth_wall":false,"usage":{"byStage":[{"stage":"script","model":"grok-4-5","inputTokens":3530,"outputTokens":6825,"totalTokens":10355,"callCount":1,"costUsd":0.019204},{"stage":"brief","model":"grok-4-5","inputTokens":10035,"outputTokens":1025,"totalTokens":11060,"callCount":1,"costUsd":0.010488}],"llm":{"inputTokens":13565,"outputTokens":7850,"callCount":2,"inputCostUsd":0.010852,"outputCostUsd":0.01884,"totalCostUsd":0.029692},"tts":{"inputChars":0,"inputTokensEst":0,"outputTokensEst":0,"callCount":0,"inputCostUsd":0,"outputCostUsd":0,"totalCostUsd":0},"external":{"openrouter_chat":2},"totalCostUsd":0.029692},"stage_timings":{"ingestMs":145486,"briefMs":50795,"scriptMs":174774},"brand_review":{"source":"site-theme","ground":"#FFF8F2"},"last_requeue_at":1784976905951},{"id":"9zfuarm809","kind":"project","prompt":"","duration":30,"orientation":"vertical","quality":"1080p","width":1080,"height":1920,"fps":30,"frame_pack":"lantern-night","frame_pack_user":1,"status":"failed","progress":null,"video_url":null,"error":"server restarted while job was in-flight","used_fallback":0,"llm_tokens_in":0,"llm_tokens_out":0,"created_at":1784974410064,"started_at":null,"finished_at":1784976906171,"client_ip":"::1","voice_style":null,"captions_enabled":0,"upload_path":null,"task":null,"requeue_count":2,"intent":{"prompt":"","websiteUrl":"https://obsidian.md","blogUrl":null,"hasReferenceVideo":false,"preferences":{"duration":30,"orientation":"vertical","voiceStyle":"auto","framePack":"lantern-night"},"website":{"url":"https://obsidian.md","title":"Obsidian - Sharpen your thinking","description":"The free and flexible app for your private thoughts.","headings":["Sharpen your thinking.","Spark ideas.","Sync securely.","Publish instantly.","It’s your time to shine."],"bodyText":"Download\nPricing\nSync\nPublish\nEnterprise\nCommunity\nAccount\nSharpen your thinking.\n\nThe free and flexible app for your private thoughts.\n\nGet Obsidian for Windows\nMore platforms\nWriting is telepathy\nEvergreen notes\nGraph of Writing is t...\nClippings\nDaily\nIdeas\nWriting is telepathy\nMeta\nProjects\nReferences\nEvergreen notes\nCalmness is a superpower\nTravel\nCreativity is combinatory u...\nEmergence\nRecipes\nBooks\nHealth\nWhat if it were easy\nTools\nSpecialization is for insects\nFirst principles\nPhilosophy\nA little bit every day\n1,000 true fans\nNotes\nWriting is telepathy\n#evergreen\n\nFrom On Writing\n\nIdeas can travel through time and space\n\nIdeas can travel through time and space without being uttered out loud. The process of telepathy requires two places:\n\nA sending place, a transmission place — where the writer sends ideas, such as a desk\nA receiving place — where the reader receives the ideas/imagery such as a couch, a comfortable chair, in bed\nQuote\nLook, here’s a table covered with red cloth. On it is a cage the size of a small fish aquarium. In the cage is a white rabbit with a pink nose and pink-rimmed eyes. On its back, clearly marked in blue ink, is the numeral 8. The most interesting thing here isn’t even the carrot-munching rabbit in the cage, but the number on its back. I never opened my mouth and you never opened yours. We’re not even in the same year together, let alone the same room... except we are together. We are close. We’re having a meeting of the minds. We’ve engaged in an act of telepathy.\n1 backlink\n206 words\n1139 char\n3:54\nJapan Trip Planning\n#projects\n#travel\nTo-do\nSchedule flights\nAsk for recommendations\n✓\nKeiko\n✓\nAndrew\nGarrett\nResearch ryokans in\nKyoto\nItinerary\n1\nYour thoughts are yours.\nObsidian stores notes privately on your device, so you can access them quickly, even offline. No one else can read them, not even us.\nYour mind is unique.\nWith thousands of plugins and themes, you can shape Obsidian to fit your way of thinking.\nYour knowledge should last.\nObsidian uses open file formats, so you’re never locked in. You own your data for the long term.\nFree without limits.\nDownload now\nSpark ideas.\n\nFrom personal notes to journaling, knowledge bases, and project management, Obsidian gives you the tools to come up with ideas and organize them.\n\nLinks\nCreate connections between your notes. Link anything and everything — ideas, people, places, books, and beyond. Invent your own personal Wikipedia.\n\nIn Meditations on First Philosophy the philosopher René Descartes describes a series of doubts about the nature of reality, arriving at the famous phrase:\n\n[[I thin]]\nI think therefore I am\nJust think about it\nThinking, Fast and Slow\n\nBooks/\nThe Thing\n\nMovies/\n\nHe argues that doubting requires thinking, and therefore, the act of thinking confirms his existence.\n\nGraph\nVisualize the relationships between your notes. Find hidden patterns in your thinking through a visually engaging and interactive graph.\nCanvas\nAn infinite space to research, brainstorm, diagram, and lay out your ideas. Canvas is a limitless playground for your mind. Learn more.\nLecture 1\n\nRationalists\n\nReason and innate knowledge → acquire knowledge\nFundamental truths and principles can be known independent of experience\nA priori reasoning\nReason and deduction\n\nEmpiricists\n\nExperience and sensory perception → acquire knowledge\nAll knowledge is derived from experience and observation of the external world\nA posteriori reasoning\nCogito, ergo sum\n\nIn Meditations on First Philosophy the philosopher René Descartes describes a series of doubts about the nature of reality, arriving at the famous phrase:\n\nI think therefore I am\n\nHe argues that doubting requires thinking, and therefore, the act of thinking confirms his existence.\n\nPhilosophers\nPlugins\nBuild your ideal thinking space. With thousands of plugins and our open API, it’s easy to tailor Obsidian to fit your personal workflow. Learn more.\nCommunity plugins\nCalendar by Liam Cain\nCalendar view of your daily","brandColors":["#8B4CF8","#6931C7","#341D59","#282831"],"ogImage":"https://obsidian.md/images/banner.png","hasRealScreenshots":3},"__ingested":true},"autopilot":1,"render3d":0,"compose_mode":null,"brief":{"improvedPrompt":"A 30-second vertical film for Obsidian, the free note-taking app that sharpens private thinking. It opens on the quiet friction of scattered thoughts, then reveals a local vault where notes link into a living personal graph — ideas, books, projects connected like a private Wikipedia. Built for writers, researchers, and deep thinkers who refuse cloud lock-in. The arc lands on ownership: notes stay on your device, offline, forever yours, shaped by thousands of plugins. Calm, luminous, and quietly confident — a lantern in the dark for people who take their minds seriously.","subject":"linked notes and knowledge graph UI","audience":"Writers, researchers, and knowledge workers who want private, local-first note systems","tone":"calm, luminous, intelligent, private","goal":"Make the viewer feel their mind deserves a private home — and download Obsidian","keyMessages":["Sharpen your thinking","The free app for your private thoughts","Notes stay on your device — offline, unread by anyone","Link anything into your personal Wikipedia","Thousands of plugins to fit how you think","Open formats — you own your data forever"],"mustIncludeFacts":["The free and flexible app for your private thoughts","Obsidian stores notes privately on your device, even offline","No one else can read them, not even us","Thousands of plugins and themes","Open file formats — never locked in, you own your data","Free without limits","Links, Graph, Canvas, and Plugins"],"brandColors":["#8B4CF8","#6931C7","#341D59","#282831"],"suggestedFramePack":"lantern-night","suggestedDuration":30,"musicMood":"warm ambient night glow","voProfile":"soft-spoken female, mid-30s, measured and reflective, unhurried"},"script":{"title":"Your Mind's Private Home","scenes":[{"id":"s1","start":0,"duration":3,"purpose":"hook","voiceover":"Scattered thoughts?","onScreenText":["Scattered thoughts?"],"visualDirection":"Handwritten note fragments drift and tumble through soft darkness as the camera slowly pushes through the chaos.","assetNeeds":[],"sfx":["riser"],"musicCue":"intro"},{"id":"s2","start":3,"duration":3.5,"purpose":"context","voiceover":"They need a private home.","onScreenText":["A private home"],"visualDirection":"Fragments gently gather toward a warm lantern glow at center while the camera orbits and settles.","assetNeeds":[{"type":"image","query":"person journaling desk soft lamp","role":"background"}],"sfx":[],"musicCue":"build"},{"id":"s3","start":6.5,"duration":4,"purpose":"feature","voiceover":"Obsidian. The free app for private thoughts.","onScreenText":["Free without limits"],"visualDirection":"The real product UI rises into a browser frame with a slow push-in across the note list and soft sidebar glow.","assetNeeds":[],"sfx":["whoosh","pop"],"musicCue":"steady"},{"id":"s4","start":10.5,"duration":4,"purpose":"feature","voiceover":"Notes stay on your device. Offline. Unread by anyone.","onScreenText":["On your device","Even offline"],"visualDirection":"Camera pans across layered note cards with a soft shield overlay settling into place on depth planes.","assetNeeds":[{"type":"icon","query":"shield lock","role":"inset"},{"type":"image","query":"hands closing notebook desk","role":"background"}],"sfx":["click"],"musicCue":"steady"},{"id":"s5","start":14.5,"duration":4,"purpose":"feature","voiceover":"Link anything into your personal Wikipedia.","onScreenText":["Personal Wikipedia"],"visualDirection":"Slow zoom into the real product graph view as luminous nodes and links spark and connect, camera circling gently.","assetNeeds":[{"type":"icon","query":"connected nodes","role":"texture"}],"sfx":["sparkle"],"musicCue":"steady"},{"id":"s6","start":18.5,"duration":4,"purpose":"how","voiceover":"Thousands of plugins to fit how you think.","onScreenText":["Thousands of plugins",