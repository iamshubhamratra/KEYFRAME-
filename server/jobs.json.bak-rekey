:2,"keptPhotos":4,"demoted":0,"heroScale":0.56,"montageMax":6,"prominentTotal":6,"scenes":[{"sceneId":"s1","archetype":"hook","heroScale":0.56},{"sceneId":"s2","archetype":"text","heroScale":0.56},{"sceneId":"s3","archetype":"text","heroScale":0.56},{"sceneId":"s4","archetype":"text","heroScale":0.56},{"sceneId":"s5","archetype":"stat","heroScale":0.56},{"sceneId":"s6","archetype":"stat","heroScale":0.56},{"sceneId":"s7","archetype":"quote","heroScale":0.56},{"sceneId":"s8","archetype":"cta","heroScale":0.56}],"score":{"compositionQuality":100,"source":"deterministic"}},"captions":[{"start":0,"end":3.05,"text":"Fresh pesticide-free produce year-round?"},{"start":3.6,"end":7.300000000000001,"text":"No backyard, no green thumb, no time."},{"start":7.85,"end":12.149999999999999,"text":"Meet Gardyn, your smart indoor garden."},{"start":12.7,"end":15.458208955223878,"text":"Meet Kelby, your AI gardener that"},{"start":15.458208955223878,"end":18.299999999999997,"text":"monitors water, light, and health."},{"start":18.85,"end":23.225,"text":"100,000 happy Gardyners. Six million plants grown."},{"start":23.78,"end":28.155,"text":"Grow and love over 100 non-GMO varieties."},{"start":28.71,"end":33.71,"text":"4.8 stars. HSA and FSA eligible."},{"start":34.26,"end":39.26,"text":"All the benefits, none of the work. Shop Gardyn today."}],"srt_url":"/videos/tr8ytrk7kx.srt","final_attempt":"main","qa":{"pass":true,"score":10,"issues":[]},"quality_report":{"verdict":"flagged","flags":["1 screenshot(s) dropped by QA"],"contrast":{"checked":true,"fixed":1,"remaining":0,"passes":1},"identity":{"remapped":0},"layout":{"duplicatesRemoved":0,"collisionsScrimmed":0},"assetFloor":null,"audio":{"lufs":-14,"peak":-2.9,"lra":5.4,"target":-14,"layers":{"voice":8,"sfx":6,"music":true,"ambient":false,"musicEnvelope":false}},"screenshots":{"kept":2,"dropped":1,"repinned":2,"problems":["scene-mismatch"]},"assetQuality":82,"templateFit":87,"qa":{"pass":true,"score":10,"skipped":false,"blockers":0}}},{"id":"6rg33ba5zi","kind":"project","prompt":"","duration":30,"orientation":"vertical","quality":"1080p","width":1080,"height":1920,"fps":30,"frame_pack":"daybreak-bakehouse","frame_pack_user":1,"status":"done","progress":"finalizing","video_url":"/videos/6rg33ba5zi.mp4","error":null,"used_fallback":0,"llm_tokens_in":56496,"llm_tokens_out":24279,"created_at":1784974409989,"started_at":1784976441912,"finished_at":1784976782563,"client_ip":"::1","voice_style":null,"captions_enabled":0,"upload_path":null,"task":null,"requeue_count":0,"intent":{"prompt":"","websiteUrl":"https://tartinebakery.com","blogUrl":null,"hasReferenceVideo":false,"preferences":{"duration":30,"orientation":"vertical","voiceStyle":"auto","framePack":"daybreak-bakehouse"},"website":{"url":"https://tartinebakery.com","title":"Tartine Bakery","description":"Tartine is a thoughtful expression of modern craft through good food and warm experiences. We are a product of our communities and our friends.","headings":["Welcome to Tartine","Tartine Happenings","SPECIAL ORDER CAKES","PRE ORDER CAKES & TARTS","Gift Cards","Tartine: Inside Stories, Chapter 3: Stewardship","WHO WE ARE","A thoughtful expression of modern craft.","Tartine at home"],"bodyText":"Skip to Main Content\n\nCRAVING PIZZA?\n\nCLICK HERE TO MAKE A DINNER RESERVATION @ TARTINE MANUFACTORY\nLOCATIONSABOUT US\nNATIONAL SHIPPING\nORDER\nWelcome to Tartine\n\na thoughtful expression of modern craft through good food and warm experiences.\n\nBay Area\n\n4 locations →\n\nLos Angeles\n\n7 locations →\n\nSeoul\n\n6 locations →\nTartine Happenings\nSlide 1 of 3\n\nRise Each Day. Warm Every Table. Join Tartine\n\nJOIN TARTINE\n\nCraving Tartine but you don't live in SF or LA? We're thrilled to offer nationwide shipping through Goldbelly.\n\nORDER NATIONWIDE\nSPECIAL ORDER CAKES\n\nHave a special event coming up? We can help with that.\n\nPlease note that special order cakes require a seven day lead time.\nCLICK HERE TO ORDER YOUR SPECIAL ORDER CAKE - PICK-UP FROM TARTINE BAKERY @ 600 GUERRERO ST.\nPRE ORDER CAKES & TARTS\n\nClick the link below to pre-order a cake or tart.\n\nCLICK HERE TO PRE-ORDER CAKES & TARTS- PICK-UP FROM TARTINE BAKERY @ 600 GUERRERO ST.\nGift Cards\n\nYou can now buy a Tartine gift card online. You can send as a gift or treat yourself! Tartine gift cards can be redeemed at Tartine Bakery in SF, Tartine Manufactory, Tartine Inner Sunset as well as our 5 LA locations.\n\nBUY GIFT CARD\nTartine: Inside Stories, Chapter 3: Stewardship\n\nThe final exploration in the series. Watch Chapter 3 below:\n\nWHO WE ARE\nA thoughtful expression of modern craft.\n\nTartine began with a mission: bring bread with an old-soul into the lives of our friends and family in California.\n\nLEARN ABOUT US\n\n\"Fresh out of the oven, each loaf has a shell of blistered mahogany and an interior so chewy and preternaturally moist that it shimmers in the light\"\n\nVogue\nSlide 1 of 6\n\nBREAD BOOK Available for Pre-order\n\nTartine: A Classic Revisited on Amazon\n\nTartine All Day on Amazon\n\nTartine Bread\n\nTartine\n\nTartine Book No 3\n\nTartine at home\n\nIn 2010 we published TARTINE BREAD. The baking community was in shock that we would share our secret to the iconic Tartine Country Loaf. For us, the magic is in the endless thought and experimentation that goes into making each loaf; learning to push the boundaries of what we do, so more people can enjoy it.\n\nLocations\n\nNational Shipping\n\nAbout Us\n\nJoin Tartine\n\nPress\n\ninfo@tartinebakery.com\n\ninfo@tartinemanufactory.com\n\npress@tartinebakery.com\n\nFacebook\n\n / \n\nInstagram\n\nRise each day.\nWarm every table.\n\n2021 Tartine\n\nAll rights reserved\n\nPrivacy Policy\n\nSite Map\n\nTerms of Service\n\nCLOSE\n\nLocations\n\nAbout\n\nOrder\n\nJoin Tartine\n\nPress\n\nCLOSE\nCHANGE LOCATION\nEACH\nDAY\nMADE\nEACH\nDAY","brandColors":["#261B16","#322928","#32231A","#4A362D"],"ogImage":"assets/tartine-share.jpg","hasRealScreenshots":3},"__ingested":true},"autopilot":1,"render3d":0,"compose_mode":null,"brief":{"improvedPrompt":"A 30-second vertical brand film for Tartine Bakery, the California craft bakery known for its iconic Country Loaf and warm community tables. It opens on steam rising from blistered mahogany crusts, then moves through the craft story — old-soul bread, special-order cakes, and locations from the Bay Area to LA to Seoul — before closing on nationwide shipping and the invitation to rise each day and warm every table. Made for food lovers who crave real craft over fast bread. Warm, honest, artisanal energy, like morning light through a bakery window.","subject":"fresh artisan bread loaves and bakery","audience":"Food lovers and craft-baking fans in SF, LA, Seoul, and nationwide shippers","tone":"warm, artisanal, inviting, honest","goal":"Make viewers crave Tartine bread and order, visit, or ship a loaf","keyMessages":["Rise each day. Warm every table.","Old-soul bread, modern craft","Iconic Country Loaf with blistered mahogany crust","Bay Area, LA, and Seoul — plus nationwide shipping","Special-order cakes and tarts for your table"],"mustIncludeFacts":["A thoughtful expression of modern craft through good food and warm experiences","Bay Area 4 locations, Los Angeles 7 locations, Seoul 6 locations","Nationwide shipping through Goldbelly","Special order cakes require a seven day lead time","Tartine began with a mission to bring bread with an old-soul into the lives of friends and family in California","In 2010 published TARTINE BREAD sharing the secret to the iconic Tartine Country Loaf","Vogue: each loaf has a shell of blistered mahogany and an interior so chewy and preternaturally moist that it shimmers in the light","Rise each day. Warm every table."],"brandColors":["#261B16","#322928","#4A362D"],"suggestedFramePack":"daybreak-bakehouse","suggestedDuration":30,"musicMood":"warm acoustic morning folk","voProfile":"female, mid-30s, warm and unhurried, soft bakery-counter intimacy"},"script":{"title":"Tartine Warms Every Table","scenes":[{"id":"s1","start":0,"duration":3.5,"purpose":"hook","voiceover":"Steam rising from the crust.","onScreenText":["The Country Loaf"],"visualDirection":"Slow push-in on steam curling from a blistered mahogany loaf in golden morning light.","assetNeeds":[{"type":"image","query":"steam rising fresh sourdough loaf","role":"background"}],"sfx":["impact"],"musicCue":"intro"},{"id":"s2","start":3.5,"duration":4,"purpose":"context","voiceover":"Old-soul bread. Modern California craft.","onScreenText":["Old-soul · Modern craft"],"visualDirection":"Soft camera drift across floured hands shaping dough on a wooden board.","assetNeeds":[{"type":"image","query":"hands shaping dough wooden table","role":"background"}],"sfx":["whoosh"],"musicCue":"build"},{"id":"s3","start":7.5,"duration":4,"purpose":"feature","voiceover":"Blistered mahogany shell. Chewy. It shimmers.","onScreenText":["Blistered mahogany"],"visualDirection":"Slow orbit around the whole loaf, then a cut to the open moist crumb catching light.","assetNeeds":[{"type":"image","query":"artisan sourdough crust closeup","role":"background"},{"type":"image","query":"sliced sourdough open crumb","role":"inset"}],"sfx":["sparkle"],"musicCue":"steady"},{"id":"s4","start":11.5,"duration":3.5,"purpose":"feature","voiceover":"Special-order cakes. Seven days of care.","onScreenText":["Cakes & tarts","7-day lead"],"visualDirection":"Camera tilts up a tall frosted cake as soft light catches sugar crystals.","assetNeeds":[{"type":"image","query":"elegant frosted layer cake bakery","role":"background"}],"sfx":["pop"],"musicCue":"steady"},{"id":"s5","start":15,"duration":4,"purpose":"proof","voiceover":"Bay Area. Los Angeles. And Seoul.","onScreenText":["Bay Area 4","LA 7","Seoul 6"],"visualDirection":"Warm bakery interiors cross-dissolve with soft location markers for three cities.","assetNeeds":[{"type":"image","query":"cozy bakery café interior morning","role":"background"}],"sfx":["transition"],"musicCue":"build"},{"id":"s6","start":19,"duration":3.5,"purpose":"how","voiceover":"Nationwide shipping through Goldbelly.","onScreenText":["Ship nationwide"],"visualDirection":"A carefully packed loaf in a box; camera pulls back as packing paper settles.","assetNeeds":[{"type":"image","query":"bread loaf gift box packaging","role":"background"}],"sfx":["click"],"musicCue":"lift"},{"id":"s7","start":22.5,"duration":3.5,"purpose":"quote","voiceover":"Rise each day. Warm every table.","onScreenText":["Rise each day.","Warm every table."],"visualDirection":"Shared community table in soft morning light; hands pass sliced bread across plates.","assetNeeds":[{"type":"image","query":"friends sharing bread breakfast table","role":"background"}],"sfx":["ding"],"musicCue":"lift"},{"id":"s8","start":26,"duration":4,"purpose":"cta","voiceover":"Order. Visit. Ship a loaf.","onScreenText":["Order · Visit · Ship"],"visualDirection":"Hero Country Loaf settles center over warm wood; Tartine mark and soft glow land beneath.","assetNeeds":[],"sfx":["riser","impact"],"musicCue":"outro"}],"music":{"mood":"warm acoustic morning folk","query":"warm acoustic folk"},"voice":{"style":"female, mid-30s, warm and unhurried, soft bakery-counter intimacy","pace":"calm"}},"script_warnings":[],"website_screenshot":"C:\\internship\\KEYFRAME\\server\\jobs\\6rg33ba5zi\\ingest\\website.png","website_screenshots":["C:\\internship\\KEYFRAME\\server\\jobs\\6rg33ba5zi\\ingest\\website.png","C:\\internship\\KEYFRAME\\server\\jobs\\6rg33ba5zi\\ingest\\website_section2.png","C:\\internship\\KEYFRAME\\server\\jobs\\6rg33ba5zi\\ingest\\website_section3.png"],"website_images":[{"path":"C:\\internship\\KEYFRAME\\server\\jobs\\6rg33ba5zi\\ingest\\site_images\\site_img_0.jpeg","alt":"hero background","width":1580,"height":1053},{"path":"C:\\internship\\KEYFRAME\\server\\jobs\\6rg33ba5zi\\ingest\\site_images\\site_img_1.jpg","alt":"hero background","width":1800,"height":1202},{"path":"C:\\internship\\KE