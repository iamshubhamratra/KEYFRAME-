neId":"s17","archetype":"text","heroScale":0.54},{"sceneId":"s18","archetype":"text","heroScale":0.54},{"sceneId":"s19","archetype":"text","heroScale":0.54},{"sceneId":"s20","archetype":"text","heroScale":0.54},{"sceneId":"s21","archetype":"text","heroScale":0.54},{"sceneId":"s22","archetype":"text","heroScale":0.54},{"sceneId":"s23","archetype":"text","heroScale":0.54},{"sceneId":"s24","archetype":"text","heroScale":0.54},{"sceneId":"s25","archetype":"text","heroScale":0.54},{"sceneId":"s26","archetype":"text","heroScale":0.54},{"sceneId":"s27","archetype":"quote","heroScale":0.54},{"sceneId":"s28","archetype":"text","heroScale":0.54},{"sceneId":"s29","archetype":"text","heroScale":0.54},{"sceneId":"s30","archetype":"cta","heroScale":0.54}],"score":{"compositionQuality":100,"source":"deterministic"}},"captions":[{"start":0,"end":2.3,"text":"Product work is breaking."},{"start":3.5,"end":6.6,"text":"Plan here. Execute elsewhere."},{"start":7.15,"end":11.65,"text":"As feedback drowns in inboxes, priorities drift."},{"start":12.2,"end":16.250045,"text":"When noise wins, momentum dies."},{"start":16.8,"end":19.75,"text":"Modern teams need one system."},{"start":20.8,"end":25.75,"text":"Linear. The product development system for teams and agents."},{"start":26.3,"end":30.950862,"text":"Purpose-built to plan and build with AI agents."},{"start":31.5,"end":34.5,"text":"Make product operations self-driving."},{"start":35.5,"end":40.35,"text":"Turn conversations and customer feedback into actionable issues."},{"start":40.9,"end":45.05,"text":"Routed, labeled, and prioritized automatically."},{"start":45.6,"end":48.75,"text":"Intake and triage that run themselves."},{"start":49.3,"end":53.05,"text":"Then plan what actually matters."},{"start":53.6,"end":57.550000000000004,"text":"Initiatives that align every team."},{"start":58.1,"end":62.2,"text":"Roadmaps that stay honest as reality shifts."},{"start":62.75,"end":66.85,"text":"PRDs linked straight to the work that ships."},{"start":67.4,"end":71.5,"text":"One continuous path from idea to launch."},{"start":72.05,"end":74.64999999999999,"text":"Then agents join the work."},{"start":75.55,"end":80.6,"text":"Shared human and agent workflows, from PRD to PR."},{"start":81.15,"end":85,"text":"Side by side, they move work forward."},{"start":85.55,"end":90.14999999999999,"text":"Review pull requests and agent output in one place."},{"start":90.7,"end":95.10000000000001,"text":"Understand progress clearly at any scale."},{"start":95.65,"end":100,"text":"Linear reduces noise and restores momentum."},{"start":100.55,"end":103.85,"text":"Ship with high velocity and focus."},{"start":104.55,"end":107.6,"text":"Built for product and engineering leaders."},{"start":108.55,"end":112.25,"text":"For teams adopting AI agents now."},{"start":112.8,"end":116.5,"text":"One system from planning to pull request."},{"start":117.3,"end":119.89999999999999,"text":"Speed without chaos."},{"start":121.3,"end":124.8,"text":"The product OS for the AI era."},{"start":132.3,"end":136.60000000000002,"text":"Focus returns. Work finally moves."},{"start":147.3,"end":151,"text":"The product development system for teams and agents."}],"srt_url":"/videos/u4strmnt6y.srt","final_attempt":"main","qa":{"pass":true,"score":9,"issues":[{"atSec":0.6,"severity":"minor","issue":"Typo in the main headline: 'Too manu tools.' instead of 'Too many tools.'","fix":"In scene s1, change the text content of the main headline element from 'Too manu tools.' to 'Too many tools.'"}]},"quality_report":{"verdict":"flagged","flags":["3 text element(s) still below WCAG AA"],"contrast":{"checked":true,"fixed":0,"remaining":3,"passes":0},"identity":{"remapped":0},"layout":{"duplicatesRemoved":3,"collisionsScrimmed":0},"assetFloor":null,"audio":{"lufs":-14,"peak":-0.05,"lra":7.1,"target":-14,"layers":{"voice":30,"sfx":10,"music":true,"ambient":false,"musicEnvelope":false}},"screenshots":{"kept":4,"dropped":0,"problems":[]},"assetQuality":83,"templa