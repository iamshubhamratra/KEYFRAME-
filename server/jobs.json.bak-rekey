source (Iconify — per-set license)","sourceUrl":"https://icon-sets.iconify.design/","source":"iconify","fromCache":false,"clipRelevance":0.023}],"text_review":{"source":"llm","added":10,"llmAdded":5,"minedAdded":5,"scenesWithSubtext":8,"scenesWithBullets":7,"sceneCount":8},"layout_review":{"keptScreenshots":3,"keptPhotos":2,"demoted":0,"heroScale":0.54,"montageMax":6,"prominentTotal":5,"scenes":[{"sceneId":"s1","archetype":"hook","heroScale":0.54},{"sceneId":"s2","archetype":"text","heroScale":0.54},{"sceneId":"s3","archetype":"stat","heroScale":0.54},{"sceneId":"s4","archetype":"text","heroScale":0.54},{"sceneId":"s5","archetype":"text","heroScale":0.54},{"sceneId":"s6","archetype":"stat","heroScale":0.54},{"sceneId":"s7","archetype":"quote","heroScale":0.54},{"sceneId":"s8","archetype":"cta","heroScale":0.54}],"score":{"compositionQuality":100,"source":"deterministic"}},"template_review":{"source":"llm","framePack":"organic-garden","scenes":8,"llmCast":8,"deterministic":0,"unsourcedNumbers":0,"withMedia":3,"assetsUsed":4,"assetPool":7,"types":{"hook":1,"statement":2,"feature":2,"montage":1,"stats":1,"cta":1},"cast":[{"id":"s1","type":"hook","media":0,"why":"Introduces the promise with a strong hook."},{"id":"s2","type":"statement","media":0,"why":"States the core benefit clearly."},{"id":"s3","type":"feature","media":1,"why":"Shows the product in a browser frame."},{"id":"s5","type":"montage","media":2,"why":"Shows the range of plant capacity."},{"id":"s6","type":"stats","media":0,"why":"Uses stats to build social proof."},{"id":"s7","type":"feature","media":1,"why":"Shows expert validation in a browser frame."},{"id":"s4","type":"statement","media":0,"why":"Explains the AI feature with quiet staging."},{"id":"s8","type":"cta","media":0,"why":"Final call to action."}]},"captions":[{"start":0,"end":3.2,"text":"Crave pesticide-free produce year-round?"},{"start":3.75,"end":6.9,"text":"All the benefits of growing, none of the work."},{"start":7.45,"end":12.443061,"text":"Grow veggies, herbs, and flowers indoors with Gardyn."},{"start":12.99,"end":17.240000000000002,"text":"Kelby, your AI gardener, tends water, light, and health."},{"start":17.79,"end":21.39,"text":"Harvest and eat thirty plants right at home."},{"start":21.94,"end":26.990000000000002,"text":"100,000 Gardyners. 6 million plants sold."},{"start":27.54,"end":31.39,"text":"4.8 stars from 900 reviews."},{"start":31.94,"end":36.09,"text":"Save thirty percent pre-tax. Shop Gardyn today."}],"srt_url":"/videos/g3bzdzebt2.srt","final_attempt":"main","qa":{"pass":false,"score":4,"issues":[{"atSec":0.6,"severity":"blocker","issue":"Text contrast failure on 'YEAR-ROUND' in the opening frame; the light grey text blends into the light cream background, making it illegible.","fix":"Change the text color of 'YEAR-ROUND' in the first scene to the dark brown brand color token to ensure high contrast from the start of the animation."},{"atSec":0.6,"severity":"blocker","issue":"The header text 'Gardyn Grows Dinne' is truncated, cutting off the final letter 'r' of 'Dinner'.","fix":"Expand the width of the header text container or apply 'white-space: nowrap' with a slightly smaller font size to prevent truncation."},{"atSec":20.3,"severity":"blocker","issue":"The 2x2 grid layout contains two completely empty cream placeholder cards at the bottom, leaving the frame under-illustrated and incomplete.","fix":"Populate the two bottom cards with harmonized images of fresh produce, or change the layout to a side-by-side 1x2 grid if only two images are available."}]},"quality_report":{"verdict":"flagged","flags":["1 screenshot(s) dropped by QA","QA: 3 blocker(s)"],"contrast":{"checked":true,"fixed":0,"remaining":0,"passes":0},"identity":{"remapped":0},"layout":{"duplicatesRemoved":0,"collisionsScrimmed":0},"assetFloor":null,"audio":{"lufs":-14,"peak":-3.71,"lra":4.7,"target":-14,"layers":{"voice":8,"sfx":6,"music":true,"ambient":false,"musicEnvelope":false}},"screenshots":{"kept":3,"dropped":1,"repinned":1,"problems":["scene-mismatch"]},"assetQuality":84,"templateFit":89,"qa":{"pass":false,"score":4,"skipped":false,"blockers":3}}},{"id":"xtr8f8dxgz","kind":"project","prompt":"","duration":30,"orientation":"vertical","quality":"1080p","width":1080,"height":1920,"fps":30,"frame_pack":"lantern-night","frame_pack_user":1,"status":"done","progress":"finalizing","video_url":"/videos/xtr8f8dxgz.mp4","error":null,"used_fallback":0,"llm_tokens_in":59953,"llm_tokens_out":20491,"created_at":1785215979051,"started_at":1785218258163,"finished_at":1785218646162,"client_ip":"::ffff:127.0.0.32","voice_style":null,"captions_enabled":0,"upload_path":null,"task":null,"requeue_count":0,"intent":{"prompt":"","websiteUrl":"https://obsidian.md","blogUrl":null,"hasReferenceVideo":false,"preferences":{"duration":30,"orientation":"vertical","voiceStyle":"auto","framePack":"lantern-night"},"website":{"url":"https://obsidian.md","title":"Obsidian - Sharpen your thinking","description":"The free and flexible app for your private thoughts.","headings":["Sharpen your thinking.","Spark ideas.","Sync securely.","Publish instantly.","It’s your time to shine."],"bodyText":"Download\nPricing\nSync\nPublish\nEnterprise\nCommunity\nAccount\nSharpen your thinking.\n\nThe free and flexible app for your private thoughts.\n\nGet Obsidian for Windows\nMore platforms\nWriting is telepathy\nEvergreen notes\nGraph of Writing is t...\nClippings\nDaily\nIdeas\nWriting is telepathy\nMeta\nProjects\nReferences\nEvergreen notes\nCalmness is a superpower\nTravel\nCreativity is combinatory u...\nEmergence\nRecipes\nBooks\nHealth\nWhat if it were easy\nTools\nSpecialization is for insects\nFirst principles\nPhilosophy\nA little bit every day\n1,000 true fans\nNotes\nWriting is telepathy\n#evergreen\n\nFrom On Writing\n\nIdeas can travel through time and space\n\nIdeas can travel through time and space without being uttered out loud. The process of telepathy requires two places:\n\nA sending place, a transmission place — where the writer sends ideas, such as a desk\nA receiving place — where the reader receives the ideas/imagery such as a couch, a comfortable chair, in bed\nQuote\nLook, here’s a table covered with red cloth. On it is a cage the size of a small fish aquarium. In the cage is a white rabbit with a pink nose and pink-rimmed eyes. On its back, clearly marked in blue ink, is the numeral 8. The most interesting thing here isn’t even the carrot-munching rabbit in the cage, but the number on its back. I never opened my mouth and you never opened yours. We’re not even in the same year together, let alone the same room... except we are together. We are close. We’re having a meeting of the minds. We’ve engaged in an act of telepathy.\n1 backlink\n206 words\n1139 char\n10:57\nJapan Trip Planning\n#projects\n#travel\nTo-do\nSchedule flights\nAsk for recommendations\n✓\nKeiko\n✓\nAndrew\nGarrett\nResearch ryokans in\nKyoto\nItinerary\n1\nYour thoughts are yours.\nObsidian stores notes privately on your device, so you can access them quickly, even offline. No one else can read them, not even us.\nYour mind is unique.\nWith thousands of plugins and themes, you can shape Obsidian to fit your way of thinking.\nYour knowledge should last.\nObsidian uses open file formats, so you’re never locked in. You own your data for the long term.\nFree without limits.\nDownload now\nSpark ideas.\n\nFrom personal notes to journaling, knowledge bases, and project management, Obsidian gives you the tools to come up with ideas and organize them.\n\nLinks\nCreate connections between your notes. Link anything and everything — ideas, people, places, books, and beyond. Invent your own personal Wikipedia.\n\nIn Meditations on First Philosophy the philosopher René Descartes describes a series of doubts about the nature of reality, arriving at the famous phrase:\n\n[[I thin]]\nI think therefore I am\nJust think about it\nThinking, Fast and Slow\n\nBooks/\nThe Thing\n\nMovies/\n\nHe argues that doubting requires thinking, and therefore, the act of thinking confirms his existence.\n\nGraph\nVisualize the relationships between your notes. Find hidden patterns in your thinking through a visually engaging and interactive graph.\nCanvas\nAn infinite space to research, brainstorm, diagram, and lay out your ideas. Canvas is a limitless playground for your mind. Learn more.\nLecture 1\n\nRationalists\n\nReason and innate knowledge → acquire knowledge\nFundamental truths and principles can be known independent of experience\nA priori reasoning\nReason and deduction\n\nEmpiricists\n\nExperience and sensory perception → acquire knowledge\nAll knowledge is derived from experience and observation of the external world\nA posteriori reasoning\nCogito, ergo sum\n\nIn Meditations on First Philosophy the philosopher René Descartes describes a series of doubts about the nature of reality, arriving at the famous phrase:\n\nI think therefore I am\n\nHe argues that doubting requires thinking, and therefore, the act of thinking confirms his existence.\n\nPhilosophers\nPlugins\nBuild your ideal thinking space. With thousands of plugins and our open API, it’s easy to tailor Obsidian to fit your personal workflow. Learn more.\nCommunity plugins\nCalendar by Liam Cain\nCalendar view of your dail","brandColors":["#8B4CF8","#6931C7","#341D59","#282831"],"ogImage":"https://obsidian.md/images/banner.png","hasRealScreenshots":3},"__ingested":true},"autopilot":1,"render3d":0,"compose_mode":null,"brief":{"improvedPrompt":"A 30-second vertical film for Obsidian, the free and flexible app for private thoughts. It opens on the quiet power of a second brain — notes linking into a living graph — then lands the promise: your thoughts stay on your device, offline, yours alone. Built for writers, researchers, and anyone who thinks in connections. Features bloom in sequence: bi-directional links that invent a personal Wikipedia, an interactive graph that reveals hidden patterns, infinite Canvas, and thousands of plugins that reshape the app to how you think. It closes on ownership and freedom — open formats, never locked in, free without limits — and a calm invitation to download and sharpen your thinking.","subject":"linked notes graph and writing app UI","audience":"Writers, researchers, students, and knowledge workers building a personal second brain","tone":"thoughtful, empowering, calm, intimate","goal":"Make the viewer feel their private thinking space is finally free — and download Obsidian","keyMessages":["The free and flexible app for your private thoughts","Your notes stay on your device — private, offline, yours alone","Link anything into your own personal Wikipedia","See hidden patterns in an interactive graph","Thousands of plugins and themes shape it to how you think","Open formats — you own your data, free without limits"],"mustIncludeFacts":["The free and flexible app for your private thoughts","Stores notes privately on your device, accessible offline","No one else can read them, not even Obsidian","Thousands of plugins and themes","Open file formats so you’re never locked in","Free without limits","Links between notes to invent your own personal Wikipedia","Interactive graph visualizes relationships between notes","Canvas is an infinite space to research, brainstorm, and diagram"],"brandColors":["#8B4CF8","#6931C7","#341D59","#282831"],"suggestedFramePack":"lantern-night","suggestedDuration":30,"musicMood":"warm ambient glow electronica","voProfile":"soft-spoken female, mid-30s, intimate and unhurried, quietly confident"},"script":{"title":"Your Private Second Brain","scenes":[{"id":"s1","start":0,"duration":3,"purpose":"hook","voiceover":"What if notes could think with you?","onScreenText":["A second brain"],"visualDirection":"Scattered note fragments drift in darkness then snap into a glowing web of linked nodes as the camera slowly pushes in.","assetNeeds":[],"sfx":["riser"],"musicCue":"intro"},{"id":"s2","start":3,"duration":4,"purpose":"context","voiceover":"On your device. Offline. Not even Obsidian reads them.","onScreenText":["Private. Offline. Yours."],"visualDirection":"A quiet lamp-lit desk dissolves into a soft shield icon locking over a local vault, camera drifting closer with intimate depth.","assetNeeds":[{"type":"image","query":"person journaling alone soft lamp","role":"background"},{"type":"icon","query":"shield","role":"inset"}],"sfx":["whoosh"],"musicCue":"build"},{"id":"s3","start":7,"duration":4,"purpose":"feature","voiceover":"Obsidian — free and flexible for private thoughts.","onScreenText":["Free and flexible"],"visualDirection":"Hero product reveal: the real Obsidian writing UI floats in a browser frame with a gentle push-in across the note pane.","assetNeeds":[],"sfx":["pop"],"musicCue":"steady"},{"id":"s4","start":11,"duration":3.5,"purpose":"feature","voiceover":"Link anything into your personal Wikipedia.","onScreenText":["Your Wikipedia"],"visualDirection":"Zoom into the real product UI as bi-directional links light up between stacked note cards on layered planes.","assetNeeds":[{"type":"icon","query":"chain link","role":"inset"}],"sfx":["click"],"musicCue":"steady"},{"id":"s5","start":14.5,"duration":3.5,"purpose":"feature","voiceover":"The interactive graph shows hidden patterns.","onScreenText":["See hidden patterns"],"visualDirection":"Camera orbits the real interactive graph UI as clusters of nodes pulse, connect, and reveal unexpected relationships.","assetNeeds":[],"sfx":["sparkle"],"musicCue":"lift"},{"id":"s6","start":18,"duration":4,"purpose":"feature","voiceover":"Canvas — infinite space to research and brainstorm.","onScreenText":["Infinite Canvas"],"visualDirection":"Slow pan across the real Canvas UI as cards, arrows, and diagrams spread outward on an endless plane.","assetNeeds":[{"type":"icon","query":"whiteboard","role":"inset"}],"sfx":["swoosh"],"musicCue":"lift"},{"id":"s7","start":22,"duration":4,"purpose":"proof","voiceover":"Thousands of plugins. Open formats. Free without limits.","onScreenText":["Thousands of plugins","Never locked in"],"visualDirection":"Plugin and theme tiles cascade in parallax past the camera, then settle beside an open folder mark of ownership.","assetNeeds":[{"type":"icon","query":"puzzle piece","role":"inset"},{"type":"icon","query":"folder","role":"inset"}],"sfx":["ding"],"musicCue":"steady"},{"id":"s8","start":26,"duration":4,"purpose":"cta","voiceover":"Download Obsidian. Sharpen how you think.","onScreenText":["Download free","Own your mind"],"visualDirection":"Obsidian logo locks center over a soft purple pulse; a glowing download button settles as the frame breathes out.","assetNeeds":[],"sfx":["riser","impact"],"musicCue":"outro"}],"music":{"mood":"warm ambient glow electronica","query":"warm ambient electronica"},"voice":{"style":"soft-spoken female, mid-30s, intimate and unhurried, quietly confident","pace":"calm"}},"script_warnings":[],"website_screenshot":"C:\\internship\\KEYFRAME\\server\\jobs\\xtr8f8dxgz\\ingest\\website.png","website_screenshots":["C:\\internship\\KEYFRAME\\server\\jobs\\xtr8f8dxgz\\ingest\\website.png","C:\\internship\\KEYFRAME\\server\\jobs\\xtr8f8dxgz\\ingest\\website_section2.png","C:\\internship\\KEYFRAME\\server\\jobs\\xtr8f8dxgz\\ingest\\website_section3.png"],"website_images":[{"path":"C:\\internship\\KEYFRAME\\server\\jobs\\xtr8f8dxgz\\ingest\\site_images\\site_img_0.png","alt":"Example of Obsidian Help site powered by Obsidian Publish","width":2899,"height":1757},{"path":"C:\\internship\\KEYFRAME\\server\\jobs\\xtr8f8dxgz\\ingest\\site_images\\site_img_1.png","alt":"Wikipedia page about David Hume embedded in Obsidian Canvas","width":300,"height":500}],"website_bg":"#0F0F0F","website_dark":true,"website_title":"Obsidian - Sharpen your thinking","website_pages":[{"url":"https://obsidian.md/download","text":"Download"},{"url":"https://obsidian.md/pricing","text":"Pricing"},{"url":"https://obsidian.md/sync","text":"Sync"},{"url":"https://obsidi