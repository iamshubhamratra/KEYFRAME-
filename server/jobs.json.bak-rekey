ative space."},{"atSec":53,"severity":"blocker","issue":"Palette-clashing photo. The photo on the right features raw, unharmonized warm/brown daylight tones that clash with the cool, high-contrast neon green and white design system.","fix":"Apply a cool-toned duotone filter or a semi-transparent gradient map using the design system's green and black tokens over the photo at 53s to integrate it into the palette."},{"atSec":53,"severity":"minor","issue":"The photo inset on the right is very small and reads like a static sticker rather than a premium motion asset.","fix":"Enlarge the photo container by 25% and add a subtle zoom-in scale animation to the image inside the frame."}]}},{"id":"dtp8nhfm29","kind":"project","prompt":"","duration":30,"orientation":"horizontal","quality":"720p","width":1280,"height":720,"fps":30,"frame_pack":"blockframe","status":"done","progress":"finalizing","video_url":null,"error":null,"used_fallback":0,"llm_tokens_in":262291,"llm_tokens_out":87067,"created_at":1783508111326,"started_at":1783508192930,"finished_at":1783510282230,"client_ip":"::1","voice_style":null,"captions_enabled":0,"upload_path":null,"intent":{"prompt":"","websiteUrl":"https://in.bookmyshow.com/","hasReferenceVideo":false,"preferences":{"duration":30,"orientation":"horizontal","voiceStyle":"auto","framePack":"auto"},"website":{"url":"https://in.bookmyshow.com/","title":"Movie Tickets, Plays, Sports, Events & Cinemas nearby - BookMyShow","description":"BookMyShow offers showtimes, movie tickets, reviews, trailers, concert tickets and events near Mumbai . Also features promotional offers, coupons and mobile app.\n","headings":["Recommended Movies","Welcome To The Jungle","Dhamaal 4","Alpha","Minions & Monsters","The Odyssey","The Best Of Live Events"],"bodyText":"Search for Movies, Events, Plays, Sports and Activities\nSelect your region\nSign in\nMovies\nStream\nEvents\nPlays\nSports\nActivities\nListYourShow\nCorporates\nOffers\nGift Cards\nDetect my location\n\nPopular