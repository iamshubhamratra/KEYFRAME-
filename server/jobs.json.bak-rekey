t graphic slightly leftward to create a more cohesive, balanced composition."}]}},{"id":"ot5li78wo3","kind":"generate","prompt":"Launch teaser for KEYFRAME, an AI video studio that turns a prompt into a cinematic product film in minutes.","duration":12,"orientation":"horizontal","quality":"1080p","width":1920,"height":1080,"fps":30,"frame_pack":"neon-premiere","status":"done","progress":"finalizing","video_url":"/videos/ot5li78wo3.mp4","error":null,"used_fallback":0,"llm_tokens_in":15227,"llm_tokens_out":6059,"created_at":1783926860738,"started_at":1783926860782,"finished_at":1783927083840,"client_ip":"::1","voice_style":null,"captions_enabled":0,"upload_path":null,"intent":null,"autopilot":0,"render3d":0,"compose_mode":null,"brief":null,"script":null,"script_warnings":null,"usage":{"byStage":[{"stage":"storyboard","model":"grok-4-5","inputTokens":10088,"outputTokens":5123,"totalTokens":15211,"callCount":1,"costUsd":0.020366},{"stage":"brief","model":"grok-4-5","inputTokens":5139,"outputTokens":936,"totalTokens":6075,"callCount":1,"costUsd":0.006358}],"llm":{"inputTokens":15227,"outputTokens":6059,"callCount":2,"inputCostUsd":0.012182,"outputCostUsd":0.014542,"totalCostUsd":0.026723},"tts":{"inputChars":0,"inputTokensEst":0,"outputTokensEst":0,"callCount":0,"inputCostUsd":0,"outputCostUsd":0,"totalCostUsd":0},"external":{"openrouter_chat":2,"hyperframes_lint":1,"hyperframes_render":1},"totalCostUsd":0.026723},"stage_timings":{"briefMs":8692,"storyboardMs":41401,"compose_renderMs":172957},"final_attempt":"scenekit"},{"id":"adtnzmtmyl","kind":"project","prompt":"Explain our app which is a tech app and it is about translating the human to dog translation","duration":25,"orientation":"horizontal","quality":"720p","width":1280,"height":720,"fps":30,"frame_pack":"terminal-green","status":"script_review","progress":"script_review","video_url":null,"error":null,"used_fallback":0,"llm_tokens_in":0,"llm_tokens_out":0,"created_at":1783926924301,"started_at":1783927084400,"finished_at":null,"client_ip":"::1","voice_style":null,"captions_enabled":0,"upload_path":null,"intent":{"prompt":"Explain our app which is a tech app and it is about translating the human to dog translation","websiteUrl":null,"hasReferenceVideo":false,"preferences":{"duration":25,"orientation":"horizontal","voiceStyle":"auto","framePack":"terminal-green"}},"autopilot":0,"render3d":0,"compose_mode":"standard","brief":{"improvedPrompt":"A 25-second horizontal explainer for a tech app that translates human speech into dog language. It opens on the everyday gap between owner and dog — talking, getting only a head tilt — then reveals the app turning spoken words into something a dog can respond to. Aimed at dog owners who wish they could finally get through. The arc is hook (the communication fail), substance (the translator at work), and a light CTA to try it. Playful, slightly nerdy energy with retro-terminal flair.","subject":"dog owner talking into smartphone beside dog","audience":"Dog owners and pet lovers who want a fun way to communicate with their dogs","tone":"playful, techy, curious, lighthearted","goal":"Make the viewer feel human–dog talk is finally possible — and try the app","keyMessages":["A tech app that translates human to dog","Turn your words into dog language","Bridge the gap between you and your dog","Try the translator"],"mustIncludeFacts":["Tech app for human-to-dog translation"],"brandColors":["#0A120A","#39FF14","#1A2E1A"],"suggestedFramePack":"terminal-green","suggestedDuration":25,"musicMood":"quirky retro synthwave","voProfile":"male, late-20s, wry, playful, lightly nerdy"},"script":{"title":"Translate Human Words Into Dog","scenes":[{"id":"s1","start":0,"duration":3,"purpose":"hook","voiceover":"Your dog just doesn't get it?","onScreenText":["Doesn't get it?"],"visualDirection":"Tight push-in on a dog's puzzled head tilt while an owner gestures wildly just off-frame.","assetNeeds":[{"type":"image","query":"confused dog head tilt closeup","role":"background"}],"sfx":["impact"],"musicCue":"intro"},{"id":"s2","start":3,"duration":3.5,"purpose":"context","voiceover":"You talk. All you get is a tilt.","onScreenText":["Talk. Tilt. Repeat."],"visualDirection":"Camera whip-pans from the owner's mouth mid-sentence to the dog staring blankly in a looping fail.","assetNeeds":[{"type":"image","query":"dog owner talking pet living room","role":"background"}],"sfx":["whoosh"],"musicCue":"build"},{"id":"s3","start":6.5,"duration":4,"purpose":"feature","voiceover":"There's a tech app that translates human to dog.","onScreenText":["Human → Dog"],"visualDirection":"A smartphone rises into center frame; retro green terminal UI flickers on as the camera slow-pushes toward the screen.","assetNeeds":[{"type":"image","query":"hand holding smartphone dog nearby","role":"background"},{"type":"icon","query":"speech bubble","role":"inset"}],"sfx":["pop"],"musicCue":"build"},{"id":"s4","start":10.5,"duration":4,"purpose":"how","voiceover":"Speak into your phone. Words become dog language.","onScreenText":["Speak once","Dog language"],"visualDirection":"Close tracking shot of lips at the mic; green waveforms pulse and morph into playful glyph shapes floating off the phone.","assetNeeds":[{"type":"image","query":"person speaking into smartphone closeup","role":"background"}],"sfx":["click"],"musicCue":"steady"},{"id":"s5","start":14.5,"duration":3.5,"purpose":"proof","voiceover":"Your dog can finally hear you.","onScreenText":["Heard at last"],"visualDirection":"Dog's ears snap forward as floating sound glyphs settle around it; soft orbiting camera.","assetNeeds":[{"type":"image","query":"alert dog ears perked attention","role":"background"}],"sfx":["sparkle"],"musicCue":"lift"},{"id":"s6","start":18,"duration":3.5,"purpose":"proof","voiceover":"Bridge the gap between you and your dog.","onScreenText":["Bridge the gap"],"visualDirection":"Warm two-shot of owner and dog face-to-face with a gentle push-in as they connect under soft ligh