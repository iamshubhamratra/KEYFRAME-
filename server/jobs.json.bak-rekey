nning"],"mustIncludeFacts":[],"brandColors":["#E50914","#111111","#F5F5F7"],"suggestedFramePack":"bold-poster","suggestedDuration":10,"musicMood":"punchy rhythmic drums","voProfile":"male, mid-20s, driving, punchy, motivational"},"script":{"title":"Take Control of Your Day","scenes":[{"id":"s1","start":0,"duration":3,"purpose":"hook","voiceover":"Stop losing your time.","onScreenText":["STOP","LOSING","TIME"],"visualDirection":"Stark black and white poster typography slams onto the screen with high-contrast red accents.","assetNeeds":[],"sfx":["impact"],"musicCue":"intro"},{"id":"s2","start":3,"duration":4,"purpose":"feature","voiceover":"Take control of your day instantly.","onScreenText":["TAKE","CONTROL"],"visualDirection":"A stylized, high-contrast mobile calendar UI snaps into view, tasks checking off in rapid succession.","assetNeeds":[{"type":"icon","query":"checklist","role":"inset"}],"sfx":["pop","click"],"musicCue":"build"},{"id":"s3","start":7,"duration":3,"purpose":"cta","voiceover":"Download now.","onScreenText":["DOWNLOAD NOW"],"visualDirection":"A bold red download button pulses in the center of a striking poster-style layout.","assetNeeds":[],"sfx":["riser","ding"],"musicCue":"outro"}],"music":{"mood":"punchy rhythmic drums","query":"punchy rhythmic drums"},"voice":{"style":"male, mid-20s, driving, punchy, motivational","pace":"brisk"}},"script_warnings":[],"usage":{"byStage":[{"stage":"qa","model":"grok-4-5","inputTokens":21924,"outputTokens":683,"totalTokens":22607,"callCount":3,"costUsd":0.019178},{"stage":"storyboard","model":"grok-4-5","inputTokens":10347,"outputTokens":2536,"totalTokens":12883,"callCount":1,"costUsd":0.014364},{"stage":"vision","model":"grok-4-5","inputTokens":4947,"outputTokens":144,"totalTokens":5091,"callCount":1,"costUsd":0.004303},{"stage":"vo_fit","model":"grok-4-5","inputTokens":55,"outputTokens":3,"totalTokens":58,"callCount":1,"costUsd":0.000051}],"llm":{"inputTokens":37273,"outputTokens":3366,"callCount":6,"inputCostU