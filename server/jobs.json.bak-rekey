ished_at":1783503950086,"client_ip":"::1","voice_style":null,"captions_enabled":0,"upload_path":null,"intent":{"prompt":"make a intro video","websiteUrl":"https://claude.ai/","hasReferenceVideo":false,"preferences":{"duration":20,"orientation":"horizontal","voiceStyle":"auto","framePack":"bauhaus-print"},"website":{"url":"https://claude.ai/","title":"Sign in - Claude","description":"Sign in to Claude, Anthropic's AI assistant for problem solvers.","headings":["Meet Claude","Platform","Solutions","Pricing","Resources","Think fast,build faster","Bring any idea to life with chat, Cowork, Claude Code, and Claude Design.","Explore plans","Free","Pro","Max","Frequently asked questions","What is Claude and how does it work?","What is Claude and how does it work?","What should I use Claude for?","What should I use Claude for?","How much does it cost to use?","How much does it cost to use?","Products","Features","Models","Solutions","Claude Platform","Resources","Company"],"bodyText":"Think fast,\nbuild faster\nBring any idea to life with chat, Cowork, Claude Code, and Claude Design.\n\nNew\nFable 5 is here: a tier above Opus\n\nContinue with Google\n\nOR\n\nContinue with email\nContinue with SSO\nDownload desktop app\nExplore plans\nIndividual\nTeam and Enterprise\nIndividual\nTeam and Enterprise\nFree\n\nTry Claude\n\n$0\nFree for everyone\n\nTry Claude\nChat on web, iOS, Android, and on your desktop\nGenerate code and visualize data\nWrite, edit, and create content\nAnalyze text and images\nAbility to search the web\nCreate files and execute code\nUnlock more from Claude with desktop extensions\nConnect Slack and Google Workspace services\nIntegrate any context or tool through connectors with remote MCP\nExtended thinking for complex work\nPro\n\nFor everyday productivity\n\n$17\nPer month with annual subscription discount ($200 billed up front). $20 if billed monthly.\nTry Claude\n\nNo commitment · Cancel anytime\n\nEverything in Free, plus:\nMore usage*\nClaude Code\nCo