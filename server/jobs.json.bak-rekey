ets.iconify.design/","source":"iconify","fromCache":false,"clipRelevance":0.002}],"text_review":{"source":"llm","added":10,"llmAdded":7,"minedAdded":3,"scenesWithSubtext":8,"scenesWithBullets":7,"sceneCount":8},"layout_review":{"keptScreenshots":1,"keptPhotos":4,"demoted":0,"heroScale":0.6,"montageMax":6,"prominentTotal":5,"scenes":[{"sceneId":"s1","archetype":"hook","heroScale":0.6},{"sceneId":"s2","archetype":"text","heroScale":0.6},{"sceneId":"s3","archetype":"text","heroScale":0.6},{"sceneId":"s4","archetype":"text","heroScale":0.6},{"sceneId":"s5","archetype":"text","heroScale":0.6},{"sceneId":"s6","archetype":"stat","heroScale":0.6},{"sceneId":"s7","archetype":"quote","heroScale":0.6},{"sceneId":"s8","archetype":"cta","heroScale":0.6}],"score":{"compositionQuality":100,"source":"deterministic"}},"template_review":{"source":"llm","framePack":"organic-garden","scenes":8,"llmCast":8,"deterministic":0,"unsourcedNumbers":0,"withMedia":2,"assetsUsed":3,"assetPool":7,"types":{"cover":1,"spread":1,"circlednum":2,"scrapbook":1,"notequote":1,"chapters":1,"signoff":1},"cast":[{"id":"s1","type":"cover","media":0,"why":"Introductory hook with visual context."},{"id":"s2","type":"spread","media":1,"why":"Explains the problem and solution."},{"id":"s4","type":"circlednum","media":0,"why":"Highlights the AI gardener and savings."},{"id":"s5","type":"scrapbook","media":2,"why":"Showcases automated features with images."},{"id":"s7","type":"notequote","media":0,"why":"Social proof via testimonial style."},{"id":"s3","type":"chapters","media":0,"why":"Lists core benefits clearly."},{"id":"s6","type":"circlednum","media":0,"why":"Focuses on the variety and quality."},{"id":"s8","type":"signoff","media":0,"why":"Final call to action."}]},"captions":[{"start":0,"end":2.544014,"text":"Craving fresher food at home?"},{"start":3.09,"end":6.786009,"text":"No space, no time, no green thumb."},{"start":7.34,"end":10.676009,"text":"Gardyn brings a living vertical garden home."},{"start":11.34,"end":14.34,"text":"Meet Kelby, your AI gardener."},{"start":15.34,"end":20.02,"text":"Kelby automatically monitors water, light, and plant health."},{"start":20.57,"end":24.122018,"text":"Fresh, pesticide-free produce year-round."},{"start":24.67,"end":28.198005000000002,"text":"One hundred thousand happy Gardyners love it."},{"start":28.75,"end":33.75,"text":"HSA eligible. Save 30%. Shop Gardyn."}],"srt_url":"/videos/b4pp7svf96.srt","final_attempt":"main","qa":{"pass":true,"issues":[],"error":"403 Key limit exceeded (daily limit). Manage it using https://openrouter.ai/workspaces/default/keys/bc6c462a6ad8c5c19bcb3a91ae6f73d73746f810705d23d8d8947a1d36e8c8b1"},"quality_report":{"verdict":"flagged","flags":["3 screenshot(s) dropped by QA"],"contrast":{"checked":true,"fixed":0,"remaining":0,"passes":0},"identity":{"remapped":0},"layout":{"duplicatesRemoved":0,"collisionsScrimmed":0},"assetFloor":null,"audio":{"lufs":-14.52,"peak":-0.5,"lra":4,"target":-14,"layers":{"voice":8,"sfx":6,"music":true,"ambient":false,"musicEnvelope":false}},"screenshots":{"kept":1,"dropped":3,"repinned":0,"problems":["scene-mismatch","scene-mismatch","scene-mismatch"]},"assetQuality":78,"templateFit":83,"qa":{"pass":true,"score":null,"skipped":false,"blockers":0}}},{"id":"5fk20r3mja","kind":"project","prompt":"","duration":30,"orientation":"vertical","quality":"1080p","width":1080,"height":1920,"fps":30,"frame_pack":"lantern-night","frame_pack_user":1,"status":"failed","progress":"storyboard","video_url":null,"error":"403 Key limit exceeded (daily limit). Manage it using https://openrouter.ai/workspaces/default/keys/bc6c462a6ad8c5c19bcb3a91ae6f73d73746f810705d23d8d8947a1d36e8c8b1","used_fallback":0,"llm_tokens_in":0,"llm_tokens_out":0,"created_at":1784979873947,"started_at":1784982051276,"finished_at":1784982051443,"client_ip":"::ffff:127.0.0.1","voice_style":null,"captions_enabled":0,"upload_path":null,"task":null,"requeue_count":0,"intent":{"prompt":"","websiteUrl":"https://obsidian.md","blogUrl":null,"hasReferenceVideo":false,"preferences":{"duration":30,"orientation":"vertical","voiceStyle":"auto","framePack":"lantern-night"},"website":{"url":"https://obsidian.md","title":"Obsidian - Sharpen your thinking","description":"The free and flexible app for your private thoughts.","headings":["Sharpen your thinking.","Spark ideas.","Sync securely.","Publish instantly.","It’s your time to shine."],"bodyText":"Download\nPricing\nSync\nPublish\nEnterprise\nCommunity\nAccount\nSharpen your thinking.\n\nThe free and flexible app for your private thoughts.\n\nGet Obsidian for Windows\nMore platforms\nWriting is telepathy\nEvergreen notes\nGraph of Writing is t...\nClippings\nDaily\nIdeas\nWriting is telepathy\nMeta\nProjects\nReferences\nEvergreen notes\nCalmness is a superpower\nTravel\nCreativity is combinatory u...\nEmergence\nRecipes\nBooks\nHealth\nWhat if it were easy\nTools\nSpecialization is for insects\nFirst principles\nPhilosophy\nA little bit every day\n1,000 true fans\nNotes\nWriting is telepathy\n#evergreen\n\nFrom On Writing\n\nIdeas can travel through time and space\n\nIdeas can travel through time and space without being uttered out loud. The process of telepathy requires two places:\n\nA sending place, a transmission place — where the writer sends ideas, such as a desk\nA receiving place — where the reader receives the ideas/imagery such as a couch, a comfortable chair, in bed\nQuote\nLook, here’s a table covered with red cloth. On it is a cage the size of a small fish aquarium. In the cage is a white rabbit with a pink nose and pink-rimmed eyes. On its back, clearly marked in blue ink, is the numeral 8. The most interesting thing here isn’t even the carrot-munching rabbit in the cage, but the number on its back. I never opened my mouth and you never opened yours. We’re not even in the same year together, let alone the same room... except we are together. We are close. We’re having a meeting of the minds. We’ve engaged in an act of telepathy.\n1 backlink\n206 words\n1139 char\n5:23\nJapan Trip Planning\n#projects\n#travel\nTo-do\nSchedule flights\nAsk for recommendations\n✓\nKeiko\n✓\nAndrew\nGarrett\nResearch ryokans in\nKyoto\nItinerary\n1\nYour thoughts are yours.\nObsidian stores notes privately on your device, so you can access them quickly, even offline. No one else can read them, not even us.\nYour mind is unique.\nWith thousands of plugins and themes, you can shape Obsidian to fit your way of thinking.\nYour knowledge should last.\nObsidian uses open file formats, so you’re never locked in. You own your data for the long term.\nFree without limits.\nDownload now\nSpark ideas.\n\nFrom personal notes to journaling, knowledge bases, and project management, Obsidian gives you the tools to come up with ideas and organize them.\n\nLinks\nCreate connections between your notes. Link anything and everything — ideas, people, places, books, and beyond. Invent your own personal Wikipedia.\n\nIn Meditations on First Philosophy the philosopher René Descartes describes a series of doubts about the nature of reality, arriving at the famous phrase:\n\n[[I thin]]\nI think therefore I am\nJust think about it\nThinking, Fast and Slow\n\nBooks/\nThe Thing\n\nMovies/\n\nHe argues that doubting requires thinking, and therefore, the act of thinking confirms his existence.\n\nGraph\nVisualize the relationships between your notes. Find hidden patterns in your thinking through a visually engaging and interactive graph.\nCanvas\nAn infinite space to research, brainstorm, diagram, and lay out your ideas. Canvas is a limitless playground for your mind. Learn more.\nLecture 1\n\nRationalists\n\nReason and innate knowledge → acquire knowledge\nFundamental truths and principles can be known independent of experience\nA priori reasoning\nReason and deduction\n\nEmpiricists\n\nExperience and sensory perception → acquire knowledge\nAll knowledge is derived from experience and observation of the external world\nA posteriori reasoning\nCogito, ergo sum\n\nIn Meditations on First Philosophy the philosopher René Descartes describes a series of doubts about the nature of reality, arriving at the famous phrase:\n\nI think therefore I am\n\nHe argues that doubting requires thinking, and therefore, the act of thinking confirms his existence.\n\nPhilosophers\nPlugins\nBuild your ideal thinking space. With thousands of plugins and our open API, it’s easy to tailor Obsidian to fit your personal workflow. Learn more.\nCommunity plugins\nCalendar by Liam Cain\nCalendar view of your daily","brandColors":["#8B4CF8","#6931C7","#341D59","#282831"],"ogImage":"https://obsidian.md/images/banner.png","hasRealScreenshots":3},"__ingested":true},"autopilot":1,"render3d":0,"compose_mode":null,"brief":{"improvedPrompt":"A 30-second vertical film for Obsidian, the free note-taking app for private thoughts. It opens in quiet darkness — a single glowing note — then blooms into a living web of linked ideas, graph connections, and an infinite canvas. Built for writers, researchers, and anyone whose mind outruns a blank page. The arc lands on ownership: notes stay on your device, offline, forever yours, shaped by thousands of plugins. Warm, lantern-lit, and contemplative — it invites the viewer to download and start sharpening their thinking tonight.","subject":"linked digital notes and knowledge graph","audience":"Writers, researchers, students, and knowledge workers who want private, flexible note-taking","tone":"contemplative, warm, elegant, empowering","goal":"Make the viewer feel their mind deserves a private home — and download Obsidian","keyMessages":["The free app for your private thoughts","Notes stay on your device — offline, unread by anyone","Link anything into your personal Wikipedia","Thousands of plugins and themes to fit your mind","Open formats — you own your data forever","Sharpen your thinking"],"mustIncludeFacts":["Free and flexible app for your private thoughts","Stores notes privately on your device, even offline","No one else can read them, not even us","Thousands of plugins and themes","Open file formats so you’re never locked in","Free without limits"],"brandColors":["#8B4CF8","#6931C7","#341D59","#282831"],"suggestedFramePack":"lantern-night","suggestedDuration":30,"musicMood":"warm ambient night glow","voProfile":"soft-spoken female, mid-30s, unhurried, quietly confident"},"script":{"title":"Home for Your Private Thoughts","scenes":[{"id":"s1","start":0,"duration":3,"purpose":"hook","voiceover":"Your thoughts deserve a private home.","onScreenText":["A private home"],"visualDirection":"Quiet darkness holds a single glowing note that pulses like a lantern as the camera slowly pushes in.","assetNeeds":[],"sfx":["riser"],"musicCue":"intro"},{"id":"s2","start":3,"duration":3.5,"purpose":"context","voiceover":"Scattered notes. Lost ideas. Blank pages.","onScreenText":["Scattered. Lost."],"visualDirection":"Camera pans across a dimly lit desk where loose papers and notebooks drift softly into shadow.","assetNeeds":[{"type":"image","query":"cluttered desk night lamp papers","role":"background"}],"sfx":["whoosh"],"musicCue":"build"},{"id":"s3","start":6.5,"duration":3.5,"purpose":"feature","voiceover":"Obsidian. Free without limits for private thoughts.","onScreenText":["Free without limits"],"visualDirection":"Slow push-in on the real product UI in a browser frame, a clean glowing note editor against deep purple.","assetNeeds":[],"sfx":["pop"],"musicCue":"steady"},{"id":"s4","start":10,"duration":3.5,"purpose":"feature","voiceover":"Link anything into your personal Wikipedia.","onScreenText":["Your personal Wikipedia"],"visualDirection":"Camera orbits the real product graph view as glowing lines bloom and connect notes into a living web.","assetNeeds":[{"type":"icon","query":"nodes","role":"inset"}],"sfx":["swoosh"],"musicCue":"steady"},{"id":"s5","start":13.5,"duration":3.5,"purpose":"proof","voiceover":"On your device. Offline. Not even us.","onScreenText":["Private. Offline.","Not even us"],"visualDirection":"A soft shield seals the canvas; the UI dims to local glow as the camera pulls back to a quiet device.","assetNeeds":[{"type":"icon","query":"shield","role":"inset"},{"type":"image","query":"laptop desk soft lamp night","role":"background"}],"sfx":["click"],"musicCue":"build"},{"id":"s6","start":17,"duration":3.5,"purpose":"feature","voiceover":"Thousands of plugins and themes fit your mind.","onScreenText":["Thousands of plugins"],"visualDirection":"Colorful theme cards and plugin tiles parallax past the hero canvas in layered depth, settling gently.","assetNeeds":[{"type":"icon","query":"puzzle piece","role":"inset"}],"sfx":["sparkle"],"musicCue":"lift"},{"id":"s7","start":20.5,"duration":3.5,"purpose":"proof","voiceover":"Open formats. You own your data forever.","onScreenText":["You own your data"],"visualDirection":"Open file cards float free from the canvas while the camera pans across an infinite dark workspace of linked notes.","assetNeeds":[{"type":"icon","query":"folder","role":"inset"}],"sfx":["ding"],"musicCue":"lift"},{"id":"s8","start":24,"duration":3,"purpose":"proof","voiceover":"Sharpen your thinking.","onScreenText":["Sharpen your thinking"],"visualDirection":"The knowledge graph crystallizes into sharp luminous nodes, energy concentrating toward center with a gentle lift.","assetNeeds":[],"sfx":["whoosh"],"musicCue":"lift"},{"id":"s9","start":27,"duration":3,"purpose":"cta","voiceover":"Download free. Start tonight.","onScreenText":["Download free","Start tonight"],"visualDirection":"Obsidian logo settles center over warm lantern glow as a soft download button pulses invitingly.","assetNeeds":[],"sfx":["riser","impact"],"musicCue":"outro"}],"music":{"mood":"warm ambient night glow","query":"warm ambient night"},"voice":{"style":"soft-spoken female, mid-30s, unhurried, quietly confident","pace":"calm"}},"script_warnings":[],"website_screenshot":"C:\\internship\\KEYFRAME\\server\\jobs\\5fk20r3mja\\ingest\\website.png","website_screenshots":["C:\\internship\\KEYFRAME\\server\\jobs\\5fk20r3mja\\ingest\\website.png","C:\\internship\\KEYFRAME\\server\\jobs\\5fk20r3mja\\ingest\\website_section2.png","C:\\internship\\KEYFRAME\\server\\jobs\\5fk20r3mja\\ingest\\website_section3.png"],"website_images":[{"path":"C:\\internship\\KEYFRAME\\server\\jobs\\5fk20r3mja\\ingest\\site_images\\site_img_0.png","alt":"Example of Obsidian Help site powered by Obsidian Publish","width":2899,"height":1757},{"path":"C:\\internship\\KEYFRAME\\server\\jobs\\5fk20r3mja\\ingest\\site_images\\site_img_1.png","alt":"Wikipedia page about David Hume embedded in Obsidian Canvas","width":300,"height":500}],"website_bg":"#0F0F0F","website_dark":true,"website_title":"Obsidian - Sharpen your thinking","website_pages":[{"url":"https://obsidian.md/download","text":"Download"},{"url":"https://obsidian.md/pricing","text":"Pricing"},{"url":"https://obsidian.md/sync","text":"Sync"},{"url":"https://obsidian.md/publish","text":"Publish"},{"url":"https://obsidian.md/enterprise","text":"Enterprise"},{"url":"https://obsidian.md/ar","text":"العربية"},{"url":"https://obsidian.md/bn","text":"বাংলা"},{"url":"https://obsidian.md/de","text":"Deutsch"},{"url":"https://obsidian.md/es","text":"Español"},{"url":"https://obsidian.md/fr","text":"Français"},{"url":"https://obsidian.md/it","text":"Italiano"},{"url":"https://obsidian.md/ja","text":"日本語"},{"url":"https://obsidian.md/ko","text":"한국어"},{"url":"https://obsidian.md/pl","text":"Polski"},{"url":"https://obsidian.md/pt-BR","text":"Português (Brasil)"},{"url":"https://obsidian.md/ro","text":"Română"},{"url":"https://obsidian.md/ru","text":"Русский"},{"url":"https://obsidian.md/sv","text":"Svenska"},{"url":"https://obsidian.md/zh","text":"简体中文"},{"url":"https://obsidian.md/account","text":"Account"},{"url":"https://obsidian.md/clipper","text":"Web Clipper"},{"url":"https://obsidian.md/help","text":"Help"},{"url":"https://obsidian.md/about","text":"About"},{"url":"https://obsidian.md/blog","text":"Blog"},{"url":"https://obsidian.md/changelog","text":"Changelog"},{"url":"https://obsidian.md/roadmap","text":"Roadmap"},{"url":"https://obsidian.md/security","text":"Security"},{"url":"https://obsidian.md/softwear","text":"Merch store"},{"url":"https://obsidian.md/privacy","text":"Privacy"},{"url":"https://obsidian.md/canvas","text":"Canvas An infinite space to research, brainstorm, diagram, a"},{"url":"https://obsidian.md/mobile","text":"Mobile"},{"url":"https://obsidian.md/cli","text":"CLI"},{"url":"https://obsidian.md/license","text":"License overview"},{"url":"https://obsidian.md/terms","text":"Terms of service"},{"url":"https://obsidian.md/brand","text":"Brand guidelines"}],"website_auth_wall":false,"usage":{"byStage":[],"llm":{"inputTokens":0,"outputTokens":0,"callCount":0,"inputCostUsd":0,"outputCostUsd":0,"totalCostUsd":0},"tts":{"inputChars":0,"inputTokensEst":0,"outputTokensEst":0,"callCount":0,"inputCostUsd":0,"outputCostUsd":0,"totalCostUsd":0},"external":{},"totalCostUsd":0},"stage_timings":{"ingestMs":32594,"briefMs":28649,"scriptMs":165024},"audio_notes":["Voiceover used the free fallback voice (paid TTS providers were unavailable) — the narration may sound different from your usual voice."]},{"id":"66zl5gr1cq","kind":"project","prompt":"","duration":30,"orientation":"vertical","quality":"1080p","width":1080,"height":1920,"fps":30,"frame_pack":"hype-wave","frame_pack_user":1,"status":"failed","progress":"storyboard","video_url":null,"error":"403 Key limit exceeded (daily limit). Manage it using https://openrouter.ai/workspaces/default/keys/bc6c462a6ad8c5c19bcb3a91ae6f73d73746f810705d23d8d8947a1d36e8c8b1","used_fallback":0,"llm_tokens_in":0,"llm_tokens_out":0,"created_at":1784979873957,"started_at":1784982051478,"finished_at":1784982051550,"client_ip":"::ffff:127.0.0.1","voice_style":null,"captions_enabled":0,"upload_path":null,"task":null,"requeue_count":0,"intent":{"prompt":"","websiteUrl":"https://gumroad.com","blogUrl":null,"hasReferenceVideo":false,"preferences":{"duration":30,"orientation":"vertical","voiceStyle":"auto","framePack":"hype-wave"},"website":{"url":"https://gumroad.com","title":"Earn your first dollar online with Gumroad","description":"Start selling what you know, see what sticks, and get paid. Simple and effective.","headings":["Go from 0 to $1","We want you to try them, lots of them, and find out what works.","$1,992,651","Max Ulichney","Steph Smith","trendsvc","Daniel Vassallo","Unlimited possibilities","Don't take risks. That's scary!","Place small bets. That's exciting!","Share your work. Someone out there needs it."],"bodyText":"9.4K\nDiscover\nBlog\nPricing\nFeatures\nAbout\nGumclaw\nLog in\nStart selling\nGo from 0 to $1\nAnyone can earn their first dollar online. Just start with what you know, see what sticks, and get paid. It's that easy.\nStart selling\nSearch marketplace\n\nContribute or fork on \nGitHub\n\nSell anything\n\nVideo lessons. Monthly subscriptions. Whatever! Gumroad was created to help you experiment with all kinds of ideas and formats.\n\nMake your own road\n\nWhether you need more balance, flexibility, or just a different gig, we make it easy to chart a new path.\n\nSell to anyone\n\nGo from 0 to $1 and automated workflows.\n\nLet your customers pay in their own currency.\n\nChoose between one-time, recurring, or fixed-length payments in your currency of choice.\n\nSell anywhere\n\nCreate and customize your storefront with our all-in-one platform or choose to use your personal site instead. Seamlessly connect your Gumroad account to thousands of apps in your current stack.\n\nInstead of building a company...\n\n...start selling a side project!\n\nYou know all those great ideas you have?\nThe Gumroad Way\nStart Small\nGet Better Together\nLearn Quickly\nWe want you to try them, lots of them, and find out what works.\n\nYou don't have to be a tech expert or even understand how to start a business. You just gotta take what you know and sell it.\n\nFind out how\n$1,992,651\nThe amount of income earned by Gumroad digital entrepreneurs last week.\n\nI launched MaxPacks as an experimental side gig; but within 2 years those Procreate brushes were earning more than my 6-figure salary in CG. Leaving in favor of Gumroad enabled me to explore other aspects of my art, develop new hobbies, and finally prioritize my personal life.\n\nMax Ulichney\n\nSells Procreate brush packs\n\nFor years, I had a goal to develop 'passive' income streams, but struggled to make that a reality. Last year, I started selling informational products on Gumroad and since then have made $10k+ per month building products that I love.\n\nSteph Smith\n\nSells content tutorials\n\nOriginally, I took pre-orders for my Trend Reports on Gumroad. But I received... exactly $0. So I changed tactics: I made half of my report free, and the other half paid. Today, 99% of Trends.VC revenue is recurring in the form of annual and quarterly subscriptions.\n\ntrendsvc\n\nSells business insights and expertise\n\nI love Gumroad because it can't be any simpler. I upload a file, set a price, and I can start selling on the internet. The money I make from my sales lands directly in my bank account every Friday.\n\nDaniel Vassallo\n\nSells business insights and expertise\n\nUnlimited possibilities\n\nDiscover the best-selling products and creators on Gumroad\n\nblender\nmeditation\ncomic\nnotion template\ntextures\nprocreate\n3d model\nhypnosis\nmanga\ninvesting\nmockup\nbrushes\nspark ar\nsubliminal messages\nanime\ninstagram\nfont\nblender\nmeditation\ncomic\nnotion template\ntextures\nprocreate\n3d model\nhypnosis\nmanga\ninvesting\nmockup\nbrushes\nspark ar\nsubliminal messages\nanime\ninstagram\nfont\nart\nafter effects\neducation\nfitness\nsci-fi\nvrchat\nableton\ncertification exams\nvj loops\nworkout program\npoetry\navatar\nsample pack\nlearning\nluts\nyoga\nfiction\nassets\nsheet music\nart\nafter effects\neducation\nfitness\nsci-fi\nvrchat\nableton\ncertification exams\nvj loops\nworkout program\npoetry\navatar\nsample pack\nlearning\nluts\nyoga\nfiction\nassets\nsheet music\nreference photos\ncoloring page\nsingles\nprogramming\nkdp interior\nstock photos\nprintable\njazz\nwindows\nebook\nphotobash\nproductivity\ninstrumental music\ntheme\nlow content books\nreference photos\ncoloring page\nsingles\nprogramming\nkdp interior\nstock photos\nprintable\njazz\nwindows\nebook\nphotobash\nproductivity\ninstrumental music\ntheme\nlow content books\nDon't take risks.\nThat's scary!\n\nInstead of selling a book...\n\n...start by selling a blog post!\n\nPlace small bets.\nThat's exciting!\nShare your work.\nSomeone out there needs it.\nStart selling\nSubscribe to get tips and tactics to grow the way you want.\n→\nⒸ Gumroad, Inc.\nDiscover\nBlog\nPricing\nFeatures\nAbout\nGumclaw\nSmall Bets\nH","brandColors":["#ED89D8","#FD90E9","#E5B1D8","#965488"],"ogImage":"https://assets.gumroad.com/images/opengraph_image.png","hasRealScreenshots":1},"__ingested":true},"autopilot":1,"render3d":0,"compose_mode":null,"brief":{"improvedPrompt":"A 30-second vertical promo for Gumroad, the platform that helps anyone earn their first dollar online. It opens on the fear of big risks, then flips the script: place small bets, sell what you already know, and get paid. Quick hits of creator wins and the weekly payout total land the proof. Built for side-project dreamers and indie makers who want simplicity over building a company. Loud, playful, and thumb-stopping — it closes with a direct invite to start selling.","subject":"creators selling digital products online","audience":"Aspiring creators, freelancers, and side-hustlers who want to monetize what they know","tone":"bold, playful, encouraging, high-energy","goal":"Make the viewer feel starting is easy — and tap Start selling on Gumroad","keyMessages":["Go from 0 to $1","Anyone can earn their first dollar online","Place small bets — that's exciting","Sell what you know and get paid","Instead of building a company, start a side project","Share your work — someone needs it"],"mustIncludeFacts":["Go from 0 to $1","$1,992,651 earned by Gumroad digital entrepreneurs last week","Anyone can earn their first dollar online","Sell video lessons, monthly subscriptions, and more","Steph Smith made $10k+ per month selling informational products","Max Ulichney's Procreate brush packs out-earned a 6-figure salary"],"brandColors":["#ED89D8","#FD90E9","#E5B1D8","#965488"],"suggestedFramePack":"hype-wave","suggestedDuration":30,"musicMood":"bright punchy indie-pop","voProfile":"female, mid-20s, upbeat and cheeky, rapid-fire confidence"},"script":{"title":"Earn Your First Dollar Online","scenes":[{"id":"s1","start":0,"duration":3,"purpose":"hook","voiceover":"Scared of the big risk?","onScreenText":["Big risk?"],"visualDirection":"Bold type slams into frame through a burst of pink confetti as the camera rushes forward.","assetNeeds":[],"sfx":["impact"],"musicCue":"intro"},{"id":"s2","start":3,"duration":3.5,"purpose":"context","voiceover":"Building a company feels impossible.","onScreenText":["Skip the company"],"visualDirection":"A towering stack of folders topples sideways while the camera tilts and pulls back.","assetNeeds":[{"type":"icon","query":"office building","role":"inset"}],"sfx":["whoosh"],"musicCue":"build"},{"id":"s3","start":6.5,"duration":3.5,"purpose":"how","voiceover":"Place small bets. That's exciting.","onScreenText":["Small bets","Side project"],"visualDirection":"Tiny glowing coins bounce into a simple jar across layered pastel planes with playful parallax.","assetNeeds":[{"type":"icon","query":"coin","role":"inset"}],"sfx":["pop"],"musicCue":"build"},{"id":"s4","start":10,"duration":4,"purpose":"feature","voiceover":"Sell what you know and get paid.","onScreenText":["Sell what you know"],"visualDirection":"The real Gumroad product UI slides into a browser frame; camera slow-pushes across product cards.","assetNeeds":[],"sfx":["swoosh"],"musicCue":"steady"},{"id":"s5","start":14,"duration":3.5,"purpose":"feature","voiceover":"Video lessons, monthly subscriptions, more.","onScreenText":["Lessons","Subscriptions"],"visualDirection":"Camera zooms into the real Gumroad create screen as lesson and subscription options light up.","assetNeeds":[{"type":"icon","query":"play button","role":"inset"},{"type":"icon","query":"calendar","role":"inset"}],"sfx":["click"],"musicCue":"steady"},{"id":"s6","start":17.5,"duration":3.5,"purpose":"proof","voiceover":"Nearly two million earned last week.","onScreenText":["$1,992,651","Last week"],"visualDirection":"A giant dollar counter races upward and locks on the total with a sparkle burst.","assetNeeds":[],"sfx":["ding","sparkle"],"musicCue":"lift"},{"id":"s7","start":21,"duration":4.5,"purpose":"proof","voiceover":"Steph Smith: ten K plus monthly. Max out-earned six figures.","onScreenText":["Steph Smith $10k+/mo","Max's Procreate packs"],"visualDirection":"Name cards and rising earnings bars slide past on staggered depth planes with soft parallax.","assetNeeds":[{"type":"image","query":"confident woman laptop home desk","role":"background"},{"type":"image","query":"hand drawing tablet stylus closeup","role":"inset"}],"sfx":["pop"],"musicCue":"lift"},{"id":"s8","start":25.5,"duration":4.5,"purpose":"cta","voiceover":"Anyone can earn their first dollar. Start selling.","onScreenText":["0 to $1","Start selling"],"visualDirection":"Gumroad logo locks center over a soft pink pulse; a glowing Start Selling button rises into frame.","assetNeeds":[],"sfx":["riser","impact"],"musicCue":"outro"}],"music":{"mood":"bright punchy indie-pop","query":"bright punchy indie pop"},"voice":{"style":"female, mid-20s, upbeat and cheeky, rapid-fire confidence","pace":"brisk"}},"script_warnings":[],"website_screenshot":"C:\\internship\\KEYFRAME\\server\\jobs\\66zl5gr1cq\\ingest\\website.png","website_screenshots":["C:\\internship\\KEYFRAME\\server\\jobs\\66zl5gr1cq\\ingest\\website.png"],"web