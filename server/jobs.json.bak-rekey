g","note":"Scored against the selected frame pack (KEYFRAME's templates are frame packs).","averageScore":79},"qualityScore":77,"category":"marketing","creativeDirectorNotes":["Rejected 3 weak/off-topic asset(s); prioritized quality over quantity.","Approved 6 asset(s); 4 cleared for prominent placement."]},"assets":[{"path":"assets/images/page_0_flights-page.png","type":"image","sceneId":"s7","startSec":21.5,"durationSec":3.5,"style":"inset","alt":"REAL website screenshot of Online Shopping Site for Mobiles, Electronics, Furniture, Grocery, Lifestyle, Books & More. Best Offers! — the flights page (matches this scene's topic) — present in a styled browser frame with hero treatment","license":"owner content","sourceUrl":"https://www.flipkart.com/flights-travel-uhp-at-store","source":"website","fromCache":false,"clipRelevance":0.971,"cdScore":80,"sees":"Flipkart flight booking interface with Sale is Live banner","cdProminence":"support","sectionType":"features","visionOk":true,"kind":"shot","fit":"cover","focus":"top","effect":"rise","quality":"high","cropFocus":"top center","container":"browser"},{"path":"assets/images/site_1.png","type":"image","sceneId":"s2","startSec":7,"durationSec":3.5,"style":"inset","alt":"REAL website screenshot of Online Shopping Site for Mobiles, Electronics, Furniture, Grocery, Lifestyle, Books & More. Best Offers! (page section 2) — present in a styled browser frame with hero treatment","license":"owner content","sourceUrl":"https://www.flipkart.com/","source":"website","fromCache":false,"clipRelevance":0.976,"cdScore":85,"sees":"Flipkart app interface showing flight bookings and fashion deals","cdProminence":"hero","sectionType":"features","visionOk":true,"kind":"shot","fit":"cover","focus":"top","effect":"rise","quality":"high","cropFocus":"top center","container":"browser"},{"path":"assets/images/0.jpg","type":"image","sceneId":"s1","startSec":0,"durationSec":3,"style":"background","alt":"rapid poster cuts mobiles","width":853,"height"