ts/images/2.png","type":"image","sceneId":"s4","startSec":13.5,"durationSec":5.5,"style":"inset","alt":"rocket launching","license":"curated-library","sourceUrl":null,"source":"library:vector-illustrations","fromCache":true},{"path":"assets/images/3.png","type":"image","sceneId":"s5","startSec":19,"durationSec":5,"style":"background","alt":"glowing neural network","license":"curated-library","sourceUrl":null,"source":"library:assetcollection","fromCache":true},{"path":"assets/images/4.jpg","type":"image","sceneId":"s5.5","startSec":24,"durationSec":3,"style":"background","alt":"clean full shot lumen","license":"curated-library","sourceUrl":null,"source":"library:revenue","fromCache":true},{"path":"assets/images/5.png","type":"image","sceneId":"s6","startSec":27,"durationSec":3,"style":"inset","alt":"app store logo","license":"curated-library","sourceUrl":null,"source":"library:vetors","fromCache":true},{"path":"assets/images/6.jpg","type":"image","sceneId":"s6","startSec":27,"durationSec":3,"style":"inset","alt":"google play logo","license":"curated-library","sourceUrl":null,"source":"library:vetors","fromCache":true}],"captions":[{"start":0,"end":2.7,"text":"Tired of scattered notes and missed ideas?"},{"start":4.5,"end":8.45,"text":"Introducing Lumen: your intelligent AI note-taking companion."},{"start":8.5,"end":10.8,"text":"Experience seamless organization and"},{"start":10.8,"end":13.100000000000001,"text":"intelligent insights, automatically."},{"start":13.5,"end":15.444615384615384,"text":"Lumen's powerful features unlock"},{"start":15.444615384615384,"end":17.45,"text":"your true productivity potential."},{"start":19,"end":22.7,"text":"It's more than notes; it's your AI-powered thinking partner."},{"start":27,"end":30,"text":"Download Lumen, transform your notes."}],"srt_url":"/videos/tkpxhkd9uf.srt","final_attempt":"fallback","qa":{"pass":true,"issues":[],"skipped":true}},{"id":"nxmg979tlp","kind":"project","prompt":"i want a product launch video for my coffee brand named Lala coffee","duration":30,"orientation":"horizontal","quality":"720p","width":1280,"height":720,"fps":30,"frame_pack":"blockframe","status":"done","progress":"finalizing","video_url":null,"error":null,"used_fallback":1,"llm_tokens_in":17086,"llm_tokens_out":3299,"created_at":1781679861573,"started_at":1781679991992,"finished_at":1781680221150,"client_ip":"::1","voice_style":null,"captions_enabled":1,"upload_path":null,"intent":{"prompt":"i want a product launch video for my coffee brand named Lala coffee","websiteUrl":null,"hasReferenceVideo":false,"preferences":{"duration":30,"orientation":"horizontal","voiceStyle":"auto","framePack":"auto"}},"autopilot":0,"brief":{"improvedPrompt":"Create a product launch video for Lala Coffee, a new coffee brand. The video should introduce the brand and its core offerings, highlighting what makes Lala Coffee a unique and desirable choice for coffee lovers. The goal is to generate excitement and encourage immediate trial or purchase.","audience":"Coffee enthusiasts, consumers looking for premium or new coffee experiences.","tone":"Excited, premium, inviting","goal":"Generate excitement and encourage purchase of Lala Coffee.","keyMessages":["Introducing Lala Coffee: Your new favorite brew.","Experience the unique taste and quality of Lala Coffee.","Lala Coffee is here to elevate your daily coffee ritual."],"mustIncludeFacts":["Brand name: Lala Coffee"],"brandColors":["#FFD700","#A0522D","#FFFFFF"],"suggestedFramePack":"blockframe","suggestedDuration":30,"musicMood":"Uplifting, energetic, modern","voProfile":"Warm, friendly, enthusiastic, clear"},"script":{"title":"Introducing Lala Coffee: Your New Favorite Brew","scenes":[{"id":"s1","start":0,"duration":4,"purpose":"hook","voiceover":"Tired of the same old coffee?","onScreenText":["Lala Coffee is Here."],"visualDirection":"An energetic opening shot with animated brand elements and a hint of coffee beans, setting an exciting tone.","assetNeeds":[{"type":"icon","query":"coffee bean","role":"inset"}],"sfx":["impact"],"musicCue":"intro"},{"id":"s2","start":4,"duration":5,"purpose":"context","voiceover":"Introducing Lala Coffee, your new favorite brew, crafted for moments that matter.","onScreenText":["Lala Coffee"],"visualDirection":"A smooth transition to showcase the Lala Coffee logo and brand aesthetic, perhaps with subtle animations using brand colors.","assetNeeds":[{"type":"image","query":"Lala Coffee packaging","role":"background"}],"sfx":["whoosh"],"musicCue":"build"},{"id":"s3","start":9,"duration":6,"purpose":"feature","voiceover":"Experience the unique taste and rich quality that will awaken your senses.","onScreenText":["Unique Taste","Rich Quality"],"visualDirection":"Visually appealing shots of coffee being brewed and poured, highlighting the texture and aroma, with close-ups on rich coffee colors.","assetNeeds":[{"type":"video","query":"coffee pouring into mug slow motion","role":"background"},{"type":"icon","query":"aroma steam","role":"inset"}],"sfx":["swoosh"],"musicCue":"steady"},{"id":"s4","start":15,"duration":5,"purpose":"feature","voiceover":"From bold espressos to smooth lattes, there's a perfect cup for every coffee lover.","onScreenText":["Espresso","Latte"],"visualDirection":"Showcasing a variety of coffee drinks made with Lala Coffee, in stylish settings, emphasizing variety and premium presentation.","assetNeeds":[{"type":"image","query":"variety of coffee drinks","role":"background"},{"type":"icon","query":"coffee cup","role":"inset"}],"sfx":["pop"],"musicCue":"steady"},{"id":"s5","start":20,"duration":5,"purpose":"proof","voiceover":"Lala Coffee is here to elevate your daily coffee ritual.","onScreenText":["Elevate Your Ritual"],"visualDirection":"Scenes of people enjoying Lala Coffee in different daily scenarios – morning routines, work breaks, relaxed moments, showing satisfaction.","assetNeeds":[{"type":"image","query":"person enjoying coffee morning","role":"background"},{"type":"image","query"