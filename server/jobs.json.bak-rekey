.com/fr","text":"Français (France)"},{"url":"https://www.notion.com/it","text":"Italiano"},{"url":"https://www.notion.com/nl","text":"Nederlands"},{"url":"https://www.notion.com/nb","text":"Norsk"},{"url":"https://www.notion.com/pt","text":"Português (Brasil)"},{"url":"https://www.notion.com/fi","text":"Suomi"},{"url":"https://www.notion.com/sv","text":"Svenska"},{"url":"https://www.notion.com/vi","text":"Tiếng Việt"},{"url":"https://www.notion.com/he","text":"עברית"},{"url":"https://www.notion.com/ar","text":"العربية"},{"url":"https://www.notion.com/th","text":"ภาษาไทย"},{"url":"https://www.notion.com/ko","text":"한국어"},{"url":"https://www.notion.com/ja","text":"日本語"}],"website_auth_wall":false,"usage":{"byStage":[],"llm":{"inputTokens":0,"outputTokens":0,"callCount":0,"inputCostUsd":0,"outputCostUsd":0,"totalCostUsd":0},"tts":{"inputChars":0,"inputTokensEst":0,"outputTokensEst":0,"callCount":0,"inputCostUsd":0,"outputCostUsd":0,"totalCostUsd":0},"external":{},"totalCostUsd":0},"stage_timings":{"ingestMs":32608,"briefMs":19529,"scriptMs":27556}},{"id":"35yl332mbj","kind":"project","prompt":"","duration":30,"orientation":"vertical","quality":"1080p","width":1080,"height":1920,"fps":30,"frame_pack":"daybreak-bakehouse","frame_pack_user":1,"status":"done","progress":"finalizing","video_url":"/videos/35yl332mbj.mp4","error":null,"used_fallback":0,"llm_tokens_in":60627,"llm_tokens_out":21182,"created_at":1785215978278,"started_at":1785217344149,"finished_at":1785217778935,"client_ip":"::ffff:127.0.0.30","voice_style":null,"captions_enabled":0,"upload_path":null,"task":null,"requeue_count":0,"intent":{"prompt":"","websiteUrl":"https://tartinebakery.com","blogUrl":null,"hasReferenceVideo":false,"preferences":{"duration":30,"orientation":"vertical","voiceStyle":"auto","framePack":"daybreak-bakehouse"},"website":{"url":"https://tartinebakery.com","title":"Tartine Bakery","description":"Tartine is a thoughtful expression of modern craft through good food and warm experiences. We are a product of our communities and our friends.","headings":["Welcome to Tartine","Tartine Happenings","SPECIAL ORDER CAKES","PRE ORDER CAKES & TARTS","Gift Cards","Tartine: Inside Stories, Chapter 3: Stewardship","WHO WE ARE","A thoughtful expression of modern craft.","Tartine at home"],"bodyText":"Skip to Main Content\n\nCRAVING PIZZA?\n\nCLICK HERE TO MAKE A DINNER RESERVATION @ TARTINE MANUFACTORY\nLOCATIONSABOUT US\nNATIONAL SHIPPING\nORDER\nWelcome to Tartine\n\na thoughtful expression of modern craft through good food and warm experiences.\n\nBay Area\n\n4 locations →\n\nLos Angeles\n\n7 locations →\n\nSeoul\n\n6 locations →\nTartine Happenings\nSlide 1 of 3\n\nRise Each Day. Warm Every Table. Join Tartine\n\nJOIN TARTINE\n\nCraving Tartine but you don't live in SF or LA? We're thrilled to offer nationwide shipping through Goldbelly.\n\nORDER NATIONWIDE\nSPECIAL ORDER CAKES\n\nHave a special event coming up? We can help with that.\n\nPlease note that special order cakes require a seven day lead time.\nCLICK HERE TO ORDER YOUR SPECIAL ORDER CAKE - PICK-UP FROM TARTINE BAKERY @ 600 GUERRERO ST.\nPRE ORDER CAKES & TARTS\n\nClick the link below to pre-order a cake or tart.\n\nCLICK HERE TO PRE-ORDER CAKES & TARTS- PICK-UP FROM TARTINE BAKERY @ 600 GUERRERO ST.\nGift Cards\n\nYou can now buy a Tartine gift card online. You can send as a gift or treat yourself! Tartine gift cards can be redeemed at Tartine Bakery in SF, Tartine Manufactory, Tartine Inner Sunset as well as our 5 LA locations.\n\nBUY GIFT CARD\nTartine: Inside Stories, Chapter 3: Stewardship\n\nThe final exploration in the series. Watch Chapter 3 below:\n\nWHO WE ARE\nA thoughtful expression of modern craft.\n\nTartine began with a mission: bring bread with an old-soul into the lives of our friends and family in California.\n\nLEARN ABOUT US\n\n\"Fresh out of the oven, each loaf has a shell of blistered mahogany and an interior so chewy and preternaturally moist that it shimmers in the light\"\n\nVogue\nSlide 1 of 6\n\nBREAD BOOK Available for Pre-order\n\nTartine: A Classic Revisited on Amazon\n\nTartine All Day on Amazon\n\nTartine Bread\n\nTartine\n\nTartine Book No 3\n\nTartine at home\n\nIn 2010 we published TARTINE BREAD. The baking community was in shock that we would share our secret to the iconic Tartine Country Loaf. For us, the magic is in the endless thought and experimentation that goes into making each loaf; learning to push the boundaries of what we do, so more people can enjoy it.\n\nLocations\n\nNational Shipping\n\nAbout Us\n\nJoin Tartine\n\nPress\n\ninfo@tartinebakery.com\n\ninfo@tartinemanufactory.com\n\npress@tartinebakery.com\n\nFacebook\n\n / \n\nInstagram\n\nRise each day.\nWarm every table.\n\n2021 Tartine\n\nAll rights reserved\n\nPrivacy Policy\n\nSite Map\n\nTerms of Service\n\nCLOSE\n\nLocations\n\nAbout\n\nOrder\n\nJoin Tartine\n\nPress\n\nCLOSE\nCHANGE LOCATION\nEACH\nDAY\nMADE\nEACH\nDAY","brandColors":["#261B16","#322928","#32231A","#4A362D"],"ogImage":"assets/tartine-share.jpg","hasRealScreenshots":3},"__ingested":true},"autopilot":1,"render3d":0,"compose_mode":null,"brief":{"improvedPrompt":"A 30-second vertical brand film for Tartine Bakery, the craft bakery that began by bringing old-soul bread to friends and family in California. It opens on steam rising from a blistered mahogany country loaf, then moves through warm tables, special-order cakes, and the quiet ritual of daily baking. For people who care how bread is made and how a table feels. Closes on the invitation to rise each day and warm every table — visit a location or order nationwide. Cozy, artisanal, golden-hour energy.","subject":"blistered country loaf bread","audience":"Craft-food lovers and bakery fans in SF, LA, Seoul, and nationwide shippers","tone":"warm, artisanal, thoughtful, inviting","goal":"Make the viewer crave Tartine bread and want to visit or order","keyMessages":["Rise each day. Warm every table.","A thoughtful expression of modern craft through good food","Old-soul bread, born in California","Bay Area, Los Angeles, and Seoul locations","Order nationwide through Goldbelly"],"mustIncludeFacts":["A thoughtful expression of modern craft through good food and warm experiences","Tartine began with a mission: bring bread with an old-soul into the lives of friends and family in California","Bay Area 4 locations, Los Angeles 7 locations, Seoul 6 locations","Nationwide shipping through Goldbelly","Special order cakes require a seven day lead time","In 2010 we published TARTINE BREAD and shared the secret to the iconic Tartine Country Loaf","Rise each day. Warm every table."],"brandColors":["#261B16","#322928","#32231A","#4A362D"],"suggestedFramePack":"daybreak-bakehouse","suggestedDuration":30,"musicMood":"warm acoustic morning folk","voProfile":"female, mid-30s, soft and grounded, unhurried bakery-morning warmth"},"script":{"title":"Tartine Warms Every Table","scenes":[{"id":"s1","start":0,"duration":3.5,"purpose":"hook","voiceover":"Steam rises from old-soul bread.","onScreenText":["Old-soul bread"],"visualDirection":"Extreme close-up of a blistered mahogany country loaf as steam curls upward and the camera slowly pushes in.","assetNeeds":[{"type":"image","query":"blistered sourdough loaf steam closeup","role":"background"}],"sfx":["riser"],"musicCue":"intro"},{"id":"s2","start":3.5,"duration":3.5,"purpose":"context","voiceover":"Born in California for friends and family.","onScreenText":["Born in California"],"visualDirection":"Flour-dusted hands gently shape dough on a wooden board as warm morning light drifts across the frame.","assetNeeds":[{"type":"image","query":"hands shaping bread dough bakery","role":"background"}],"sfx":["whoosh"],"musicCue":"build"},{"id":"s3","start":7,"duration":3.5,"purpose":"feature","voiceover":"Thoughtful craft. Good food. Warm tables.","onScreenText":["Modern craft","Warm experiences"],"visualDirection":"Camera glides along a golden-hour communal table set with sliced bread, butter, and coffee in soft focus.","assetNeeds":[{"type":"image","query":"communal table bread coffee morning","role":"background"}],"sfx":[],"musicCue":"steady"},{"id":"s4","start":10.5,"duration":4,"purpose":"how","voiceover":"The quiet ritual of daily baking.","onScreenText":["Daily baking"],"visualDirection":"An oven door swings open and a peel draws golden loaves toward camera in a slow tracking motion.","assetNeeds":[{"type":"image","query":"baker pulling loaves from oven","role":"background"}],"sfx":["swoosh"],"musicCue":"steady"},{"id":"s5","start":14.5,"duration":3.5,"purpose":"proof","voiceover":"In twenty-ten, we shared the secret.","onScreenText":["TARTINE BREAD","2010"],"visualDirection":"An open cookbook rests beside the iconic country loaf as pages turn and the camera eases downward.","assetNeeds":[{"type":"image","query":"open bread cookbook kitchen table","role":"background"},{"type":"icon","query":"book","role":"inset"}],"sfx":["sparkle"],"musicCue":"lift"},{"id":"s6","start":18,"duration":4,"purpose":"proof","voiceover":"Bay Area, Los Angeles, and Seoul.","onScreenText":["4 Bay Area","7 Los Angeles","6 Seoul"],"visualDirection":"Three location cards cascade forward over a soft bakery storefront morning, numbers landing with weight.","assetNeeds":[{"type":"image","query":"cozy bakery storefront morning exterior","role":"background"},{"type":"icon","query":"map pin","role":"inset"}],"sfx":["ding","pop"],"musicCue":"lift"},{"id":"s7","start":22,"duration":4,"purpose":"how","voiceover":"Nationwide on Goldbelly. Cakes need seven days.","onScreenText":["Order nationwide","7-day cake orders"],"visualDirection":"A finished loaf settles into packing paper while a special-order cake rotates slowly on a stand in warm side light.","assetNeeds":[{"type":"image","query":"artisan cake bakery display stand","role":"background"}],"sfx":["click"],"musicCue":"build"},{"id":"s8","start":26,"duration":4,"purpose":"cta","voiceover":"Rise each day. Warm every table.",