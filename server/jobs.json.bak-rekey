alCostUsd":0.023932},"tts":{"inputChars":0,"inputTokensEst":0,"outputTokensEst":0,"callCount":0,"inputCostUsd":0,"outputCostUsd":0,"totalCostUsd":0},"external":{"openrouter_chat":2},"totalCostUsd":0.023932},"stage_timings":{"ingestMs":24050,"briefMs":21196,"scriptMs":96667},"last_requeue_at":1784976905951},{"id":"bpuotxlp1b","kind":"project","prompt":"","duration":30,"orientation":"vertical","quality":"1080p","width":1080,"height":1920,"fps":30,"frame_pack":"poster-pop","frame_pack_user":1,"status":"failed","progress":null,"video_url":null,"error":"server restarted while job was in-flight","used_fallback":0,"llm_tokens_in":0,"llm_tokens_out":0,"created_at":1784974410079,"started_at":null,"finished_at":1784976906171,"client_ip":"::1","voice_style":null,"captions_enabled":0,"upload_path":null,"task":null,"requeue_count":2,"intent":{"prompt":"","websiteUrl":"https://mailchimp.com","blogUrl":null,"hasReferenceVideo":false,"preferences":{"duration":30,"orientation":"vertical","voiceStyle":"auto","framePack":"poster-pop"},"website":{"url":"https://mailchimp.com","title":"Email & SMS Marketing Platform | Mailchimp","description":"Utilize real-time user behavior data and artificial intelligence to convert more customers. Easy to use, get started for free!","headings":["Industries and Solutions","Integrations","Most Popular","Most Popular","Resources","Account","Main Menu","Industries and Solutions","Integrations","Most Popular","Resources","Account","Email & SMS marketing minus the learning curve","Recommended for your business","Design with ease","Get more sales","Reach your audience on any device","Connect all your apps","Make Mailchimp work for you","Businesses like yours are thriving with Mailchimp","Try our Standard plan for 50% off!","Standard","The ultimate expert-assisted platform for growth at scale","Phone & Priority Support","Phone & Priority Support"],"bodyText":"___\nSkip to main content\n\nSave 50% for 12 months - limited time offer. Get started today.\n\nIndustries and Solutions\nIntegrations\nResources\nSwitch to Mailchimp\nSales: +1 (855) 446-0578\nPricing\nLog In\nMain Menu\nEmail & SMS marketing minus the learning curve\n\nDrive revenue with intuitive marketing analytics, automations, and AI tools.\n\nSign Up\nMailchimp has a four and half star rating\n\n*Based on 33,000+ reviews across\n\nRecommended for your business\nCustomize my experience\nDesign with ease\n\nCreate emails like a pro with easy-to-use tools and high-quality templates for every purpose.\n\n300+ templates for different seasons and industries\nIntuitive drag-and-drop builder\nUse AI-powered content creation tools to craft on-brand headlines and designs in seconds\nSee our content creation tools\nDesign with ease\nGet more sales\n\nSend effective, personalized messages that turn shoppers into buyers.\n\nAlways-on marketing automations\nPowerful e-commerce integrations\nSave up to 42% by switching from Klaviyo to Mailchimp*\nLearn about Mailchimp for e-commerce\nGet more sales\nReach your audience on any device\n\nBoost results by reaching your audience with the right message on the right device.\n\nSeamless integration and fast registration\nOn-brand, AI-powered content tips\nMailchimp users saw up to a 97% click rate when they used both Email and SMS\nSee SMS marketing\nReach your audience on any device\nConnect all your apps\n\nMailchimp seamlessly connects to the apps, platforms, and stores you depend on.\n\nUnify your data in one place—automatically\nShopify, WooCommerce, Wix, and more\nE-commerce customers saw up to 30x ROI when they connected their stores to Mailchimp*\nSee 300+ integrations\nConnect all your apps\nSee pricing\nMake Mailchimp work for you\n\nGot a second to answer a couple questions? We can personalize your visit with the info that matters most to you and your business.\n\nWhat's your industry?\nSelect\nWhat are the top 4 things you want to achieve?\nSelect up to 4\nGet more sales\nSave time with automation\nAttract more customers\nOptimize your marketing\nSend SMS campaigns\nManage customer relationships\nDesign better emails\nConnect your store and other apps\nGet 24/7 support\nSwitch from another tool\nNo thank you\nCustomize my experience\nBusinesses like yours are thriving with Mailchimp\nView all case studies\nRequest demo\nSign Up\nTry our Standard plan for 50% off!\n\nSpend less to grow more with 50% off for 12 months, even if you change to our Premium or Essentials plans. Cancel or downgrade to our basic Free plan at any time.\n\nGenerative AI features\n\nActionable insights into audience growth and conversion funnels\n\nEnhanced automations\n\nCustom-coded email templates\n\nCustomizable Popup forms\n\nPersonalized onboarding\n\nSee all plans\n₹ INR\n$ USD\nStandard\n\nSend up to 6,000 emails each month.\n\nContacts\n0-500\n501-1,500\n1,501-2,500\n2,501-5,000\n5,001-10,000\n10,001-15,000\n15,001-20,000\n20,001-25,000\n25,001-30,000\n30,001-40,000\n40,001-50,000\n50,001-75,000\n75,001-100,000\n100,001-130,000\n130,001-150,000\n150,001-200,000\n200,001-250,000\n250,001-500,000\n500,001-1,000,000\n1,000,000+\n\nSave 50%\n\n₹\n575\n/mo for 12 months\n\n₹575 per month for 12 months\n\nThen, starts at ₹1,150/month†\nper month†\n\nBuy Now\n\n†See Offer Terms. Overages apply if contact or email send limit is exceeded. Learn More\ntooltip\n\nOne marketing platform to unite 300+ apps\n\nMailchimp integrates with hundreds of tools to help you save time and get more done.\n\nView all integrations\nQuickBooks Online\nSync real-time data between QuickBooks and Mailchimp\nCanva\nCreate custom designs in Canva and seamlessly share them\nSalesforce\nEasy to set up bi-directional sync with Salesforce\nStripe\nSync Stripe customer and order data\nSquarespace\nConnect commerce and website data to Mailchimp\nWooCommerce\nAccess powerful marketing features\nQuickBooks Online\nSync real-time data between QuickBooks and Mailchimp\nCanva\nCreate custom designs in Canva and seamlessly share them\nSalesforce\nEasy to set up bi-directional sync with Salesforce\nStripe\nSync","brandColors":["#524734","#281B0E","#353027","#312719"],"ogImage":"https://mailchimp.com/ctf/images/yzco4xsimv0y/1SB1jCYU95Dh5YDdrucTh0/add18363e44ff00d54254592c7c0860c/Intuit_Mailchimp_-_Wordmark_2023_-_Recirculation_.png","hasRealScreenshots":3},"__ingested":true},"autopilot":1,"render3d":0,"compose_mode":null,"brief":{"improvedPrompt":"A 30-second vertical promo for Mailchimp, the email and SMS marketing platform that removes the learning curve for growing businesses. It opens on the overwhelm of DIY marketing, then snaps into Mailchimp’s drag-and-drop builder, AI content tools, and always-on automations that turn shoppers into buyers. Built for small-business owners and e-commerce sellers who want revenue without complexity. Closes hard on connected-store ROI and a limited-time 50% off Standard — bold type, solid color blocks, impossible to scroll past.","subject":"email templates and phone SMS screens","audience":"Small-business owners and e-commerce sellers who need simple email and SMS marketing","tone":"bold, punchy, confident, high-energy","goal":"Feel marketing just got easy — and sign up for Mailchimp now","keyMessages":["Email & SMS marketing minus the learning curve","Drive revenue with AI, automations, and analytics","E-commerce stores saw up to 30x ROI","300+ templates and drag-and-drop builder","Connect 300+ apps including Shopify and WooCommerce","Try Standard for 50% off — 12 months"],"mustIncludeFacts":["Email & SMS marketing minus the learning curve","E-commerce customers saw up to 30x ROI when they connected their stores to Mailchimp","Mailchimp users saw up to a 97% click rate when they used both Email and SMS","Save up to 42% by switching from Klaviyo to Mailchimp","300+ templates","300+ integrations","50% off Standard plan for 12 months","Four and half star rating based on 33,000+ reviews","AI-powered content creation tools","Intuitive drag-and-drop builder"],"brandColors":["#524734","#281B0E","#353027","#312719"],"suggestedFramePack":"poster-pop","suggestedDuration":30,"musicMood":"bold punchy brass-pop","voProfile":"female, late-20s, bold and rapid-fire, confident"},"script":{"title":"Mailchimp Makes Marketing Easy","scenes":[{"id":"s1","start":0,"duration":3,"purpose":"hook","voiceover":"DIY marketing got you stuck?","onScreenText":["DIY overwhelm"],"visualDirection":"Chaotic sticky notes, overflowing inboxes and phone alerts crash into frame from every angle then freeze mid-air.","assetNeeds":[],"sfx":["impact"],"musicCue":"intro"},{"id":"s2","start":3,"duration":3.5,"purpose":"context","voiceover":"The learning curve is eating your growth.","onScreenText":["Steep learning curve"],"visualDirection":"Slow push-in on a frustrated small-business owner at a cluttered desk as flat charts and tool icons spin and collapse around her.","assetNeeds":[{"type":"image","query":"frustrated woman laptop home office","role":"background"}],"sfx":["whoosh"],"musicCue":"build"},{"id":"s3","start":6.5,"duration":4,"purpose":"feature","voiceover":"Mailchimp. Email and SMS minus the learning curve.","onScreenText":["Minus the learning curve"],"visualDirection":"Bold Mailchimp logo slams center then the real product dashboard UI glides into a clean browser frame with a confident push-in.","assetNeeds":[],"sfx":["swoosh","pop"],"musicCue":"build"},{"id":"s4","start":10.5,"duration":3.5,"purpose":"feature","voiceover":"Three hundred plus templates. Drag and drop.","onScreenText":["300+ templates","Drag-and-drop builder"],"visualDirection":"Camera pans across the real drag-and-drop builder as colorful email template cards cascade and snap into place on layered planes.","assetNeeds":[],"sfx":["click"],"musicCue":"steady"},{"id":"s5","start":14,"duration":4,"purpose":"feature","voiceover":"AI content tools. Automations that convert.","onScreenText":["AI-powered content","300+ apps"],"visualDirection":"Sparkles erupt over live AI-generated copy while autom