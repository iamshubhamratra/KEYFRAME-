/tartinebakery.com","source":"website-image","fromCache":false,"clipRelevance":0.998,"cdScore":96,"sees":"Woven proofing baskets in a warm, atmospheric bakery workshop","cdProminence":"hero","visionOk":true,"kind":"photo","fit":"cover","focus":"center","effect":"zoom","quality":"high","cropFocus":"center center"},{"path":"assets/images/9.svg","type":"image","sceneId":"s2","startSec":3,"durationSec":3.5,"style":"background","alt":"camera drifts past flour","width":128,"height":128,"license":"Open source (Iconify — per-set license)","sourceUrl":"https://icon-sets.iconify.design/","source":"iconify","fromCache":false,"clipRelevance":0.022},{"path":"assets/images/11.svg","type":"image","sceneId":"s4","startSec":11,"durationSec":4,"style":"background","alt":"gentle pan friends breaking","width":128,"height":128,"license":"Open source (Iconify — per-set license)","sourceUrl":"https://icon-sets.iconify.design/","source":"iconify","fromCache":false,"clipRelevance":0.115},{"path":"assets/images/topup_0.jpg","type":"image","sceneId":"s3","startSec":6.5,"durationSec":4.5,"style":"background","alt":"country loaf","width":1280,"height":853,"license":"Pixabay Content License","sourceUrl":"https://pixabay.com/photos/bread-loaf-loaves-grain-fresh-2944170/","source":"cache:pixabay","cdScore":86,"sees":"Rustic flour-dusted sourdough bread loaves stacked closely","cdProminence":"hero","visionOk":true,"kind":"photo","fit":"cover","focus":"center","effect":"zoom","quality":"high","cropFocus":"center center"}],"text_review":{"source":"llm","added":8,"llmAdded":5,"minedAdded":3,"scenesWithSubtext":8,"scenesWithBullets":6,"sceneCount":8},"layout_review":{"keptScreenshots":4,"keptPhotos":2,"demoted":0,"heroScale":0.54,"montageMax":6,"prominentTotal":6,"scenes":[{"sceneId":"s1","archetype":"hook","heroScale":0.54},{"sceneId":"s2","archetype":"text","heroScale":0.54},{"sceneId":"s3","archetype":"text","heroScale":0.54},{"sceneId":"s4","archetype":"text","heroScale":0.54},{"sceneId":"s5","archetype":"stat","heroScale":0.54},{"sceneId":"s6","archetype":"text","heroScale":0.54},{"sceneId":"s7","archetype":"quote","heroScale":0.54},{"sceneId":"s8","archetype":"cta","heroScale":0.54}],"score":{"compositionQuality":100,"source":"deterministic"}},"captions":[{"start":0,"end":2.35,"text":"Steam rises at dawn."},{"start":3,"end":6.7,"text":"Tartine started with bread for friends and family."},{"start":7.25,"end":11.7,"text":"Blistered mahogany crust. An interior that shimmers."},{"start":12.25,"end":15.75,"text":"A thoughtful craft, shared at the table."},{"start":16.3,"end":20.950862,"text":"Four in Bay Area, seven in LA, six in Seoul."},{"start":21.5,"end":26.5,"text":"Special cakes take seven days. Ship nationwide on Goldbelly."},{"start":27.05,"end":31.35,"text":"Rise each day and warm every table."},{"start":31.9,"end":35.5,"text":"Visit, order, or ship Tartine home."}],"srt_url":"/videos/ezugc7igdq.srt","final_attempt":"main","qa":{"pass":false,"score":4,"issues":[{"atSec":10.3,"severity":"blocker","issue":"The taped image card overlaps the 'Baked on stone hearth' text card, and its frosted edge blurs the text, causing a readability failure.","fix":"Move the taped image card further to the right or down, or increase the layout gap so it does not collide with the text card."},{"atSec":24.8,"severity":"blocker","issue":"The taped arrow card overlaps the 'Nationwide shipping via Goldbelly' card, blurring the text 'Goldbelly' and making it unreadable.","fix":"Reposition the taped arrow card to the right or down to eliminate the overlap with the text card."},{"atSec":29.6,"severity":"blocker","issue":"The taped card on the right displays a laundry wash-tub icon, which is completely off-topic for a bakehouse brand.","fix":"Replace the laundry care icon with a relevant bakery-themed vector illustration, such as a wheat stalk or bread loaf."}]},"quality_report":{"verdict":"flagged","flags":["QA: 3 blocker(s)"],"contrast":{"checked":true,"fixed":2,"remaining":0,"passes":0},"identity":{"remapped":0},"layout":{"duplicatesRemoved":0,"collisionsScrimmed":1},"assetFloor":null,"audio":{"lufs":-14,"peak":-3.66,"lra":3.8,"target":-14,"layers":{"voice":8,"sfx":6,"music":true,"ambient":false,"musicEnvelope":false}},"screenshots":{"kept":4,"dropped":0,"repinned":0,"problems":[]},"assetQuality":87,"templateFit":87,"qa":{"pass":false,"score":4,"skipped":false,"blockers":3}}},{"id":"ldh4opel9y","kind":"project","prompt":"","duration":30,"orientation":"horizontal","quality":"1080p","width":1920,"height":1080,"fps":30,"frame_pack":"organic-garden","frame_pack_user":1,"status":"failed","progress":"ingest","video_url":null,"error":"ingest produced no usable signal (prompt empty, website/blog/video ingest all failed)","used_fallback":0,"llm_tokens_in":0,"llm_tokens_out":0,"created_at":1784958832376,"started_at":1784959041751,"finished_at":1784959056829,"client_ip":"::1","voice_style":null,"captions_enabled":0,"upload_path":null,"task":null,"requeue_count":0,"intent":{"prompt":"","websiteUrl":"https://www.gardyn.com","blogUrl":null,"hasReferenceVideo":false,"preferences":{"duration":30,"orientation":"horizontal","voiceStyle":"auto","framePack":"organic-garden"}},"autopilot":1,"render3d":0,"compose_mode":null,"brief":null,"script":null,"script_warnings":null,"usage":{"byStage":[],"llm":{"inputTokens":0,"outputTokens":0,"callCount":0,"inputCostUsd":0,"outputCostUsd":0,"totalCostUsd":0},"tts":{"inputChars":0,"inputTokensEst":0,"outputTokensEst":0,"callCount":0,"inputCostUsd":0,"outputCostUsd":0,"totalCostUsd":0},"external":{},"totalCostUsd":0},"stage_timings":{"ingestMs":15077}},{"id":"3y64so399y","kind":"project","prompt":"","duration":30,"orientation":"horizontal","quality":"1080p","width":1920,"height":1080,"fps":30,"frame_pack":"lantern-night","frame_pack_user":1,"status":"done","progress":"finalizing","video_url":"/videos/3y64so399y.mp4","error":null,"used_fallback":0,"llm_tokens_in":67057,"llm_tokens_out":29004,"created_at":1784958832383,"started_at":1784959718955,"finished_at":1784960072579,"client_ip":"::1","voice_style":null,"captions_enabled":0,"upload_path":null,"task":null,"requeue_count":0,"intent":{"prompt":"","websiteUrl":"https://obsidian.md","blogUrl":null,"hasReferenceVideo":false,"preferences":{"duration":30,"orientation":"horizontal","voiceStyle":"auto","framePack":"lantern-night"},"website":{"url":"https://obsidian.md","title":"Obsidian - Sharpen your thinking","description":"The free and flexible app for your private thoughts.","headings":["Sharpen your thinking.","Spark ideas.","Sync securely.","Publish instantly.","It’s your time to shine."],"bodyText":"Download\nPricing\nSync\nPublish\nEnterprise\nCommunity\nAccount\nSharpen your thinking.\n\nThe free and flexible app for your private thoughts.\n\nGet Obsidian for Windows\nMore platforms\nWriting is telepathy\nEvergreen notes\nGraph of Writing is t...\nClippings\nDaily\nIdeas\nWriting is telepathy\nMeta\nProjects\nReferences\nEvergreen notes\nCalmness is a superpower\nTravel\nCreativity is combinatory u...\nEmergence\nRecipes\nBooks\nHealth\nWhat if it were easy\nTools\nSpecialization is for insects\nFirst principles\nPhilosophy\nA little bit every day\n1,000 true fans\nNotes\nWriting is telepathy\n#evergreen\n\nFrom On Writing\n\nIdeas can travel through time and space\n\nIdeas can travel through time and space without being uttered out loud. The process of telepathy requires two places:\n\nA sending place, a transmission place — where the writer sends ideas, such as a desk\nA receiving place — where the reader receives the ideas/imagery such as a couch, a comfortable chair, in bed\nQuote\nLook, here’s a table covered with red cloth. On it is a cage the size of a small fish aquarium. In the cage is a white rabbit with a pink nose and pink-rimmed eyes. On its back, clearly marked in blue ink, is the numeral 8. The most interesting thing here isn’t even the carrot-munching rabbit in the cage, but the number on its back. I never opened my mouth and you never opened yours. We’re not even in the same year together, let alone the same room... except we are together. We are close. We’re having a meeting of the minds. We’ve engaged in an act of telepathy.\n1 backlink\n206 words\n1139 char\n11:27\nJapan Trip Planning\n#projects\n#travel\nTo-do\nSchedule flights\nAsk for recommendations\n✓\nKeiko\n✓\nAndrew\nGarrett\nResearch ryokans in\nKyoto\nItinerary\n1\nYour thoughts are yours.\nObsidian stores notes privately on your device, so you can access them quickly, even offline. No one else can read them, not even us.\nYour mind is unique.\nWith thousands of plugins and themes, you can shape Obsidian to fit your way of thinking.\nYour knowledge should last.\nObsidian uses open file formats, so you’re never locked in. You own your data for the long term.\nFree without limits.\nDownload now\nSpark ideas.\n\nFrom personal notes to journaling, knowledge bases, and project management, Obsidian gives you the tools to come up with ideas and organize them.\n\nLinks\nCreate connections between your notes. Link anything and everything — ideas, people, places, books, and beyond. Invent your own personal Wikipedia.\n\nIn Meditations on First Philosophy the philosopher René Descartes describes a series of doubts about the nature of reality, arriving at the famous phrase:\n\n[[I thin]]\nI think therefore I am\nJust think about it\nThinking, Fast and Slow\n\nBooks/\nThe Thing\n\nMovies/\n\nHe argues that doubting requires thinking, and therefore, the act of thinking confirms his existence.\n\nGraph\nVisualize the relationships between your notes. Find hidden patterns in your thinking through a visually engaging and interactive graph.\nCanvas\nAn infinite space to research, brainstorm, diagram, and lay out your ideas. Canvas is a limitless playground for your mind. Learn more.\nLecture 1\n\nRationalists\n\nReason and innate knowledge → acquire knowledge\nFundamental truths and principles can be known independent of experience\nA priori reasoning\nReason and deduction\n\nEmpiricists\n\nExperience and sensory perception → acquire knowledge\nAll knowledge is derived from experience and observation of the external world\nA posteriori reasoning\nCogito, ergo sum\n\nIn Meditations on First Philosophy the philosopher René Descartes describes a series of doubts about the nature of reality, arriving at the famous phrase:\n\nI think therefore I am\n\nHe argues that doubting requires thinking, and therefore, the act of thinking confirms his existence.\n\nPhilosophers\nPlugins\nBuild your ideal thinking space. With thousands of plugins and our open API, it’s easy to tailor Obsidian to fit your personal workflow. Learn more.\nCommunity plugins\nCalendar by Liam Cain\nCalendar view of your dail","brandColors":["#8B4CF8","#6931C7","#341D59","#282831"],"ogImage":"https://obsidian.md/images/banner.png","hasRealScreenshots":3},"__ingested":true},"autopilot":1,"render3d":0,"compose_mode":null,"brief":{"improvedPrompt":"A 30-second horizontal film for Obsidian, the free and flexible note-taking app for private thoughts. It opens on the quiet power of a single idea — a glowing note on a dark desk — then expands into a living web of linked notes, graphs, and canvases that show how personal knowledge compounds. Built for writers, researchers, and deep thinkers who refuse to rent their minds to the cloud. It lands on ownership and freedom: notes stay on your device, open formats last forever, and thousands of plugins shape the tool to you. Warm, nocturnal, and quietly confident — like a lantern festival for the mind.","subject":"linked notes and knowledge graph UI","audience":"Writers, researchers, and knowledge workers who want private, local-first note-taking","tone":"thoughtful, warm, premium, contemplative","goal":"Make the viewer feel their thinking deserves a private home — and download Obsidian","keyMessages":["Sharpen your thinking","Your thoughts stay private on your device","Free without limits","Link notes into your own Wikipedia","Thousands of plugins shape it to you","Open formats — you own your data forever"],"mustIncludeFacts":["The free and flexible app for your private thoughts","Obsidian stores notes privately on your device, accessible offline","No one else can read them, not even Obsidian","Thousands of plugins and themes","Open file formats so you’re never locked in","Free without limits","Links create connections between notes","Interactive graph visualizes note relationships","Canvas is an infinite space to research and brainstorm"],"brandColors":["#8B4CF8","#6931C7","#341D59","#282831"],"suggestedFramePack":"lantern-night","suggestedDuration":30,"musicMood":"warm nocturnal ambient","voProfile":"female, mid-30s, calm and luminous, unhurried"},"script":{"title":"Obsidian Home for Private Thoughts","scenes":[{"id":"s1","start":0,"duration":3,"purpose":"hook","voiceover":"Ideas deserve a private home.","onScreenText":["One idea."],"visualDirection":"A single glowing note appears on a dark wooden desk as the camera slowly pushes in with warm lantern light.","assetNeeds":[{"type":"image","query":"notebook open dark desk lamp","role":"background"}],"sfx":["impact"],"musicCue":"intro"},{"id":"s2","start":3,"duration":4,"purpose":"how","voiceover":"Link notes into your own Wikipedia.","onScreenText":["Your Wikipedia"],"visualDirection":"Camera pulls back as notes multiply and glowing lines connect them inside the real Obsidian UI.","assetNeeds":[{"type":"icon","query":"link","role":"inset"}],"sfx":["whoosh"],"musicCue":"build"},{"id":"s3","start":7,"duration":3.5,"purpose":"context","voiceover":"Private on your device. Not even Obsidian.","onScreenText":["Yours alone"],"visualDirection":"A soft shield settles over the app window while the camera gently orbits the real local vault.","assetNeeds":[{"type":"icon","query":"shield","role":"inset"}],"sfx":["pop"],"musicCue":"steady"},{"id":"s4","start":10.5,"duration":4,"purpose":"feature","voiceover":"Intera