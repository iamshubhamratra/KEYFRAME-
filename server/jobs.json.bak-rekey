g"],"musicCue":"lift"},{"id":"s5","start":22,"duration":5,"purpose":"proof","voiceover":"Focus on thinking. Atlas handles execution.","onScreenText":["Focus on Thinking","Atlas Executes"],"visualDirection":"Split screen: one side shows a person in deep thought, the other shows Atlas executing complex tasks in the background with fluid animations.","assetNeeds":[{"type":"icon","query":"lightbulb icon","role":"inset"},{"type":"icon","query":"checkmark icon","role":"inset"}],"sfx":["sparkle"],"musicCue":"steady"},{"id":"s6","start":27,"duration":3,"purpose":"cta","voiceover":"Work just changed forever.","onScreenText":["Work Just Changed Forever."],"visualDirection":"Atlas logo fills the screen with a powerful, cinematic flourish. The background pulses with energy.","assetNeeds":[],"sfx":["riser","impact"],"musicCue":"outro"}],"music":{"mood":"epic orchestral, driving electronica, cinematic","query":"epic cinematic electronic"},"voice":{"style":"male or female, authoritative yet warm, confident, slightly dramatic delivery","pace":"brisk"}},"script_warnings":[],"usage":{"llm":{"inputTokens":188498,"outputTokens":98645,"callCount":6,"inputCostUsd":0.282747,"outputCostUsd":0.887805,"totalCostUsd":1.170552},"tts":{"inputChars":0,"inputTokensEst":0,"outputTokensEst":0,"callCount":0,"inputCostUsd":0,"outputCostUsd":0,"totalCostUsd":0},"external":{"freesound_search":1,"freesound_download":1,"openrouter_chat":6,"asset_library_hit":11,"hyperframes_lint":4,"hyperframes_render":2},"totalCostUsd":1.170552},"stage_timings":{"briefMs":6465,"scriptMs":16320,"productionMs":931558},"assets":[{"path":"assets/images/0.jpg","type":"image","sceneId":"s1","startSec":0,"durationSec":5,"style":"inset","alt":"notification bell icon","license":"curated-library","sourceUrl":null,"source":"library:negotiation","fromCache":true},{"path":"assets/images/1.png","type":"image","sceneId":"s1","startSec":0,"durationSec":5,"style":"inset","alt":"browser tab icon","license":"curated-library","sourceUrl":n