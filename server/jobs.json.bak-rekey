t":null,"finished_at":1783317627517,"client_ip":"::1","voice_style":null,"captions_enabled":0,"upload_path":null,"intent":{"prompt":"make it like a addvertisment like video","websiteUrl":"https://claude.ai/","hasReferenceVideo":false,"preferences":{"duration":30,"orientation":"horizontal","voiceStyle":"auto","framePack":"longshot-cinema"}},"autopilot":0,"render3d":0,"compose_mode":"standard","brief":null,"script":null,"script_warnings":null},{"id":"jah9pxmko1","kind":"project","prompt":"make a intro video for this website with best screenshots","duration":25,"orientation":"horizontal","quality":"720p","width":1280,"height":720,"fps":30,"frame_pack":"longshot-cinema","status":"script_review","progress":"script_review","video_url":null,"error":null,"used_fallback":0,"llm_tokens_in":0,"llm_tokens_out":0,"created_at":1783317700409,"started_at":1783317702862,"finished_at":null,"client_ip":"::1","voice_style":null,"captions_enabled":0,"upload_path":null,"intent":{"prompt":"make a intro video for this website with best screenshots","websiteUrl":"https://claude.ai/","hasReferenceVideo":false,"preferences":{"duration":25,"orientation":"horizontal","voiceStyle":"auto","framePack":"longshot-cinema"},"website":{"url":"https://claude.ai/","title":"Sign in - Claude","description":"Sign in to Claude, Anthropic's AI assistant for problem solvers.","headings":["Meet Claude","Platform","Solutions","Pricing","Resources","Think fast,build faster","Bring any idea to life with chat, Cowork, Claude Code, and Claude Design.","Explore plans","Free","Pro","Max","Frequently asked questions","What is Claude and how does it work?","What is Claude and how does it work?","What should I use Claude for?","What should I use Claude for?","How much does it cost to use?","How much does it cost to use?","Products","Features","Models","Solutions","Claude Platform","Resources","Company"],"bodyText":"Think fast,\nbuild faster\nBring any idea to life with chat, Cowork, Claude Code, and Claude Design.\n\nNew