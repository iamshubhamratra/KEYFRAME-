ame with hero treatment","license":"owner content","sourceUrl":"https://obsidian.md","source":"website","fromCache":false,"clipRelevance":0.993,"cdScore":88,"sees":"Dark homepage showing graph view UI and main headline","cdProminence":"hero","sectionType":"hero","visionOk":true,"kind":"shot","fit":"cover","focus":"top","effect":"rise","quality":"high","cropFocus":"top center","container":"browser"},{"path":"assets/images/siteimg_0.png","type":"image","sceneId":"s7","startSec":11,"durationSec":3.5,"style":"inset","width":2899,"height":1757,"ratio":1.6499715424018213,"alt":"Brand image from Obsidian - Sharpen your thinking — Example of Obsidian Help site powered by Obsidian Publish","license":"owner content","sourceUrl":"https://obsidian.md","source":"website-image","fromCache":false,"clipRelevance":0.955,"cdScore":73,"sees":"Dark help documentation page detailing themes and community plugins","cdProminence":"support","sectionType":"features","visionOk":true,"kind":"shot","fit":"cover","focus":"top","effect":"rise","quality":"high","cropFocus":"top center","container":"browser"},{"path":"assets/images/siteimg_1.png","type":"image","sceneId":"s4","startSec":14.5,"durationSec":3.5,"style":"inset","width":300,"height":500,"ratio":0.6,"alt":"Brand image from Obsidian - Sharpen your thinking — Wikipedia page about David Hume embedded in Obsidian Canvas","license":"owner content","sourceUrl":"https://obsidian.md","source":"website-image","fromCache":false,"clipRelevance":0.306,"cdScore":57,"sees":"Light mode Wikipedia article page about philosopher David Hume","cdProminence":"background","sectionType":"other","visionOk":false,"kind":"shot","fit":"cover","focus":"top","effect":"rise","quality":"ok","cropFocus":"center center"},{"path":"assets/images/0.jpg","type":"image","sceneId":"s5","startSec":0,"durationSec":3,"style":"background","alt":"scattered note fragments drift","width":853,"height":1280,"ratio":0.666,"hasAlpha":false,"license":"Pixabay Content License","sourceUrl":"https://pixabay.com/photos/lights-christmas-luminaries-night-1088140/","source":"pixabay","fromCache":false,"clipRelevance":0.216,"cdScore":83,"sees":"A path of glowing paper lanterns at night with warm bokeh lights","cdProminence":"hero","visionOk":true,"kind":"photo","fit":"cover","focus":"center","effect":"zoom","quality":"high","cropFocus":"center center"},{"path":"assets/images/7.svg","type":"image","sceneId":"s2","startSec":3,"durationSec":4,"style":"inset","alt":"shield","width":128,"height":128,"license":"Open source (Iconify — per-set license)","sourceUrl":"https://icon-sets.iconify.design/","source":"iconify","fromCache":false,"clipRelevance":0.315},{"path":"assets/images/9.svg","type":"image","sceneId":"s3","startSec":7,"durationSec":4,"style":"background","alt":"hero product reveal real","width":128,"height":128,"license":"Open source (Iconify — per-set license)","sourceUrl":"https://icon-sets.iconify.design/","source":"iconify","fromCache":false,"clipRelevance":0.784}],"text_review":{"source":"llm","added":5,"llmAdded":3,"minedAdded":2,"scenesWithSubtext":8,"scenesWithBullets":7,"sceneCount":8},"layout_review":{"keptScreenshots":5,"keptPhotos":1,"demoted":0,"heroScale":0.54,"montageMax":6,"prominentTotal":6,"scenes":[{"sceneId":"s1","archetype":"hook","heroScale":0.54},{"sceneId":"s2","archetype":"text","heroScale":0.54},{"sceneId":"s3","archetype":"text","heroScale":0.54},{"sceneId":"s4","archetype":"text","heroScale":0.54},{"sceneId":"s5","archetype":"stat","heroScale":0.54},{"sceneId":"s6","archetype":"text","heroScale":0.54},{"sceneId":"s7","archetype":"text","heroScale":0.54},{"sceneId":"s8","archetype":"cta","heroScale":0.54}],"score":{"compositionQuality":100,"source":"deterministic"}},"template_review":{"source":"llm","framePack":"lantern-night","scenes":8,"llmCast":8,"deterministic":0,"unsourcedNumbers":1,"withMedia":4,"assetsUsed":5,"assetPool":7,"types":{"hook":1,"feature":2,"montage":1,"stats":1,"statement":2,"cta":1},"cast":[{"id":"s1","type":"hook","media":1,"why":"Introduces the core concept with a hook."},{"id":"s3","type":"feature","media":1,"why":"Showcases the product interface and key features."},{"id":"s4","type":"montage","media":2,"why":"Visualizes the interconnected nature of notes."},{"id":"s5","type":"stats","media":0,"why":"Highlights the graph feature with a stat."},{"id":"s6","type":"feature","media":1,"why":"Shows the infinite canvas research tool."},{"id":"s7","type":"statement","media":0,"why":"Reinforces the open nature of the app."},{"id":"s2","type":"statement","media":0,"why":"Establishes the core privacy value proposition."},{"id":"s8","type":"cta","media":0,"why":"Final call to action for the user."}]},"captions":[{"start":0,"end":2.8,"text":"What if notes could think?"},{"start":3.35,"end":8.347098,"text":"Stored offline on your device. Not even Obsidian reads them."},{"start":8.9,"end":13.9,"text":"Obsidian: free, flexible, and private for your thoughts."},{"start":14.45,"end":18.825,"text":"Link anything to your personal Wikipedia."},{"start":19.38,"end":23.53,"text":"This interactive graph reveals hidden patterns."},{"start":24.08,"end":28.43,"text":"Canvas — infinite space to research and brainstorm."},{"start":28.98,"end":33.88,"text":"Thousands of plugins. Open formats. Completely free."},{"start":34.43,"end":38.53,"text":"Download Obsidian to sharpen how you think."}],"srt_url":"/videos/xtr8f8dxgz.srt","final_attempt":"main","qa":{"pass":false,"score":6,"issues":[{"atSec":0.6,"severity":"blocker","issue":"The top-left header text 'Your Private Secon' is clipped/cut off mid-word, missing the final letter(s).","fix":"Increase the width of the top-left header text container or reduce its font-size slightly so that 'Your Private Second' renders completely without truncation."}]},"quality_report":{"verdict":"flagged","flags":["1 text element(s) still below WCAG AA","QA: 1 blocker(s)"],"contrast":{"checked":true,"fixed":0,"remaining":1,"passes":0},"identity":{"remapped":4},"layout":{"duplicatesRemoved":0,"collisionsScrimmed":0},"assetFloor":null,"audio":{"lufs":-14,"peak":-3.77,"lra":4.3,"target":-14,"layers":{"voice":8,"sfx":6,"music":true,"ambient":false,"musicEnvelope":false}},"screenshots":{"kept":4,"dropped":0,"repinned":0,"problems":[]},"assetQuality":77,"templateFit":76,"qa":{"pass":false,"score":6,"skipped":false,"blockers":1}}},{"id":"y6vui34syb","kind":"project","prompt":"","duration":30,"orientation":"vertical","quality":"1080p","width":1080,"height":1920,"fps":30,"frame_pack":"hype-wave","frame_pack_user":1,"status":"done","progress":"finalizing","video_url":"/videos/y6vui34syb.mp4","error":null,"used_fallback":0,"llm_tokens_in":70303,"llm_tokens_out":26516,"created_at":1785215979280,"started_at":1785218646253,"finished_at":1785219481096,"client_ip":"::ffff:127.0.0.33","voice_style":null,"captions_enabled":0,"upload_path":null,"task":null,"requeue_count":0,"intent":{"prompt":"","websiteUrl":"https://gumroad.com","blogUrl":null,"hasReferenceVideo":false,"preferences":{"duration":30,"orientation":"vertical","voiceStyle":"auto","framePack":"hype-wave"},"website":{"url":"https://gumroad.com","title":"Earn your first dollar online with Gumroad","description":"Start selling what you know, see what sticks, and get paid. Simple and effective.","headings":["Go from 0 to $1","We want you to try them, lots of them, and find out what works.","$1,927,990","Max Ulichney","Steph Smith","trendsvc","Daniel Vassallo","Unlimited possibilities","Don't take risks. That's scary!","Place small bets. That's exciting!","Share your work. Someone out there needs it."],"bodyText":"9.4K\nDiscover\nBlog\nPricing\nFeatures\nAbout\nGumclaw\nLog in\nStart selling\nGo from 0 to $1\nAnyone can earn their first dollar online. Just start with what you know, see what sticks, and get paid. It's that easy.\nStart selling\nSearch marketplace\n\nContribute or fork on \nGitHub\n\nSell anything\n\nVideo lessons. Monthly subscriptions. Whatever! Gumroad was created to help you experiment with all kinds of ideas and formats.\n\nMake your own road\n\nWhether you need more balance, flexibility, or just a different gig, we make it easy to chart a new path.\n\nSell to anyone\n\nGo from 0 to $1 and automated workflows.\n\nLet your customers pay in their own currency.\n\nChoose between one-time, recurring, or fixed-length payments in your currency of choice.\n\nSell anywhere\n\nCreate and customize your storefront with our all-in-one platform or choose to use your personal site instead. Seamlessly connect your Gumroad account to thousands of apps in your current stack.\n\nInstead of building a company...\n\n...start selling a side project!\n\nYou know all those great ideas you have?\nThe Gumroad Way\nStart Small\nGet Better Together\nLearn Quickly\nWe want you to try them, lots of them, and find out what works.\n\nYou don't have to be a tech expert or even understand how to start a business. You just gotta take what you know and sell it.\n\nFind out how\n$1,927,990\nThe amount of income earned by Gumroad digital entrepreneurs last week.\n\nI launched MaxPacks as an experimental side gig; but within 2 years those Procreate brushes were earning more than my 6-figure salary in CG. Leaving in favor of Gumroad enabled me to explore other aspects of my art, develop new hobbies, and finally prioritize my personal life.\n\nMax Ulichney\n\nSells Procreate brush packs\n\nFor years, I had a goal to develop 'passive' income streams, but struggled to make that a reality. Last year, I started selling informational products on Gumroad and since then have made $10k+ per month building products that I love.\n\nSteph Smith\n\nSells content tutorials\n\nOriginally, I took pre-orders for my Trend Reports on Gumroad. But I received... exactly $0. So I changed tactics: I made half of my report free, and the other half paid. Today, 99% of Trends.VC revenue is recurring in the form of annual and quarterly subscriptions.\n\ntrendsvc\n\nSells business insights and expertise\n\nI love Gumroad because it can't be any simpler. I upload a file, set a price, and I can start selling on the internet. The money I make from my sales lands directly in my bank account every Friday.\n\nDaniel Vassallo\n\nSells business insights and expertise\n\nUnlimited possibilities\n\nDiscover the best-selling products and creators on Gumroad\n\nblender\nmeditation\ncomic\nnotion template\ntextures\nprocreate\n3d model\nhypnosis\nmanga\ninvesting\nmockup\nbrushes\nspark ar\nsubliminal messages\nanime\ninstagram\nfont\nblender\nmeditation\ncomic\nnotion template\ntextures\nprocreate\n3d model\nhypnosis\nmanga\ninvesting\nmockup\nbrushes\nspark ar\nsubliminal messages\nanime\ninstagram\nfont\nart\nafter effects\neducation\nfitness\nsci-fi\nvrchat\nableton\ncertification exams\nvj loops\nworkout program\npoetry\navatar\nsample pack\nlearning\nluts\nyoga\nfiction\nassets\nsheet music\nart\nafter effects\neducation\nfitness\nsci-fi\nvrchat\nableton\ncertification exams\nvj loops\nworkout program\npoetry\navatar\nsample pack\nlearning\nluts\nyoga\nfiction\nassets\nsheet music\nreference photos\ncoloring page\nsingles\nprogramming\nkdp interior\nstock photos\nprintable\njazz\nwindows\nebook\nphotobash\nproductivity\ninstrumental music\ntheme\nlow content books\nreference photos\ncoloring page\nsingles\nprogramming\nkdp interior\nstock photos\nprintable\njazz\nwindows\nebook\nphotobash\nproductivity\ninstrumental music\ntheme\nlow content books\nDon't take risks.\nThat's scary!\n\nInstead of selling a book...\n\n...start by selling a blog post!\n\nPlace small bets.\nThat's exciting!\nShare your work.\nSomeone out there needs it.\nStart selling\nSubscribe to get tips and tactics to grow the way you want.\n→\nⒸ Gumroad, Inc.\nDiscover\nBlog\nPricing\nFeatures\nAbout\nGumclaw\nSmall Bets\nH","brandColors":["#ED89D8","#FD90E9","#E5B1D8","#965488"],"ogImage":"https://assets.gumroad.com/images/opengraph_image.png","hasRealScreenshots":1},"__ingested":true},"autopilot":1,"render3d":0,"compose_mode":null,"brief":{"improvedPrompt":"A 30-second vertical hype reel for Gumroad that dares anyone with a skill, file, or idea to earn their first dollar online. It opens on the fear of big risks, then flips to the Gumroad way: place small bets, sell what you know, see what sticks. Flash creator proof — last week’s $1.9M in earnings, Max’s Procreate packs out-earning a six-figure job, Steph’s $10k+ months — and close on a simple CTA: start selling. Loud, playful, thumb-stopping energy for aspiring side-hustlers and indie creators.","subject":"creators selling digital products online","audience":"Aspiring creators, freelancers, and side-hustlers who want to monetize skills online","tone":"bold, playful, encouraging, electric","goal":"Make starting feel low-risk and irresistible — push the viewer to start selling on Gumroad","keyMessages":["Go from 0 to $1 online","Start with what you know, see what sticks, get paid","Place small bets — that’s exciting","$1,927,990 earned by creators last week","Sell anything: files, lessons, subscriptions","Share your work — someone needs it"],"mustIncludeFacts":["Go from 0 to $1","$1,927,990 earned by Gumroad digital entrepreneurs last week","Anyone can earn their first dollar online","Max Ulichney’s Procreate brushes out-earned his 6-figure CG salary","Steph Smith makes $10k+ per month selling informational products","Daniel Vassallo gets payouts every Friday","Sell one-time, recurring, or fixed-length payments"],"brandColors":["#ED89D8","#FD90E9","#E5B1D8","#965488"],"suggestedFramePack":"hype-wave","suggestedDuration":30,"musicMood":"electric upbeat pop","voProfile":"female, mid-20s, bright, punchy, hype-host energy"},"script":{"title":"Earn Your First Dollar Online","scenes":[{"id":"s1","start":0,"duration":2.5,"purpose":"hook","voiceover":"Anyone can earn their first dollar.","onScreenText":["0 → $1"],"visualDirection":"Electric type slams center as a counter snaps from 0 to $1 with a bright f