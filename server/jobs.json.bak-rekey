141,"llm_tokens_out":45509,"created_at":1781252198241,"started_at":1781252224258,"finished_at":1781252484535,"client_ip":"::1","voice_style":null,"captions_enabled":1,"upload_path":null,"intent":{"prompt":"A 30 second launch video for Atlas, a project tracker for small teams. Three features: instant timelines, workload balancing, and a daily focus digest. 4.9 stars from 2,000 reviews. End with: Start free at atlas.app.","websiteUrl":null,"hasReferenceVideo":false,"preferences":{"duration":30,"orientation":"horizontal","voiceStyle":"auto","framePack":"blockframe"}},"autopilot":1,"brief":{"improvedPrompt":"A high-energy, fast-paced launch video introducing Atlas, a project tracker designed specifically for small teams overwhelmed by tool clutter. The video opens with a relatable hook about team coordination chaos, then rapidly showcases three core features using bold, tactile UI transitions: instant timelines, workload balancing, and a daily focus digest. It builds credibility with an impressive social proof milestone and closes with a clear, low-friction call to action to start free at atlas.app.","audience":"Small teams, startup founders, and project managers seeking a streamlined, clutter-free way to collaborate.","tone":"playful, confident, energetic, direct","goal":"Excite small teams about a simpler tracking tool and drive them to sign up for free at atlas.app.","keyMessages":["Atlas is the ultimate project tracker built specifically for small teams.","Map out projects instantly with intuitive timelines.","Keep workloads balanced to prevent team burnout.","Start every day aligned with an automated daily focus digest."],"mustIncludeFacts":["Atlas is a project tracker for small teams.","Features include: instant timelines, workload balancing, and a daily focus digest.","Rated 4.9 stars from 2,000 reviews.","Call to action: Start free at atlas.app."],"brandColors":["#FFD93D","#4D96FF","#FF6B6B","#111111"],"suggestedFramePack":"blockframe","suggestedDuration":30,"musicMood":"upbeat retro-synth pop","voProfile":"female, late 20s, warm, enthusiastic, conversational"},"script":{"title":"Ditch the Clutter with Atlas","scenes":[{"id":"s1","start":0,"duration":4,"purpose":"hook","voiceover":"Is your team drowning in tool clutter?","onScreenText":["Too Many Tools?"],"visualDirection":"A chaotic grid of overlapping, generic app icons rapidly scales up and down against a dark background, creating a feeling of digital overwhelm.","assetNeeds":[{"type":"video","query":"stressed person typing laptop","role":"background"}],"sfx":["digital alert beep"],"musicCue":"intro"},{"id":"s2","start":4,"duration":4.5,"purpose":"context","voiceover":"Meet Atlas. The project tracker built specifically for small teams.","onScreenText":["Meet Atlas","Built for Small Teams"],"visualDirection":"A bold, bright yellow frame sweeps away the clutter to reveal a clean, minimalist UI dashboard mockup centered on screen.","assetNeeds":[],"sfx":["whoosh"],"musicCue":"build"},{"id":"s3","start":8.5,"duration":4.5,"purpose":"feature","voiceover":"Map out your projects instantly with intuitive timelines.","onScreenText":["Instant Timelines"],"visualDirection":"A colorful, tactile timeline schedule smoothly expands horizontally across the screen with satisfying block-by-block animations.","assetNeeds":[{"type":"image","query":"gantt chart timeline UI","role":"inset"}],"sfx":["soft click"],"musicCue":"steady"},{"id":"s4","start":13,"duration":6,"purpose":"feature","voiceover":"Keep workloads balanced to prevent burnout, and start every day aligned.","onScreenText":["Balanced Workloads","Daily Focus Digest"],"visualDirection":"The screen splits evenly to showcase two clean UI modules: a balanced team capacity chart on the left, and a neat morning checklist on the right.","assetNeeds":[{"type":"image","query":"clean software calendar dashboard","role":"inset"}],"sfx":["pop"],"musicCue":"steady"},{"id":"s5","start":19,"duration":5,"purpose":"proof","voiceover":"See why we're rated four-point-nine stars from two thousand reviews.","onScreenText":["★ 4.9 Rating","2,000+ Reviews"],"visualDirection":"Large, bold typography slides into view alongside five glowing stars that light up one by one in a playful sequence.","assetNeeds":[{"type":"icon","query":"five gold stars rating","role":"inset"}],"sfx":["success chime"],"musicCue":"lift"},{"id":"s6","start":24,"duration":6,"purpose":"cta","voiceover":"Ditch the chaos. Start free today at atlas.app.","onScreenText":["Start Free","atlas.app"],"visualDirection":"A vibrant yellow background locks into place with a prominent, high-contrast call-to-action button pulsing gently in the center.","assetNeeds":[],"sfx":["whoosh"],"musicCue":"outro"}],"music":{"mood":"upbeat retro-synth pop","query":"energetic 80s synth pop beat"},"voice":{"style":"female, late 20s, warm, enthusiastic, conversational","pace":"conversational"}},"script_warnings":[],"usage":{"llm":{"inputTokens":46141,"outputTokens":45509,"callCount":4,"inputCostUsd":0.069212,"outputCostUsd":0.409581,"totalCostUsd":0.478792},"tts":{"inputChars":403,"inputTokensEst":103,"outputTokensEst":1516,"callCount":7,"inputCostUsd":0.000062,"outputCostUsd":0.003638,"totalCostUsd":0.0037},"external":{"freesound_search":1,"openverse_search":4,"internet_archive_search":1,"openrouter_tts":7,"pixabay_scrape_search":4,"openrouter_chat":4,"internet_archive_download":1,"hyperframes_lint":2,"hyperframes_render":1},"totalCostUsd":0.482493},"stage_timings":{"briefMs":11439,"scriptMs":14575,"storyboardMs":42203,"compose_renderMs":216867,"audioMs":1169},"assets":[{"path":"assets/images/0.jpg","type":"image","sceneId":"s1","startSec":0,"durationSec":4,"style":"background","alt":"stressed person typing laptop","license":"Pixabay Content License","sourceUrl":"https://cdn.pixabay.com/photo/2015/07/17/22/43/student-849825_1280.jpg","source":"pixabay_scrape","fromCache":false},{"path":"assets/images/1.jpg","type":"image","sceneId":"s3","startSec":8.5,"durationSec":4.