eed is intense and Linear helps us be action biased.Ni"},{"url":"https://linear.app/customers/opendoor","text":"Linear is excellent, just excellent. It has the right opinio"},{"url":"https://linear.app/contact/sales","text":"Contact sales"},{"url":"https://linear.app/download","text":"Download"},{"url":"https://linear.app/security","text":"Security"},{"url":"https://linear.app/asks","text":"Asks"},{"url":"https://linear.app/agents","text":"Agents"},{"url":"https://linear.app/customer-requests","text":"Customer Requests"},{"url":"https://linear.app/insights","text":"Insights"},{"url":"https://linear.app/mobile","text":"Mobile"},{"url":"https://linear.app/integrations","text":"Integrations"},{"url":"https://linear.app/about","text":"About"},{"url":"https://linear.app/careers","text":"Careers"},{"url":"https://linear.app/blog","text":"Blog"},{"url":"https://linear.app/method","text":"Method"},{"url":"https://linear.app/quality","text":"Quality"},{"url":"https://linear.app/brand","text":"Brand"},{"url":"https://linear.app/switch","text":"Switch"},{"url":"https://linear.app/developers","text":"Developers"},{"url":"https://linear.app/enterprise","text":"Enterprise"},{"url":"https://linear.app/startups","text":"Startups"},{"url":"https://linear.app/join-slack","text":"Community"},{"url":"https://linear.app/privacy","text":"Privacy"},{"url":"https://linear.app/terms","text":"Terms"},{"url":"https://linear.app/dpa","text":"DPA"},{"url":"https://linear.app/legal/aup","text":"AUP"}],"website_auth_wall":false,"usage":{"byStage":[{"stage":"dressing","model":"google/gemini-3.5-flash","inputTokens":1570,"outputTokens":18478,"totalTokens":20048,"callCount":2,"costUsd":0.046666},{"stage":"storyboard","model":"grok-4-5","inputTokens":10879,"outputTokens":8685,"totalTokens":19564,"callCount":1,"costUsd":0.029547},{"stage":"creative_director","model":"google/gemini-3.5-flash","inputTokens":18469,"outputTokens":6291,"totalTokens":24760,"callCount":4,"costUsd":0.021268},{"stage":"qa","mo