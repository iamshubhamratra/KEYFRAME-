x":[],"musicCue":"intro"},{"id":"s4","start":15,"duration":5,"purpose":"context","voiceover":"Yet, deep, restorative rest feels completely out of reach.","onScreenText":["Rest feels","Out of reach"],"visualDirection":"Slow macro push-in on a clock dial slowly ticking forward.","assetNeeds":[{"type":"image","query":"clock ticking dark room close up","role":"background"}],"sfx":["transition"],"musicCue":"intro"},{"id":"s5","start":20,"duration":5,"purpose":"context","voiceover":"But great sleep isn't luck. It's a science.","onScreenText":["Sleep is a science"],"visualDirection":"The dark room begins to soften as a warm, gentle light rises.","assetNeeds":[],"sfx":["swoosh"],"musicCue":"build"},{"id":"s6","start":25,"duration":5,"purpose":"feature","voiceover":"Meet Aurora. Reimagining the way you rest.","onScreenText":["Meet Aurora"],"visualDirection":"The Aurora app interface slowly fades in on a beautiful nightstand.","assetNeeds":[],"sfx":["pop"],"musicCue":"build"},{"id":"s7","start":30,"duration":5,"purpose":"feature","voiceover":"Designed for ambitious minds who need to switch off.","onScreenText":["Built for","Ambitious minds"],"visualDirection":"A modern, elegant bedroom with soft warm lighting filling the screen.","assetNeeds":[{"type":"image","query":"modern minimal cozy bedroom warm lighting","role":"background"}],"sfx":[],"musicCue":"build"},{"id":"s8","start":35,"duration":5,"purpose":"feature","voiceover":"At its heart is an adaptive audio engine.","onScreenText":["Adaptive","Audio Engine"],"visualDirection":"Abstract glowing waves pulsing gently in sync with a slow breathing rhythm.","assetNeeds":[{"type":"icon","query":"sparkle","role":"inset"}],"sfx":["sparkle"],"musicCue":"build"},{"id":"s9","start":40,"duration":5,"purpose":"feature","voiceover":"Soundscapes that shift as your body settles down.","onScreenText":["Soundscapes that shift"],"visualDirection":"The app UI displays real-time responsive sound waves changing form.","assetNeeds":[],"sfx":["tr