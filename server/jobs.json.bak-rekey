archetype":"text","heroScale":0.54},{"sceneId":"s18","archetype":"text","heroScale":0.54},{"sceneId":"s19","archetype":"text","heroScale":0.54},{"sceneId":"s20","archetype":"text","heroScale":0.54},{"sceneId":"s21","archetype":"text","heroScale":0.54},{"sceneId":"s22","archetype":"quote","heroScale":0.54},{"sceneId":"s23","archetype":"text","heroScale":0.54},{"sceneId":"s24","archetype":"hook","heroScale":0.54},{"sceneId":"s25","archetype":"text","heroScale":0.54},{"sceneId":"s26","archetype":"text","heroScale":0.54},{"sceneId":"s27","archetype":"hook","heroScale":0.54},{"sceneId":"s28","archetype":"text","heroScale":0.54},{"sceneId":"s29","archetype":"text","heroScale":0.54},{"sceneId":"s30","archetype":"cta","heroScale":0.54}],"score":{"compositionQuality":100,"source":"deterministic"}},"captions":[{"start":0,"end":3.2,"text":"Shipping software shouldn't feel like this."},{"start":3.75,"end":7.75,"text":"Feedback is scattered. Issues are stalled."},{"start":8.3,"end":11.850000000000001,"text":"Endless syncs that go nowhere."},{"start":12.4,"end":15,"text":"The noise drowns out the work."},{"start":15.9,"end":19.1,"text":"Momentum dies before you ship."},{"start":19.65,"end":23.4,"text":"What if product ops ran themselves?"},{"start":23.95,"end":26.099999999999998,"text":"This is Linear."},{"start":28.45,"end":32.500045,"text":"The product development system for teams and agents."},{"start":33.05,"end":36.65,"text":"Purpose-built for the AI era."},{"start":37.2,"end":40.45,"text":"Define product direction with clarity."},{"start":41.2,"end":44.25,"text":"Initiatives set the north star."},{"start":45.2,"end":48.6,"text":"Roadmaps keep every team aligned."},{"start":49.2,"end":52.400000000000006,"text":"PRDs capture what ships next."},{"start":53.2,"end":57.45,"text":"Direction stays clear—from vision to backlog."},{"start":58,"end":61.35,"text":"Make product operations self-driving."},{"start":62.5,"end":66.75,"text":"Intake becomes intelligent and automatic."},{"start":67.3,"end":70.35,"text":"Work routes to the right people."},{"start":71.3,"end":73.95,"text":"And the right agents."},{"start":75.3,"end":78.7,"text":"Shared workflows for humans and agents."},{"start":79.8,"end":83.14999999999999,"text":"From PRD all the way to PR."},{"start":84.3,"end":87.7,"text":"Coding Sessions keep agents in flow."},{"start":88.3,"end":91.7,"text":"Agents draft PRs beside the team."},{"start":92.3,"end":95.64999999999999,"text":"Work moves forward, automatically."},{"start":96.3,"end":98.39999999999999,"text":"Designed for speed."},{"start":100.3,"end":103.25,"text":"Experience less noise."},{"start":103.8,"end":105.85,"text":"More shipping momentum."},{"start":107.3,"end":111.2,"text":"One board. Every issue. In motion."},{"start":111.8,"end":115.1,"text":"Roadmaps that stay alive as you build."},{"start":123.8,"end":126.6,"text":"Velocity—without the chaos."},{"start":138.8,"end":141.85000000000002,"text":"Built for modern software teams."}],"srt_url":"/videos/p1awdazo22.srt","final_attempt":"qa-repair","qa":{"pass":false,"score":2,"issues":[{"atSec":51.6,"severity":"blocker","issue":"EMPTY FRAME: The frame contains only the background grid and coordinate markers, with no actual content or typography.","fix":"Add the planned feature content, illustrations, and typography for scene s13."},{"atSec":73.7,"severity":"blocker","issue":"EMPTY FRAME: The frame contains only the background grid and coordinate markers, with no actual content or typography.","fix":"Add the planned feature content, illustrations, and typography for scene s18."},{"atSec":90.7,"severity":"blocker","issue":"EMPTY FRAME: The frame contains only the background grid and coordinate markers, with no actual content or typography.","fix":"Add the planned feature content, illustrations, and typography for scene s22."},{"atSec":110,"severity":"blocker","issue":"EMPTY FRAME: The frame contains only the background grid and coordinate markers, with no actual content or typograph