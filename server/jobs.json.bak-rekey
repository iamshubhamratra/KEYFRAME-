India delivery."},{"start":16,"end":20,"text":"Sign up today and browse our extensive catalogue."}],"srt_url":"/videos/83ze51x0aj.srt","final_attempt":"main","qa":{"pass":false,"score":4,"issues":[{"atSec":0.6,"severity":"blocker","issue":"Under-illustrated frame: The frame primarily shows text and a simple question mark shape. There are not enough distinct visual elements to meet the premium video standard.","fix":"Add more animated vector/asset layers to the frame. Consider a subtle particle field, a decorative drawing underline for the text, or an inset image to enrich the visual composition."},{"atSec":2.1,"severity":"blocker","issue":"Under-illustrated frame: The frame primarily shows text and a simple question mark shape. There are not enough distinct visual elements to meet the premium video standard.","fix":"Add more animated vector/asset layers to the frame. Consider a subtle particle field, a decorative drawing underline for the text, or an inset image to enrich the visual composition."},{"atSec":6.2,"severity":"blocker","issue":"Text contrast failure: The text 'Your Direct Gateway to Wholesale Beauty' is light text on a dark, busy background within the browser window, making it difficult to read comfortably at thumbnail size.","fix":"Add a solid, semi-transparent scrim or panel behind the text 'Your Direct Gateway to Wholesale Beauty' within the browser window to improve contrast, or change the text color to a token that provides sufficient contrast."},{"atSec":10.7,"severity":"blocker","issue":"Text contrast failure: The text '50+' in the top right corner is light text on a dark background, but the background is not solid enough, and the text is small, making it difficult to read comfortably at thumbnail size.","fix":"Ensure the background behind the '50+' text in the top right is a solid color with sufficient contrast, or increase the text size and weight to improve readability."},{"atSec":14.6,"severity":"blocker","issue":"Text contrast failure: The text 'Latest From Our Blog' is light text on a dark, busy background within the browser window, making it difficult to read comfortably at thumbnail size.","fix":"Add a solid, semi-transparent scrim or panel behind the text 'Latest From Our Blog' within the browser window to improve contrast, or change the text color to a token that provides sufficient contrast."},{"atSec":18.4,"severity":"blocker","issue":"Under-illustrated frame: The frame shows essentially just text on a flat background with a large red circle and some abstract shapes. There are not enough distinct non-text visual elements to meet the premium video standard.","fix":"Add more animated vector/asset layers to the frame. Consider a subtle particle field, a decorative drawing underline for the text, or an inset image to enrich the visual composition."}]}},{"id":"ryhc6pgtws","kind":"project","prompt":"","duration":20,"orientation":"horizontal","quality":"720p","width":1280,"height":720,"fps":30,"frame_pack":"bloom-illustrated","status":"done","progress":"finalizing","video_url":null,"error":null,"used_fallback":1,"llm_tokens_in":133983,"llm_tokens_out":63703,"created_at":1781847006835,"started_at":1781847116927,"finished_at":1781847456702,"client_ip":"::1","voice_style":null,"captions_enabled":1,"upload_path":null,"intent":{"prompt":"","websiteUrl":"https://www.amazon.in/","hasReferenceVideo":false,"preferences":{"duration":20,"orientation":"horizontal","voiceStyle":"auto","framePack":"bloom-illustrated"},"website":{"url":"https://www.amazon.in/","title":"Online Shopping site in India: Shop Online for Mobiles, Books, Watches, Shoes and More - Amazon.in","description":"Amazon.in: Online Shopping India - Buy mobiles, laptops, cameras, books, watches, apparel, shoes and e-Gift Cards. Free Shipping & Cash on Delivery Available.","headings":["Skip to","Keyboard shortcuts","Appliances for your home | Up to 55% off","Revamp your home in style","Starting ₹49 | Deals on home essentials","Up to 75% off | Deals on 