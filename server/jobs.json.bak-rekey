 Streak","scenes":[{"id":"s1","start":0,"duration":3.5,"purpose":"hook","voiceover":"Struggling to build a home workout routine?","onScreenText":["Stuck on the couch?","Hard to start?"],"visualDirection":"A split-screen showing a tired person on a couch next to a clock spinning rapidly.","assetNeeds":[{"type":"image","query":"tired person sitting couch living room","role":"background"}],"sfx":["impact"],"musicCue":"intro"},{"id":"s2","start":3.5,"duration":4,"purpose":"how","voiceover":"Fitly builds personalized plans just for you.","onScreenText":["Personalized Plans","Built For You"],"visualDirection":"A fast camera zoom transitions to an energetic person training with custom workout cards sliding into view.","assetNeeds":[{"type":"image","query":"happy energetic woman exercising living room","role":"background"}],"sfx":["whoosh"],"musicCue":"build"},{"id":"s3","start":7.5,"duration":4,"purpose":"feature","voiceover":"Work out on your own schedule, anytime.","onScreenText":["Your Schedule","Anytime"],"visualDirection":"The real product UI mockup drops into the center of the frame, showing custom generator options.","assetNeeds":[],"sfx":["click"],"musicCue":"steady"},{"id":"s4","start":11.5,"duration":4,"purpose":"proof","voiceover":"And track your progress with fun daily streaks!","onScreenText":["Daily Streaks","Stay Motivated"],"visualDirection":"A colorful flame-themed streak counter pops up in the center and increments from four to five.","assetNeeds":[{"type":"icon","query":"fire streak icon","role":"inset"}],"sfx":["ding","sparkle"],"musicCue":"lift"},{"id":"s5","start":15.5,"duration":4.5,"purpose":"cta","voiceover":"Download Fitly today and start your streak!","onScreenText":["Download Fitly","Start Your Streak"],"visualDirection":"The Fitly logo settles in the center of a bold coral canvas as a download button pulses below.","assetNeeds":[],"sfx":["riser","impact"],"musicCue":"outro"}],"music":{"mood":"upbeat high-energy indie pop","query":"upbeat high-e