n a strong call to action to open the app and book their next weekend escape.","subject":"people booking tickets on a smartphone and cheering at a live concert","audience":"Urban entertainment seekers, moviegoers, and live event enthusiasts in India","tone":"playful, high-energy, vibrant, social","goal":"Inspire the viewer to open BookMyShow and instantly book a movie, play, sport, or live event for their next outing","keyMessages":["Your gateway to movies, live events, sports, and plays","Book tickets in seconds, anytime, anywhere","Discover the best experiences happening near you","Partner with us to list your own show"],"mustIncludeFacts":["BookMyShow offers showtimes, movie tickets, reviews, trailers, concert tickets and events","Features events, plays, sports, and activities","24/7 customer care available"],"brandColors":["#DF1843","#2B2A29","#FFFFFF"],"suggestedFramePack":"blockframe","suggestedDuration":30,"musicMood":"upbeat energetic pop-rock","voProfile":"male, mid-20s, enthusiastic, friendly, fast-paced"},"script":{"title":"BookMyShow Your Next Escape","scenes":[{"id":"s1","start":0,"duration":4,"purpose":"hook","voiceover":"Bored on a quiet evening?","onScreenText":["Bored at home?"],"visualDirection":"A slow push-in on a young man looking bored on a dark couch, illuminated only by his phone screen.","assetNeeds":[{"type":"image","query":"bored man looking at smartphone couch evening","role":"background"}],"sfx":["whoosh"],"musicCue":"intro"},{"id":"s2","start":4,"duration":5,"purpose":"context","voiceover":"Flip the script. BookMyShow is your gateway to movies, live events, sports, and plays.","onScreenText":["Flip the script.","Your gateway to entertainment."],"visualDirection":"The scene dynamically transitions as vibrant red shapes swipe across, revealing a montage of movie screens, theater stages, and cricket pitches.","assetNeeds":[{"type":"image","query":"vibrant stadium lights under dark sky","role":"background"}],"sfx":["transition","impact"],"musicCue":"build"},{"id":"s3","start":9,"duration":4.5,"purpose":"feature","voiceover":"Discover the best experiences happening near you, and book tickets in seconds.","onScreenText":["Happening near you","Book in seconds"],"visualDirection":"A phone screen enters from the bottom, showcasing the sleek BookMyShow app interface with movie showtimes and concert events spinning into view.","assetNeeds":[],"sfx":["click","pop"],"musicCue":"steady"},{"id":"s4","start":13.5,"duration":4.5,"purpose":"proof","voiceover":"Explore reviews, watch trailers, and secure seats for the biggest concerts.","onScreenText":["Reviews & Trailers","Concerts & Events"],"visualDirection":"The camera pans rapidly past floating visual cards showing rating stars, trailer play buttons, and live music icons.","assetNeeds":[{"type":"icon","query":"sparkle","role":"texture"}],"sfx":["sparkle","swoosh"],"musicCue":"steady"},{"id":"s5","start":18,"duration":4,"purpose":"proof","voiceover":"Plus, enjoy peace of mind with twenty-four seven customer care.","onScreenText":["24/7","Customer Care"],"visualDirection":"A friendly split-screen showing a customer support icon alongside happy people entering a theater.","assetNeeds":[{"type":"icon","query":"chat bubble","role":"inset"},{"type":"image","query":"happy young couple entering cinema theater smiling","role":"background"}],"sfx":["ding"],"musicCue":"lift"},{"id":"s6","start":22,"duration":4,"purpose":"feature","voiceover":"Hosting an event? Partner with us to list your own show.","onScreenText":["List your show"],"visualDirection":"The camera zooms out to reveal a crowd cheering at a live concert, with a spotlight hitting the stage.","assetNeeds":[{"type":"image","query":"crowd cheering live concert stage lights","role":"background"}],"sfx":["whoosh"],"musicCue":"lift"},{"id":"s7","start":26,"duration":4,"purpose":"cta","voiceover":"Open BookMyShow and book your next escape.","onScreenText":["Book your escape","Open BookMyShow"],"visualDirection":"A bo