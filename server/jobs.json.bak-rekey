rue}]},{"id":"ex0dfdblnl","kind":"project","prompt":"Turn my dog into a movie star","duration":30,"orientation":"horizontal","quality":"720p","width":1280,"height":720,"fps":30,"frame_pack":"vapor-chrome","status":"done","progress":"finalizing","video_url":null,"error":null,"used_fallback":0,"llm_tokens_in":736558,"llm_tokens_out":195145,"created_at":1783063750885,"started_at":1783063812472,"finished_at":1783066089982,"client_ip":"::1","voice_style":null,"captions_enabled":0,"upload_path":null,"intent":{"prompt":"Turn my dog into a movie star","websiteUrl":null,"hasReferenceVideo":false,"preferences":{"duration":30,"orientation":"horizontal","voiceStyle":"auto","framePack":"auto"}},"autopilot":0,"render3d":0,"compose_mode":"premium","brief":{"improvedPrompt":"A cinematic 30-second horizontal trailer framing an everyday dog as Hollywood's next big action hero. The video opens with dramatic suspense—ordinary naps and backyard squirrel chases elevated to high-stakes movie stunts. It builds with fast cuts, bold title cards, and a booming voiceover celebrating their mundane habits, like sleeping 14 hours and barking at the mailman, as legendary method acting. It closes with a theatrical title card announcing the dog's blockbuster debut.","audience":"Pet owners who love cinematic humor and want to celebrate their dog as a superstar","tone":"cinematic, dramatic, playful, epic","goal":"Make the viewer laugh and feel entertained by framing their dog as a legendary movie icon","keyMessages":["From backyard nap-taker to Hollywood legend","Everyday habits turned into high-stakes drama","The breakout dog actor of the year","Coming soon to a couch near you"],"mustIncludeFacts":[],"brandColors":["#FFD700","#8B0000","#121212"],"suggestedFramePack":"vapor-chrome","suggestedDuration":30,"musicMood":"epic orchestral trailer","voProfile":"male, deep movie-trailer voice, dramatic, booming"},"script":{"title":"The Next Hollywood Action Hero","scenes":[{"id":"s1","start":0,"duration":4.5,