pe":"image","sceneId":"s3","startSec":7,"durationSec":5,"style":"inset","alt":"REAL website screenshot of Bulkdoor - India's #1 B2B Beauty, Cosmetics & Skincare Wholesale Marketplace | Bulk Buy 50+ Brands (page section 2) — present in a styled browser frame with hero treatment","license":"owner content","sourceUrl":"https://bulkdoor.in","source":"website","fromCache":false},{"path":"assets/images/site_2.png","type":"image","sceneId":"s4","startSec":12,"durationSec":5,"style":"inset","alt":"REAL website screenshot of Bulkdoor - India's #1 B2B Beauty, Cosmetics & Skincare Wholesale Marketplace | Bulk Buy 50+ Brands (page section 3) — present in a styled browser frame with hero treatment","license":"owner content","sourceUrl":"https://bulkdoor.in","source":"website","fromCache":false}],"captions":[{"start":0,"end":2.2,"text":"Tired of sourcing hassles?"},{"start":3,"end":6.95,"text":"Bulkdoor: India's #1 B2B beauty marketplace."},{"start":7,"end":11.95,"text":"Source over 50 brands, with MOQs as low as 6 units."},{"start":12,"end":14.475,"text":"Get 100% authentic products, GST"},{"start":14.475,"end":16.95,"text":"billing, and Pan-India delivery."},{"start":17,"end":20.75,"text":"Your wholesale beauty gateway. Try Bulkdoor."}],"srt_url":"/videos/sec69bwasa.srt","final_attempt":"qa-repair","qa":{"pass":false,"score":2,"issues":[{"atSec":0.6,"severity":"blocker","issue":"UNDER-ILLUSTRATED FRAME","fix":"The frame shows only text on a black background. Add at least 2-3 distinct visual elements, such as animated vector shapes, particles, or an inset image, to support the text."},{"atSec":1.8,"severity":"blocker","issue":"UNDER-ILLUSTRATED FRAME","fix":"The frame shows only text on a black background. Add at least 2-3 distinct visual elements, such as animated vector shapes, particles, or an inset image, to support the text."},{"atSec":5.4,"severity":"blocker","issue":"UNDER-ILLUSTRATED FRAME","fix":"The frame shows only text on a black background with some small colored squares. Add more substantial visual elements like an animated graphic, a product screenshot, or illustrative vectors to support the text."},{"atSec":10,"severity":"blocker","issue":"UNDER-ILLUSTRATED FRAME","fix":"The frame shows a screenshot of an application with minimal surrounding elements. Enlarge the screenshot to occupy at least 50% of the frame and add supporting decorative elements or animations to meet the minimum illustration requirement."},{"atSec":15,"severity":"blocker","issue":"UNDER-ILLUSTRATED FRAME","fix":"The frame shows a screenshot of an application with minimal surrounding elements. Enlarge the screenshot to occupy at least 50% of the frame and add supporting decorative elements or animations to meet the minimum illustration requirement."},{"atSec":18.8,"severity":"blocker","issue":"UNDER-ILLUSTRATED FRAME","fix":"The frame shows only text on a black background. Add at least 2-3 distinct visual elements, such as animated vector shapes, particles, or an inset image, to support the text."}]}},{"id":"hx2kv5dv8d","kind":"project","prompt":"A high-energy 20-second vertical promo for Bulkdoor (bulkdoor.in), India's #1 B2B beauty & cosmetics wholesale marketplace. Punchy hook, clear value proposition, modern motion-design, bold legible hero text filling the frame, confident voiceover, upbeat music, strong call-to-action ending on the brand. Premium, trustworthy, fast-paced. Clean design-system backgrounds and the real website screenshots; no off-brand stock imagery; no empty scenes.","duration":20,"orientation":"vertical","quality":"1080p","width":1080,"height":1920,"fps":30,"frame_pack":"blockframe","status":"done","progress":"finalizing","video_url":null,"error":null,"used_fallback":0,"llm_tokens_in":766817,"llm_tokens_out":118888,"created_at":1782279235716,"started_at":1782279270015,"finished_at":1782280515404,"client_ip":"::1","voice_style":null,"captions_enabled":0,"upload_path":null,"intent":{"prompt":"A high-energy 20-second vertical promo for Bulkdoor (bulkdoor.in), India's #1 B2B beauty & cosmetics wholesale marketplace. Punchy hook, clear value proposition, modern motion-design, bold legible hero text filling the frame, confident voiceover, upbeat music, strong call-to-action ending on the brand. Premium, trustworthy, fast-paced. Clean design-system backgrounds and the real website screenshots; no off-brand stock imagery; no empty scenes.","websiteUrl":"https://bulkdoor.in","hasReferenceVideo":false,"preferences":{"duration":20,"orientation":"vertical","voiceStyle":"auto","framePack":"auto"},"website":{"url":"https://bulkdoor.in","title":"Bulkdoor - India's #1 B2B Beauty, Cosmetics & Skincare Wholesale Marketplace | Bulk Buy 50+ Brands","description":"Bulkdoor is India's First B2B wholesale marketplace for beauty, cosmetics, skincare, haircare & personal care. Buy Dot&Key, Lotus Herbals, Forever52 theboldeye, Mamaearth, Cetaphil & 50+ brands in bulk. MOQ from 6 units. 500+ SKUs. 100% authentic direct sourcing from verified suppliers. Pan-India delivery.","headings":["Your DirectGateway toWholesale Beauty","Welcome Back","Welcome Back","What is Bulkdoor?","Centralized Hub","Verification First","Scalable Growth","Source beauty stock with less guesswork","Buyer Confidence","What We Offer ?","Cosmetics","Skincare","Beauty Tools","Haircare","Fragrances","Our Services","Verified Supplier Sourcing","Authentic Products","Logistics Support","Market Analytics","How To Use Bulkdoor?","Login","Browse Brands","Select Quantity","Order & Delivery"],"bodyText":"Login\nB2B BEAUTY WHOLESALE\nYour Direct\nGateway to\nWholesale Beauty\n\nBulkdoor is a B2B wholesale marketplace in India for beauty, cosmetics, skincare, haircare and personal care products. It helps retailers, pharmacies, salons and resellers source from verified suppliers and brands - reducing traditional wholesaler layers. With low MOQ options, GST billing and Free doorstep delivery across India.\n\nBuilt for retailers, pharmacies, salons and resellers across India\n\nStart Shopping\nView Catalogue\n\nIndia's Trusted B2B Beauty Marketplace\n\n4.9/5\nWelcome Back\n\nAccess your wholesale Marketplace\n\nLogin\nRegister\n+91\nGet OTP\n\nBy continuing, you agree to our Terms of Service\n\nWhat is Bulkdoor?\n\nBulkdoor is a business-to-business(B2B) wholesale platform for beauty, cosmetics, skincare, haircare, and personal care products in India. It helps retailers, shop owners, pharmacies, salons, and resellers find products and buy in bulk with low MOQ. You get GST invoices and delivery across India - all from one place, with 100% authentic and original product quality.\n\nCentralized Hub\n\nAccess beauty, cosmetics, skincare, haircare and personal care products through a single interface for simpler bulk procurement.\n\nVerification First\n\nCheck supplier information, GST billing, product details and support terms before placing larger orders.\n\nScalable Growth\n\nStart with smaller quantities where available, then increase order size as your demand becomes predictable.\n\nBUILT FOR BUSINESS BUYING\nSource beauty stock with less guesswork\n\nBulkdoor helps retailers, pharmacies, salons and resellers buy beauty, cosmetics, skincare, haircare and personal care products through one B2B catalogue, with low MOQ options, GST billing and order support built into the sourcing flow.\n\n50+\nBRANDS\n500+\nSKUS\nGST\nBILLING\nPan-India\nDELIVERY\nBrowse Wholesale Products\nTalk to Sales\nBuyer Confidence\n\nA simple first-order path for new B2B buyers.\n\n01\nChoose the right Products\n\nSelect brands, categories, pack sizes, MOQ and wholesale pricing before adding stock.\n\n02\nVerify business details\n\nUse GST billing, product information and seller support to confirm your purchase terms.\n\n03\nStart with a controlled order\n\nChoose quantity and place your order easily. You can start small with low MOQ.\n\n04\nTrack delivery and reorder\n\nGet regular updates and use support to manage your inventory flow.\n\nWhat We Offer ?\n\nExplore a wide range of professional beauty product categories\n\nCosmetics\n\nA wide range of makeup products from trusted beauty brands.\n\nSkincare\n\nSkincare products for pharmacies, salons, beauty retailers and resellers.\n\nBeauty Tools\n\nProfessional beauty tools for precise and effective application.\n\nHaircare\n\nProfessional haircare products for healthy, beautiful hair.\n\nFragrances\n\nPopular perfumes and fragrances for every preference.\n\nOur Services\nVerified Supplier Sourcing\n\nSource through brand, distributor and supplier channels reviewed for business suitability, invoice readiness and product information quality.\n\nAuthentic Products\n\nBulkdoor prioritizes genuine inventory, clear product details and GST billing so business buyers can verify what they are purchasing before scaling orders.\n\nQUALITY GUARANTEED\nLogistics Support\n\nTracked fulfillment support from dispatch to delivery, with order updates designed for retailers, salons, resellers and distributors.\n\nMarket Analytics\n\nUse category demand, brand availability and wholesale pricing signals to plan inventory more carefully and reduce dead stock.\n\n85%\nACCURACY\n24/7\nUPTIME\n4.8/5\nRATING\nHow To Use Bulkdoor?\n\nGet started in 4 simple steps\n\n1\nLogin\n\nQuick access using your Mobile Number and OTP.\n\n2\nBrowse Brands\n\nExplore beauty, skincare, haircare and personal care products from listed brands.\n\n3\nSelect Quantity\n\nChoose the exact quantities you need for your business inventory.\n\n4\nOrder & Delivery\n\nSet payment method and tracked delivery to your doorstep.\n\nGame Changer for Small Businesses\nLow MOQ Options.\nWholesale Pricing.\n\nStart with s","brandColors":["#0F314F","#0B243B","#2E4D69","#2A445B"],"ogImage":"https://www.bulkdoor.in/logo.png","hasRealScreenshots":3},"__ingested":true},"autopilot":1,"brief":{"improvedPrompt":"A 20-second vertical, high-energy promo for Bulkdoor, India's #1 B2B beauty and cosmetics wholesale marketplace. The video opens with a punchy hook targeting retailers, pharmacies, salons, and resellers, immediately followed by a clear value proposition showcasing Bulkdoor as the direct gateway to wholesale beauty. It emphasizes ease of use, authentic products, low MOQs, GST billing, and pan-India delivery. The visual style is modern motion design with bold, legible hero text, clean backgrounds, and real website screenshots. The tone is premium, trustworthy, and fast-paced, ending with a strong call-to-action on the Bulkdoor brand.","audience":"Retailers, pharmacies, salons, and resellers in India looking to purchase beauty, cosmetics, skincare, haircare, and personal care products in bulk.","tone":"premium, trustworthy, fast-paced, confident, bold","goal":"Drive viewers to visit Bulkdoor and explore wholesale beauty products for their business.","keyMessages":["India's #1 B2B Beauty & Cosmetics Wholesale Marketplace","Your Direct Gateway to Wholesale Beauty","Buy 50+ Brands, 500+ SKUs, Low MOQ","100% Authentic Products, GST Billing, Pan-India Delivery"],"mustIncludeFacts":["India's #1 B2B beauty & cosmetics wholesale marketplace","Buy 50+ Brands","500+ SKUs","MOQ from 6 units","100% authentic direct sourcing from verified suppliers","Pan-India delivery","GST billing"],"brandColors":["#0F314F","#0B243B","#2E4D69","#2A445B"],"suggestedFramePack":"blockframe","suggestedDuration":20,"musicMood":"upbeat, driving electronic","voProfile":"male or female, confident, clear, slightly authoritative, modern"},"script":{"title":"Bulkdoor: India's Wholesale Beauty Gateway","scenes":[{"id":"s1","start":0,"duration":3,"purpose":"hook","voiceover":"Tired of chasing wholesale beauty?","onScreenText":["Wholesale Beauty Hassles?"],"visualDirection":"Fast cuts of cluttered shelves and stressed retailers, resolving into a bold, abstract graphic.","assetNeeds":[],"sfx":["impact"],"musicCue":"intro"},{"id":"s2","start":3,"duration":4,"purpose":"context","voiceover":"Introducing Bulkdoor: India's #1 B2B beauty and cosmetics wholesale marketplace.","onScreenText":["India's #1 B2B Wholesale Marketplace"],"visualDirection":"The Bulkdoor logo animates center screen with a clean, energetic reveal over a dark, branded background.","assetNeeds":[],"sfx":["riser","pop"],"musicCue":"build"},{"id":"s3","start":7,"duration":5,"purpose":"feature","voiceover":"Your direct gateway to authentic products and low MOQs. Buy 50+ brands, over 500 SKUs.","onScreenText":["50+ Brands","500+ SKUs","Low MOQ: From 6 Units"],"visualDirection":"A dynamic carousel showcases product categories, zooming into specific items with their brand and SKU count.","assetNeeds":[{"type":"image","query":"cosmetics product collage","role":"background"}],"sfx":["swoosh","click"],"musicCue":"steady"},{"id":"s4","start":12,"duration":4,"purpose":"proof","voiceover":"Shop with confidence: 100% authentic sourcing, GST billing, and pan-India delivery.","onScreenText":["100% Authentic","GST Billing","Pan-India Delivery"],"visualDirection":"Icons representing authenticity, GST, and delivery animate and arrange themselves neatly on screen.","assetNeeds":[],"sfx":["ding","sparkle"],"musicCue":"lift"},{"id":"s5","start":16,"duration":4,"purpose":"cta","voiceover":"Visit Bulkdoor. Your wholesale beauty business, amplified.","onScreenText":["Visit Bulkdoor","bulkdoor.com"],"visualDirection":"The Bulkdoor logo appears large and centered, with a clear call-to-action button animating beneath it.","assetNeeds":[],"sfx":["riser","impact"],"musicCue":"outro"}],"music":{"mood":"upbeat, driving electronic","query":"upbeat driving electronic"},"voice":{"style":"male or female, confident, clear, slightly authoritative, modern","pace":"brisk"}},"script_warnings":[],"website_screenshot":"C:\\internship\\KEYFRAME\\server\\jobs\\hx2kv5dv8d\\ingest\\website.png","website_screenshots":["C:\\internship\\KEYFRAME\\server\\jobs\\hx2kv5dv8d\\ingest\\website.png","C:\\internship\\KEYFRAME\\server\\jobs\\hx2kv5dv8d\\ingest\\website_section2.png"