e":"text","heroScale":0.54},{"sceneId":"s6","archetype":"text","heroScale":0.54},{"sceneId":"s7","archetype":"text","heroScale":0.54},{"sceneId":"s8","archetype":"text","heroScale":0.54},{"sceneId":"s9","archetype":"text","heroScale":0.54},{"sceneId":"s10","archetype":"text","heroScale":0.54},{"sceneId":"s11","archetype":"text","heroScale":0.54},{"sceneId":"s12","archetype":"text","heroScale":0.54},{"sceneId":"s13","archetype":"quote","heroScale":0.54},{"sceneId":"s14","archetype":"cta","heroScale":0.54}],"score":{"compositionQuality":100,"source":"deterministic"}},"captions":[{"start":0,"end":3.75,"text":"Scattered feedback. Stalled roadmaps."},{"start":4.3,"end":7.949999999999999,"text":"Noisy tools everywhere. No single system."},{"start":8.5,"end":13.35,"text":"Linear. The product development system for teams and agents."},{"start":13.9,"end":18,"text":"Turn conversations into actionable issues."},{"start":18.55,"end":22.950000000000003,"text":"Purpose-built for planning and building with AI agents."},{"start":23.5,"end":28.2,"text":"Define direction. Align initiatives and PRDs."},{"start":28.75,"end":32.65,"text":"Move work. Ship with high velocity."},{"start":33.25,"end":37.8,"text":"Seamless shared workflows from PRD to PR."},{"start":38.35,"end":42.25,"text":"Humans and agents, side by side."},{"start":42.85,"end":46.900045,"text":"Understand progress at every scale."},{"start":47.45,"end":50.650000000000006,"text":"Make product operations self-driving."},{"start":51.95,"end":55.900000000000006,"text":"Designed for speed. Ship with focus."},{"start":56.45,"end":60.1,"text":"Built for the future. Available today."},{"start":60.95,"end":62.45,"text":"Start with Linear."}],"srt_url":"/videos/41n2phac6k.srt","final_attempt":"qa-repair","qa":{"pass":false,"score":6,"issues":[{"atSec":6.8,"severity":"blocker","issue":"Text in the third card is cut off mid-word ('wi'), and the second card has a single letter 'a' awkwardly wrapped to a new line.","fix":"Reduce the font size of the body text inside the cards or increase the card container width so the text fits cleanly without clipping."},{"atSec":26.7,"severity":"blocker","issue":"Text inside the browser mockup is cut off mid-word ('Plan and navigat' instead of 'navigate').","fix":"Correct the spelling to 'navigate' and adjust the text container width or font size to prevent clipping."}]},"quality_report":{"verdict":"flagged","flags":["QA: 2 blocker(s)"],"contrast":{"checked":true,"fixed":0,"remaining":0,"passes":0},"identity":{"remapped":2},"layout":{"duplicatesRemoved":42,"collisionsScrimmed":0},"assetFloor":null,"audio":{"lufs":-13.39,"peak":-0.51,"lra":3.2,"target":-14,"layers":{"voice":14,"sfx":10,"music":true,"ambient":false,"musicEnvelope":false}},"screenshots":{"kept":4,"dropped":0,"repinned":1,"problems":[]},"assetQuality":86,"templateFit":91,"qa":{"pass":false,"score":6,"skipped":false,"blockers":2}}},{"id":"emdz2fw4ez","kind":"project","prompt":"","duration":150,"orientation":"horizontal","quality":"1080p","width":1920,"height":1080,"fps":30,"frame_pack":"aurora-spectrum","frame_pack_user":1,"status":"done","progress":"finalizing","video_url":"/videos/emdz2fw4ez.mp4","error":null,"used_fallback":0,"llm_tokens_in":65809,"llm_tokens_out":44150,"created_at":1784783589952,"started_at":1784785738535,"finished_at":1784786827244,"client_ip":"::1","voice_style":null,"captions_enabled":0,"upload_path":null,"task":null,"requeue_count":1,"intent":{"prompt":"","websiteUrl":"https://linear.app","blogUrl":null,"hasReferenceVideo":false,"preferences":{"duration":150,"orientation":"horizontal","voiceStyle":"auto","framePack":"aurora-spectrum"},"website":{"url":"https://linear.app","title":"Linear – The system for product development","description":"Purpose-built for planning and building products with AI agents.","headings":["The product development system for teams and agentsThe product developmentsystem for teams and agentsThe product development system for teams and agents","Faster app launch","A new species of product tool. Purpose-built for modern teams with AI workflows at its core, Linear sets a new standard for planning and building products.","Make product operations self-driving","Define the product direction","Move work forward across teams and agents","Review PRs and agent output","Understand progress at scale","Changelog","Built for the future. Available today.","Product","Features","Company","Resources","Connect","Legal"],"bodyText":"Skip to content →\nProduct\nResources\nCustomers\nPricing\nNow\nContact\nLog in\nSign up\nThe product development\nsystem for teams and agents\nThe product development system for teams and agents\n\nPurpose-built for planning and building products. Designed for the AI era.\n\nNew\nCoding Sessions →\nLinear\nInbox\nMy issues\nReviews\nPulse\nWorkspace\nInitiatives\nProjects\nMore\nFavorites\nFaster app launch\nAgent tasks\nUI Refresh\nAgents Insights\nFaster app launch\n02\n/\n145\nFaster app launch\n\nRender UI before vehicle_state sync when minimum required state is present, instead of blocking on full refresh during iOS startup.\n\nActivity\nLinear created the issue via Slack on behalf of karri · 2min ago\nTriage Intelligence added the label Performance and iOS · 2min ago\nkarri\n· 4 min ago\nRight now we show a spinner forever, which makes it look like the car disappeared...\njori\n· just now\n@Linear can you take a stab at this?\nLinear\nconnected by\njori\n·\n2 min ago\nChanged 2 files\nDraft PR awaiting your review\n·\n2 min ago\nLinear moved from Todo to In Progress · just now\nLinearOpus 4.8\njori\nconnected Linear to ENG-2703\nExamining the startup path...\nThinking...\nENG-2703\nIn Progress\nHigh\njori\nLinear\nLabels\nPerformance\niOS\nCycle\nCycle 144\nProject\nCore Performance\nA new species of product tool. Purpose-built for modern teams with AI workflows at its core, Linear sets a new standard for planning and building products.\nFIG 0.2\nPurpose-built\n\nLinear is shaped by the practices and principles of world-class product teams.\n\nFIG 0.3\nPowered by agents\n\nDesigned for workflows shared by humans and agents, from PRD to PR.\n\nFIG 0.4\nDesigned for speed\n\nReduces noise and restores momentum to help teams ship with high velocity and focus.\n\nMake product operations self-driving\n\nTurn conversations and customer feedback into actionable issues that are routed, labeled, and prioritized for the right team.\n\n1.0Intake→\nBacklog\n8\nENG-2085\nReduce UI flicker during autonomy...\nENG-2094\nAdd buffering for autonomy event streams\nENG-2092\nReduce startup delay caused by vehicle sync\nENG-2200\nFix delayed route updates during rerouting\nTodo\n71\nENG-926\nRemove UI inconsistencies\nBug\nDesign\nENG-2088\nTypeError: Cannot read properties\nBug\nENG-924\nUpgrade to Claude Opus 4.8\nAI\nENG-1882\nOptimize load times\nPerformance\nIn Progress\n3\nENG-1487\nRemove contentData from GraphQL API\n61039\nMKT-1028\nLaunch page assets\nDesign\nENG-2187\nPrevent duplicate ride requests on poor...\nBug\n62048\nDone\n53\nENG-2074\nClean up deprecated APIs...\nAPI\n61002\nENG-1912\nReduce latency in autonomy st...\n61005\nENG-1951\nReduce ETA fluctuations durin...\n61202\nENG-1960\nImprove fallback messaging\nUI\n61149\nENG-1991\nImprove rider visibility into veh...\nThread in #feedback\ndidier\n10:43 AM\nHas anyone been looking into the iOS startup performance issues?\nlena\n10:43 AM\nAnyone else noticing the iOS app feels slow to open if you haven't used it in a bit?\ndidier\n10:43 AM\nYea, we're still blocking initial render on a full vehicle_state sync every time...\nandreas\n10:43 AM\nFeels like we could render sooner and load the rest in the background. Probably also worth tracking startup timing so we know how often this happens!\n@Linear\ncreate urgent issues and assign to me\n1.1\nLinear Agent +\n1.2\nTriage +\n1.3\nCustomer Requests +\n1.4\nLinear Asks +\nDefine the product direction\n\nPlan and navigate from idea to launch. Align your team with product initiatives, strategic roadmaps, and clear, up-to-date PRDs.\n\n2.0Plan→\nFEB\nMAR\nAPR\nMAY\nJUN\nJUL\nAUG\nSEP\n2\n9\n16\n23\n2\n9\n16\n23\n30\n6\n13\n20\n27\n4\n11\n18\n25\n1\n8\n15\n22\n29\n6\n13\n20\n27\n3\n10\n17\n24\n31\n7\n14\n21\n28\nUI Refresh\nCore screens\nPolish\nSplit fares\nInternal\nPublic Beta\nAutonomy status clarity\nAlpha\nGA\nInitiatives\nCore Product\n99\nInfra stability\n28\nAutonomous systems\n16\nMobile apps\n8\nAPAC Expansion\n21\nJapan Launch\n12\nCustomer-driven priorities\n9\n2.1\nProjects +\n2.2\nDocuments +\n2.3\nInitiatives +\n2.4\nVisual planning +\nMove work forward across teams and agents\n\nBuild and deploy AI agents that work alongside your team. Work on complex tasks toget","brandColors":["#191917","#27261A","#201E12"],"ogImage":"https://linear.app/static/og/homepage.jpg","hasRealScreenshots":3},"__ingested":true},"autopilot":1,"render3d":0,"compose_mode":"standard","brief":{"improvedPrompt":"A 150-second horizontal brand film for Linear, the product development system purpose-built for modern teams and AI agents. It opens on the chaos of scattered feedback, stalled roadmaps, and handoff friction, then reveals Linear as a new species of product tool: intake that turns conversations into prioritized issues, initiatives and visual planning that define direction, agents that move work from PRD to PR alongside humans, and live progress views that restore focus at scale. Built for product and engineering leaders who want operations to become self-driving. Premium, calm, and decisive — it closes on the promise that this future is available today.","subject":"product development software dashboard UI","audience":"Product managers, eng leaders, and modern product teams building with AI agents","tone":"premium, confident, sleek, understated","goal":"Convince viewers Linear is the definitive AI-era product system — and drive them to try it","keyMessages":["The product development system for teams and agents","Purpose-built for planning and building products in the AI era","Make product operations self-driving","Move work forward across teams and agents — from PRD to PR","Define product direction with initiatives, roadmaps, and PRDs","Built for the future. Available today."],"mustIncludeFacts":["The product development system for teams and agents","Purpose-built for planning and building products with AI agents","Designed for the AI era","A new species of product tool","Make product operations self-driving","Powered by agents — workflows shared by humans and agents, from PRD to PR","Designed for speed — helps teams ship with high velocity and focus","Built for the future. Available today."],"brandColors":["#191917","#27261A","#201E12"],"suggestedFramePack":"aurora-spectrum","suggestedDuration":150,"musicMood":"atmospheric minimal electronica","voProfile":"male, mid-30s, calm, precise, quietly confident"},"script":{"title":"Linear: Built for Teams and Agents","scenes":[{"id":"s1","start":0,"duration":3.5,"purpose":"hook","voiceover":"Product development is chaos.","onScreenText":["Chaos."],"visualDirection":"Fast cut montage of overlapping sticky notes and chat bubbles exploding outward from a dark center, camera pushing hard into the mess.","assetNeeds":[],"sfx":["impact"],"musicCue":"intro"},{"id":"s2","start":3.5,"duration":3.5,"purpose":"context","voiceover":"Feedback floods every channel.","onScreenText":["Scattered feedback"],"visualDirection":"A cascade of message bubbles and email fragments rains down past camera on layered planes.","assetNeeds":[{"type":"icon","query":"chat bubble","role":"inset"}],"sfx":["whoosh"],"musicCue":"intro"},{"id":"s3","start":7,"duration":4,"purpose":"context","voiceover":"Roadmaps stall. Priorities blur.","onScreenText":["Stalled roadmaps"],"visualDirection":"A timeline of cards freezes mid-scroll, edges soft-focus as the camera drifts past unfinished milestones.","assetNeeds":[{"type":"icon","query":"calendar","role":"inset"}],"sfx":[],"musicCue":"build"},{"id":"s4","start":11,"duration":4,"purpose":"pain","voiceover":"Handoffs break. Context vanishes.","onScreenText":["Broken handoffs"],"visualDirection":"Two workspace halves split apart on a hinge; documents and notes dissolve into empty space between them.","assetNeeds":[{"type":"image","query":"frustrated team meeting office","role":"background"}],"sfx":["transition"],"musicCue":"build"},{"id":"s5","start":15,"duration":4,"purpose":"pain","voiceover":"Tools pile up. Focus fades.","onScreenText":["Too many tools"],"visualDirection":"App tiles stack and tilt into a chaotic tower as the camera orbits slowly around the clutter.","assetNeeds":[{"type":"icon","query":"grid apps","role":"inset"}],"sfx":[],"musicCue":"build"},{"id":"s6","start":19,"duration":4,"purpose":"pain","voiceover":"Agents arrive. Fragmentation stays.","onScreenText":["Still fragmented"],"visualDirection":"A lone human silhouette and a glowing agent orb stand on separate platforms that never connect, camera drifting between them.","assetNeeds":[{"type":"icon","query":"sparkle","role":"inset"},{"type":"image","query":"solo developer laptop night desk","role":"background"}],"sfx":["riser"],"musicCue":"build"},{"id":"s7","start":23,"duration":3.5,"purpose":"hook","voiceover":"Until now.","onScreenText":["Until now."],"visualDirection":"All chaos freezes, then collapses inward to a single dark point of light, hard cut to black.","assetNeeds":[],"sfx":["impact"],"musicCue":"build"},{"id":"s8","start":26.5,"duration":5,"purpose":"feature","voiceover":"Linear. A new species of product tool.","onScreenText":["A new species","of product tool"],"visualDirection":"The Linear product UI materializes in a floating browser frame, camera slowly pushing in across a clean dark interface.","assetNeeds":[],"sfx":["sparkle","whoosh"],"musicCue":"steady"},{"id":"s9","start":31.5,"duration":5,"purpose":"feature","voiceover":"The product development system for teams and agents.","onScreenText":["Teams + Agents"],"