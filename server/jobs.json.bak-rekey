","assetNeeds":[{"type":"image","query":"dog lounging couch living room","role":"background"}],"sfx":["impact"],"musicCue":"intro"},{"id":"s2","start":4,"duration":4,"purpose":"context","voiceover":"From couch companion to red-carpet legend.","onScreenText":["Couch to legend"],"visualDirection":"Camera tracks beside the dog striding a red carpet under golden lights as paparazzi flashes burst past.","assetNeeds":[{"type":"image","query":"dog walking red carpet glamorous","role":"background"}],"sfx":["whoosh"],"musicCue":"build"},{"id":"s3","start":8,"duration":4,"purpose":"feature","voiceover":"Hollywood glamour for your best friend.","onScreenText":["Hollywood glamour"],"visualDirection":"Slow orbital move around a side-lit dog as gold particles drift past on layered planes.","assetNeeds":[{"type":"image","query":"dog dramatic spotlight golden light","role":"background"}],"sfx":["sparkle"],"musicCue":"steady"},{"id":"s4","start":12,"duration":4,"purpose":"proof","voiceover":"Your dog is a movie star.","onScreenText":["Movie star"],"visualDirection":"Hero letterbox push-in: the dog fills the frame under sweeping spotlights with pure leading-role energy.","assetNeeds":[{"type":"image","query":"proud dog cinematic portrait closeup","role":"background"}],"sfx":["ding","impact"],"musicCue":"lift"},{"id":"s5","start":16,"duration":4,"purpose":"cta","voiceover":"Give them the premiere they deserve.","onScreenText":["The premiere they deserve"],"visualDirection":"The dog owns center stage as golden title treatment settles and a soft epic pulse breathes behind them.","assetNeeds":[],"sfx":["riser"],"musicCue":"outro"}],"music":{"mood":"playful epic trailer swell","query":"playful epic trailer"},"voice":{"style":"male, mid-40s, gravelly trailer announcer, warm and wry","pace":"brisk"}},"script_warnings":[],"usage":{"byStage":[{"stage":"storyboard","model":"grok-4-5","inputTokens":10246,"outputTokens":3408,"totalTokens":13654,"callCount":1,"costUsd":0.016376},{"stage":"qa","mo