e screenshot — matches this scene's topic — present in a styled browser frame with hero treatment","license":"owner content","sourceUrl":"https://linear.app/plan","source":"website","fromCache":false,"clipRelevance":0.998,"cdScore":94,"sees":"Dark mode website screenshot showing roadmap planning elements.","cdProminence":"hero","sectionType":"features","visionOk":true,"kind":"shot","fit":"cover","focus":"top","effect":"rise","quality":"high","cropFocus":"top center","container":"browser"},{"path":"assets/images/9.jpg","type":"image","sceneId":"s5","startSec":59,"durationSec":4.5,"style":"background","alt":"diverse team whiteboard planning office","width":1280,"height":800,"license":"Pixabay Content License","sourceUrl":"https://pixabay.com/photos/computer-laptop-notebook-technology-3174729/","source":"cache:pixabay","fromCache":true,"clipRelevance":0.948,"cdScore":80,"sees":"Floating laptop with multiple transparent UI screens projecting outwards.","cdProminence":"support","visionOk":true,"kind":"photo","fit":"cover","focus":"center","effect":"zoom","quality":"ok","cropFocus":"center center"},{"path":"assets/images/10.jpg","type":"image","sceneId":"s3","startSec":68.5,"durationSec":4.5,"style":"background","alt":"engineer dual monitors morning light","width":1280,"height":853,"license":"Pixabay Content License","sourceUrl":"https://pixabay.com/illustrations/ai-generated-software-developer-8942079/","source":"cache:pixabay","fromCache":true,"clipRelevance":0.675,"cdScore":73,"sees":"Man looking at CAD mechanical blueprint on a computer monitor","cdProminence":"support","visionOk":true,"kind":"photo","fit":"cover","focus":"center","effect":"blur-in","quality":"high","cropFocus":"center center"},{"path":"assets/images/14.jpg","type":"image","sceneId":"s2","startSec":99,"durationSec":4,"style":"background","alt":"hands typing laptop closeup focus","width":1280,"height":853,"license":"Pixabay Content License","sourceUrl":"https://pixabay.com/photos/computer-desk-typing-l