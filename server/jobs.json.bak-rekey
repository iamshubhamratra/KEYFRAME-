","fromCache":false},{"path":"assets/images/0.jpg","type":"image","sceneId":"s1","startSec":0,"durationSec":3.5,"style":"background","alt":"fast paced chaotic collage","width":1280,"height":731,"license":"Pixabay Content License","sourceUrl":"https://pixabay.com/vectors/browser-internet-web-search-tab-1666982/","source":"cache:pixabay","fromCache":true},{"path":"assets/images/3.svg","type":"image","sceneId":"s2","startSec":3.5,"durationSec":4.5,"style":"background","alt":"smooth push onto sleek","width":128,"height":128,"license":"Open source (Iconify — per-set license)","sourceUrl":"https://icon-sets.iconify.design/","source":"iconify","fromCache":false}]},{"id":"premiummrd9gt2q","kind":"generate","prompt":"Launch announcement for Prism, a design collaboration platform where product teams brainstorm, prototype, and ship together in real time. Ideas move from sketch to shipped, faster than ever.","duration":18,"orientation":"horizontal","quality":"720p","width":1280,"height":720,"fps":30,"frame_pack":"prism-launch","status":"done","progress":"finalizing","video_url":"/videos/premiummrd9gt2q.mp4","error":"server restarted while job was in-flight","used_fallback":0,"llm_tokens_in":0,"llm_tokens_out":0,"created_at":1783586694194,"started_at":1783586694225,"finished_at":1783666016218,"client_ip":"local","voice_style":null,"captions_enabled":0,"upload_path":null,"intent":null,"autopilot":0,"render3d":0,"compose_mode":null,"brief":null,"script":null,"script_warnings":null},{"id":"cinemamrd9pv13","kind":"generate","prompt":"A cinematic teaser for Helix, the AI engine that turns raw data into decisions at the speed of thought. See the future of intelligent software.","duration":18,"orientation":"horizontal","quality":"720p","width":1280,"height":720,"fps":30,"frame_pack":"midnight-glass","status":"done","progress":"finalizing","video_url":"/videos/cinemamrd9pv13.mp4","error":"server restarted while job was in-flight","used_fallback":0,"llm_tokens_in":0,"llm_tokens_out":0,"created_at":1783587116631,"started_at":1783587116635,"finished_at":1783666016215,"client_ip":"local","voice_style":null,"captions_enabled":0,"upload_path":null,"intent":null,"autopilot":0,"render3d":0,"compose_mode":null,"brief":null,"script":null,"script_warnings":null},{"id":"27b83lmw1r","kind":"project","prompt":"A 20-second energetic promo for Notion, the all-in-one workspace for notes, docs, and project management.","duration":20,"orientation":"horizontal","quality":"1080p","width":1920,"height":1080,"fps":30,"frame_pack":"mono-corporate","status":"done","progress":"finalizing","video_url":"/videos/27b83lmw1r.mp4","error":null,"used_fallback":0,"llm_tokens_in":46625,"llm_tokens_out":2881,"created_at":1783589045944,"started_at":1783589086533,"finished_at":1783589734825,"client_ip":"::1","voice_style":null,"captions_enabled":0,"upload_path":null,"intent":{"prompt":"A 20-second energetic promo for Notion, the all-in-one workspace for notes, docs, and project management.","websiteUrl":"https://www.notion.com/","hasReferenceVideo":false,"preferences":{"duration":20,"orientation":"horizontal","voiceStyle":"auto","framePack":"auto"},"website":{"url":"https://www.notion.com/","title":"The AI workspace that works for you. | Notion","description":"Build Custom Agents, search across all your apps, and automate busywork. The AI workspace where teams get more done, faster.","headings":["Capture","Find","Automate","Where teams and agents Create together.","Keep work moving 24/7.","Automate repetitive work for your team.","See what Custom Agents can do","Triage product feedback→","Resolve support tickets in Slack→","Respond to security alerts faster→","Automate weekly reporting→","Create your own Custom Agent→","Ask your on-demand assistants.","You assign the tasks. Notion Agent does the work.","One search for everything.","Perfect notes, every time.","Bring all your work together.","Simple and powerful.","One source of truth for teams and agents.","Less tracking. More progress.","Trusted by teams that ship.","Get started today."],"bodyText":"Product\nSolutions\nResources\nDevelopers\nEnterprise\nPricing\nRequest a demo\nGet Notion free\nLog in\nWhere teams and agents \nCreate\n together.\n\nCapture context, find answers, and automate tasks with AI built for your team.\n\nGet Notion free\nRequest a demo\nPlay\n\nTrusted by 98% of the Forbes Cloud 100\n\nKeep work moving 24/7.\nCustom Agents\nAutomate repetitive work for your team.\n→\nQ&A agents\n\nAnswers questions instantly using knowledge you already have.\n\nTask routing agents\n\nAssigns, prioritizes, and routes tasks on its own.\n\nReporting agents\n\nSummarizes, writes, and sends reports for you.\n\nCreate your own\n\nMake a Custom Agent for any work that repeats.\n\nSee what Custom Agents can do\n \nTriage product feedback→\n \nResolve support tickets in Slack→\n \nRespond to security alerts faster→\n \nAutomate weekly reporting→\n \nCreate your own Custom Agent→\nAsk your on-demand assistants.\n \nNotion Agent\nYou assign the tasks. Notion Agent does the work.\n→\n \nEnterprise Search\nOne search for everything.\n→\n \nAI Meeting Notes\nPerfect notes, every time.\n→\nBring all your work together.\n \nDocs\nSimple and powerful.\n→\n \nKnowledge Base\nOne source of truth for teams and agents.\n→\n \nProjects\nLess tracking. More progress.\n→\nYour AI everything app.\nTrusted by teams that ship.\nUsing the most AI-native tools like Notion is an important competitive advantage for us to stay small while doing a lot.\nMichael TruellCo-founder & CEO\nNotion’s thoughtful design speeds up collaboration and decisions so we can deliver impact to our customers faster.\nRenee SolorzanoSr. Director of Product Design\nNotion Custom Agents help our team go beyond doing work with AI to building AI tools that do the work for them.\nBen LevickHead of Operations & Internal AI\n\nG2’s #1 knowledge base for 3 consecutive years\n\n100M users in over 50 countries\n\nOver 50% of YC companies\n\n1.4M+ community members\n\n62% of Fortune 100 use Notion\n\nG2’s #1 knowledge base for 3 consecutive years\n\n100M users in over 50 countries\n\nOver 50% of YC companies\n\n1.4M+ community members\n\n62% of Fortune 100 use Notion\n\nG2’s #1 knowledge base for 3 consecutive years\n\n100M users in over 50 countries\n\nOver 50% of YC companies\n\n1.4M+ community members\n\n62% of Fortune 100 use Notion\n\nGet started today.\nGet Notion free\nRequest a demo\nEnglish (US)\nCookie settings\n© 2026 Notion Labs, Inc.\nCompany\nAbout us\nCareers\nSecurity\nStatus\nTerms & privacy\nYour privacy rights\nDownload\niOS & Android\nMac & Windows\nCalendar\nWeb Clipper\nResources\nHelp center\nPricing\nBlog\nCommunity\nConnections\nTemplates\nPartner programs\nNotion for\nEnterprise\nSmall business\nPersonal\nExplore more→","brandColors":["#F0D0B4","#FFE2C9","#B7D7F3","#96C7F3"],"ogImage":"https://www.notion.com/front-static/meta/teams-and-agents.jpg","hasRealScreenshots":3},"__ingested":true},"autopilot":1,"render3d":0,"compose_mode":null,"brief":{"improvedPrompt":"A high-energy, 20-second horizontal promo for Notion, the AI-powered workspace. The video moves at a breakneck pace, targeting fast-moving modern teams who want to escape tool fatigue. It hooks the viewer on the chaos of scattered docs before revealing Notion as the single home for notes, docs, and custom AI agents that automate repetitive work. Visuals are clean and structural, showing rapid UI transformations from simple text to organized project boards and autonomous agents. It ends with a strong call to join over 100 million users worldwide.","subject":"software application interface and digital documents","audience":"Modern teams, startups, and knowledge workers drowning in tool sprawl","tone":"energetic, clean, productive, fast","goal":"Make teams feel that Notion is the ultimate, frictionless hub to run their entire workflow and automate busywork","keyMessages":["The AI workspace where teams and agents create together","One search for all your docs, notes, and projects","Automate repetitive work with Custom Agents"],"mustIncludeFacts":["100M users in over 50 countries","62% of Fortune 100 use Notion","G2’s #1 knowledge base for 3 consecutive years"],"brandColors":["#F0D0B4","#FFE2C9","#B7D7F3","#96C7F3"],"suggestedFramePack":"mono-corporate","suggestedDuration":20,"musicMood":"fast minimal electronic","voProfile":"male, late-20s, crisp, enthusiastic, fast-paced"},"script":{"title":"Notion AI Workspace Promo","scenes":[{"id":"s1","start":0,"duration":3.5,"purpose":"hook","voiceover":"Drowning in scattered docs and endless tabs?","onScreenText":["Too many tools?"],"visualDirection":"A chaotic, fast-moving grid of overlapping document windows and browser tabs collapses inward.","assetNeeds":[],"sfx":["riser"],"musicCue":"intro"},{"id":"s2","start":3.5,"duration":4.5,"purpose":"context","voiceover":"Meet Notion. One search for all your docs, notes, and projects.","onScreenText":["One search.","Everything in Notion."],"visualDirection":"The chaos resolves instantly into a clean, minimalist Notion interface with a pulsing search bar.","assetNeeds":[],"sfx":["impact"],"musicCue":"build"},{"id":"s3","start":8,"duration":4.5,"purpose":"feature","voiceover":"Now, automate repetitive work with Custom Agents that work for you.","onScreenText":["Custom Agents","Automate work"],"visualDirection":"A sidebar menu expands smoothly as an AI agent card populates a project board automatically.","assetNeeds":[{"type":"icon","query":"sparkle","role":"inset"}],"sfx":["pop"],"musicCue":"steady"},{"id":"s4","start":12.5,"duration":4,"purpose":"proof","voiceover":"Trusted by sixty-two percent of the Fortune one-hundred.","onScreenText":["62% of","Fortune 100"],"visualDirection":"A sleek, animated data visualization of corporate logos transforming into a bold 62% graphic.","assetNeeds":[],"sfx":["ding"],"musicCue":"lift"},{"id":"s5","start":16.5,"duration":3.5,"purpose":"cta","voiceover":"Join over one hund