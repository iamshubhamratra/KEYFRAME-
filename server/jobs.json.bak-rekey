y":100,"source":"deterministic"}},"captions":[{"start":0,"end":1.45,"text":"Messy thoughts everywhere?"},{"start":3,"end":6.25,"text":"Scattered ideas. Half-formed notes."},{"start":6.8,"end":11.175,"text":"NimbusNotes turns messy thoughts into organized notes."},{"start":11.73,"end":14.38,"text":"AI note-taking that structures for you."},{"start":14.93,"end":16.78,"text":"Try NimbusNotes today."}],"srt_url":"/videos/rvt5wtauu6.srt","final_attempt":"qa-repair","qa":{"pass":false,"score":6,"issues":[{"atSec":1.8,"severity":"blocker","issue":"An extraneous duplicate 'Messy thoughts?' text strip is rendered directly below the main headline, colliding with the bar chart graphic in the background.","fix":"Remove the duplicate text layer or adjust the layout container to prevent it from overlapping the background illustration."}]},"quality_report":{"verdict":"flagged","flags":["QA: 1 blocker(s)"],"contrast":{"checked":true,"fixed":1,"remaining":0,"passes":1},"identity":{"remapped":0},"layout":{"duplicatesRemoved":0,"collisionsScrimmed":24},"assetFloor":null,"audio":{"lufs":-14.97,"peak":-1.9,"lra":2,"target":-14,"layers":{"voice":5,"sfx":3,"music":true,"ambient":false,"musicEnvelope":false}},"screenshots":null,"assetQuality":79,"templateFit":80,"qa":{"pass":false,"score":6,"skipped":false,"blockers":1}}},{"id":"uf54lrpzsz","kind":"project","prompt":"A 15-second launch film for NimbusNotes, an AI note-taking app that turns messy thoughts into organized notes. Confident, modern tone; three quick feature beats; a strong closing call to action.","duration":15,"orientation":"horizontal","quality":"720p","width":1280,"height":720,"fps":30,"frame_pack":"liquid-glass","frame_pack_user":0,"status":"done","progress":"finalizing","video_url":"/videos/uf54lrpzsz.mp4","error":null,"used_fallback":0,"llm_tokens_in":56883,"llm_tokens_out":26361,"created_at":1784715474792,"started_at":1784715551437,"finished_at":1784716316955,"client_ip":"::1","voice_style":null,"captions_enabled":0,"upload_path":null,"task":null,"requeue_count":0,"intent":{"prompt":"A 15-second launch film for NimbusNotes, an AI note-taking app that turns messy thoughts into organized notes. Confident, modern tone; three quick feature beats; a strong closing call to action.","websiteUrl":null,"blogUrl":null,"hasReferenceVideo":false,"preferences":{"duration":15,"orientation":"horizontal","voiceStyle":"auto","framePack":"auto"}},"autopilot":1,"render3d":0,"compose_mode":"standard","brief":{"improvedPrompt":"A sharp 15-second horizontal launch film for NimbusNotes, an AI note-taking app that turns messy thoughts into organized notes. Aimed at busy knowledge workers drowning in half-finished ideas and scattered scribbles. Opens on the chaos of raw thoughts, then hits three quick confident feature beats showing messy input becoming clean, structured notes, and lands on a bold closing call to action to try NimbusNotes. Confident, modern, fast, and decisive — premium SaaS energy with zero fluff.","subject":"messy notes becoming clean app UI","audience":"Busy professionals and students who capture ideas but struggle to organize them","tone":"confident, modern, brisk, decisive","goal":"Feel the chaos of notes is solved — and try NimbusNotes now","keyMessages":["Messy thoughts become organized notes","AI note-taking that does the sorting for you","From chaos to clarity in seconds","Try NimbusNotes"],"mustIncludeFacts":["NimbusNotes","AI note-taking app","turns messy thoughts into organized notes"],"brandColors":["#0B1220","#6366F1","#F8FAFC"],"suggestedFramePack":"liquid-glass","suggestedDuration":15,"musicMood":"bright confident electronica","voProfile":"female, late-20s, crisp, confident, unhurried"},"script":{"title":"Messy Thoughts Become Clean Notes","scenes":[{"id":"s1","start":0,"duration":3,"purpose":"hook","voiceover":"Messy thoughts piling up?","onScreenText":["Messy thoughts?"],"visualDirection":"Crumpled sticky notes and scribbled pages whirl chaotically into a dark frame, fast and restless.","assetNeeds":[{"type":"image","query":"scattered sticky notes paper desk","role":"background"}],"sfx":["impact"],"musicCue":"intro"},{"id":"s2","start":3,"duration":3,"purpose":"context","voiceover":"NimbusNotes — the AI note-taking app.","onScreenText":["AI note-taking"],"visualDirection":"The real product UI rises into a browser frame as the camera pushes in with quiet confidence.","assetNeeds":[],"sfx":["whoosh"],"musicCue":"build"},{"id":"s3","start":6,"duration":3.5,"purpose":"feature","voiceover":"Turns messy thoughts into organized notes.","onScreenText":["Messy in","Organized out"],"visualDirection":"Feature spotlight: camera zooms into the real UI as raw lines snap into clean structured note cards.","assetNeeds":[{"type":"icon","query":"notebook","role":"inset"}],"sfx":["pop","click"],"musicCue":"steady"},{"id":"s4","start":9.5,"duration":2.5,"purpose":"proof","voiceover":"Chaos to clarity in seconds.","onScreenText":["In seconds"],"visualDirection":"A sharp before-after wipe resolves into one pristine organized board with a soft upward lift.","assetNeeds":[{"type":"image","query":"focused woman laptop desk notes","role":"background"}],"sfx":["sparkle"],"musicCue":"lift"},{"id":"s5","start":12,"duration":3,"purpose":"cta","voiceover":"Try NimbusNotes now.","onScreenText":["Try NimbusNotes"],"visualDirection":"Logo locks center over a soft indigo pulse as a single glowing button settles into place.","assetNeeds":[],"sfx":["riser","impact"],"musicCue":"outro"}],"music":{"mood":"bright confident electronica","query":"bright confident electronica"},"voice":{"style":"female, late-20s, crisp, confident, unhurried","pace":"calm"}},"script_warnings":[],"usage":{"byStage":[{"stage":"qa","model":"google/gemini-3.5-flash","inputTokens":26805,"outputTokens":5805,"totalTokens":32610,"callCount":3,"costUsd":0.022554},{"stage":"storyboard","model":"grok-4-5","inputTokens":10292,"outputTokens":4940,"totalTokens":15232,"callCount":1,"costUsd":0.02009},{"stag