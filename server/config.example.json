{
  "server": {
    "port": 8080,
    "maxDurationSec": 600,
    "minDurationSec": 5,
    "rateLimitPerHourPerIp": 5,
    "dailyJobCap": 100,
    "videoTtlHours": 24,
    "renderQuality": "high",
    "watchdogMultiplier": 30,
    "watchdogBufferSec": 300,
    "watchdogMinSec": 900,
    "maxStorageMb": 500,
    "stageBudgetSec": 1200,
    "jobConcurrency": 2,
    "renderWorkers": 1
  },
  "llm": {
    "kieRoutes": {
      "gemini-3.6-flash": {
        "provider": "kie",
        "baseUrl": "https://api.kie.ai/gemini-3-6-flash-openai/v1",
        "api": "chat",
        "model": "gemini-3.6-flash"
      },
      "claude-opus-5": {
        "provider": "kie",
        "baseUrl": "https://api.kie.ai/claude/v1",
        "api": "messages",
        "model": "claude-opus-5"
      }
    },
    "provider": "openrouter",
    "model": "meta/muse-spark-1.3-contributor",
    "modelFast": "meta/muse-spark-1.3-contributor",
    "modelFallback": "google/gemini-3-flash-preview",
    "stageModels": {
      "storyboard": "meta/muse-spark-1.3-contributor",
      "composer": "meta/muse-spark-1.3-contributor",
      "assetPlanner": "meta/muse-spark-1.3-contributor",
      "audioPlanner": "meta/muse-spark-1.3-contributor",
      "brief": "meta/muse-spark-1.3-contributor",
      "script": "meta/muse-spark-1.3-contributor",
      "template_generator": "meta/muse-spark-1.3-contributor"
    },
    "stageEffort": {
      "text_director": "low",
      "screenshot_director": "low",
      "vo_fit": "low",
      "qa": "low",
      "scope": "low"
    },
    "noFallbackStages": [],
    "baseUrl": "https://openrouter.ai/api/v1",
    "apiKey": "",
    "maxTokens": {
      "default": 12288,
      "composer": 40960,
      "storyboard": 16384,
      "analysis": 4096,
      "scope": 2048
    },
    "storyboardMaxRetries": 1,
    "composerMaxRetries": 1,
    "composerLintRepairs": 2,
    "temperature": 0.7,
    "temperatureByStage": {
      "composer": 0.2
    },
    "requestTimeoutMs": 180000,
    "requestTimeoutByStage": {
      "composer": 300000,
      "analysis": 45000,
      "scope": 13000
    },
    "httpReferer": "https://video-gen.local",
    "xTitle": "video-gen",
    "premiumStages": [],
    "scriptEscalationModel": "meta/muse-spark-1.3-contributor",
    "scopeBudgetMs": 20000
  },
  "orientations": {
    "horizontal": {
      "aspectRatio": "16:9"
    },
    "vertical": {
      "aspectRatio": "9:16"
    },
    "square": {
      "aspectRatio": "1:1"
    }
  },
  "qualities": {
    "480p": {
      "short": 480,
      "long": 854
    },
    "720p": {
      "short": 720,
      "long": 1280
    },
    "1080p": {
      "short": 1080,
      "long": 1920
    }
  },
  "audio": {
    "pixabayKey": "",
    "freesoundToken": "",
    "ttsProvider": "auto",
    "ttsKieModel": "google/gemini-3-1-flash-tts",
    "ttsVoiceId": "Charon",
    "ttsModel": "openai/gpt-audio-mini",
    "defaultMusicVolume": 0.22
  },
  "defaults": {
    "orientation": "horizontal",
    "quality": "1080p",
    "fps": 30,
    "pace": "normal",
    "scriptOverlay": false
  },
  "allowedFps": [
    24,
    30,
    60
  ],
  "frames": {
    "dir": "../frames",
    "defaultPack": "bold-poster"
  },
  "render": {
    "hyperframesVersion": "0.6.120"
  },
  "orchestrator": "langgraph",
  "qa": {
    "enabled": true,
    "maxRepairs": 2
  },
  "stt": {
    "provider": "local",
    "localModel": "small",
    "pythonBin": "python"
  },
  "assetProviders": {
    "order": [
      "pixabay",
      "openverse",
      "pexels",
      "pixabay_scrape"
    ],
    "pixabay": {
      "apiKey": ""
    },
    "pexels": {
      "apiKey": ""
    }
  },
  "ingest": {
    "maxUploadMb": 200,
    "websiteTimeoutMs": 60000,
    "peekshot": {
      "apiKey": "",
      "projectId": null
    }
  },
  "paths": {
    "jobsDir": "jobs",
    "videosDir": "public/videos",
    "uploadsDir": "uploads",
    "dbFile": "jobs.json"
  },
  "auth": {
    "adminEmails": []
  }
}
