{
  "server": {
    "port": 8080,
    "maxDurationSec": 600,
    "minDurationSec": 5,
    "rateLimitPerHourPerIp": 5,
    "dailyJobCap": 100,
    "videoTtlHours": 24,
    "renderQuality": "high",
    "watchdogMultiplier": 30,
    "watchdogBufferSec": 300,
    "watchdogMinSec": 900,
    "maxStorageMb": 500,
    "stageBudgetSec": 1200,
    "jobConcurrency": 2,
    "renderWorkers": 1
  },
  "llm": {
    "primary": {
      "provider": "kie",
      "baseUrl": "https://api.kie.ai/grok/v1",
      "api": "responses",
      "model": "grok-4-5",
      "apiKey": ""
    },
    "kieRoutes": {
      "gemini-3.6-flash": {
        "provider": "kie",
        "baseUrl": "https://api.kie.ai/gemini-3-6-flash-openai/v1",
        "api": "chat",
        "model": "gemini-3.6-flash"
      },
      "claude-opus-5": {
        "provider": "kie",
        "baseUrl": "https://api.kie.ai/claude/v1",
        "api": "messages",
        "model": "claude-opus-5"
      }
    },
    "provider": "openrouter",
    "model": "meta/muse-spark-1.3-contributor",
    "modelFast": "meta/muse-spark-1.3-contributor",
    "modelFallback": "google/gemini-3-flash-preview",
    "stageModels": {
      "storyboard": "meta/muse-spark-1.3-contributor",
      "composer": "meta/muse-spark-1.3-contributor",
      "assetPlanner": "meta/muse-spark-1.3-contributor",
      "audioPlanner": "meta/muse-spark-1.3-contributor",
      "brief": "meta/muse-spark-1.3-contributor",
      "script": "meta/muse-spark-1.3-contributor",
      "template_generator": "meta/muse-spark-1.3-contributor"
    },
    "noFallbackStages": [
      "template_generator"
    ],
    "baseUrl": "https://openrouter.ai/api/v1",
    "apiKey": "",
    "maxTokens": {
      "default": 12288,
      "composer": 40960,
      "storyboard": 16384
    },
    "storyboardMaxRetries": 1,
    "composerMaxRetries": 1,
    "composerLintRepairs": 2,
    "temperature": 0.7,
    "temperatureByStage": {
      "composer": 0.2
    },
    "requestTimeoutMs": 180000,
    "requestTimeoutByStage": {
      "composer": 300000
    },
    "httpReferer": "https://video-gen.local",
    "xTitle": "video-gen",
    "premiumStages": [],
    "scriptEscalationModel": "kie:gemini-3.6-flash",
    "stageEffort": {
      "vo_fit": "minimal",
      "transcribe": "minimal",
      "vision": "minimal",
      "qa": "minimal",
      "creative_director": "minimal",
      "user_assets": "minimal"
    }
  },
  "orientations": {
    "horizontal": {
      "aspectRatio": "16:9"
    },
    "vertical": {
      "aspectRatio": "9:16"
    },
    "square": {
      "aspectRatio": "1:1"
    }
  },
  "qualities": {
    "480p": {
      "short": 480,
      "long": 854
    },
    "720p": {
      "short": 720,
      "long": 1280
    },
    "1080p": {
      "short": 1080,
      "long": 1920
    }
  },
  "audio": {
    "pixabayKey": "",
    "freesoundToken": "",
    "ttsProvider": "openrouter",
    "ttsKieModel": "google/gemini-3-1-flash-tts",
    "ttsVoiceId": "EkK5I93UQWFDigLMpZcX",
    "ttsModel": "openai/gpt-audio-mini",
    "defaultMusicVolume": 0.22,
    "ttsVoiceName": "Charon"
  },
  "defaults": {
    "orientation": "horizontal",
    "quality": "1080p",
    "fps": 30,
    "scriptOverlay": false,
    "pace": "normal"
  },
  "pacing": {
    "relaxed": {
      "label": "Relaxed",
      "multiplier": 0.8,
      "wordsPerSec": 2.3
    },
    "normal": {
      "label": "Normal",
      "multiplier": 1.0,
      "wordsPerSec": 2.6
    },
    "fast": {
      "label": "Fast",
      "multiplier": 1.25,
      "wordsPerSec": 2.0
    },
    "veryFast": {
      "label": "Very Fast",
      "multiplier": 1.5,
      "wordsPerSec": 1.7
    },
    "calibration": false
  },
  "allowedFps": [
    24,
    30,
    60
  ],
