{
  "server": {
    "port": 8080,
    "maxDurationSec": 150,
    "minDurationSec": 5,
    "rateLimitPerHourPerIp": 5,
    "dailyJobCap": 100,
    "videoTtlHours": 24,
    "renderQuality": "high",
    "watchdogMultiplier": 30,
    "watchdogBufferSec": 300,
    "watchdogMinSec": 900,
    "maxStorageMb": 500,
    "stageBudgetSec": 1200,
    "jobConcurrency": 2,
    "renderWorkers": 1
  },
  "llm": {
    "_comment": "Every LLM stage runs on KIE (llm.primary). llm.baseUrl/apiKey below are OpenRouter, kept ONLY for the voiceover (audio.ttsModel) and the budget probe.",
    "primary": {
      "provider": "kie",
      "model": "gemini-3-6-flash",
      "fallbackModel": "gemini-3-6-flash",
      "models": {
        "gemini-3-6-flash":   { "baseUrl": "https://api.kie.ai/gemini-3-6-flash-openai/v1", "protocol": "openai" },
        "grok-4-5":           { "baseUrl": "https://api.kie.ai/grok/v1",                    "protocol": "responses" },
        "qwen/qwen3.7-flash": { "baseUrl": "https://openrouter.ai/api/v1", "protocol": "openai", "provider": "openrouter", "reasoning": false }
      },
      "stageModels": {
        "composer":   "grok-4-5",
        "storyboard": "grok-4-5",
        "script":     "grok-4-5",
        "vo_fit":     "qwen/qwen3.7-flash",
        "dressing":   "qwen/qwen3.7-flash",
        "assets":     "qwen/qwen3.7-flash",
        "audio":      "qwen/qwen3.7-flash"
      },
      "apiKey": ""
    },
    "provider": "kie",
    "baseUrl": "https://openrouter.ai/api/v1",
    "apiKey": "",
    "maxTokens": {
      "default": 12288,
      "composer": 40960,
      "storyboard": 16384
    },
    "storyboardMaxRetries": 1,
    "composerMaxRetries": 1,
    "composerLintRepairs": 2,
    "temperature": 0.7,
    "temperatureByStage": {
      "composer": 0.2
    },
    "requestTimeoutMs": 180000,
    "requestTimeoutByStage": { "composer": 300000, "creative_director": 90000 },
    "httpReferer": "https://video-gen.local",
    "xTitle": "video-gen"
  },
  "orientations": {
    "horizontal": { "aspectRatio": "16:9" },
    "vertical":   { "aspectRatio": "9:16" },
    "square":     { "aspectRatio": "1:1" }
  },
  "qualities": {
    "480p":  { "short": 480,  "long": 854 },
    "720p":  { "short": 720,  "long": 1280 },
    "1080p": { "short": 1080, "long": 1920 }
  },
  "audio": {
    "pixabayKey": "",
    "freesoundToken": "",
    "ttsProvider": "auto",
    "ttsKieModel": "elevenlabs/text-to-speech-multilingual-v2",
    "ttsVoiceId": "EkK5I93UQWFDigLMpZcX",
    "ttsModel": "openai/gpt-audio-mini",
    "defaultMusicVolume": 0.22
  },
  "defaults": {
    "orientation": "horizontal",
    "quality": "1080p",
    "fps": 30
  },
  "allowedFps": [24, 30, 60],
  "frames": {
    "dir": "../frames",
    "defaultPack": "edition"
  },
  "render": {
    "hyperframesVersion": "0.6.120"
  },
  "creativeDirector": {
    "enabled": true,
    "maxPerScene": 2,
    "maxTopUp": 3,
    "chunkSize": 6,
    "minScore": 45,
    "rejectScore": 25
  },
  "orchestrator": "langgraph",
  "artDirector": {
    "_comment": "art_director is one of five stages whose stageModels entry is OVERWRITTEN at boot from its own block (see src/config.js). Set the model HERE, not in stageModels.",
    "model": "qwen/qwen3.7-flash"
  },
  "qa": {
    "enabled": true,
    "maxRepairs": 2
  },
  "stt": {
    "provider": "local",
    "localModel": "small",
    "pythonBin": "python"
  },
  "assetProviders": {
    "order": ["pixabay", "pexels", "unsplash", "openverse", "pixabay_scrape"],
    "pixabay":  { "apiKey": "" },
    "pexels":   { "apiKey": "" },
    "unsplash": { "apiKey": "" }
  },
  "ingest": {
    "maxUploadMb": 200,
    "websiteTimeoutMs": 60000,
    "maxSectionShots": 6
  },
  "paths": {
    "jobsDir": "jobs",
    "videosDir": "public/videos",
    "uploadsDir": "uploads",
    "dbFile": "jobs.json"
  }
}
