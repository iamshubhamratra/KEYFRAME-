# KEYFRAME server secrets — copy to `.env` and fill in. `.env` is gitignored.
# Rotate keys by editing `.env` only; no code or config.json changes needed.
#
# Provider split (see src/services/openrouter.js and src/services/tts.js):
#   LLM  -> OpenRouter ONLY. Every stage (brief, script, storyboard, composer,
#           the directors, vision/QA — config.json's whole llm.stageModels table)
#           runs on one model: meta/muse-spark-1.3-contributor. llm.modelFallback
#           names a second OpenRouter model used only if that one is unreachable.
#   TTS  -> KIE (google/gemini-3-1-flash-tts), with OpenRouter gpt-audio and then
#           an offline edge voice behind it if KIE fails.

# OpenRouter — REQUIRED. Serves every LLM stage. https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# KIE — TTS ONLY (it no longer serves any LLM stage). Leave blank and the
# voice-over falls back to OpenRouter gpt-audio, which sounds different.
KIE_API_KEY=

# TTS overrides (optional) — swap voice/model without editing config.json.
#   TTS_VOICE: a Gemini voice (Charon, Kore, Puck, Sulafat, ...) or one of the
#     app's narrator personas (james, brian, bella, allison, ...).
#   TTS_PROVIDER: "auto" (default: KIE first, then fall back), "kie" (KIE only —
#     surfaces errors instead of silently changing the narrator's voice), or
#     "openrouter" (skip KIE entirely).
# TTS_MODEL=google/gemini-3-1-flash-tts
# TTS_VOICE=Charon
# TTS_PROVIDER=auto

# Stock media (images/video/SFX). MEDIA_PROVIDER moves that source to the front
# of the asset search order ("pixabay-api" is normalized to the "pixabay" provider).
MEDIA_PROVIDER=pixabay-api
PIXABAY_API_KEY=
FREESOUND_TOKEN=

# Pixabay-only mode. Set to 1 to force EVERY asset to come from Pixabay:
#  - images/vectors: only the pixabay + pixabay_scrape providers (drops openverse,
#    pexels, and the iconify SVG fallback); cache hits are source-filtered too
#  - music/SFX: only the Pixabay bridge (drops the Freesound + Internet-Archive
#    fallbacks). Music still falls to a synthesized ambient pad so a dry result
#    never ships a silent film; SFX is optional (dry = no effect).
# Requires the Pixabay bridge service running (PIXABAY_BRIDGE_URL) for music/SFX/vectors.
PIXABAY_ONLY=0

# ── Authentication (login / signup / forgot-password OTP) ────────────────────
# JWT signing secret (REQUIRED in production). Use a long random string.
SECRET_KEY=
# Gmail for sending OTP / welcome / login-alert emails (nodemailer). Use a Gmail
# App Password (myaccount.google.com → Security → App passwords), NOT your login.
# If unset, the auth flow still works but OTPs are logged to the server console.
GMAIL_USER=
GMAIL_PASS=

# ── Deployment / operational (optional in .env; the systemd unit sets these in
#    production — see deploy/keyframe.service). Not secrets. ──────────────────
# PORT=8080                                  # HTTP port (nginx proxies :80 → here)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser   # system Chromium (required on ARM64)
# PUPPETEER_SKIP_DOWNLOAD=true               # don't auto-download Chrome (use system Chromium)
# JOB_CONCURRENCY=auto                       # parallel render jobs (auto = from CPU/RAM)
# RENDER_WORKERS=auto                        # frame-capture workers per job
# RENDER_QUALITY=draft                       # draft|standard|high
