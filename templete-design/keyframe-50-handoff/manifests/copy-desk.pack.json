{
  "id": "copy-desk",
  "name": "Copy Desk",
  "renderer": "filmkit",
  "orientation": "vertical",
  "sizePx": [
    1080,
    1920
  ],
  "cohort": "03 news / journalism",
  "set": "article-text-50",
  "globalName": "CopyDesk",
  "configFile": "configs/article-pack-03.js",
  "vibe": "the copy floor at deadline",
  "form": {
    "runtimeMs": 129400,
    "runtimeRangeMs": [
      90000,
      150000
    ],
    "beats": 18
  },
  "readingBudget": {
    "wpm": 225,
    "landSeconds": 1.2,
    "checkedBy": "scripts/lint-reading-budget.js"
  },
  "fonts": {
    "display": "Barlow Condensed",
    "body": "Barlow",
    "mono": "IBM Plex Mono",
    "scaleRatio": 1.25,
    "bundled": true,
    "fallback": {
      "devanagari": "Noto Sans Devanagari"
    }
  },
  "palette": {
    "slots": [
      "bg",
      "surface",
      "rule",
      "inkMuted",
      "ink",
      "accent",
      "accent2",
      "accentInk"
    ],
    "values": {
      "bg": "#e6e8e2",
      "surface": "#f6f8f4",
      "rule": "#c3c8bd",
      "inkMuted": "#697064",
      "ink": "#141712",
      "accent": "#2f7d7a",
      "accent2": "#d97a2f",
      "accentInk": "#f6f8f4"
    },
    "strategy": "luminance ladder; hue-rotatable at each slot’s own lightness"
  },
  "tweaks": [
    {
      "key": "brand",
      "type": "text"
    },
    {
      "key": "bg",
      "type": "color"
    },
    {
      "key": "accent",
      "type": "color"
    },
    {
      "key": "accent2",
      "type": "color"
    },
    {
      "key": "motion",
      "type": "radio",
      "options": [
        "Calm",
        "Lively",
        "Bouncy"
      ],
      "default": "Lively"
    },
    {
      "key": "typeScale",
      "type": "radio",
      "options": [
        "Compact",
        "Default",
        "Editorial"
      ],
      "default": "Default"
    }
  ],
  "motion": {
    "titlePreset": "machete",
    "itemPreset": "pop",
    "camera": [
      "pushU",
      "pushL",
      "zoomIn",
      "pushR",
      "pushD",
      "zoomOut"
    ],
    "mechanics": "Scroll: \"board\", Typing: \"caret\", Ring: \"gauge\"",
    "chrome": false
  },
  "world": {
    "description": "the copy floor at deadline. Far: a ceiling tube run in the top band with a carrier shooting through it every 5s, and desk rows converging in perspective. Mid: spike files, trays and a phone row along the deck. Near: paper slips rising. Nothing enters the text column: the tube sits above y=250 and everything else below y=1380.",
    "cyclePeriodMs": 5000,
    "planes": 3,
    "textSafety": "object confined above y=290, below y=1330, or right of x=820; never crosses the copy column"
  },
  "mediaSlots": [
    {
      "id": "image",
      "beat": "Feature",
      "beatIndex": 10,
      "aspect": "16:10",
      "minPx": [
        640,
        400
      ],
      "fit": "cover",
      "priority": 1,
      "optional": true,
      "onEmpty": "swap per look.feature.swap (borrows nearest unclaimed script line)"
    },
    {
      "id": "logo",
      "beat": "CTA",
      "beatIndex": 17,
      "aspect": "1:1",
      "minPx": [
        256,
        256
      ],
      "fit": "contain",
      "priority": 2,
      "optional": true,
      "onEmpty": "pack icon mark in a filled badge"
    }
  ],
  "determinism": {
    "randomness": false,
    "wallClock": false,
    "seekSafe": true,
    "clock": "single authored timeline via animations-v2"
  },
  "paths": {
    "html": "templates/copy-desk.html",
    "config": "configs/article-pack-03.js",
    "storyboard": "fixtures/storyboard.copy-desk.json",
    "timestamps": "fixtures/timestamps.copy-desk.json",
    "referenceFrames": "reference-frames/copy-desk/"
  }
}