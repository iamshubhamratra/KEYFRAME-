{
  "id": "proof-steps",
  "name": "Proof Steps",
  "renderer": "filmkit",
  "orientation": "vertical",
  "sizePx": [
    1080,
    1920
  ],
  "cohort": "08 science / explainer",
  "set": "article-text-50",
  "globalName": "ProofSteps",
  "configFile": "configs/article-pack-08.js",
  "vibe": "a proof rig on a bench",
  "form": {
    "runtimeMs": 129400,
    "runtimeRangeMs": [
      90000,
      150000
    ],
    "beats": 18
  },
  "readingBudget": {
    "wpm": 225,
    "landSeconds": 1.2,
    "checkedBy": "scripts/lint-reading-budget.js"
  },
  "fonts": {
    "display": "Space Mono",
    "body": "Atkinson Hyperlegible",
    "mono": null,
    "scaleRatio": 1.25,
    "bundled": true,
    "fallback": {
      "devanagari": "Noto Sans Devanagari"
    }
  },
  "palette": {
    "slots": [
      "bg",
      "surface",
      "rule",
      "inkMuted",
      "ink",
      "accent",
      "accent2",
      "accentInk"
    ],
    "values": {
      "bg": "#eef0ef",
      "surface": "#fbfcfc",
      "rule": "#c9cdcc",
      "inkMuted": "#6b7170",
      "ink": "#111413",
      "accent": "#2f6f5f",
      "accent2": "#c98a2f",
      "accentInk": "#fbfcfc"
    },
    "strategy": "luminance ladder; hue-rotatable at each slot’s own lightness"
  },
  "tweaks": [
    {
      "key": "brand",
      "type": "text"
    },
    {
      "key": "bg",
      "type": "color"
    },
    {
      "key": "accent",
      "type": "color"
    },
    {
      "key": "accent2",
      "type": "color"
    },
    {
      "key": "motion",
      "type": "radio",
      "options": [
        "Calm",
        "Lively",
        "Bouncy"
      ],
      "default": "Lively"
    },
    {
      "key": "typeScale",
      "type": "radio",
      "options": [
        "Compact",
        "Default",
        "Editorial"
      ],
      "default": "Default"
    }
  ],
  "motion": {
    "titlePreset": "machete",
    "itemPreset": "rise",
    "camera": [
      "pushU",
      "zoomIn",
      "pushL",
      "drop",
      "zoomOut",
      "pushR"
    ],
    "mechanics": "Scroll: \"board\", Typing: \"terminal\", Ring: \"gauge\"",
    "chrome": false
  },
  "world": {
    "description": "a proof rig on a bench. Overhead: a truss of measuring rules and a row of clamp lamps. Margin: an escapement whose wheel steps one tooth per swing while a step counter advances. Floor: a QED plaque, a stack of proof sheets and a caliper. Near: chalk motes.",
    "cyclePeriodMs": 12000,
    "planes": 3,
    "textSafety": "object confined above y=290, below y=1330, or right of x=820; never crosses the copy column"
  },
  "mediaSlots": [
    {
      "id": "image",
      "beat": "Feature",
      "beatIndex": 10,
      "aspect": "16:10",
      "minPx": [
        640,
        400
      ],
      "fit": "cover",
      "priority": 1,
      "optional": true,
      "onEmpty": "swap per look.feature.swap (borrows nearest unclaimed script line)"
    },
    {
      "id": "logo",
      "beat": "CTA",
      "beatIndex": 17,
      "aspect": "1:1",
      "minPx": [
        256,
        256
      ],
      "fit": "contain",
      "priority": 2,
      "optional": true,
      "onEmpty": "pack icon mark in a filled badge"
    }
  ],
  "determinism": {
    "randomness": false,
    "wallClock": false,
    "seekSafe": true,
    "clock": "single authored timeline via animations-v2"
  },
  "paths": {
    "html": "templates/proof-steps.html",
    "config": "configs/article-pack-08.js",
    "storyboard": "fixtures/storyboard.proof-steps.json",
    "timestamps": "fixtures/timestamps.proof-steps.json",
    "referenceFrames": "reference-frames/proof-steps/"
  }
}