{
  "id": "long-table",
  "name": "Long Table",
  "renderer": "filmkit",
  "orientation": "vertical",
  "sizePx": [
    1080,
    1920
  ],
  "cohort": "09 lifestyle / culture",
  "set": "article-text-50",
  "globalName": "LongTable",
  "configFile": "configs/article-pack-09.js",
  "vibe": "an open kitchen at service",
  "form": {
    "runtimeMs": 129400,
    "runtimeRangeMs": [
      90000,
      150000
    ],
    "beats": 18
  },
  "readingBudget": {
    "wpm": 225,
    "landSeconds": 1.2,
    "checkedBy": "scripts/lint-reading-budget.js"
  },
  "fonts": {
    "display": "Shrikhand",
    "body": "Mukta",
    "mono": "IBM Plex Mono",
    "scaleRatio": 1.25,
    "bundled": true,
    "fallback": {
      "devanagari": "Noto Serif Devanagari"
    }
  },
  "palette": {
    "slots": [
      "bg",
      "surface",
      "rule",
      "inkMuted",
      "ink",
      "accent",
      "accent2",
      "accentInk"
    ],
    "values": {
      "bg": "#1a1512",
      "surface": "#251e19",
      "rule": "#3b302a",
      "inkMuted": "#9a8d84",
      "ink": "#f4efe9",
      "accent": "#e8903c",
      "accent2": "#7fb06a",
      "accentInk": "#120d0a"
    },
    "strategy": "luminance ladder; hue-rotatable at each slot’s own lightness"
  },
  "tweaks": [
    {
      "key": "brand",
      "type": "text"
    },
    {
      "key": "bg",
      "type": "color"
    },
    {
      "key": "accent",
      "type": "color"
    },
    {
      "key": "accent2",
      "type": "color"
    },
    {
      "key": "motion",
      "type": "radio",
      "options": [
        "Calm",
        "Lively",
        "Bouncy"
      ],
      "default": "Lively"
    },
    {
      "key": "typeScale",
      "type": "radio",
      "options": [
        "Compact",
        "Default",
        "Editorial"
      ],
      "default": "Default"
    }
  ],
  "motion": {
    "titlePreset": "rise",
    "itemPreset": "stamp",
    "camera": [
      "zoomIn",
      "pushL",
      "drop",
      "pushR",
      "pushU",
      "zoomOut"
    ],
    "mechanics": "Scroll: \"board\", Typing: \"caret\", Ring: \"bar\"",
    "chrome": false
  },
  "world": {
    "description": "an open kitchen at service. Overhead: a heat lamp row and a rack of hanging herbs. Margin: the rotisserie — a spit turning on a 9s revolution with three birds on it, the fire beneath breathing and fat dripping. Floor: a long table laid down the room, a stockpot, a knife block. Near: sparks.",
    "cyclePeriodMs": 12000,
    "planes": 3,
    "textSafety": "object confined above y=290, below y=1330, or right of x=820; never crosses the copy column"
  },
  "mediaSlots": [
    {
      "id": "image",
      "beat": "Feature",
      "beatIndex": 10,
      "aspect": "16:10",
      "minPx": [
        640,
        400
      ],
      "fit": "cover",
      "priority": 1,
      "optional": true,
      "onEmpty": "swap per look.feature.swap (borrows nearest unclaimed script line)"
    },
    {
      "id": "logo",
      "beat": "CTA",
      "beatIndex": 17,
      "aspect": "1:1",
      "minPx": [
        256,
        256
      ],
      "fit": "contain",
      "priority": 2,
      "optional": true,
      "onEmpty": "pack icon mark in a filled badge"
    }
  ],
  "determinism": {
    "randomness": false,
    "wallClock": false,
    "seekSafe": true,
    "clock": "single authored timeline via animations-v2"
  },
  "paths": {
    "html": "templates/long-table.html",
    "config": "configs/article-pack-09.js",
    "storyboard": "fixtures/storyboard.long-table.json",
    "timestamps": "fixtures/timestamps.long-table.json",
    "referenceFrames": "reference-frames/long-table/"
  }
}