{
  "id": "city-guide",
  "name": "City Guide",
  "renderer": "filmkit",
  "orientation": "vertical",
  "sizePx": [
    1080,
    1920
  ],
  "cohort": "09 lifestyle / culture",
  "set": "article-text-50",
  "globalName": "CityGuide",
  "configFile": "configs/article-pack-09.js",
  "vibe": "a street at the end of the day",
  "form": {
    "runtimeMs": 129400,
    "runtimeRangeMs": [
      90000,
      150000
    ],
    "beats": 18
  },
  "readingBudget": {
    "wpm": 225,
    "landSeconds": 1.2,
    "checkedBy": "scripts/lint-reading-budget.js"
  },
  "fonts": {
    "display": "Playfair Display",
    "body": "Poppins",
    "mono": "IBM Plex Mono",
    "scaleRatio": 1.25,
    "bundled": true,
    "fallback": {
      "devanagari": "Noto Serif Devanagari"
    }
  },
  "palette": {
    "slots": [
      "bg",
      "surface",
      "rule",
      "inkMuted",
      "ink",
      "accent",
      "accent2",
      "accentInk"
    ],
    "values": {
      "bg": "#eef0f2",
      "surface": "#fbfcfd",
      "rule": "#c8cdd2",
      "inkMuted": "#6a7075",
      "ink": "#111417",
      "accent": "#2f4f8c",
      "accent2": "#c9803a",
      "accentInk": "#fbfcfd"
    },
    "strategy": "luminance ladder; hue-rotatable at each slot’s own lightness"
  },
  "tweaks": [
    {
      "key": "brand",
      "type": "text"
    },
    {
      "key": "bg",
      "type": "color"
    },
    {
      "key": "accent",
      "type": "color"
    },
    {
      "key": "accent2",
      "type": "color"
    },
    {
      "key": "motion",
      "type": "radio",
      "options": [
        "Calm",
        "Lively",
        "Bouncy"
      ],
      "default": "Lively"
    },
    {
      "key": "typeScale",
      "type": "radio",
      "options": [
        "Compact",
        "Default",
        "Editorial"
      ],
      "default": "Default"
    }
  ],
  "motion": {
    "titlePreset": "rise",
    "itemPreset": "pop",
    "camera": [
      "pushR",
      "zoomIn",
      "pushL",
      "hopU",
      "zoomOut",
      "drop"
    ],
    "mechanics": "Scroll: \"feed\", Typing: \"caret\", Ring: \"bar\"",
    "chrome": false
  },
  "world": {
    "description": "a street at the end of the day. Overhead: a catenary wire with hanging lamps and a strip of shopfront signs. Mid: a tram running a 16s traverse, pantograph sparking on joints, wheels at travel speed, and a stop with a shelter. Floor: kerb, planters, cobbles, a cyclist passing.",
    "cyclePeriodMs": 16000,
    "planes": 3,
    "textSafety": "object confined above y=290, below y=1330, or right of x=820; never crosses the copy column"
  },
  "mediaSlots": [
    {
      "id": "image",
      "beat": "Feature",
      "beatIndex": 10,
      "aspect": "16:10",
      "minPx": [
        640,
        400
      ],
      "fit": "cover",
      "priority": 1,
      "optional": true,
      "onEmpty": "swap per look.feature.swap (borrows nearest unclaimed script line)"
    },
    {
      "id": "logo",
      "beat": "CTA",
      "beatIndex": 17,
      "aspect": "1:1",
      "minPx": [
        256,
        256
      ],
      "fit": "contain",
      "priority": 2,
      "optional": true,
      "onEmpty": "pack icon mark in a filled badge"
    }
  ],
  "determinism": {
    "randomness": false,
    "wallClock": false,
    "seekSafe": true,
    "clock": "single authored timeline via animations-v2"
  },
  "paths": {
    "html": "templates/city-guide.html",
    "config": "configs/article-pack-09.js",
    "storyboard": "fixtures/storyboard.city-guide.json",
    "timestamps": "fixtures/timestamps.city-guide.json",
    "referenceFrames": "reference-frames/city-guide/"
  }
}