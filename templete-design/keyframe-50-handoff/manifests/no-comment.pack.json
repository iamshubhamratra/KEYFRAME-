{
  "id": "no-comment",
  "name": "No Comment",
  "renderer": "filmkit",
  "orientation": "vertical",
  "sizePx": [
    1080,
    1920
  ],
  "cohort": "10 opinion / manifesto",
  "set": "article-text-50",
  "globalName": "NoComment",
  "configFile": "configs/article-pack-10.js",
  "vibe": "a shuttered frontage",
  "form": {
    "runtimeMs": 129400,
    "runtimeRangeMs": [
      90000,
      150000
    ],
    "beats": 18
  },
  "readingBudget": {
    "wpm": 225,
    "landSeconds": 1.2,
    "checkedBy": "scripts/lint-reading-budget.js"
  },
  "fonts": {
    "display": "Alfa Slab One",
    "body": "Wix Madefor Text",
    "mono": "IBM Plex Mono",
    "scaleRatio": 1.25,
    "bundled": true,
    "fallback": {
      "devanagari": "Noto Serif Devanagari"
    }
  },
  "palette": {
    "slots": [
      "bg",
      "surface",
      "rule",
      "inkMuted",
      "ink",
      "accent",
      "accent2",
      "accentInk"
    ],
    "values": {
      "bg": "#ece8e1",
      "surface": "#fbf9f5",
      "rule": "#c9c2b6",
      "inkMuted": "#6d675e",
      "ink": "#151310",
      "accent": "#c94f2f",
      "accent2": "#2f4f5f",
      "accentInk": "#fbf9f5"
    },
    "strategy": "luminance ladder; hue-rotatable at each slot’s own lightness"
  },
  "tweaks": [
    {
      "key": "brand",
      "type": "text"
    },
    {
      "key": "bg",
      "type": "color"
    },
    {
      "key": "accent",
      "type": "color"
    },
    {
      "key": "accent2",
      "type": "color"
    },
    {
      "key": "motion",
      "type": "radio",
      "options": [
        "Calm",
        "Lively",
        "Bouncy"
      ],
      "default": "Lively"
    },
    {
      "key": "typeScale",
      "type": "radio",
      "options": [
        "Compact",
        "Default",
        "Editorial"
      ],
      "default": "Default"
    }
  ],
  "motion": {
    "titlePreset": "slam",
    "itemPreset": "stamp",
    "camera": [
      "drop",
      "slamL",
      "zoomIn",
      "pushD",
      "slamR",
      "zoomOut"
    ],
    "mechanics": "Scroll: \"feed\", Typing: \"hand\", Ring: \"bar\"",
    "chrome": false
  },
  "world": {
    "description": "a shuttered frontage. Overhead: a fascia sign and a lamp on a bracket. Margin: the shutter running down and up on a 13s cycle, slats accumulating, the drum turning, a padlock swinging at the foot. Floor: pavement, a discarded flyer, a bollard. Near: grit blowing past.",
    "cyclePeriodMs": 13000,
    "planes": 3,
    "textSafety": "object confined above y=290, below y=1330, or right of x=820; never crosses the copy column"
  },
  "mediaSlots": [
    {
      "id": "image",
      "beat": "Feature",
      "beatIndex": 10,
      "aspect": "16:10",
      "minPx": [
        640,
        400
      ],
      "fit": "cover",
      "priority": 1,
      "optional": true,
      "onEmpty": "swap per look.feature.swap (borrows nearest unclaimed script line)"
    },
    {
      "id": "logo",
      "beat": "CTA",
      "beatIndex": 17,
      "aspect": "1:1",
      "minPx": [
        256,
        256
      ],
      "fit": "contain",
      "priority": 2,
      "optional": true,
      "onEmpty": "pack icon mark in a filled badge"
    }
  ],
  "determinism": {
    "randomness": false,
    "wallClock": false,
    "seekSafe": true,
    "clock": "single authored timeline via animations-v2"
  },
  "paths": {
    "html": "templates/no-comment.html",
    "config": "configs/article-pack-10.js",
    "storyboard": "fixtures/storyboard.no-comment.json",
    "timestamps": "fixtures/timestamps.no-comment.json",
    "referenceFrames": "reference-frames/no-comment/"
  }
}