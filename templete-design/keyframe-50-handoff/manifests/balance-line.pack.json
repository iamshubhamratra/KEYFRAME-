{
  "id": "balance-line",
  "name": "Balance Line",
  "renderer": "filmkit",
  "orientation": "vertical",
  "sizePx": [
    1080,
    1920
  ],
  "cohort": "06 business / analyst",
  "set": "article-text-50",
  "globalName": "BalanceLine",
  "configFile": "configs/article-pack-06.js",
  "vibe": "a counting house",
  "form": {
    "runtimeMs": 129400,
    "runtimeRangeMs": [
      90000,
      150000
    ],
    "beats": 18
  },
  "readingBudget": {
    "wpm": 225,
    "landSeconds": 1.2,
    "checkedBy": "scripts/lint-reading-budget.js"
  },
  "fonts": {
    "display": "Libre Bodoni",
    "body": "Livvic",
    "mono": "IBM Plex Mono",
    "scaleRatio": 1.25,
    "bundled": true,
    "fallback": {
      "devanagari": "Noto Serif Devanagari"
    }
  },
  "palette": {
    "slots": [
      "bg",
      "surface",
      "rule",
      "inkMuted",
      "ink",
      "accent",
      "accent2",
      "accentInk"
    ],
    "values": {
      "bg": "#f2eee4",
      "surface": "#fbf9f3",
      "rule": "#cec7b6",
      "inkMuted": "#6f695c",
      "ink": "#161410",
      "accent": "#1f5137",
      "accent2": "#8c2f45",
      "accentInk": "#fbf9f3"
    },
    "strategy": "luminance ladder; hue-rotatable at each slot’s own lightness"
  },
  "tweaks": [
    {
      "key": "brand",
      "type": "text"
    },
    {
      "key": "bg",
      "type": "color"
    },
    {
      "key": "accent",
      "type": "color"
    },
    {
      "key": "accent2",
      "type": "color"
    },
    {
      "key": "motion",
      "type": "radio",
      "options": [
        "Calm",
        "Lively",
        "Bouncy"
      ],
      "default": "Calm"
    },
    {
      "key": "typeScale",
      "type": "radio",
      "options": [
        "Compact",
        "Default",
        "Editorial"
      ],
      "default": "Default"
    }
  ],
  "motion": {
    "titlePreset": "drowse",
    "itemPreset": "rise",
    "camera": [
      "zoomIn",
      "pushU",
      "zoomOut",
      "pushL",
      "drop",
      "pushR"
    ],
    "mechanics": "Scroll: \"board\", Typing: \"caret\", Ring: \"ring\"",
    "chrome": false
  },
  "world": {
    "description": "a counting house. Far: a ruled ledger wall and a wall clock. Mid: a balance scale on the bench whose beam settles toward level on a 12s cycle while weights are added — pans swing with lag, chains flex, the pointer overshoots and comes back. Near: coins stacked, and dust.",
    "cyclePeriodMs": 12000,
    "planes": 3,
    "textSafety": "object confined above y=290, below y=1330, or right of x=820; never crosses the copy column"
  },
  "mediaSlots": [
    {
      "id": "image",
      "beat": "Feature",
      "beatIndex": 10,
      "aspect": "16:10",
      "minPx": [
        640,
        400
      ],
      "fit": "cover",
      "priority": 1,
      "optional": true,
      "onEmpty": "swap per look.feature.swap (borrows nearest unclaimed script line)"
    },
    {
      "id": "logo",
      "beat": "CTA",
      "beatIndex": 17,
      "aspect": "1:1",
      "minPx": [
        256,
        256
      ],
      "fit": "contain",
      "priority": 2,
      "optional": true,
      "onEmpty": "pack icon mark in a filled badge"
    }
  ],
  "determinism": {
    "randomness": false,
    "wallClock": false,
    "seekSafe": true,
    "clock": "single authored timeline via animations-v2"
  },
  "paths": {
    "html": "templates/balance-line.html",
    "config": "configs/article-pack-06.js",
    "storyboard": "fixtures/storyboard.balance-line.json",
    "timestamps": "fixtures/timestamps.balance-line.json",
    "referenceFrames": "reference-frames/balance-line/"
  }
}