{
  "id": "thesis-draft",
  "name": "Thesis Draft",
  "renderer": "filmkit",
  "orientation": "vertical",
  "sizePx": [
    1080,
    1920
  ],
  "cohort": "04 academic / research",
  "set": "article-text-50",
  "globalName": "ThesisDraft",
  "configFile": "configs/article-pack-04.js",
  "vibe": "the last night of the draft",
  "form": {
    "runtimeMs": 129400,
    "runtimeRangeMs": [
      90000,
      150000
    ],
    "beats": 18
  },
  "readingBudget": {
    "wpm": 225,
    "landSeconds": 1.2,
    "checkedBy": "scripts/lint-reading-budget.js"
  },
  "fonts": {
    "display": "Prata",
    "body": "Nunito Sans",
    "mono": "IBM Plex Mono",
    "scaleRatio": 1.25,
    "bundled": true,
    "fallback": {
      "devanagari": "Noto Serif Devanagari"
    }
  },
  "palette": {
    "slots": [
      "bg",
      "surface",
      "rule",
      "inkMuted",
      "ink",
      "accent",
      "accent2",
      "accentInk"
    ],
    "values": {
      "bg": "#101426",
      "surface": "#1a2036",
      "rule": "#2e3650",
      "inkMuted": "#8b93ad",
      "ink": "#f2f2f7",
      "accent": "#e8829a",
      "accent2": "#7fa8e8",
      "accentInk": "#0b0e1a"
    },
    "strategy": "luminance ladder; hue-rotatable at each slot’s own lightness"
  },
  "tweaks": [
    {
      "key": "brand",
      "type": "text"
    },
    {
      "key": "bg",
      "type": "color"
    },
    {
      "key": "accent",
      "type": "color"
    },
    {
      "key": "accent2",
      "type": "color"
    },
    {
      "key": "motion",
      "type": "radio",
      "options": [
        "Calm",
        "Lively",
        "Bouncy"
      ],
      "default": "Calm"
    },
    {
      "key": "typeScale",
      "type": "radio",
      "options": [
        "Compact",
        "Default",
        "Editorial"
      ],
      "default": "Default"
    }
  ],
  "motion": {
    "titlePreset": "drowse",
    "itemPreset": "rise",
    "camera": [
      "drop",
      "zoomIn",
      "pushU",
      "pushL",
      "zoomOut",
      "pushR"
    ],
    "mechanics": "Scroll: \"board\", Typing: \"hand\", Ring: \"gauge\"",
    "chrome": false
  },
  "world": {
    "description": "the last night of the draft. Far: a window with rain running down it and a street glow beyond. Mid: a radiator under the sill, stacks of paper on the floor that grow through the film, and an hourglass on a gimbal that flips every 11s while the sand streams. Near: rain on the glass.",
    "cyclePeriodMs": 11000,
    "planes": 3,
    "textSafety": "object confined above y=290, below y=1330, or right of x=820; never crosses the copy column"
  },
  "mediaSlots": [
    {
      "id": "image",
      "beat": "Feature",
      "beatIndex": 10,
      "aspect": "16:10",
      "minPx": [
        640,
        400
      ],
      "fit": "cover",
      "priority": 1,
      "optional": true,
      "onEmpty": "swap per look.feature.swap (borrows nearest unclaimed script line)"
    },
    {
      "id": "logo",
      "beat": "CTA",
      "beatIndex": 17,
      "aspect": "1:1",
      "minPx": [
        256,
        256
      ],
      "fit": "contain",
      "priority": 2,
      "optional": true,
      "onEmpty": "pack icon mark in a filled badge"
    }
  ],
  "determinism": {
    "randomness": false,
    "wallClock": false,
    "seekSafe": true,
    "clock": "single authored timeline via animations-v2"
  },
  "paths": {
    "html": "templates/thesis-draft.html",
    "config": "configs/article-pack-04.js",
    "storyboard": "fixtures/storyboard.thesis-draft.json",
    "timestamps": "fixtures/timestamps.thesis-draft.json",
    "referenceFrames": "reference-frames/thesis-draft/"
  }
}