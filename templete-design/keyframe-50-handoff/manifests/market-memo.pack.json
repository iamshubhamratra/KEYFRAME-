{
  "id": "market-memo",
  "name": "Market Memo",
  "renderer": "filmkit",
  "orientation": "vertical",
  "sizePx": [
    1080,
    1920
  ],
  "cohort": "06 business / analyst",
  "set": "article-text-50",
  "globalName": "MarketMemo",
  "configFile": "configs/article-pack-06.js",
  "vibe": "an open-plan floor after hours",
  "form": {
    "runtimeMs": 129400,
    "runtimeRangeMs": [
      90000,
      150000
    ],
    "beats": 18
  },
  "readingBudget": {
    "wpm": 225,
    "landSeconds": 1.2,
    "checkedBy": "scripts/lint-reading-budget.js"
  },
  "fonts": {
    "display": "Familjen Grotesk",
    "body": "Commissioner",
    "mono": "IBM Plex Mono",
    "scaleRatio": 1.25,
    "bundled": true,
    "fallback": {
      "devanagari": "Noto Sans Devanagari"
    }
  },
  "palette": {
    "slots": [
      "bg",
      "surface",
      "rule",
      "inkMuted",
      "ink",
      "accent",
      "accent2",
      "accentInk"
    ],
    "values": {
      "bg": "#efece7",
      "surface": "#fbfaf7",
      "rule": "#cbc5bb",
      "inkMuted": "#6e6862",
      "ink": "#161412",
      "accent": "#8c2f2f",
      "accent2": "#2f7f8c",
      "accentInk": "#fbfaf7"
    },
    "strategy": "luminance ladder; hue-rotatable at each slot’s own lightness"
  },
  "tweaks": [
    {
      "key": "brand",
      "type": "text"
    },
    {
      "key": "bg",
      "type": "color"
    },
    {
      "key": "accent",
      "type": "color"
    },
    {
      "key": "accent2",
      "type": "color"
    },
    {
      "key": "motion",
      "type": "radio",
      "options": [
        "Calm",
        "Lively",
        "Bouncy"
      ],
      "default": "Lively"
    },
    {
      "key": "typeScale",
      "type": "radio",
      "options": [
        "Compact",
        "Default",
        "Editorial"
      ],
      "default": "Default"
    }
  ],
  "motion": {
    "titlePreset": "rise",
    "itemPreset": "pop",
    "camera": [
      "pushR",
      "hopU",
      "pushL",
      "zoomIn",
      "drop",
      "zoomOut"
    ],
    "mechanics": "Scroll: \"feed\", Typing: \"typewriter\", Ring: \"ring\"",
    "chrome": false
  },
  "world": {
    "description": "an open-plan floor after hours. Far: a window wall with blinds and a skyline. Mid: desk pods receding on parallax, a whiteboard of figures, and a paper plane flying an 11s arc across the room — it banks into the turn, dips and lifts, and its shadow tracks along the floor. Near: two memos tumbling.",
    "cyclePeriodMs": 11000,
    "planes": 3,
    "textSafety": "object confined above y=290, below y=1330, or right of x=820; never crosses the copy column"
  },
  "mediaSlots": [
    {
      "id": "image",
      "beat": "Feature",
      "beatIndex": 10,
      "aspect": "16:10",
      "minPx": [
        640,
        400
      ],
      "fit": "cover",
      "priority": 1,
      "optional": true,
      "onEmpty": "swap per look.feature.swap (borrows nearest unclaimed script line)"
    },
    {
      "id": "logo",
      "beat": "CTA",
      "beatIndex": 17,
      "aspect": "1:1",
      "minPx": [
        256,
        256
      ],
      "fit": "contain",
      "priority": 2,
      "optional": true,
      "onEmpty": "pack icon mark in a filled badge"
    }
  ],
  "determinism": {
    "randomness": false,
    "wallClock": false,
    "seekSafe": true,
    "clock": "single authored timeline via animations-v2"
  },
  "paths": {
    "html": "templates/market-memo.html",
    "config": "configs/article-pack-06.js",
    "storyboard": "fixtures/storyboard.market-memo.json",
    "timestamps": "fixtures/timestamps.market-memo.json",
    "referenceFrames": "reference-frames/market-memo/"
  }
}