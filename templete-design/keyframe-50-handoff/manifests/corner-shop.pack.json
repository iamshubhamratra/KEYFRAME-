{
  "id": "corner-shop",
  "name": "Corner Shop",
  "renderer": "filmkit",
  "orientation": "vertical",
  "sizePx": [
    1080,
    1920
  ],
  "cohort": "05 personal blog / diary",
  "set": "article-text-50",
  "globalName": "CornerShop",
  "configFile": "configs/article-pack-05.js",
  "vibe": "the shopfront at opening",
  "form": {
    "runtimeMs": 129400,
    "runtimeRangeMs": [
      90000,
      150000
    ],
    "beats": 18
  },
  "readingBudget": {
    "wpm": 225,
    "landSeconds": 1.2,
    "checkedBy": "scripts/lint-reading-budget.js"
  },
  "fonts": {
    "display": "Lobster Two",
    "body": "Hind",
    "mono": "IBM Plex Mono",
    "scaleRatio": 1.25,
    "bundled": true,
    "fallback": {
      "devanagari": "Noto Sans Devanagari"
    }
  },
  "palette": {
    "slots": [
      "bg",
      "surface",
      "rule",
      "inkMuted",
      "ink",
      "accent",
      "accent2",
      "accentInk"
    ],
    "values": {
      "bg": "#f5ecd8",
      "surface": "#fdf8ec",
      "rule": "#d8c9a6",
      "inkMuted": "#756a51",
      "ink": "#1b1810",
      "accent": "#d1462f",
      "accent2": "#4f8a3c",
      "accentInk": "#fdf8ec"
    },
    "strategy": "luminance ladder; hue-rotatable at each slot’s own lightness"
  },
  "tweaks": [
    {
      "key": "brand",
      "type": "text"
    },
    {
      "key": "bg",
      "type": "color"
    },
    {
      "key": "accent",
      "type": "color"
    },
    {
      "key": "accent2",
      "type": "color"
    },
    {
      "key": "motion",
      "type": "radio",
      "options": [
        "Calm",
        "Lively",
        "Bouncy"
      ],
      "default": "Bouncy"
    },
    {
      "key": "typeScale",
      "type": "radio",
      "options": [
        "Compact",
        "Default",
        "Editorial"
      ],
      "default": "Default"
    }
  ],
  "motion": {
    "titlePreset": "slam",
    "itemPreset": "pop",
    "camera": [
      "hopU",
      "pushR",
      "spin",
      "pushL",
      "drop",
      "zoomIn"
    ],
    "mechanics": "Scroll: \"board\", Typing: \"hand\", Ring: \"bar\"",
    "chrome": false
  },
  "world": {
    "description": "the shopfront at opening. Far: the terrace above and a hanging sign that swings. Mid: a striped awning, crates of produce on the pavement with price cards, and a sack trolley of crates wheeled past on a 11s traverse — wheels turn at travel speed, the load leans on the tilt. Near: a pigeon and a few leaves.",
    "cyclePeriodMs": 11000,
    "planes": 3,
    "textSafety": "object confined above y=290, below y=1330, or right of x=820; never crosses the copy column"
  },
  "mediaSlots": [
    {
      "id": "image",
      "beat": "Feature",
      "beatIndex": 10,
      "aspect": "16:10",
      "minPx": [
        640,
        400
      ],
      "fit": "cover",
      "priority": 1,
      "optional": true,
      "onEmpty": "swap per look.feature.swap (borrows nearest unclaimed script line)"
    },
    {
      "id": "logo",
      "beat": "CTA",
      "beatIndex": 17,
      "aspect": "1:1",
      "minPx": [
        256,
        256
      ],
      "fit": "contain",
      "priority": 2,
      "optional": true,
      "onEmpty": "pack icon mark in a filled badge"
    }
  ],
  "determinism": {
    "randomness": false,
    "wallClock": false,
    "seekSafe": true,
    "clock": "single authored timeline via animations-v2"
  },
  "paths": {
    "html": "templates/corner-shop.html",
    "config": "configs/article-pack-05.js",
    "storyboard": "fixtures/storyboard.corner-shop.json",
    "timestamps": "fixtures/timestamps.corner-shop.json",
    "referenceFrames": "reference-frames/corner-shop/"
  }
}