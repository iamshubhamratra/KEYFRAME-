{
  "id": "morning-pages",
  "name": "Morning Pages",
  "renderer": "filmkit",
  "orientation": "vertical",
  "sizePx": [
    1080,
    1920
  ],
  "cohort": "05 personal blog / diary",
  "set": "article-text-50",
  "globalName": "MorningPages",
  "configFile": "configs/article-pack-05.js",
  "vibe": "the table before anyone else is up",
  "form": {
    "runtimeMs": 129400,
    "runtimeRangeMs": [
      90000,
      150000
    ],
    "beats": 18
  },
  "readingBudget": {
    "wpm": 225,
    "landSeconds": 1.2,
    "checkedBy": "scripts/lint-reading-budget.js"
  },
  "fonts": {
    "display": "Caveat",
    "body": "Nunito",
    "mono": "IBM Plex Mono",
    "scaleRatio": 1.25,
    "bundled": true,
    "fallback": {
      "devanagari": "Noto Sans Devanagari"
    }
  },
  "palette": {
    "slots": [
      "bg",
      "surface",
      "rule",
      "inkMuted",
      "ink",
      "accent",
      "accent2",
      "accentInk"
    ],
    "values": {
      "bg": "#f3ece1",
      "surface": "#fbf7f1",
      "rule": "#d5c9b8",
      "inkMuted": "#736a5d",
      "ink": "#1b1712",
      "accent": "#e07a5f",
      "accent2": "#81a06b",
      "accentInk": "#fbf7f1"
    },
    "strategy": "luminance ladder; hue-rotatable at each slot’s own lightness"
  },
  "tweaks": [
    {
      "key": "brand",
      "type": "text"
    },
    {
      "key": "bg",
      "type": "color"
    },
    {
      "key": "accent",
      "type": "color"
    },
    {
      "key": "accent2",
      "type": "color"
    },
    {
      "key": "motion",
      "type": "radio",
      "options": [
        "Calm",
        "Lively",
        "Bouncy"
      ],
      "default": "Lively"
    },
    {
      "key": "typeScale",
      "type": "radio",
      "options": [
        "Compact",
        "Default",
        "Editorial"
      ],
      "default": "Default"
    }
  ],
  "motion": {
    "titlePreset": "rise",
    "itemPreset": "pop",
    "camera": [
      "hopU",
      "zoomIn",
      "pushR",
      "drop",
      "pushL",
      "zoomOut"
    ],
    "mechanics": "Scroll: \"feed\", Typing: \"hand\", Ring: \"gauge\"",
    "chrome": false
  },
  "world": {
    "description": "the table before anyone else is up. Far: a window with a feeder and a dawn wash. Mid: a robin arrives at the feeder on a 9s cycle, hops, pecks and leaves; a mug steams and a plant leans to the light. Near: crumbs and dust in the beam.",
    "cyclePeriodMs": 9000,
    "planes": 3,
    "textSafety": "object confined above y=290, below y=1330, or right of x=820; never crosses the copy column"
  },
  "mediaSlots": [
    {
      "id": "image",
      "beat": "Feature",
      "beatIndex": 10,
      "aspect": "16:10",
      "minPx": [
        640,
        400
      ],
      "fit": "cover",
      "priority": 1,
      "optional": true,
      "onEmpty": "swap per look.feature.swap (borrows nearest unclaimed script line)"
    },
    {
      "id": "logo",
      "beat": "CTA",
      "beatIndex": 17,
      "aspect": "1:1",
      "minPx": [
        256,
        256
      ],
      "fit": "contain",
      "priority": 2,
      "optional": true,
      "onEmpty": "pack icon mark in a filled badge"
    }
  ],
  "determinism": {
    "randomness": false,
    "wallClock": false,
    "seekSafe": true,
    "clock": "single authored timeline via animations-v2"
  },
  "paths": {
    "html": "templates/morning-pages.html",
    "config": "configs/article-pack-05.js",
    "storyboard": "fixtures/storyboard.morning-pages.json",
    "timestamps": "fixtures/timestamps.morning-pages.json",
    "referenceFrames": "reference-frames/morning-pages/"
  }
}