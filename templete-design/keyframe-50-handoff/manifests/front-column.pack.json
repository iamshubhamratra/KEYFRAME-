{
  "id": "front-column",
  "name": "Front Column",
  "renderer": "filmkit",
  "orientation": "vertical",
  "sizePx": [
    1080,
    1920
  ],
  "cohort": "03 news / journalism",
  "set": "article-text-50",
  "globalName": "FrontColumn",
  "configFile": "configs/article-pack-03.js",
  "vibe": "the round, just before six",
  "form": {
    "runtimeMs": 129400,
    "runtimeRangeMs": [
      90000,
      150000
    ],
    "beats": 18
  },
  "readingBudget": {
    "wpm": 225,
    "landSeconds": 1.2,
    "checkedBy": "scripts/lint-reading-budget.js"
  },
  "fonts": {
    "display": "Bitter",
    "body": "Asap",
    "mono": "IBM Plex Mono",
    "scaleRatio": 1.25,
    "bundled": true,
    "fallback": {
      "devanagari": "Noto Serif Devanagari"
    }
  },
  "palette": {
    "slots": [
      "bg",
      "surface",
      "rule",
      "inkMuted",
      "ink",
      "accent",
      "accent2",
      "accentInk"
    ],
    "values": {
      "bg": "#e9edf0",
      "surface": "#f9fbfc",
      "rule": "#c4ccd2",
      "inkMuted": "#69727a",
      "ink": "#141719",
      "accent": "#26456e",
      "accent2": "#e0a13c",
      "accentInk": "#f9fbfc"
    },
    "strategy": "luminance ladder; hue-rotatable at each slot’s own lightness"
  },
  "tweaks": [
    {
      "key": "brand",
      "type": "text"
    },
    {
      "key": "bg",
      "type": "color"
    },
    {
      "key": "accent",
      "type": "color"
    },
    {
      "key": "accent2",
      "type": "color"
    },
    {
      "key": "motion",
      "type": "radio",
      "options": [
        "Calm",
        "Lively",
        "Bouncy"
      ],
      "default": "Lively"
    },
    {
      "key": "typeScale",
      "type": "radio",
      "options": [
        "Compact",
        "Default",
        "Editorial"
      ],
      "default": "Default"
    }
  ],
  "motion": {
    "titlePreset": "rise",
    "itemPreset": "pop",
    "camera": [
      "pushR",
      "zoomIn",
      "pushL",
      "hopU",
      "zoomOut",
      "drop"
    ],
    "mechanics": "Scroll: \"feed\", Typing: \"caret\", Ring: \"gauge\"",
    "chrome": false
  },
  "world": {
    "description": "the round, just before six. Far: terrace roofline and a haze band. Mid: railings and lamp posts passing at two speeds, bundled papers on the kerb, and a delivery bicycle crossing on a 13s traverse — wheels turning at travel speed, the basket load bouncing, the rider's cape lifting. Near: two birds and a few leaves.",
    "cyclePeriodMs": 13000,
    "planes": 3,
    "textSafety": "object confined above y=290, below y=1330, or right of x=820; never crosses the copy column"
  },
  "mediaSlots": [
    {
      "id": "image",
      "beat": "Feature",
      "beatIndex": 10,
      "aspect": "16:10",
      "minPx": [
        640,
        400
      ],
      "fit": "cover",
      "priority": 1,
      "optional": true,
      "onEmpty": "swap per look.feature.swap (borrows nearest unclaimed script line)"
    },
    {
      "id": "logo",
      "beat": "CTA",
      "beatIndex": 17,
      "aspect": "1:1",
      "minPx": [
        256,
        256
      ],
      "fit": "contain",
      "priority": 2,
      "optional": true,
      "onEmpty": "pack icon mark in a filled badge"
    }
  ],
  "determinism": {
    "randomness": false,
    "wallClock": false,
    "seekSafe": true,
    "clock": "single authored timeline via animations-v2"
  },
  "paths": {
    "html": "templates/front-column.html",
    "config": "configs/article-pack-03.js",
    "storyboard": "fixtures/storyboard.front-column.json",
    "timestamps": "fixtures/timestamps.front-column.json",
    "referenceFrames": "reference-frames/front-column/"
  }
}