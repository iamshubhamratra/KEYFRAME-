{
  "id": "home-desk",
  "name": "Home Desk",
  "renderer": "filmkit",
  "orientation": "vertical",
  "sizePx": [
    1080,
    1920
  ],
  "cohort": "05 personal blog / diary",
  "set": "article-text-50",
  "globalName": "HomeDesk",
  "configFile": "configs/article-pack-05.js",
  "vibe": "the corner you work in",
  "form": {
    "runtimeMs": 129400,
    "runtimeRangeMs": [
      90000,
      150000
    ],
    "beats": 18
  },
  "readingBudget": {
    "wpm": 225,
    "landSeconds": 1.2,
    "checkedBy": "scripts/lint-reading-budget.js"
  },
  "fonts": {
    "display": "Neucha",
    "body": "Cabin",
    "mono": "IBM Plex Mono",
    "scaleRatio": 1.25,
    "bundled": true,
    "fallback": {
      "devanagari": "Noto Sans Devanagari"
    }
  },
  "palette": {
    "slots": [
      "bg",
      "surface",
      "rule",
      "inkMuted",
      "ink",
      "accent",
      "accent2",
      "accentInk"
    ],
    "values": {
      "bg": "#efeadf",
      "surface": "#fbf9f4",
      "rule": "#d0c9ba",
      "inkMuted": "#6f6a5f",
      "ink": "#1a1813",
      "accent": "#2f7d78",
      "accent2": "#c9743c",
      "accentInk": "#fbf9f4"
    },
    "strategy": "luminance ladder; hue-rotatable at each slot’s own lightness"
  },
  "tweaks": [
    {
      "key": "brand",
      "type": "text"
    },
    {
      "key": "bg",
      "type": "color"
    },
    {
      "key": "accent",
      "type": "color"
    },
    {
      "key": "accent2",
      "type": "color"
    },
    {
      "key": "motion",
      "type": "radio",
      "options": [
        "Calm",
        "Lively",
        "Bouncy"
      ],
      "default": "Lively"
    },
    {
      "key": "typeScale",
      "type": "radio",
      "options": [
        "Compact",
        "Default",
        "Editorial"
      ],
      "default": "Default"
    }
  ],
  "motion": {
    "titlePreset": "rise",
    "itemPreset": "rise",
    "camera": [
      "pushU",
      "zoomIn",
      "pushL",
      "drop",
      "pushR",
      "zoomOut"
    ],
    "mechanics": "Scroll: \"feed\", Typing: \"typewriter\", Ring: \"bar\"",
    "chrome": false
  },
  "world": {
    "description": "the corner you work in. Far: a shelf of plants and mugs, a cork board with pinned scraps. Mid: a desk fan whose head sweeps a 6s arc while the blades spin much faster, a keyboard, a mug, a cable tangle that sways in the draught. Near: dust.",
    "cyclePeriodMs": 12000,
    "planes": 3,
    "textSafety": "object confined above y=290, below y=1330, or right of x=820; never crosses the copy column"
  },
  "mediaSlots": [
    {
      "id": "image",
      "beat": "Feature",
      "beatIndex": 10,
      "aspect": "16:10",
      "minPx": [
        640,
        400
      ],
      "fit": "cover",
      "priority": 1,
      "optional": true,
      "onEmpty": "swap per look.feature.swap (borrows nearest unclaimed script line)"
    },
    {
      "id": "logo",
      "beat": "CTA",
      "beatIndex": 17,
      "aspect": "1:1",
      "minPx": [
        256,
        256
      ],
      "fit": "contain",
      "priority": 2,
      "optional": true,
      "onEmpty": "pack icon mark in a filled badge"
    }
  ],
  "determinism": {
    "randomness": false,
    "wallClock": false,
    "seekSafe": true,
    "clock": "single authored timeline via animations-v2"
  },
  "paths": {
    "html": "templates/home-desk.html",
    "config": "configs/article-pack-05.js",
    "storyboard": "fixtures/storyboard.home-desk.json",
    "timestamps": "fixtures/timestamps.home-desk.json",
    "referenceFrames": "reference-frames/home-desk/"
  }
}