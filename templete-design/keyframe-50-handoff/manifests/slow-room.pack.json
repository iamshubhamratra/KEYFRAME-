{
  "id": "slow-room",
  "name": "Slow Room",
  "renderer": "filmkit",
  "orientation": "vertical",
  "sizePx": [
    1080,
    1920
  ],
  "cohort": "09 lifestyle / culture",
  "set": "article-text-50",
  "globalName": "SlowRoom",
  "configFile": "configs/article-pack-09.js",
  "vibe": "a veranda in the late afternoon",
  "form": {
    "runtimeMs": 129400,
    "runtimeRangeMs": [
      90000,
      150000
    ],
    "beats": 18
  },
  "readingBudget": {
    "wpm": 225,
    "landSeconds": 1.2,
    "checkedBy": "scripts/lint-reading-budget.js"
  },
  "fonts": {
    "display": "Yeseva One",
    "body": "Outfit",
    "mono": "IBM Plex Mono",
    "scaleRatio": 1.25,
    "bundled": true,
    "fallback": {
      "devanagari": "Noto Serif Devanagari"
    }
  },
  "palette": {
    "slots": [
      "bg",
      "surface",
      "rule",
      "inkMuted",
      "ink",
      "accent",
      "accent2",
      "accentInk"
    ],
    "values": {
      "bg": "#efe6d9",
      "surface": "#fbf6ee",
      "rule": "#cec0ac",
      "inkMuted": "#6f6558",
      "ink": "#17130e",
      "accent": "#b0623a",
      "accent2": "#5f7f72",
      "accentInk": "#fbf6ee"
    },
    "strategy": "luminance ladder; hue-rotatable at each slot’s own lightness"
  },
  "tweaks": [
    {
      "key": "brand",
      "type": "text"
    },
    {
      "key": "bg",
      "type": "color"
    },
    {
      "key": "accent",
      "type": "color"
    },
    {
      "key": "accent2",
      "type": "color"
    },
    {
      "key": "motion",
      "type": "radio",
      "options": [
        "Calm",
        "Lively",
        "Bouncy"
      ],
      "default": "Calm"
    },
    {
      "key": "typeScale",
      "type": "radio",
      "options": [
        "Compact",
        "Default",
        "Editorial"
      ],
      "default": "Default"
    }
  ],
  "motion": {
    "titlePreset": "drowse",
    "itemPreset": "rise",
    "camera": [
      "zoomOut",
      "drop",
      "pushL",
      "zoomIn",
      "pushR",
      "pushU"
    ],
    "mechanics": "Scroll: \"board\", Typing: \"typewriter\", Ring: \"gauge\"",
    "chrome": false
  },
  "world": {
    "description": "a veranda in the late afternoon. Overhead: a beamed ceiling with a fan turning slowly and a hanging plant swaying. Margin: a shuttered window with light bars crossing it, and a wicker chair. Floor: floorboards, a low table with a glass and a book, a rug edge. Near: dust in the light.",
    "cyclePeriodMs": 19000,
    "planes": 3,
    "textSafety": "object confined above y=290, below y=1330, or right of x=820; never crosses the copy column"
  },
  "mediaSlots": [
    {
      "id": "image",
      "beat": "Feature",
      "beatIndex": 10,
      "aspect": "16:10",
      "minPx": [
        640,
        400
      ],
      "fit": "cover",
      "priority": 1,
      "optional": true,
      "onEmpty": "swap per look.feature.swap (borrows nearest unclaimed script line)"
    },
    {
      "id": "logo",
      "beat": "CTA",
      "beatIndex": 17,
      "aspect": "1:1",
      "minPx": [
        256,
        256
      ],
      "fit": "contain",
      "priority": 2,
      "optional": true,
      "onEmpty": "pack icon mark in a filled badge"
    }
  ],
  "determinism": {
    "randomness": false,
    "wallClock": false,
    "seekSafe": true,
    "clock": "single authored timeline via animations-v2"
  },
  "paths": {
    "html": "templates/slow-room.html",
    "config": "configs/article-pack-09.js",
    "storyboard": "fixtures/storyboard.slow-room.json",
    "timestamps": "fixtures/timestamps.slow-room.json",
    "referenceFrames": "reference-frames/slow-room/"
  }
}