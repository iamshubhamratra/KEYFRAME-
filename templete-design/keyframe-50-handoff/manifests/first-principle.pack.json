{
  "id": "first-principle",
  "name": "First Principle",
  "renderer": "filmkit",
  "orientation": "vertical",
  "sizePx": [
    1080,
    1920
  ],
  "cohort": "08 science / explainer",
  "set": "article-text-50",
  "globalName": "FirstPrinciple",
  "configFile": "configs/article-pack-08.js",
  "vibe": "a demonstration bench",
  "form": {
    "runtimeMs": 129400,
    "runtimeRangeMs": [
      90000,
      150000
    ],
    "beats": 18
  },
  "readingBudget": {
    "wpm": 225,
    "landSeconds": 1.2,
    "checkedBy": "scripts/lint-reading-budget.js"
  },
  "fonts": {
    "display": "Big Shoulders Display",
    "body": "Assistant",
    "mono": "Space Mono",
    "scaleRatio": 1.25,
    "bundled": true,
    "fallback": {
      "devanagari": "Noto Sans Devanagari"
    }
  },
  "palette": {
    "slots": [
      "bg",
      "surface",
      "rule",
      "inkMuted",
      "ink",
      "accent",
      "accent2",
      "accentInk"
    ],
    "values": {
      "bg": "#eff1f0",
      "surface": "#fcfdfc",
      "rule": "#cbd0ce",
      "inkMuted": "#6c7371",
      "ink": "#0f1211",
      "accent": "#3f5fd8",
      "accent2": "#d8a03f",
      "accentInk": "#fcfdfc"
    },
    "strategy": "luminance ladder; hue-rotatable at each slot’s own lightness"
  },
  "tweaks": [
    {
      "key": "brand",
      "type": "text"
    },
    {
      "key": "bg",
      "type": "color"
    },
    {
      "key": "accent",
      "type": "color"
    },
    {
      "key": "accent2",
      "type": "color"
    },
    {
      "key": "motion",
      "type": "radio",
      "options": [
        "Calm",
        "Lively",
        "Bouncy"
      ],
      "default": "Bouncy"
    },
    {
      "key": "typeScale",
      "type": "radio",
      "options": [
        "Compact",
        "Default",
        "Editorial"
      ],
      "default": "Default"
    }
  ],
  "motion": {
    "titlePreset": "machete",
    "itemPreset": "pop",
    "camera": [
      "drop",
      "pushR",
      "hopU",
      "zoomIn",
      "pushL",
      "zoomOut"
    ],
    "mechanics": "Scroll: \"board\", Typing: \"caret\", Ring: \"ring\"",
    "chrome": false
  },
  "world": {
    "description": "a demonstration bench. Overhead: a lecture board of force diagrams and a hanging rail. Margin: the cradle — five balls on a frame, the end ball lifting and returning on a 2.4s beat, the middle three dead still, a flash at contact. Floor: a ramp with a rolling ball, weights, a stopwatch. Near: grit.",
    "cyclePeriodMs": 5000,
    "planes": 3,
    "textSafety": "object confined above y=290, below y=1330, or right of x=820; never crosses the copy column"
  },
  "mediaSlots": [
    {
      "id": "image",
      "beat": "Feature",
      "beatIndex": 10,
      "aspect": "16:10",
      "minPx": [
        640,
        400
      ],
      "fit": "cover",
      "priority": 1,
      "optional": true,
      "onEmpty": "swap per look.feature.swap (borrows nearest unclaimed script line)"
    },
    {
      "id": "logo",
      "beat": "CTA",
      "beatIndex": 17,
      "aspect": "1:1",
      "minPx": [
        256,
        256
      ],
      "fit": "contain",
      "priority": 2,
      "optional": true,
      "onEmpty": "pack icon mark in a filled badge"
    }
  ],
  "determinism": {
    "randomness": false,
    "wallClock": false,
    "seekSafe": true,
    "clock": "single authored timeline via animations-v2"
  },
  "paths": {
    "html": "templates/first-principle.html",
    "config": "configs/article-pack-08.js",
    "storyboard": "fixtures/storyboard.first-principle.json",
    "timestamps": "fixtures/timestamps.first-principle.json",
    "referenceFrames": "reference-frames/first-principle/"
  }
}