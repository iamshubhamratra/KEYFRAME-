{
  "id": "board-pack",
  "name": "Board Pack",
  "renderer": "filmkit",
  "orientation": "vertical",
  "sizePx": [
    1080,
    1920
  ],
  "cohort": "06 business / analyst",
  "set": "article-text-50",
  "globalName": "BoardPack",
  "configFile": "configs/article-pack-06.js",
  "vibe": "the board room with the model out",
  "form": {
    "runtimeMs": 129400,
    "runtimeRangeMs": [
      90000,
      150000
    ],
    "beats": 18
  },
  "readingBudget": {
    "wpm": 225,
    "landSeconds": 1.2,
    "checkedBy": "scripts/lint-reading-budget.js"
  },
  "fonts": {
    "display": "Schibsted Grotesk",
    "body": "Red Hat Text",
    "mono": "IBM Plex Mono",
    "scaleRatio": 1.25,
    "bundled": true,
    "fallback": {
      "devanagari": "Noto Sans Devanagari"
    }
  },
  "palette": {
    "slots": [
      "bg",
      "surface",
      "rule",
      "inkMuted",
      "ink",
      "accent",
      "accent2",
      "accentInk"
    ],
    "values": {
      "bg": "#101726",
      "surface": "#1a2336",
      "rule": "#2f3c52",
      "inkMuted": "#93a0b4",
      "ink": "#f4f6fa",
      "accent": "#d8b45a",
      "accent2": "#5a9bd8",
      "accentInk": "#0b1120"
    },
    "strategy": "luminance ladder; hue-rotatable at each slot’s own lightness"
  },
  "tweaks": [
    {
      "key": "brand",
      "type": "text"
    },
    {
      "key": "bg",
      "type": "color"
    },
    {
      "key": "accent",
      "type": "color"
    },
    {
      "key": "accent2",
      "type": "color"
    },
    {
      "key": "motion",
      "type": "radio",
      "options": [
        "Calm",
        "Lively",
        "Bouncy"
      ],
      "default": "Calm"
    },
    {
      "key": "typeScale",
      "type": "radio",
      "options": [
        "Compact",
        "Default",
        "Editorial"
      ],
      "default": "Default"
    }
  ],
  "motion": {
    "titlePreset": "rise",
    "itemPreset": "rise",
    "camera": [
      "zoomIn",
      "pushU",
      "pushL",
      "drop",
      "zoomOut",
      "pushR"
    ],
    "mechanics": "Scroll: \"board\", Typing: \"hand\", Ring: \"bar\"",
    "chrome": false
  },
  "world": {
    "description": "the board room with the model out. Far: a coffered ceiling grid and a pendant row. Mid: a scale model of the site on a turntable, rotating a slow 20s revolution under a spotlight so its shadow sweeps the table; a water jug and glasses beside it. Near: motes in the beam.",
    "cyclePeriodMs": 12000,
    "planes": 3,
    "textSafety": "object confined above y=290, below y=1330, or right of x=820; never crosses the copy column"
  },
  "mediaSlots": [
    {
      "id": "image",
      "beat": "Feature",
      "beatIndex": 10,
      "aspect": "16:10",
      "minPx": [
        640,
        400
      ],
      "fit": "cover",
      "priority": 1,
      "optional": true,
      "onEmpty": "swap per look.feature.swap (borrows nearest unclaimed script line)"
    },
    {
      "id": "logo",
      "beat": "CTA",
      "beatIndex": 17,
      "aspect": "1:1",
      "minPx": [
        256,
        256
      ],
      "fit": "contain",
      "priority": 2,
      "optional": true,
      "onEmpty": "pack icon mark in a filled badge"
    }
  ],
  "determinism": {
    "randomness": false,
    "wallClock": false,
    "seekSafe": true,
    "clock": "single authored timeline via animations-v2"
  },
  "paths": {
    "html": "templates/board-pack.html",
    "config": "configs/article-pack-06.js",
    "storyboard": "fixtures/storyboard.board-pack.json",
    "timestamps": "fixtures/timestamps.board-pack.json",
    "referenceFrames": "reference-frames/board-pack/"
  }
}