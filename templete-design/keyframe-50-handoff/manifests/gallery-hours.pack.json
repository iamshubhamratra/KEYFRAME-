{
  "id": "gallery-hours",
  "name": "Gallery Hours",
  "renderer": "filmkit",
  "orientation": "vertical",
  "sizePx": [
    1080,
    1920
  ],
  "cohort": "07 creative / portfolio",
  "set": "article-text-50",
  "globalName": "GalleryHours",
  "configFile": "configs/article-pack-07.js",
  "vibe": "three framed works with labels; a ceiling track and one light head sliding a 16s pass, its cone brightening each work as it passes; a bench and a visitor who stops, looks and moves on",
  "form": {
    "runtimeMs": 129400,
    "runtimeRangeMs": [
      90000,
      150000
    ],
    "beats": 18
  },
  "readingBudget": {
    "wpm": 225,
    "landSeconds": 1.2,
    "checkedBy": "scripts/lint-reading-budget.js"
  },
  "fonts": {
    "display": "Italiana",
    "body": "Jost",
    "mono": "IBM Plex Mono",
    "scaleRatio": 1.25,
    "bundled": true,
    "fallback": {
      "devanagari": "Noto Serif Devanagari"
    }
  },
  "palette": {
    "slots": [
      "bg",
      "surface",
      "rule",
      "inkMuted",
      "ink",
      "accent",
      "accent2",
      "accentInk"
    ],
    "values": {
      "bg": "#f2f0ec",
      "surface": "#fdfcfa",
      "rule": "#d2cec7",
      "inkMuted": "#6f6b64",
      "ink": "#141311",
      "accent": "#1f4f4a",
      "accent2": "#c9a34f",
      "accentInk": "#fdfcfa"
    },
    "strategy": "luminance ladder; hue-rotatable at each slot’s own lightness"
  },
  "tweaks": [
    {
      "key": "brand",
      "type": "text"
    },
    {
      "key": "bg",
      "type": "color"
    },
    {
      "key": "accent",
      "type": "color"
    },
    {
      "key": "accent2",
      "type": "color"
    },
    {
      "key": "motion",
      "type": "radio",
      "options": [
        "Calm",
        "Lively",
        "Bouncy"
      ],
      "default": "Calm"
    },
    {
      "key": "typeScale",
      "type": "radio",
      "options": [
        "Compact",
        "Default",
        "Editorial"
      ],
      "default": "Default"
    }
  ],
  "motion": {
    "titlePreset": "drowse",
    "itemPreset": "rise",
    "camera": [
      "zoomOut",
      "pushL",
      "drop",
      "pushR",
      "zoomIn",
      "pushU"
    ],
    "mechanics": "Scroll: \"feed\", Typing: \"hand\", Ring: \"ring\"",
    "chrome": false
  },
  "world": {
    "description": "three framed works with labels; a ceiling track and one light head sliding a 16s pass, its cone brightening each work as it passes; a bench and a visitor who stops, looks and moves on.",
    "cyclePeriodMs": 16000,
    "planes": 3,
    "textSafety": "object confined above y=290, below y=1330, or right of x=820; never crosses the copy column"
  },
  "mediaSlots": [
    {
      "id": "image",
      "beat": "Feature",
      "beatIndex": 10,
      "aspect": "16:10",
      "minPx": [
        640,
        400
      ],
      "fit": "cover",
      "priority": 1,
      "optional": true,
      "onEmpty": "swap per look.feature.swap (borrows nearest unclaimed script line)"
    },
    {
      "id": "logo",
      "beat": "CTA",
      "beatIndex": 17,
      "aspect": "1:1",
      "minPx": [
        256,
        256
      ],
      "fit": "contain",
      "priority": 2,
      "optional": true,
      "onEmpty": "pack icon mark in a filled badge"
    }
  ],
  "determinism": {
    "randomness": false,
    "wallClock": false,
    "seekSafe": true,
    "clock": "single authored timeline via animations-v2"
  },
  "paths": {
    "html": "templates/gallery-hours.html",
    "config": "configs/article-pack-07.js",
    "storyboard": "fixtures/storyboard.gallery-hours.json",
    "timestamps": "fixtures/timestamps.gallery-hours.json",
    "referenceFrames": "reference-frames/gallery-hours/"
  }
}