{
  "id": "bold-claim",
  "name": "Bold Claim",
  "renderer": "filmkit",
  "orientation": "vertical",
  "sizePx": [
    1080,
    1920
  ],
  "cohort": "10 opinion / manifesto",
  "set": "article-text-50",
  "globalName": "BoldClaim",
  "configFile": "configs/article-pack-10.js",
  "vibe": "a letterpress shop at proof",
  "form": {
    "runtimeMs": 129400,
    "runtimeRangeMs": [
      90000,
      150000
    ],
    "beats": 18
  },
  "readingBudget": {
    "wpm": 225,
    "landSeconds": 1.2,
    "checkedBy": "scripts/lint-reading-budget.js"
  },
  "fonts": {
    "display": "Passion One",
    "body": "Be Vietnam Pro",
    "mono": "IBM Plex Mono",
    "scaleRatio": 1.25,
    "bundled": true,
    "fallback": {
      "devanagari": "Noto Sans Devanagari"
    }
  },
  "palette": {
    "slots": [
      "bg",
      "surface",
      "rule",
      "inkMuted",
      "ink",
      "accent",
      "accent2",
      "accentInk"
    ],
    "values": {
      "bg": "#101012",
      "surface": "#1a1a1e",
      "rule": "#2d2d33",
      "inkMuted": "#8c8c94",
      "ink": "#f7f7f9",
      "accent": "#ffe14c",
      "accent2": "#4c9bff",
      "accentInk": "#0b0b0d"
    },
    "strategy": "luminance ladder; hue-rotatable at each slot’s own lightness"
  },
  "tweaks": [
    {
      "key": "brand",
      "type": "text"
    },
    {
      "key": "bg",
      "type": "color"
    },
    {
      "key": "accent",
      "type": "color"
    },
    {
      "key": "accent2",
      "type": "color"
    },
    {
      "key": "motion",
      "type": "radio",
      "options": [
        "Calm",
        "Lively",
        "Bouncy"
      ],
      "default": "Bouncy"
    },
    {
      "key": "typeScale",
      "type": "radio",
      "options": [
        "Compact",
        "Default",
        "Editorial"
      ],
      "default": "Default"
    }
  ],
  "motion": {
    "titlePreset": "slam",
    "itemPreset": "slam",
    "camera": [
      "slamR",
      "zoomIn",
      "spin",
      "slamL",
      "drop",
      "zoomOut"
    ],
    "mechanics": "Scroll: \"board\", Typing: \"typewriter\", Ring: \"ring\"",
    "chrome": false
  },
  "world": {
    "description": "a letterpress shop at proof. Overhead: a shaft-and-belt drive and a row of galley trays. Margin: the stone with a cylinder rolling across it on a 6s cycle, inked type beneath, a sheet peeling away after each pass. Floor: a type case, an ink drum, a stack of proofs. Near: ink flecks.",
    "cyclePeriodMs": 6000,
    "planes": 3,
    "textSafety": "object confined above y=290, below y=1330, or right of x=820; never crosses the copy column"
  },
  "mediaSlots": [
    {
      "id": "image",
      "beat": "Feature",
      "beatIndex": 10,
      "aspect": "16:10",
      "minPx": [
        640,
        400
      ],
      "fit": "cover",
      "priority": 1,
      "optional": true,
      "onEmpty": "swap per look.feature.swap (borrows nearest unclaimed script line)"
    },
    {
      "id": "logo",
      "beat": "CTA",
      "beatIndex": 17,
      "aspect": "1:1",
      "minPx": [
        256,
        256
      ],
      "fit": "contain",
      "priority": 2,
      "optional": true,
      "onEmpty": "pack icon mark in a filled badge"
    }
  ],
  "determinism": {
    "randomness": false,
    "wallClock": false,
    "seekSafe": true,
    "clock": "single authored timeline via animations-v2"
  },
  "paths": {
    "html": "templates/bold-claim.html",
    "config": "configs/article-pack-10.js",
    "storyboard": "fixtures/storyboard.bold-claim.json",
    "timestamps": "fixtures/timestamps.bold-claim.json",
    "referenceFrames": "reference-frames/bold-claim/"
  }
}