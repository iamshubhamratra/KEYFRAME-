{
  "id": "press-run",
  "name": "Press Run",
  "renderer": "filmkit",
  "orientation": "vertical",
  "sizePx": [
    1080,
    1920
  ],
  "cohort": "03 news / journalism",
  "set": "article-text-50",
  "globalName": "PressRun",
  "configFile": "configs/article-pack-03.js",
  "vibe": "the dock, first edition loading",
  "form": {
    "runtimeMs": 129400,
    "runtimeRangeMs": [
      90000,
      150000
    ],
    "beats": 18
  },
  "readingBudget": {
    "wpm": 225,
    "landSeconds": 1.2,
    "checkedBy": "scripts/lint-reading-budget.js"
  },
  "fonts": {
    "display": "Merriweather",
    "body": "Work Sans",
    "mono": "IBM Plex Mono",
    "scaleRatio": 1.25,
    "bundled": true,
    "fallback": {
      "devanagari": "Noto Serif Devanagari"
    }
  },
  "palette": {
    "slots": [
      "bg",
      "surface",
      "rule",
      "inkMuted",
      "ink",
      "accent",
      "accent2",
      "accentInk"
    ],
    "values": {
      "bg": "#14161a",
      "surface": "#1f2329",
      "rule": "#333a42",
      "inkMuted": "#8e9aa5",
      "ink": "#f0f2f4",
      "accent": "#c93a2f",
      "accent2": "#e6c15a",
      "accentInk": "#0e1012"
    },
    "strategy": "luminance ladder; hue-rotatable at each slot’s own lightness"
  },
  "tweaks": [
    {
      "key": "brand",
      "type": "text"
    },
    {
      "key": "bg",
      "type": "color"
    },
    {
      "key": "accent",
      "type": "color"
    },
    {
      "key": "accent2",
      "type": "color"
    },
    {
      "key": "motion",
      "type": "radio",
      "options": [
        "Calm",
        "Lively",
        "Bouncy"
      ],
      "default": "Lively"
    },
    {
      "key": "typeScale",
      "type": "radio",
      "options": [
        "Compact",
        "Default",
        "Editorial"
      ],
      "default": "Default"
    }
  ],
  "motion": {
    "titlePreset": "slam",
    "itemPreset": "rise",
    "camera": [
      "drop",
      "pushR",
      "zoomIn",
      "pushL",
      "spin",
      "zoomOut"
    ],
    "mechanics": "Scroll: \"board\", Typing: \"typewriter\", Ring: \"ring\"",
    "chrome": false
  },
  "world": {
    "description": "the dock, first edition loading. Far: a roller shutter wall and sodium lamps. Mid: pallets of bundles, a hazard-chevron kerb, and a van pulling out on a 12s traverse — wheels turning at travel speed, body rocking on its springs, headlight cone sweeping, exhaust puffing. Near: drizzle streaks.",
    "cyclePeriodMs": 12000,
    "planes": 3,
    "textSafety": "object confined above y=290, below y=1330, or right of x=820; never crosses the copy column"
  },
  "mediaSlots": [
    {
      "id": "image",
      "beat": "Feature",
      "beatIndex": 10,
      "aspect": "16:10",
      "minPx": [
        640,
        400
      ],
      "fit": "cover",
      "priority": 1,
      "optional": true,
      "onEmpty": "swap per look.feature.swap (borrows nearest unclaimed script line)"
    },
    {
      "id": "logo",
      "beat": "CTA",
      "beatIndex": 17,
      "aspect": "1:1",
      "minPx": [
        256,
        256
      ],
      "fit": "contain",
      "priority": 2,
      "optional": true,
      "onEmpty": "pack icon mark in a filled badge"
    }
  ],
  "determinism": {
    "randomness": false,
    "wallClock": false,
    "seekSafe": true,
    "clock": "single authored timeline via animations-v2"
  },
  "paths": {
    "html": "templates/press-run.html",
    "config": "configs/article-pack-03.js",
    "storyboard": "fixtures/storyboard.press-run.json",
    "timestamps": "fixtures/timestamps.press-run.json",
    "referenceFrames": "reference-frames/press-run/"
  }
}