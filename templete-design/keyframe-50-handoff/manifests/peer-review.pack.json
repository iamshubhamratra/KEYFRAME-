{
  "id": "peer-review",
  "name": "Peer Review",
  "renderer": "filmkit",
  "orientation": "vertical",
  "sizePx": [
    1080,
    1920
  ],
  "cohort": "04 academic / research",
  "set": "article-text-50",
  "globalName": "PeerReview",
  "configFile": "configs/article-pack-04.js",
  "vibe": "the seminar room before anyone arrives",
  "form": {
    "runtimeMs": 129400,
    "runtimeRangeMs": [
      90000,
      150000
    ],
    "beats": 18
  },
  "readingBudget": {
    "wpm": 225,
    "landSeconds": 1.2,
    "checkedBy": "scripts/lint-reading-budget.js"
  },
  "fonts": {
    "display": "Marcellus",
    "body": "Spectral",
    "mono": "IBM Plex Mono",
    "scaleRatio": 1.25,
    "bundled": true,
    "fallback": {
      "devanagari": "Noto Serif Devanagari"
    }
  },
  "palette": {
    "slots": [
      "bg",
      "surface",
      "rule",
      "inkMuted",
      "ink",
      "accent",
      "accent2",
      "accentInk"
    ],
    "values": {
      "bg": "#eceae4",
      "surface": "#f8f7f3",
      "rule": "#c6c4bc",
      "inkMuted": "#6c6a63",
      "ink": "#15151a",
      "accent": "#2b3a72",
      "accent2": "#b08a3c",
      "accentInk": "#f8f7f3"
    },
    "strategy": "luminance ladder; hue-rotatable at each slot’s own lightness"
  },
  "tweaks": [
    {
      "key": "brand",
      "type": "text"
    },
    {
      "key": "bg",
      "type": "color"
    },
    {
      "key": "accent",
      "type": "color"
    },
    {
      "key": "accent2",
      "type": "color"
    },
    {
      "key": "motion",
      "type": "radio",
      "options": [
        "Calm",
        "Lively",
        "Bouncy"
      ],
      "default": "Calm"
    },
    {
      "key": "typeScale",
      "type": "radio",
      "options": [
        "Compact",
        "Default",
        "Editorial"
      ],
      "default": "Default"
    }
  ],
  "motion": {
    "titlePreset": "drowse",
    "itemPreset": "rise",
    "camera": [
      "zoomIn",
      "pushU",
      "pushL",
      "zoomOut",
      "drop",
      "pushR"
    ],
    "mechanics": "Scroll: \"board\", Typing: \"caret\", Ring: \"ring\"",
    "chrome": false
  },
  "world": {
    "description": "the seminar room before anyone arrives. Far: a chalkboard with ghost equations that fade and rewrite, tiered seat backs on parallax, two globe lamps. Mid: an orrery on its plinth, three arms turning at three rates with the gear train visible. Near: chalk dust rising.",
    "cyclePeriodMs": 12000,
    "planes": 3,
    "textSafety": "object confined above y=290, below y=1330, or right of x=820; never crosses the copy column"
  },
  "mediaSlots": [
    {
      "id": "image",
      "beat": "Feature",
      "beatIndex": 10,
      "aspect": "16:10",
      "minPx": [
        640,
        400
      ],
      "fit": "cover",
      "priority": 1,
      "optional": true,
      "onEmpty": "swap per look.feature.swap (borrows nearest unclaimed script line)"
    },
    {
      "id": "logo",
      "beat": "CTA",
      "beatIndex": 17,
      "aspect": "1:1",
      "minPx": [
        256,
        256
      ],
      "fit": "contain",
      "priority": 2,
      "optional": true,
      "onEmpty": "pack icon mark in a filled badge"
    }
  ],
  "determinism": {
    "randomness": false,
    "wallClock": false,
    "seekSafe": true,
    "clock": "single authored timeline via animations-v2"
  },
  "paths": {
    "html": "templates/peer-review.html",
    "config": "configs/article-pack-04.js",
    "storyboard": "fixtures/storyboard.peer-review.json",
    "timestamps": "fixtures/timestamps.peer-review.json",
    "referenceFrames": "reference-frames/peer-review/"
  }
}