{
  "id": "small-talk",
  "name": "Small Talk",
  "renderer": "filmkit",
  "orientation": "vertical",
  "sizePx": [
    1080,
    1920
  ],
  "cohort": "05 personal blog / diary",
  "set": "article-text-50",
  "globalName": "SmallTalk",
  "configFile": "configs/article-pack-05.js",
  "vibe": "two balconies across a gap",
  "form": {
    "runtimeMs": 129400,
    "runtimeRangeMs": [
      90000,
      150000
    ],
    "beats": 18
  },
  "readingBudget": {
    "wpm": 225,
    "landSeconds": 1.2,
    "checkedBy": "scripts/lint-reading-budget.js"
  },
  "fonts": {
    "display": "Gochi Hand",
    "body": "Quicksand",
    "mono": "IBM Plex Mono",
    "scaleRatio": 1.25,
    "bundled": true,
    "fallback": {
      "devanagari": "Noto Sans Devanagari"
    }
  },
  "palette": {
    "slots": [
      "bg",
      "surface",
      "rule",
      "inkMuted",
      "ink",
      "accent",
      "accent2",
      "accentInk"
    ],
    "values": {
      "bg": "#e6eef3",
      "surface": "#f7fbfd",
      "rule": "#c3d2da",
      "inkMuted": "#6a767e",
      "ink": "#141a1e",
      "accent": "#f08a3c",
      "accent2": "#7d6bd0",
      "accentInk": "#f7fbfd"
    },
    "strategy": "luminance ladder; hue-rotatable at each slot’s own lightness"
  },
  "tweaks": [
    {
      "key": "brand",
      "type": "text"
    },
    {
      "key": "bg",
      "type": "color"
    },
    {
      "key": "accent",
      "type": "color"
    },
    {
      "key": "accent2",
      "type": "color"
    },
    {
      "key": "motion",
      "type": "radio",
      "options": [
        "Calm",
        "Lively",
        "Bouncy"
      ],
      "default": "Bouncy"
    },
    {
      "key": "typeScale",
      "type": "radio",
      "options": [
        "Compact",
        "Default",
        "Editorial"
      ],
      "default": "Default"
    }
  ],
  "motion": {
    "titlePreset": "bounce",
    "itemPreset": "pop",
    "camera": [
      "pushL",
      "hopU",
      "pushR",
      "zoomIn",
      "drop",
      "zoomOut"
    ],
    "mechanics": "Scroll: \"board\", Typing: \"caret\", Ring: \"ring\"",
    "chrome": false
  },
  "world": {
    "description": "two balconies across a gap. Far: rooftops and a cloud drift. Mid: railings either side, laundry on a line, plant pots, and a tin-can telephone whose string sags and tightens while a paper note travels along it on a 7s trip. Near: bubbles rising.",
    "cyclePeriodMs": 7000,
    "planes": 3,
    "textSafety": "object confined above y=290, below y=1330, or right of x=820; never crosses the copy column"
  },
  "mediaSlots": [
    {
      "id": "image",
      "beat": "Feature",
      "beatIndex": 10,
      "aspect": "16:10",
      "minPx": [
        640,
        400
      ],
      "fit": "cover",
      "priority": 1,
      "optional": true,
      "onEmpty": "swap per look.feature.swap (borrows nearest unclaimed script line)"
    },
    {
      "id": "logo",
      "beat": "CTA",
      "beatIndex": 17,
      "aspect": "1:1",
      "minPx": [
        256,
        256
      ],
      "fit": "contain",
      "priority": 2,
      "optional": true,
      "onEmpty": "pack icon mark in a filled badge"
    }
  ],
  "determinism": {
    "randomness": false,
    "wallClock": false,
    "seekSafe": true,
    "clock": "single authored timeline via animations-v2"
  },
  "paths": {
    "html": "templates/small-talk.html",
    "config": "configs/article-pack-05.js",
    "storyboard": "fixtures/storyboard.small-talk.json",
    "timestamps": "fixtures/timestamps.small-talk.json",
    "referenceFrames": "reference-frames/small-talk/"
  }
}