{
  "id": "field-note",
  "name": "Field Note",
  "renderer": "filmkit",
  "orientation": "vertical",
  "sizePx": [
    1080,
    1920
  ],
  "cohort": "04 academic / research",
  "set": "article-text-50",
  "globalName": "FieldNote",
  "configFile": "configs/article-pack-04.js",
  "vibe": "a riverbank at survey time",
  "form": {
    "runtimeMs": 129400,
    "runtimeRangeMs": [
      90000,
      150000
    ],
    "beats": 18
  },
  "readingBudget": {
    "wpm": 225,
    "landSeconds": 1.2,
    "checkedBy": "scripts/lint-reading-budget.js"
  },
  "fonts": {
    "display": "Bree Serif",
    "body": "Karla",
    "mono": "IBM Plex Mono",
    "scaleRatio": 1.25,
    "bundled": true,
    "fallback": {
      "devanagari": "Noto Serif Devanagari"
    }
  },
  "palette": {
    "slots": [
      "bg",
      "surface",
      "rule",
      "inkMuted",
      "ink",
      "accent",
      "accent2",
      "accentInk"
    ],
    "values": {
      "bg": "#e7edec",
      "surface": "#f8fbfa",
      "rule": "#c2ceca",
      "inkMuted": "#68746f",
      "ink": "#131816",
      "accent": "#2f7a72",
      "accent2": "#c9903a",
      "accentInk": "#f8fbfa"
    },
    "strategy": "luminance ladder; hue-rotatable at each slot’s own lightness"
  },
  "tweaks": [
    {
      "key": "brand",
      "type": "text"
    },
    {
      "key": "bg",
      "type": "color"
    },
    {
      "key": "accent",
      "type": "color"
    },
    {
      "key": "accent2",
      "type": "color"
    },
    {
      "key": "motion",
      "type": "radio",
      "options": [
        "Calm",
        "Lively",
        "Bouncy"
      ],
      "default": "Lively"
    },
    {
      "key": "typeScale",
      "type": "radio",
      "options": [
        "Compact",
        "Default",
        "Editorial"
      ],
      "default": "Default"
    }
  ],
  "motion": {
    "titlePreset": "bounce",
    "itemPreset": "pop",
    "camera": [
      "hopU",
      "pushR",
      "drop",
      "pushL",
      "zoomIn",
      "zoomOut"
    ],
    "mechanics": "Scroll: \"feed\", Typing: \"hand\", Ring: \"gauge\"",
    "chrome": false
  },
  "world": {
    "description": "a riverbank at survey time. Far: a far bank with a gate and two hedge lines on parallax. Mid: the water band with drifting ripples and stones, reeds bending on a wind wave, and a dragonfly darting a 6s route in short bursts and holds, wings blurred by dash phase. Near: midges.",
    "cyclePeriodMs": 6000,
    "planes": 3,
    "textSafety": "object confined above y=290, below y=1330, or right of x=820; never crosses the copy column"
  },
  "mediaSlots": [
    {
      "id": "image",
      "beat": "Feature",
      "beatIndex": 10,
      "aspect": "16:10",
      "minPx": [
        640,
        400
      ],
      "fit": "cover",
      "priority": 1,
      "optional": true,
      "onEmpty": "swap per look.feature.swap (borrows nearest unclaimed script line)"
    },
    {
      "id": "logo",
      "beat": "CTA",
      "beatIndex": 17,
      "aspect": "1:1",
      "minPx": [
        256,
        256
      ],
      "fit": "contain",
      "priority": 2,
      "optional": true,
      "onEmpty": "pack icon mark in a filled badge"
    }
  ],
  "determinism": {
    "randomness": false,
    "wallClock": false,
    "seekSafe": true,
    "clock": "single authored timeline via animations-v2"
  },
  "paths": {
    "html": "templates/field-note.html",
    "config": "configs/article-pack-04.js",
    "storyboard": "fixtures/storyboard.field-note.json",
    "timestamps": "fixtures/timestamps.field-note.json",
    "referenceFrames": "reference-frames/field-note/"
  }
}