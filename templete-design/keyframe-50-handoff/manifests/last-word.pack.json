{
  "id": "last-word",
  "name": "Last Word",
  "renderer": "filmkit",
  "orientation": "vertical",
  "sizePx": [
    1080,
    1920
  ],
  "cohort": "10 opinion / manifesto",
  "set": "article-text-50",
  "globalName": "LastWord",
  "configFile": "configs/article-pack-10.js",
  "vibe": "a belfry room",
  "form": {
    "runtimeMs": 129400,
    "runtimeRangeMs": [
      90000,
      150000
    ],
    "beats": 18
  },
  "readingBudget": {
    "wpm": 225,
    "landSeconds": 1.2,
    "checkedBy": "scripts/lint-reading-budget.js"
  },
  "fonts": {
    "display": "Abril Fatface",
    "body": "Lora",
    "mono": "IBM Plex Mono",
    "scaleRatio": 1.25,
    "bundled": true,
    "fallback": {
      "devanagari": "Noto Serif Devanagari"
    }
  },
  "palette": {
    "slots": [
      "bg",
      "surface",
      "rule",
      "inkMuted",
      "ink",
      "accent",
      "accent2",
      "accentInk"
    ],
    "values": {
      "bg": "#f0ece3",
      "surface": "#fbf9f4",
      "rule": "#cbc4b5",
      "inkMuted": "#6e675c",
      "ink": "#16130d",
      "accent": "#7a2f2f",
      "accent2": "#b08c3a",
      "accentInk": "#fbf9f4"
    },
    "strategy": "luminance ladder; hue-rotatable at each slot’s own lightness"
  },
  "tweaks": [
    {
      "key": "brand",
      "type": "text"
    },
    {
      "key": "bg",
      "type": "color"
    },
    {
      "key": "accent",
      "type": "color"
    },
    {
      "key": "accent2",
      "type": "color"
    },
    {
      "key": "motion",
      "type": "radio",
      "options": [
        "Calm",
        "Lively",
        "Bouncy"
      ],
      "default": "Calm"
    },
    {
      "key": "typeScale",
      "type": "radio",
      "options": [
        "Compact",
        "Default",
        "Editorial"
      ],
      "default": "Default"
    }
  ],
  "motion": {
    "titlePreset": "drowse",
    "itemPreset": "rise",
    "camera": [
      "zoomIn",
      "pushU",
      "drop",
      "pushL",
      "zoomOut",
      "pushR"
    ],
    "mechanics": "Scroll: \"board\", Typing: \"caret\", Ring: \"gauge\"",
    "chrome": false
  },
  "world": {
    "description": "a belfry room. Overhead: a beamed frame and a louvre letting light in. Margin: the bell on its rope, rung every 8s — it swings, the clapper lags and strikes on the return, rings leaving the mouth. Floor: the rope coiled, a ledger on a stand, a stack of hymn boards. Near: dust in the louvre light.",
    "cyclePeriodMs": 17000,
    "planes": 3,
    "textSafety": "object confined above y=290, below y=1330, or right of x=820; never crosses the copy column"
  },
  "mediaSlots": [
    {
      "id": "image",
      "beat": "Feature",
      "beatIndex": 10,
      "aspect": "16:10",
      "minPx": [
        640,
        400
      ],
      "fit": "cover",
      "priority": 1,
      "optional": true,
      "onEmpty": "swap per look.feature.swap (borrows nearest unclaimed script line)"
    },
    {
      "id": "logo",
      "beat": "CTA",
      "beatIndex": 17,
      "aspect": "1:1",
      "minPx": [
        256,
        256
      ],
      "fit": "contain",
      "priority": 2,
      "optional": true,
      "onEmpty": "pack icon mark in a filled badge"
    }
  ],
  "determinism": {
    "randomness": false,
    "wallClock": false,
    "seekSafe": true,
    "clock": "single authored timeline via animations-v2"
  },
  "paths": {
    "html": "templates/last-word.html",
    "config": "configs/article-pack-10.js",
    "storyboard": "fixtures/storyboard.last-word.json",
    "timestamps": "fixtures/timestamps.last-word.json",
    "referenceFrames": "reference-frames/last-word/"
  }
}