{
  "id": "root-path",
  "name": "Root Path",
  "renderer": "filmkit",
  "orientation": "vertical",
  "sizePx": [
    1080,
    1920
  ],
  "cohort": "01 technical / documentation",
  "set": "article-text-50",
  "globalName": "RootPath",
  "configFile": "configs/article-pack-01.js",
  "vibe": "a survey corridor",
  "form": {
    "runtimeMs": 128400,
    "runtimeRangeMs": [
      90000,
      150000
    ],
    "beats": 18
  },
  "readingBudget": {
    "wpm": 225,
    "landSeconds": 1.2,
    "checkedBy": "scripts/lint-reading-budget.js"
  },
  "fonts": {
    "display": "Chakra Petch",
    "body": "Sarabun",
    "mono": "Space Mono",
    "scaleRatio": 1.25,
    "bundled": true,
    "fallback": {
      "devanagari": "Noto Sans Devanagari"
    }
  },
  "palette": {
    "slots": [
      "bg",
      "surface",
      "rule",
      "inkMuted",
      "ink",
      "accent",
      "accent2",
      "accentInk"
    ],
    "values": {
      "bg": "#141210",
      "surface": "#1e1a16",
      "rule": "#3a322a",
      "inkMuted": "#9c9186",
      "ink": "#f0eae2",
      "accent": "#f2a33c",
      "accent2": "#5fb0a8",
      "accentInk": "#120f0c"
    },
    "strategy": "luminance ladder; hue-rotatable at each slot’s own lightness"
  },
  "tweaks": [
    {
      "key": "brand",
      "type": "text"
    },
    {
      "key": "bg",
      "type": "color"
    },
    {
      "key": "accent",
      "type": "color"
    },
    {
      "key": "accent2",
      "type": "color"
    },
    {
      "key": "motion",
      "type": "radio",
      "options": [
        "Calm",
        "Lively",
        "Bouncy"
      ],
      "default": "Lively"
    },
    {
      "key": "typeScale",
      "type": "radio",
      "options": [
        "Compact",
        "Default",
        "Editorial"
      ],
      "default": "Default"
    }
  ],
  "motion": {
    "titlePreset": "slam",
    "itemPreset": "rise",
    "camera": [
      "drop",
      "pushR",
      "spin",
      "pushL",
      "hopU",
      "zoomIn"
    ],
    "mechanics": "Ring: \"ring\", Scroll: \"board\", Typing: \"hand\"",
    "chrome": false
  },
  "world": {
    "description": "a survey corridor. Far: a crosshair grid, a horizon glow and two ridge silhouettes drifting on parallax. Mid: a dashed route with pulsing waypoints, beacon masts blinking out of phase, and the quadcopter flying the route on a 16s orbit — arms, shells with a single light source, rotor discs dashed to read as blur, ground shadow tracking altitude. Near: data motes and streaks. All of it below y=H*0.62, clear of every text block.",
    "cyclePeriodMs": 12000,
    "planes": 3,
    "textSafety": "object confined above y=290, below y=1330, or right of x=820; never crosses the copy column"
  },
  "mediaSlots": [
    {
      "id": "image",
      "beat": "Feature",
      "beatIndex": 10,
      "aspect": "16:10",
      "minPx": [
        640,
        400
      ],
      "fit": "cover",
      "priority": 1,
      "optional": true,
      "onEmpty": "swap per look.feature.swap (borrows nearest unclaimed script line)"
    },
    {
      "id": "logo",
      "beat": "CTA",
      "beatIndex": 17,
      "aspect": "1:1",
      "minPx": [
        256,
        256
      ],
      "fit": "contain",
      "priority": 2,
      "optional": true,
      "onEmpty": "pack icon mark in a filled badge"
    }
  ],
  "determinism": {
    "randomness": false,
    "wallClock": false,
    "seekSafe": true,
    "clock": "single authored timeline via animations-v2"
  },
  "paths": {
    "html": "templates/root-path.html",
    "config": "configs/article-pack-01.js",
    "storyboard": "fixtures/storyboard.root-path.json",
    "timestamps": "fixtures/timestamps.root-path.json",
    "referenceFrames": "reference-frames/root-path/"
  }
}