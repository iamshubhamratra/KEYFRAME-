{
  "id": "byline-rule",
  "name": "Byline Rule",
  "renderer": "filmkit",
  "orientation": "vertical",
  "sizePx": [
    1080,
    1920
  ],
  "cohort": "03 news / journalism",
  "set": "article-text-50",
  "globalName": "BylineRule",
  "configFile": "configs/article-pack-03.js",
  "vibe": "the press pit",
  "form": {
    "runtimeMs": 129400,
    "runtimeRangeMs": [
      90000,
      150000
    ],
    "beats": 18
  },
  "readingBudget": {
    "wpm": 225,
    "landSeconds": 1.2,
    "checkedBy": "scripts/lint-reading-budget.js"
  },
  "fonts": {
    "display": "Oswald",
    "body": "PT Sans",
    "mono": "IBM Plex Mono",
    "scaleRatio": 1.25,
    "bundled": true,
    "fallback": {
      "devanagari": "Noto Sans Devanagari"
    }
  },
  "palette": {
    "slots": [
      "bg",
      "surface",
      "rule",
      "inkMuted",
      "ink",
      "accent",
      "accent2",
      "accentInk"
    ],
    "values": {
      "bg": "#0e0f11",
      "surface": "#191b1e",
      "rule": "#2c3034",
      "inkMuted": "#8b9095",
      "ink": "#f7f8f9",
      "accent": "#f2d13c",
      "accent2": "#d0473c",
      "accentInk": "#0b0c0d"
    },
    "strategy": "luminance ladder; hue-rotatable at each slot’s own lightness"
  },
  "tweaks": [
    {
      "key": "brand",
      "type": "text"
    },
    {
      "key": "bg",
      "type": "color"
    },
    {
      "key": "accent",
      "type": "color"
    },
    {
      "key": "accent2",
      "type": "color"
    },
    {
      "key": "motion",
      "type": "radio",
      "options": [
        "Calm",
        "Lively",
        "Bouncy"
      ],
      "default": "Bouncy"
    },
    {
      "key": "typeScale",
      "type": "radio",
      "options": [
        "Compact",
        "Default",
        "Editorial"
      ],
      "default": "Default"
    }
  ],
  "motion": {
    "titlePreset": "streak",
    "itemPreset": "slam",
    "camera": [
      "zoomIn",
      "pushU",
      "spin",
      "pushR",
      "drop",
      "pushL"
    ],
    "mechanics": "Scroll: \"feed\", Typing: \"hand\", Ring: \"bar\"",
    "chrome": false
  },
  "world": {
    "description": "the press pit. Far: a lit backdrop wall that pulses with each flash, and a row of crowd heads bobbing out of phase. Mid: a barrier rail, three boom mics leaning in, and a press camera swinging on its strap in the right margin — the strap lags the body and the bulb fires on a 2.6s cycle, lighting the whole frame for two frames. Near: flash sparks.",
    "cyclePeriodMs": 2600,
    "planes": 3,
    "textSafety": "object confined above y=290, below y=1330, or right of x=820; never crosses the copy column"
  },
  "mediaSlots": [
    {
      "id": "image",
      "beat": "Feature",
      "beatIndex": 10,
      "aspect": "16:10",
      "minPx": [
        640,
        400
      ],
      "fit": "cover",
      "priority": 1,
      "optional": true,
      "onEmpty": "swap per look.feature.swap (borrows nearest unclaimed script line)"
    },
    {
      "id": "logo",
      "beat": "CTA",
      "beatIndex": 17,
      "aspect": "1:1",
      "minPx": [
        256,
        256
      ],
      "fit": "contain",
      "priority": 2,
      "optional": true,
      "onEmpty": "pack icon mark in a filled badge"
    }
  ],
  "determinism": {
    "randomness": false,
    "wallClock": false,
    "seekSafe": true,
    "clock": "single authored timeline via animations-v2"
  },
  "paths": {
    "html": "templates/byline-rule.html",
    "config": "configs/article-pack-03.js",
    "storyboard": "fixtures/storyboard.byline-rule.json",
    "timestamps": "fixtures/timestamps.byline-rule.json",
    "referenceFrames": "reference-frames/byline-rule/"
  }
}