{
  "name": "cartesian",
  "renderer": "editorial-quiet",
  "vibe": "A quiet museum-catalog editorial system on warm stone paper: 1px taupe hairlines as the only structure, thin-stroke Playfair in ink, and compass-drafted rings drifting behind sparse, breathing frames.",
  "colors": {
    "bg-primary": "#EDE8E0",
    "bg-secondary": "#E2DBD1",
    "text-primary": "#1A1A1A",
    "text-secondary": "#5A5A5A",
    "accent": "#8A8178",
    "line": "#B8B0A4"
  },
  "fonts": [
    "Anton",
    "JetBrains Mono"
  ],
  "surface": {
    "flat": true,
    "lightCinematic": false,
    "ground": "#EDE8E0"
  },
  "motion": {
    "cut": "fade",
    "drift": 1.02
  },
  "fx": {
    "canvas": "grid",
    "three": null
  },
  "skin": {
    "accents": [
      "#8A8178",
      "#B8B0A4"
    ],
    "extras": [
      "#1A1A1A"
    ],
    "emphasisCss": null
  },
  "assets": {
    "photoMod": "desaturated warm-stone duotone, low contrast, editorial crop framed by a 1px taupe hairline",
    "iconStyle": "line",
    "keywords": [
      "editorial",
      "minimal",
      "museum-catalog",
      "geometric",
      "warm-stone",
      "restraint"
    ],
    "prefer": [
      "vector",
      "illustration"
    ]
  },
  "textfx": {
    "enter": "glitch",
    "emphasis": "bracket",
    "case": "upper",
    "tracking": -0.035,
    "weight": 900,
    "sizeScale": 1.18,
    "align": "left"
  },
  "audio": {
    "music": {
      "query": "hand claps foot stomps rock energetic anthem",
      "mood": "energetic",
      "volume": 0.15
    },
    "sfx": {
      "style": "hard percussive hits, stomp impacts, clap accents and riser sweeps on every cut",
      "palette": [
        "impact hit",
        "clap",
        "riser sweep",
        "whoosh transition"
      ]
    }
  },
  "layout": {
    "propFill": false,
    "kicker": true,
    "underline": true,
    "stat": "headline"
  },
  "typography": {
    "display": "Anton"
  }
}