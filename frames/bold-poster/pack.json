{
  "name": "bold-poster",
  "renderer": "poster-loud",
  "vibe": "A populist editorial poster: vintage Italian sports-magazine display, classical serif body, one saturated tomato red, ink-ruled grids — every frame feels printed on a white sheet.",
  "colors": {
    "bg": "#FFFFFF",
    "dark": "#1C1410",
    "red": "#D8000F",
    "light": "#F5F2EF"
  },
  "fonts": [
    "Orbitron",
    "Space Grotesk"
  ],
  "surface": {
    "flat": true,
    "lightCinematic": false,
    "ground": "#FFFFFF"
  },
  "motion": {
    "cut": "cut",
    "drift": 1.02
  },
  "fx": {
    "canvas": "none",
    "three": null
  },
  "skin": {
    "accents": [
      "#D8000F"
    ],
    "extras": [
      "#1C1410",
      "#F5F2EF"
    ],
    "emphasisCss": null
  },
  "assets": {
    "photoMod": "",
    "iconStyle": "solid",
    "keywords": [
      "editorial poster",
      "vintage magazine",
      "tomato red",
      "serif print",
      "mid-century",
      "bold typography"
    ],
    "prefer": [
      "vector",
      "illustration"
    ]
  },
  "textfx": {
    "enter": "stamp",
    "emphasis": "boxed",
    "case": "upper",
    "tracking": -0.035,
    "weight": 900,
    "sizeScale": 1.25,
    "align": "left"
  },
  "audio": {
    "music": {
      "query": "big beat breakbeat percussive energetic drive",
      "mood": "energetic",
      "volume": 0.15
    },
    "sfx": {
      "style": "hard percussive hits, stomp impacts, clap accents and riser sweeps on every cut",
      "palette": [
        "impact hit",
        "clap",
        "riser sweep",
        "whoosh transition"
      ]
    }
  },
  "layout": {
    "propFill": false,
    "kicker": true,
    "underline": false,
    "stat": "headline"
  },
  "typography": {
    "display": "Orbitron"
  }
}